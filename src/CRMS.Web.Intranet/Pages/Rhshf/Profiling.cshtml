@page "/rhshf/profiling/{reference}"
@model CRMS.Web.Intranet.Pages.Rhshf.ProfilingModel
@using CRMS.Domain.Enums
@using CRMS.Application.Rhshf.Queries
@using CRMS.Web.Intranet.Models
@{
    ViewData["Title"] = "Credit Profiling";
}

@if (Model.IsExpired)
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-3">Your session has expired</h4>
            <p class="text-muted">
                For your security, this profiling link is no longer valid — it may have expired, already
                been used, or been opened for a different case.
            </p>
            <p class="text-muted mb-0">
                Please return to the RH-SHF portal and select <strong>&ldquo;Continue on CRMS&rdquo;</strong>
                again to resume — a fresh link will be issued automatically.
            </p>
        </div>
    </div>
}
else if (Model.Session is null)
{
    <div class="alert alert-danger">Something went wrong loading this case. Please try again.</div>
}
else if (Model.Session.CurrentStage is null)
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            @if (Model.Session.IsAwaitingOfferAcceptance)
            {
                @* Profiling is finished, but the case is not finished with the FAC. Telling them to
                   close the tab here is what stalled cases: they had no route to the offer page. *@
                <h4 class="mb-3">Your offer is ready</h4>
                <p class="text-muted">
                    Your credit profiling for <strong>@Model.Session.CompanyName</strong>
                    (reference <code>@Model.Session.Reference</code>) has been approved, and an offer
                    is waiting for you to review.
                </p>
                <a class="btn btn-success" href="/rhshf/offer/@Model.Session.Reference">
                    Review your offer
                </a>
            }
            else
            {
                <h4 class="mb-3">Profiling submitted</h4>
                <p class="text-muted mb-0">
                    Thank you — your credit profiling for <strong>@Model.Session.CompanyName</strong>
                    (reference <code>@Model.Session.Reference</code>) has been submitted and is now under
                    review. You can close this tab; the portal will show you the outcome once it's ready.
                </p>
            }
        </div>
    </div>
}
else
{
    var stages = new[]
    {
        RhshfProfilingStage.CompanyVerification, RhshfProfilingStage.CreditBureauCheck,
        RhshfProfilingStage.EopReview, RhshfProfilingStage.SupportingDocuments, RhshfProfilingStage.ReviewAndSubmit
    };
    var currentIndex = Array.IndexOf(stages, Model.Session.CurrentStage.Value);
    var furthest = Model.Session.FurthestStage ?? Model.Session.CurrentStage.Value;
    var stageLabels = new Dictionary<RhshfProfilingStage, string>
    {
        [RhshfProfilingStage.CompanyVerification] = "Company",
        [RhshfProfilingStage.CreditBureauCheck] = "Bureau & Parties",
        [RhshfProfilingStage.EopReview] = "EOP & Farm Plan",
        [RhshfProfilingStage.SupportingDocuments] = "Documents",
        [RhshfProfilingStage.ReviewAndSubmit] = "Review & Submit",
    };

    <p class="rhshf-stage-label mb-2">Step @(currentIndex + 1) of @stages.Length</p>
    <form method="post" asp-page-handler="GoToStage" class="rhshf-stepper d-flex flex-wrap gap-2 mb-4">
        <input type="hidden" name="reference" value="@Model.Session.Reference" />
        @for (var i = 0; i < stages.Length; i++)
        {
            var s = stages[i];
            var isCurrent = s == Model.Session.CurrentStage.Value;
            var isNavigable = (int)s <= (int)furthest && !isCurrent;
            var isDone = (int)s < (int)furthest;
            var baseCls = "btn btn-sm text-start flex-grow-1 d-flex align-items-center gap-2";
            var cls = isCurrent ? $"{baseCls} btn-success"
                : isNavigable ? $"{baseCls} btn-outline-success"
                : $"{baseCls} btn-outline-secondary disabled";
            <button type="submit" name="stage" value="@s" class="@cls"
                    disabled="@(!isNavigable)" title="@(isNavigable ? "Go back to this step to edit" : null)">
                <span class="badge rounded-pill @(isCurrent ? "bg-light text-success" : isDone ? "bg-success" : "bg-secondary")">
                    @(isDone ? "✓" : (i + 1).ToString())
                </span>
                <span class="small">@stageLabels[s]</span>
            </button>
        }
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            @switch (Model.Session.CurrentStage.Value)
            {
                case RhshfProfilingStage.CompanyVerification:
                    <h4 class="mb-3">Confirm your company details</h4>
                    <p class="text-muted">These details were submitted by the RH-SHF portal on your behalf. Please confirm they're correct before continuing.</p>
                    <dl class="row">
                        <dt class="col-sm-4">Company name</dt><dd class="col-sm-8">@Model.Session.CompanyName</dd>
                        <dt class="col-sm-4">RC number</dt><dd class="col-sm-8">@Model.Session.RcNumber</dd>
                        <dt class="col-sm-4">TIN</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Session.Tin) ? "Not provided" : Model.Session.Tin)</dd>
                        <dt class="col-sm-4">BOA account</dt><dd class="col-sm-8">@Model.Session.BoaAccountNumber</dd>
                        <dt class="col-sm-4">Location</dt><dd class="col-sm-8">@Model.Session.Lga, @Model.Session.State</dd>
                    </dl>
                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <input type="hidden" name="stage" value="@RhshfProfilingStage.CompanyVerification" />
                        <button type="submit" class="btn btn-success">These details are correct — continue</button>
                    </form>
                    break;

                case RhshfProfilingStage.CreditBureauCheck:
                    <h4 class="mb-3">Credit bureau check</h4>
                    @switch (Model.Session.BureauCheckOutcome)
                    {
                        case RhshfBureauOutcome.Cleared:
                            <div class="alert alert-success">No adverse credit history found.</div>
                            break;
                        case RhshfBureauOutcome.Flagged:
                            <div class="alert alert-warning">Some existing credit facilities were found on record. This does not block your application — it will be reviewed by our credit team.</div>
                            break;
                        case RhshfBureauOutcome.Failed:
                            <div class="alert alert-secondary">We couldn't complete an automated check right now. This won't block your application — our credit team will review manually.</div>
                            break;
                        default:
                            <div class="alert alert-secondary">Running credit bureau check…</div>
                            break;
                    }
                    @if (Model.Session.BureauCheckOutcome != RhshfBureauOutcome.NotRun)
                    {
                        <dl class="row">
                            <dt class="col-sm-6">Total facilities on record</dt><dd class="col-sm-6">@(Model.Session.BureauTotalLoans ?? 0)</dd>
                            <dt class="col-sm-6">Active facilities</dt><dd class="col-sm-6">@(Model.Session.BureauActiveLoans ?? 0)</dd>
                            <dt class="col-sm-6">Delinquent facilities</dt><dd class="col-sm-6">@(Model.Session.BureauDelinquentFacilities ?? 0)</dd>
                        </dl>

                        <hr class="my-4" />
                        <h5 class="mb-1">Company directors</h5>
                        <p class="text-muted small">We run a credit-bureau check on each director, so every director must be listed with their <strong>BVN</strong> (required before you can submit). You can pull them from your Bank of Agriculture account record, then confirm.</p>

                        <form method="post" asp-page-handler="PullDirectors" class="mb-3">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i> Pull directors from Bank of Agriculture record</button>
                        </form>

                        @if (Model.Session.Directors.Count > 0)
                        {
                            <table class="table table-sm align-middle">
                                <thead><tr><th>Name</th><th>BVN</th><th class="text-end">Shareholding</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var d in Model.Session.Directors)
                                {
                                    <tr>
                                        <td>@d.FullName @if (d.IsChairman) { <span class="badge bg-secondary ms-1">Chairman</span> }</td>
                                        <td>
                                            @if (d.HasBvn)
                                            {
                                                <span class="badge bg-success">Provided</span>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="UpdateDirectorBvn" class="d-flex gap-1 align-items-center">
                                                    <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                    <input type="hidden" name="directorId" value="@d.Id" />
                                                    <input type="hidden" name="shareholdingPercent" value="@d.ShareholdingPercent" />
                                                    <input name="bvn" maxlength="11" pattern="\d{11}" title="11 digits" required class="form-control form-control-sm" style="max-width: 130px;" placeholder="Add BVN (11 digits)" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success">Save</button>
                                                </form>
                                            }
                                        </td>
                                        @* Editable, not read-only. There was no way to correct a mistyped percentage:
                                           shareholding could only be set when the director was added, and FAC-declared
                                           directors cannot be deleted — so a typo was permanent and, now that the total
                                           is capped, would have been unfixable. The ceiling is what is left of 100%
                                           excluding this row's own holding. *@
                                        <td class="text-end" style="min-width: 170px;">
                                            <form method="post" asp-page-handler="UpdateDirectorShareholding" class="d-flex gap-1 justify-content-end align-items-center">
                                                <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                <input type="hidden" name="directorId" value="@d.Id" />
                                                <input name="shareholdingPercent" type="number" step="0.01" min="0"
                                                       max="@((Model.Session.RemainingShareholding + (d.ShareholdingPercent ?? 0m)).ToString("0.##"))"
                                                       value="@(d.ShareholdingPercent?.ToString("0.##"))"
                                                       class="form-control form-control-sm text-end" style="max-width: 90px;"
                                                       placeholder="—" aria-label="Shareholding percent for @d.FullName" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Save shareholding">%</button>
                                            </form>
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="RemoveDirector" onsubmit="return confirm('Remove this director?');">
                                                <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                <input type="hidden" name="directorId" value="@d.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @* Running total: the cap is enforced server-side on every add and edit, but the FAC
                               needs to see the arithmetic rather than discover it by being refused. Over 100% is an
                               error and blocks submission; under 100% is only information, because this list is not
                               a complete ownership register. *@
                            var shareTotal = Model.Session.DeclaredShareholdingTotal;
                            <div class="d-flex justify-content-between align-items-center small mb-2">
                                <span class="text-muted">Declared shareholding</span>
                                <span>
                                    <strong class="@(shareTotal > 100m ? "text-danger" : "")">@shareTotal.ToString("0.##")%</strong>
                                    @if (shareTotal < 100m)
                                    {
                                        <span class="text-muted">&middot; @Model.Session.RemainingShareholding.ToString("0.##")% unallocated</span>
                                    }
                                </span>
                            </div>

                            @if (shareTotal > 100m)
                            {
                                <div class="alert alert-danger py-2 small">
                                    Declared shareholding totals <strong>@shareTotal.ToString("0.##")%</strong>, which is more than 100%.
                                    This usually comes from the Bank of Agriculture record. Correct the percentages above
                                    before submitting.
                                </div>
                            }
                            else if (shareTotal > 0m && shareTotal < 100m)
                            {
                                <div class="alert alert-secondary py-2 small mb-2">
                                    The directors listed here account for <strong>@shareTotal.ToString("0.##")%</strong> of the company.
                                    If the remaining @Model.Session.RemainingShareholding.ToString("0.##")% is held by shareholders who are not
                                    directors, you do not need to list them — this step captures directors.
                                </div>
                            }

                            @if (Model.Session.Directors.Any(d => !d.HasBvn))
                            {
                                <div class="alert alert-warning py-2 small">Every director needs a BVN before you can submit — the bank runs a credit check on each one. Add the missing BVN(s) above.</div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small fst-italic">No directors added yet.</p>
                        }

                        <form method="post" asp-page-handler="AddDirector" class="row g-2 align-items-end mb-2">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <div class="col-md-4"><label class="form-label small mb-0">Full name</label><input name="fullName" class="form-control form-control-sm" required /></div>
                            <div class="col-md-3"><label class="form-label small mb-0">BVN <span class="text-danger">*</span></label><input name="bvn" maxlength="11" pattern="\d{11}" title="11 digits" required class="form-control form-control-sm" placeholder="11 digits" /></div>
                            @* Ceiling is what is actually left, not a flat 100 — the old max="100" is what let
                               60% + 50% through the browser. The server refuses it either way. *@
                            <div class="col-md-2">
                                <label class="form-label small mb-0">Shareholding %</label>
                                <input name="shareholdingPercent" type="number" step="0.01" min="0"
                                       max="@Model.Session.RemainingShareholding.ToString("0.##")"
                                       class="form-control form-control-sm"
                                       title="At most @Model.Session.RemainingShareholding.ToString("0.##")% is unallocated" />
                            </div>
                            <div class="col-md-2"><div class="form-check mt-3"><input type="checkbox" name="isChairman" value="true" class="form-check-input" id="chairCheck" /><label class="form-check-label small" for="chairCheck">Chairman</label></div></div>
                            <div class="col-md-1"><button type="submit" class="btn btn-sm btn-success w-100">Add</button></div>
                        </form>

                        <hr class="my-4" />
                        <h5 class="mb-1">Guarantors</h5>
                        <p class="text-muted small">List any guarantors backing this facility. Individuals are credit-checked by <strong>BVN</strong>; companies by <strong>RC number</strong>.</p>

                        @if (Model.Session.Guarantors.Count > 0)
                        {
                            <table class="table table-sm align-middle">
                                <thead><tr><th>Name</th><th>Type</th><th>Bureau ID</th><th>Relationship</th><th class="text-end">Guarantee</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var g in Model.Session.Guarantors)
                                {
                                    <tr>
                                        <td>@g.FullName</td>
                                        <td><span class="badge bg-light text-dark border">@g.GuarantorType</span></td>
                                        <td>
                                            @if (g.GuarantorType == CRMS.Domain.Enums.RhshfGuarantorType.Individual)
                                            {
                                                @if (g.HasBvn) { <span class="badge bg-success">BVN provided</span> } else { <span class="badge bg-danger">BVN missing</span> }
                                            }
                                            else if (string.IsNullOrWhiteSpace(g.RcNumber))
                                            {
                                                <span class="badge bg-danger">RC missing</span>
                                            }
                                            else
                                            {
                                                <code>@g.RcNumber</code>
                                            }
                                        </td>
                                        <td class="small text-muted">@(string.IsNullOrWhiteSpace(g.Relationship) ? "—" : g.Relationship)</td>
                                        <td class="text-end">@(g.GuaranteeAmount.HasValue ? $"{Model.Session.Currency} {g.GuaranteeAmount:N0}" : "—")</td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="RemoveGuarantor" onsubmit="return confirm('Remove this guarantor?');">
                                                <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                <input type="hidden" name="guarantorId" value="@g.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic">No guarantors added.</p>
                        }

                        <form method="post" asp-page-handler="AddGuarantor" class="row g-2 align-items-end mb-2">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <div class="col-md-2"><label class="form-label small mb-0">Type</label>
                                <select name="guarantorType" id="guarantorTypeSelect" class="form-select form-select-sm">
                                    @foreach (var t in Enum.GetValues<CRMS.Domain.Enums.RhshfGuarantorType>()) { <option value="@t">@t</option> }
                                </select>
                            </div>
                            <div class="col-md-3"><label class="form-label small mb-0">Full name / company</label><input name="fullName" class="form-control form-control-sm" required /></div>
                            <div class="col-md-2"><label class="form-label small mb-0">BVN <span class="text-danger" id="guarantorBvnStar">*</span></label><input name="bvn" id="guarantorBvn" maxlength="11" pattern="\d{11}" title="11 digits" class="form-control form-control-sm" placeholder="11 digits" /></div>
                            <div class="col-md-2"><label class="form-label small mb-0">RC <span class="text-danger d-none" id="guarantorRcStar">*</span></label><input name="rcNumber" id="guarantorRc" class="form-control form-control-sm" /></div>
                            <div class="col-md-2"><label class="form-label small mb-0">Guarantee amount</label><input name="guaranteeAmount" type="number" step="0.01" min="0" class="form-control form-control-sm" /></div>
                            <div class="col-md-1"><button type="submit" class="btn btn-sm btn-success w-100">Add</button></div>
                            <div class="col-md-3"><input name="relationship" class="form-control form-control-sm" placeholder="Relationship (e.g. Director)" /></div>
                        </form>
                        <script>
                            (function () {
                                var sel = document.getElementById('guarantorTypeSelect');
                                if (!sel) return;
                                var bvn = document.getElementById('guarantorBvn');
                                var rc = document.getElementById('guarantorRc');
                                var bvnStar = document.getElementById('guarantorBvnStar');
                                var rcStar = document.getElementById('guarantorRcStar');
                                function sync() {
                                    var ind = sel.value === 'Individual';
                                    bvn.required = ind; bvn.disabled = !ind; if (!ind) { bvn.value = ''; }
                                    rc.required = !ind; rc.disabled = ind; if (ind) { rc.value = ''; }
                                    bvnStar.classList.toggle('d-none', !ind);
                                    rcStar.classList.toggle('d-none', ind);
                                }
                                sel.addEventListener('change', sync); sync();
                            })();
                        </script>

                        <hr class="my-4" />
                        <h5 class="mb-1">Collateral / Security</h5>
                        <p class="text-muted small">Declare the security you are offering for this facility. The Bank's Legal Officer verifies and perfects it later &mdash; you supply the instrument and its reference here, then attach the supporting document (guarantee letter, CRG certificate, title deed) to each one below.</p>

                        @if (Model.Session.Collateral.Count > 0)
                        {
                            @foreach (var c in Model.Session.Collateral)
                            {
                                var detail = c.Type switch
                                {
                                    CRMS.Domain.Enums.RhshfCollateralType.BankGuarantee => c.GuarantorBankName,
                                    CRMS.Domain.Enums.RhshfCollateralType.LegalMortgage => c.PropertyDescription,
                                    _ => null,
                                };
                                var cover = c.Type switch
                                {
                                    CRMS.Domain.Enums.RhshfCollateralType.BankGuarantee => c.GuaranteeAmount.HasValue ? $"{Model.Session.Currency} {c.GuaranteeAmount:N0}" : null,
                                    CRMS.Domain.Enums.RhshfCollateralType.NirsalCrg => c.CrgCoveragePercentage.HasValue ? $"{c.CrgCoveragePercentage:0.##}% cover" : null,
                                    CRMS.Domain.Enums.RhshfCollateralType.LegalMortgage => c.PropertyValue.HasValue ? $"{Model.Session.Currency} {c.PropertyValue:N0}" : null,
                                    _ => null,
                                };

                                <div class="border rounded p-3 mb-2">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">@c.Type</span>
                                            @if (!string.IsNullOrWhiteSpace(cover))
                                            {
                                                <span class="fw-semibold ms-1">@cover</span>
                                            }
                                            <div class="small text-muted mt-1">
                                                @if (!string.IsNullOrWhiteSpace(detail)) { <span>@detail</span> }
                                                @if (!string.IsNullOrWhiteSpace(c.ReferenceNumber)) { <span class="ms-2">Ref: <code>@c.ReferenceNumber</code></span> }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(c.Notes))
                                            {
                                                <div class="small text-muted fst-italic">@c.Notes</div>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="RemoveCollateral" onsubmit="return confirm('Remove this collateral item?');">
                                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                            <input type="hidden" name="collateralId" value="@c.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </div>

                                    <div class="border-top mt-2 pt-2">
                                        @if (c.Documents.Count > 0)
                                        {
                                            <ul class="list-unstyled mb-2">
                                                @foreach (var doc in c.Documents)
                                                {
                                                    <li class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge bg-light text-dark border fw-normal flex-grow-1 text-start">
                                                            @doc.FileName <span class="text-muted">(@((doc.SizeBytes / 1024.0).ToString("N0")) KB)</span>
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                data-preview-name="@doc.FileName"
                                                                data-preview-type="@doc.ContentType"
                                                                data-preview-src="@Url.Page("Profiling", "PreviewDocument", new { reference = Model.Session.Reference, documentId = doc.Id, kind = RhshfFacDocumentKind.Collateral })"
                                                                data-preview-download="@Url.Page("Profiling", "DownloadDocument", new { reference = Model.Session.Reference, documentId = doc.Id, kind = RhshfFacDocumentKind.Collateral })">View</button>
                                                        <a class="btn btn-sm btn-outline-secondary"
                                                           href="@Url.Page("Profiling", "DownloadDocument", new { reference = Model.Session.Reference, documentId = doc.Id, kind = RhshfFacDocumentKind.Collateral })">Download</a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <div class="small text-danger mb-2"><i class="bi bi-exclamation-circle"></i> No supporting document attached yet.</div>
                                        }
                                        <form method="post" asp-page-handler="UploadCollateralDocument" enctype="multipart/form-data" class="row g-2 align-items-center">
                                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                            <input type="hidden" name="collateralId" value="@c.Id" />
                                            <div class="col-sm-8 col-md-6"><input type="file" name="file" class="form-control form-control-sm" required /></div>
                                            <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-success">@(c.Documents.Count > 0 ? "Add another file" : "Attach document")</button></div>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small fst-italic">No collateral declared.</p>
                        }

                        <form method="post" asp-page-handler="AddCollateral" class="border rounded p-3 bg-light-subtle mb-2">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3"><label class="form-label small mb-0">Type</label>
                                    <select name="collateralType" id="collateralTypeSelect" class="form-select form-select-sm">
                                        @foreach (var t in Enum.GetValues<CRMS.Domain.Enums.RhshfCollateralType>()) { <option value="@t">@t</option> }
                                    </select>
                                </div>
                                <div class="col-md-3"><label class="form-label small mb-0">Reference no.</label><input name="referenceNumber" class="form-control form-control-sm" placeholder="Instrument / title ref" /></div>
                                <div class="col-md-6"><label class="form-label small mb-0">Notes</label><input name="notes" class="form-control form-control-sm" /></div>
                            </div>

                            <div class="row g-2 align-items-end mt-1 collateral-block" data-collateral-block="BankGuarantee">
                                <div class="col-md-5"><label class="form-label small mb-0">Guarantor bank</label><input name="guarantorBankName" class="form-control form-control-sm" /></div>
                                <div class="col-md-4"><label class="form-label small mb-0">Guarantee amount</label><input name="guaranteeAmount" type="number" step="0.01" min="0" class="form-control form-control-sm" /></div>
                                <div class="col-md-3"><div class="form-check mt-3"><input type="checkbox" name="isUnconditional" value="true" class="form-check-input" id="uncondCheck" /><label class="form-check-label small" for="uncondCheck">Unconditional</label></div></div>
                            </div>

                            <div class="row g-2 align-items-end mt-1 collateral-block" data-collateral-block="NirsalCrg">
                                <div class="col-md-4"><label class="form-label small mb-0">Coverage %</label><input name="crgCoveragePercentage" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" /></div>
                            </div>

                            <div class="row g-2 align-items-end mt-1 collateral-block" data-collateral-block="LegalMortgage">
                                <div class="col-md-5"><label class="form-label small mb-0">Property description</label><input name="propertyDescription" class="form-control form-control-sm" /></div>
                                <div class="col-md-4"><label class="form-label small mb-0">Property value</label><input name="propertyValue" type="number" step="0.01" min="0" class="form-control form-control-sm" /></div>
                                <div class="col-md-3"><label class="form-label small mb-0">Title reference</label><input name="titleReferenceNumber" class="form-control form-control-sm" /></div>
                            </div>

                            <div class="mt-3"><button type="submit" class="btn btn-sm btn-success">Add collateral</button>
                                <span class="text-muted small ms-2">Add as many instruments as you need — each one is listed above.</span></div>
                        </form>
                        <script>
                            (function () {
                                var sel = document.getElementById('collateralTypeSelect');
                                if (!sel) return;
                                var blocks = document.querySelectorAll('.collateral-block');
                                function sync() {
                                    blocks.forEach(function (b) {
                                        var show = b.getAttribute('data-collateral-block') === sel.value;
                                        b.style.display = show ? '' : 'none';
                                        if (!show) {
                                            b.querySelectorAll('input').forEach(function (i) {
                                                if (i.type === 'checkbox') { i.checked = false; } else { i.value = ''; }
                                            });
                                        }
                                    });
                                }
                                sel.addEventListener('change', sync);
                                sync();
                            })();
                        </script>

                        <hr class="my-4" />
                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <input type="hidden" name="stage" value="@RhshfProfilingStage.CreditBureauCheck" />
                            <button type="submit" class="btn btn-success">Continue</button>
                        </form>
                    }
                    else
                    {
                        <form method="get">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" class="btn btn-outline-secondary">Refresh</button>
                        </form>
                    }
                    break;

                case RhshfProfilingStage.EopReview:
                    <h4 class="mb-3">Review your Estimate of Production (EOP)</h4>
                    <p class="text-muted">Confirm the input package submitted by the portal, then tell us what you expect to produce with it.</p>
                    <table class="table table-sm">
                        @{
                            // The portal holds quantities per input (bags, litres), never a tonnage
                            // of the commodity grown, so it sends 0. Showing the FAC "0 kg" against
                            // their own EOP reads as a data error on our side.
                            var showQty = Model.Session.EopLines.Any(l => l.QuantityKg > 0 || l.UnitPricePerKg > 0);
                        }
                        <thead>
                            <tr>
                                <th>Commodity</th>
                                @if (showQty)
                                {
                                    <th class="text-end">Quantity (kg)</th>
                                    <th class="text-end">Unit price</th>
                                }
                                <th class="text-end">Line value</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in Model.Session.EopLines)
                        {
                            <tr>
                                <td>@line.Commodity</td>
                                @if (showQty)
                                {
                                    <td class="text-end">@(line.QuantityKg > 0 ? line.QuantityKg.ToString("N0") : "—")</td>
                                    <td class="text-end">@(line.UnitPricePerKg > 0 ? line.UnitPricePerKg.ToString("N2") : "—")</td>
                                }
                                <td class="text-end">@line.LineValue.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold"><td colspan="@(showQty ? 3 : 1)">Total EOP value</td><td class="text-end">@Model.Session.Currency @Model.Session.TotalEopValue.ToString("N2")</td></tr>
                        </tfoot>
                    </table>

                    <hr class="my-4" />

                    <h5>Your farm plan</h5>
                    <p class="text-muted">
                        The bank assesses repayment against what this land is expected to produce, so this section is
                        required. Add one row per crop.
                    </p>

                    @if (Model.Session.FarmPlans.Count > 0)
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Crop</th>
                                    <th class="text-end">Hectares</th>
                                    <th class="text-end">Yield (kg/ha)</th>
                                    <th class="text-end">Price (@Model.Session.Currency/kg)</th>
                                    <th class="text-end">Expected revenue</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var plan in Model.Session.FarmPlans)
                            {
                                <tr>
                                    <td>@plan.Crop</td>
                                    <td class="text-end">@plan.Hectares.ToString("N2")</td>
                                    <td class="text-end">@plan.ExpectedYieldKgPerHectare.ToString("N0")</td>
                                    <td class="text-end">@plan.ExpectedPricePerKg.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@plan.ExpectedRevenue.ToString("N2")</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RemoveFarmPlan">
                                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                            <input type="hidden" name="planId" value="@plan.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td>@Model.Session.FarmPlans.Sum(p => p.Hectares).ToString("N2") ha total</td>
                                    <td colspan="3"></td>
                                    <td class="text-end">@Model.Session.Currency @Model.Session.FarmPlans.Sum(p => p.ExpectedRevenue).ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">No crops added yet. At least one is needed before you can submit.</div>
                    }

                    <form method="post" asp-page-handler="AddFarmPlan" class="row g-2 align-items-end mb-4">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <div class="col-md-3">
                            <label class="form-label small">Crop</label>
                            <input name="crop" class="form-control" placeholder="e.g. Maize" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Hectares</label>
                            <input name="hectares" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Expected yield (kg/ha)</label>
                            <input name="yieldPerHa" type="number" step="1" min="1" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Price (@Model.Session.Currency/kg)</label>
                            <input name="pricePerKg" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-outline-success w-100">Add crop</button>
                        </div>
                    </form>

                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <input type="hidden" name="stage" value="@RhshfProfilingStage.EopReview" />
                        <button type="submit" class="btn btn-success" disabled="@(Model.Session.FarmPlans.Count == 0)">
                            This is correct — continue
                        </button>
                    </form>
                    break;

                case RhshfProfilingStage.SupportingDocuments:
                    {
                        var missingMandatory = Model.Session.DocumentRequirements
                            .Where(r => r.IsMandatory && !r.IsSatisfied).ToList();

                        <h4 class="mb-3">Supporting documents</h4>
                        <p class="text-muted">
                            Attach the documents below. Items marked <span class="badge bg-danger">Required</span>
                            must be supplied before you can submit.
                        </p>

                        <table class="table table-sm align-middle">
                            <thead><tr><th>Document</th><th>Status</th><th class="text-end">Attach</th></tr></thead>
                            <tbody>
                            @foreach (var req in Model.Session.DocumentRequirements.OrderBy(r => r.SortOrder))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @req.Title
                                            @if (req.IsMandatory)
                                            {
                                                <span class="badge bg-danger ms-1">Required</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-1">Optional</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(req.Description))
                                        {
                                            <div class="small text-muted">@req.Description</div>
                                        }
                                        @if (string.Equals(req.Category.ToString(), "AuditedFinancials", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="small mt-1">
                                                <a href="/api/financial-statements/template" target="_blank" class="text-success">
                                                    <i class="bi bi-download"></i> Download the financial statements template (3 years)
                                                </a>
                                                <div class="text-muted">Fill it in and upload it here so the bank can analyse your financials.</div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (req.IsSatisfied)
                                        {
                                            <span class="badge bg-success">@req.AttachedCount attached</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Not attached</span>
                                        }
                                    </td>
                                    <td class="text-end" style="min-width: 320px;">
                                        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="d-flex gap-2 justify-content-end">
                                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                            <input type="hidden" name="category" value="@req.Category" />
                                            <input type="file" name="file" class="form-control form-control-sm" required />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">Upload</button>
                                        </form>
                                        @* Carry-over: a CAM the FAC already supplied on an earlier season need not be
                                           uploaded again. Loaded only while this slot is empty, so it disappears once
                                           something is attached — including when the carry-over itself is what filled it. *@
                                        @if (req.Category == RhshfDocumentCategory.CreditAppraisalMemorandum
                                             && !req.IsSatisfied && Model.ReusableCamDocuments.Count > 0)
                                        {
                                            <details class="mt-2 text-start">
                                                <summary class="small text-success" style="cursor: pointer;">
                                                    Or re-use one from an earlier application (@Model.ReusableCamDocuments.Count)
                                                </summary>
                                                <ul class="list-group list-group-flush mt-2">
                                                    @foreach (var cam in Model.ReusableCamDocuments)
                                                    {
                                                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                                            <span class="small">
                                                                <span class="fw-semibold">@cam.FileName</span>
                                                                <span class="d-block text-muted">
                                                                    @cam.SourceSessionName &middot; @cam.SourceReference &middot;
                                                                    uploaded @cam.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")
                                                                </span>
                                                            </span>
                                                            <form method="post" asp-page-handler="ReuseDocument">
                                                                <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                                <input type="hidden" name="sourceDocumentId" value="@cam.DocumentId" />
                                                                <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">Use this</button>
                                                            </form>
                                                        </li>
                                                    }
                                                </ul>
                                                <div class="small text-muted mt-1">
                                                    A copy is attached to this application. Check it is still the right
                                                    version &mdash; upload a newer one instead if it is not.
                                                </div>
                                            </details>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        @if (Model.Session.SupportingDocuments.Count > 0)
                        {
                            <h6 class="mt-4">Attached files</h6>
                            <ul class="list-group mb-3">
                                @foreach (var doc in Model.Session.SupportingDocuments)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            @doc.FileName
                                            @* The requirement's Title, not the enum member: the FAC must see the same
                                               name here as on the upload slot it attached this against. *@
                                            <span class="badge bg-light text-dark border ms-1">
                                                @(Model.Session.DocumentRequirements.FirstOrDefault(r => r.Category == doc.Category)?.Title
                                                  ?? RhshfDisplayNames.CategoryLabel(doc.Category))
                                            </span>
                                            @if (doc.IsReused)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border ms-1"
                                                      title="Carried over from @doc.ReusedFromReference">re-used</span>
                                            }
                                        </span>
                                        <span class="d-flex gap-2 align-items-center">
                                            <span class="text-muted small">@((doc.SizeBytes / 1024.0).ToString("N0")) KB</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    data-preview-name="@doc.FileName"
                                                    data-preview-type="@doc.ContentType"
                                                    data-preview-src="@Url.Page("Profiling", "PreviewDocument", new { reference = Model.Session.Reference, documentId = doc.Id, kind = RhshfFacDocumentKind.Supporting })"
                                                    data-preview-download="@Url.Page("Profiling", "DownloadDocument", new { reference = Model.Session.Reference, documentId = doc.Id, kind = RhshfFacDocumentKind.Supporting })">View</button>
                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="@Url.Page("Profiling", "DownloadDocument", new { reference = Model.Session.Reference, documentId = doc.Id, kind = RhshfFacDocumentKind.Supporting })">Download</a>
                                            <form method="post" asp-page-handler="RemoveDocument">
                                                <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                <input type="hidden" name="documentId" value="@doc.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }

                        @if (missingMandatory.Count > 0)
                        {
                            <div class="alert alert-warning">
                                Still required: @string.Join(", ", missingMandatory.Select(r => r.Title))
                            </div>
                        }

                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <input type="hidden" name="stage" value="@RhshfProfilingStage.SupportingDocuments" />
                            <button type="submit" class="btn btn-success" disabled="@(missingMandatory.Count > 0)">Continue</button>
                        </form>
                    }
                    break;

                case RhshfProfilingStage.ReviewAndSubmit:
                    <h4 class="mb-1">Review and submit</h4>
                    <p class="text-muted">Check everything below before submitting for credit review. Use <strong>Edit</strong> on any section to go back and correct it &mdash; you'll return here.</p>

                    var missingBvnDirectors = Model.Session.Directors.Count(d => !d.HasBvn);
                    var missingBvnGuarantors = Model.Session.Guarantors.Count(g => g.GuarantorType == CRMS.Domain.Enums.RhshfGuarantorType.Individual && !g.HasBvn);
                    // The Bank's Legal Officer verifies and perfects the declared security before the
                    // case is circulated for approval, so a case with none cannot be submitted — and
                    // each instrument needs its evidence attached for Legal to sight.
                    var noCollateral = Model.Session.Collateral.Count == 0;
                    var undocumentedCollateral = Model.Session.Collateral.Count(c => c.Documents.Count == 0);
                    var blockSubmit = missingBvnDirectors > 0 || missingBvnGuarantors > 0
                        || noCollateral || undocumentedCollateral > 0;

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                        <h6 class="mb-0">Company</h6>
                        <form method="post" asp-page-handler="GoToStage" class="d-inline">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" name="stage" value="@RhshfProfilingStage.CompanyVerification" class="btn btn-sm btn-link p-0">Edit</button>
                        </form>
                    </div>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Company</dt><dd class="col-sm-8">@Model.Session.CompanyName (@Model.Session.RcNumber)</dd>
                        <dt class="col-sm-4">BOA account</dt><dd class="col-sm-8">@Model.Session.BoaAccountNumber</dd>
                    </dl>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                        <h6 class="mb-0">Directors, guarantors &amp; collateral</h6>
                        <form method="post" asp-page-handler="GoToStage" class="d-inline">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" name="stage" value="@RhshfProfilingStage.CreditBureauCheck" class="btn btn-sm btn-link p-0">Edit</button>
                        </form>
                    </div>
                    <dl class="row mb-1">
                        <dt class="col-sm-4">Directors</dt>
                        <dd class="col-sm-8">
                            @Model.Session.Directors.Count listed
                            @if (missingBvnDirectors > 0)
                            {
                                <span class="badge bg-danger ms-1">@missingBvnDirectors missing BVN</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Guarantors</dt>
                        <dd class="col-sm-8">
                            @Model.Session.Guarantors.Count listed
                            @if (missingBvnGuarantors > 0)
                            {
                                <span class="badge bg-danger ms-1">@missingBvnGuarantors missing BVN</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Collateral</dt>
                        <dd class="col-sm-8">
                            @Model.Session.Collateral.Count declared
                            @if (noCollateral)
                            {
                                <span class="badge bg-danger ms-1">required</span>
                            }
                            else if (undocumentedCollateral > 0)
                            {
                                <span class="badge bg-danger ms-1">@undocumentedCollateral missing document</span>
                            }
                        </dd>
                    </dl>
                    @if (missingBvnDirectors > 0 || missingBvnGuarantors > 0)
                    {
                        <div class="alert alert-warning py-2 small mb-4">
                            @if (missingBvnDirectors > 0) { <div>One or more directors have no BVN &mdash; the bank cannot run their credit check. Add it before submitting.</div> }
                            @if (missingBvnGuarantors > 0) { <div>One or more individual guarantors have no BVN. Add it before submitting.</div> }
                        </div>
                    }
                    else
                    {
                        <div class="mb-4"></div>
                    }

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                        <h6 class="mb-0">EOP &amp; farm plan</h6>
                        <form method="post" asp-page-handler="GoToStage" class="d-inline">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" name="stage" value="@RhshfProfilingStage.EopReview" class="btn btn-sm btn-link p-0">Edit</button>
                        </form>
                    </div>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Total EOP value</dt><dd class="col-sm-8">@Model.Session.Currency @Model.Session.TotalEopValue.ToString("N2")</dd>
                        <dt class="col-sm-4">Land under cultivation</dt><dd class="col-sm-8">@Model.Session.FarmPlans.Sum(p => p.Hectares).ToString("N2") ha across @Model.Session.FarmPlans.Count crop(s)</dd>
                        <dt class="col-sm-4">Expected revenue</dt><dd class="col-sm-8">@Model.Session.Currency @Model.Session.FarmPlans.Sum(p => p.ExpectedRevenue).ToString("N2")</dd>
                    </dl>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                        <h6 class="mb-0">Supporting documents</h6>
                        <form method="post" asp-page-handler="GoToStage" class="d-inline">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" name="stage" value="@RhshfProfilingStage.SupportingDocuments" class="btn btn-sm btn-link p-0">Edit</button>
                        </form>
                    </div>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Documents attached</dt><dd class="col-sm-8">@Model.Session.SupportingDocuments.Count</dd>
                    </dl>

                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <input type="hidden" name="stage" value="@RhshfProfilingStage.ReviewAndSubmit" />
                        <button type="submit" class="btn btn-success btn-lg" disabled="@blockSubmit">Submit for credit review</button>
                    </form>
                    @if (missingBvnDirectors > 0 || missingBvnGuarantors > 0)
                    {
                        <p class="small text-danger mt-2 mb-0">You can't submit yet: BVN is missing for @missingBvnDirectors director(s) and @missingBvnGuarantors individual guarantor(s). Use <strong>Edit</strong> on the directors, guarantors &amp; collateral section to add it.</p>
                    }
                    @if (noCollateral)
                    {
                        <p class="small text-danger mt-2 mb-0">You can't submit yet: no security has been declared. Use <strong>Edit</strong> on the directors, guarantors &amp; collateral section to add at least one instrument (bank guarantee, NIRSAL CRG or legal mortgage) and attach its document.</p>
                    }
                    else if (undocumentedCollateral > 0)
                    {
                        <p class="small text-danger mt-2 mb-0">You can't submit yet: @undocumentedCollateral of your @Model.Session.Collateral.Count security instrument(s) have no document attached. The Bank's Legal Officer has to sight the guarantee letter, CRG certificate or title deed itself — use <strong>Edit</strong> on the directors, guarantors &amp; collateral section to attach it.</p>
                    }
                    break;
            }
        </div>
    </div>
}

@* ── Document preview ──────────────────────────────────────────────────────────────────────────
   One modal shared by every View button on the page (collateral documents and supporting
   documents). The button carries the file's name, content type and URLs as data- attributes; the
   script below picks an inline viewer for PDFs and images and falls back to a download prompt for
   anything a browser can't render, like .docx. Nothing here changes how files are uploaded or
   removed — it only reads back what is already on file. *@
<div class="modal fade" id="docPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-truncate" id="docPreviewTitle">Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="min-height: 60vh;">
                <iframe id="docPreviewFrame" title="Document preview" class="w-100 d-none" style="height: 60vh; border: 0;"></iframe>
                <img id="docPreviewImage" alt="Document preview" class="img-fluid d-none" />
                <div id="docPreviewUnsupported" class="d-none text-center text-muted py-5">
                    <p class="mb-1">This file type can't be previewed in the browser.</p>
                    <p class="small mb-0">Use <strong>Download</strong> below to open it on your device.</p>
                </div>
            </div>
            <div class="modal-footer">
                <a id="docPreviewDownload" class="btn btn-outline-success" href="#">Download</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalEl = document.getElementById('docPreviewModal');
        if (!modalEl) return;

        var frame = document.getElementById('docPreviewFrame');
        var image = document.getElementById('docPreviewImage');
        var unsupported = document.getElementById('docPreviewUnsupported');
        var title = document.getElementById('docPreviewTitle');
        var download = document.getElementById('docPreviewDownload');
        var modal = new bootstrap.Modal(modalEl);

        function reset() {
            [frame, image, unsupported].forEach(function (el) { el.classList.add('d-none'); });
            frame.src = 'about:blank';
            image.removeAttribute('src');
        }

        document.querySelectorAll('[data-preview-src]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                reset();
                var type = (btn.getAttribute('data-preview-type') || '').toLowerCase();
                var src = btn.getAttribute('data-preview-src');
                var name = btn.getAttribute('data-preview-name') || 'Document';

                title.textContent = name;
                download.href = btn.getAttribute('data-preview-download');

                if (type.indexOf('pdf') !== -1) {
                    frame.src = src;
                    frame.classList.remove('d-none');
                } else if (type.indexOf('image/') === 0) {
                    image.src = src;
                    image.classList.remove('d-none');
                } else {
                    // Content type can be missing or generic on older uploads — fall back on the
                    // file extension before giving up, so a .pdf still previews.
                    var lower = name.toLowerCase();
                    if (lower.endsWith('.pdf')) {
                        frame.src = src;
                        frame.classList.remove('d-none');
                    } else if (/\.(png|jpe?g|gif|webp|bmp)$/.test(lower)) {
                        image.src = src;
                        image.classList.remove('d-none');
                    } else {
                        unsupported.classList.remove('d-none');
                    }
                }

                modal.show();
            });
        });

        // Don't leave a loaded PDF/image in memory (or a stale frame) behind a closed modal.
        modalEl.addEventListener('hidden.bs.modal', reset);
    })();
</script>
