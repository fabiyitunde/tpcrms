@page "/rhshf/profiling/{reference}"
@model CRMS.Web.Intranet.Pages.Rhshf.ProfilingModel
@using CRMS.Domain.Enums
@{
    ViewData["Title"] = "Credit Profiling";
}

@if (Model.IsExpired)
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-3">Your session has expired</h4>
            <p class="text-muted">
                For your security, this profiling link is no longer valid — it may have expired, already
                been used, or been opened for a different case.
            </p>
            <p class="text-muted mb-0">
                Please return to the RH-SHF portal and select <strong>&ldquo;Continue on CRMS&rdquo;</strong>
                again to resume — a fresh link will be issued automatically.
            </p>
        </div>
    </div>
}
else if (Model.Session is null)
{
    <div class="alert alert-danger">Something went wrong loading this case. Please try again.</div>
}
else if (Model.Session.CurrentStage is null)
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            @if (Model.Session.IsAwaitingOfferAcceptance)
            {
                @* Profiling is finished, but the case is not finished with the FAC. Telling them to
                   close the tab here is what stalled cases: they had no route to the offer page. *@
                <h4 class="mb-3">Your offer is ready</h4>
                <p class="text-muted">
                    Your credit profiling for <strong>@Model.Session.CompanyName</strong>
                    (reference <code>@Model.Session.Reference</code>) has been approved, and an offer
                    is waiting for you to review.
                </p>
                <a class="btn btn-success" href="/rhshf/offer/@Model.Session.Reference">
                    Review your offer
                </a>
            }
            else
            {
                <h4 class="mb-3">Profiling submitted</h4>
                <p class="text-muted mb-0">
                    Thank you — your credit profiling for <strong>@Model.Session.CompanyName</strong>
                    (reference <code>@Model.Session.Reference</code>) has been submitted and is now under
                    review. You can close this tab; the portal will show you the outcome once it's ready.
                </p>
            }
        </div>
    </div>
}
else
{
    var stages = new[]
    {
        RhshfProfilingStage.CompanyVerification, RhshfProfilingStage.CreditBureauCheck,
        RhshfProfilingStage.EopReview, RhshfProfilingStage.SupportingDocuments, RhshfProfilingStage.ReviewAndSubmit
    };
    var currentIndex = Array.IndexOf(stages, Model.Session.CurrentStage.Value);

    <p class="rhshf-stage-label mb-1">Step @(currentIndex + 1) of @stages.Length</p>
    <div class="progress mb-4" style="height: 6px;">
        <div class="progress-bar bg-success" style="width: @((currentIndex + 1) * 100 / stages.Length)%"></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            @switch (Model.Session.CurrentStage.Value)
            {
                case RhshfProfilingStage.CompanyVerification:
                    <h4 class="mb-3">Confirm your company details</h4>
                    <p class="text-muted">These details were submitted by the RH-SHF portal on your behalf. Please confirm they're correct before continuing.</p>
                    <dl class="row">
                        <dt class="col-sm-4">Company name</dt><dd class="col-sm-8">@Model.Session.CompanyName</dd>
                        <dt class="col-sm-4">RC number</dt><dd class="col-sm-8">@Model.Session.RcNumber</dd>
                        <dt class="col-sm-4">TIN</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Session.Tin) ? "Not provided" : Model.Session.Tin)</dd>
                        <dt class="col-sm-4">BOA account</dt><dd class="col-sm-8">@Model.Session.BoaAccountNumber</dd>
                        <dt class="col-sm-4">Location</dt><dd class="col-sm-8">@Model.Session.Lga, @Model.Session.State</dd>
                    </dl>
                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <input type="hidden" name="stage" value="@RhshfProfilingStage.CompanyVerification" />
                        <button type="submit" class="btn btn-success">These details are correct — continue</button>
                    </form>
                    break;

                case RhshfProfilingStage.CreditBureauCheck:
                    <h4 class="mb-3">Credit bureau check</h4>
                    @switch (Model.Session.BureauCheckOutcome)
                    {
                        case RhshfBureauOutcome.Cleared:
                            <div class="alert alert-success">No adverse credit history found.</div>
                            break;
                        case RhshfBureauOutcome.Flagged:
                            <div class="alert alert-warning">Some existing credit facilities were found on record. This does not block your application — it will be reviewed by our credit team.</div>
                            break;
                        case RhshfBureauOutcome.Failed:
                            <div class="alert alert-secondary">We couldn't complete an automated check right now. This won't block your application — our credit team will review manually.</div>
                            break;
                        default:
                            <div class="alert alert-secondary">Running credit bureau check…</div>
                            break;
                    }
                    @if (Model.Session.BureauCheckOutcome != RhshfBureauOutcome.NotRun)
                    {
                        <dl class="row">
                            <dt class="col-sm-6">Total facilities on record</dt><dd class="col-sm-6">@(Model.Session.BureauTotalLoans ?? 0)</dd>
                            <dt class="col-sm-6">Active facilities</dt><dd class="col-sm-6">@(Model.Session.BureauActiveLoans ?? 0)</dd>
                            <dt class="col-sm-6">Delinquent facilities</dt><dd class="col-sm-6">@(Model.Session.BureauDelinquentFacilities ?? 0)</dd>
                        </dl>
                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <input type="hidden" name="stage" value="@RhshfProfilingStage.CreditBureauCheck" />
                            <button type="submit" class="btn btn-success">Continue</button>
                        </form>
                    }
                    else
                    {
                        <form method="get">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <button type="submit" class="btn btn-outline-secondary">Refresh</button>
                        </form>
                    }
                    break;

                case RhshfProfilingStage.EopReview:
                    <h4 class="mb-3">Review your Estimate of Production (EOP)</h4>
                    <p class="text-muted">Confirm the input package submitted by the portal, then tell us what you expect to produce with it.</p>
                    <table class="table table-sm">
                        @{
                            // The portal holds quantities per input (bags, litres), never a tonnage
                            // of the commodity grown, so it sends 0. Showing the FAC "0 kg" against
                            // their own EOP reads as a data error on our side.
                            var showQty = Model.Session.EopLines.Any(l => l.QuantityKg > 0 || l.UnitPricePerKg > 0);
                        }
                        <thead>
                            <tr>
                                <th>Commodity</th>
                                @if (showQty)
                                {
                                    <th class="text-end">Quantity (kg)</th>
                                    <th class="text-end">Unit price</th>
                                }
                                <th class="text-end">Line value</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in Model.Session.EopLines)
                        {
                            <tr>
                                <td>@line.Commodity</td>
                                @if (showQty)
                                {
                                    <td class="text-end">@(line.QuantityKg > 0 ? line.QuantityKg.ToString("N0") : "—")</td>
                                    <td class="text-end">@(line.UnitPricePerKg > 0 ? line.UnitPricePerKg.ToString("N2") : "—")</td>
                                }
                                <td class="text-end">@line.LineValue.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold"><td colspan="@(showQty ? 3 : 1)">Total EOP value</td><td class="text-end">@Model.Session.Currency @Model.Session.TotalEopValue.ToString("N2")</td></tr>
                        </tfoot>
                    </table>

                    <hr class="my-4" />

                    <h5>Your farm plan</h5>
                    <p class="text-muted">
                        The bank assesses repayment against what this land is expected to produce, so this section is
                        required. Add one row per crop.
                    </p>

                    @if (Model.Session.FarmPlans.Count > 0)
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Crop</th>
                                    <th class="text-end">Hectares</th>
                                    <th class="text-end">Yield (kg/ha)</th>
                                    <th class="text-end">Price (@Model.Session.Currency/kg)</th>
                                    <th class="text-end">Expected revenue</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var plan in Model.Session.FarmPlans)
                            {
                                <tr>
                                    <td>@plan.Crop</td>
                                    <td class="text-end">@plan.Hectares.ToString("N2")</td>
                                    <td class="text-end">@plan.ExpectedYieldKgPerHectare.ToString("N0")</td>
                                    <td class="text-end">@plan.ExpectedPricePerKg.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@plan.ExpectedRevenue.ToString("N2")</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RemoveFarmPlan">
                                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                            <input type="hidden" name="planId" value="@plan.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td>@Model.Session.FarmPlans.Sum(p => p.Hectares).ToString("N2") ha total</td>
                                    <td colspan="3"></td>
                                    <td class="text-end">@Model.Session.Currency @Model.Session.FarmPlans.Sum(p => p.ExpectedRevenue).ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">No crops added yet. At least one is needed before you can submit.</div>
                    }

                    <form method="post" asp-page-handler="AddFarmPlan" class="row g-2 align-items-end mb-4">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <div class="col-md-3">
                            <label class="form-label small">Crop</label>
                            <input name="crop" class="form-control" placeholder="e.g. Maize" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Hectares</label>
                            <input name="hectares" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Expected yield (kg/ha)</label>
                            <input name="yieldPerHa" type="number" step="1" min="1" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Price (@Model.Session.Currency/kg)</label>
                            <input name="pricePerKg" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-outline-success w-100">Add crop</button>
                        </div>
                    </form>

                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <input type="hidden" name="stage" value="@RhshfProfilingStage.EopReview" />
                        <button type="submit" class="btn btn-success" disabled="@(Model.Session.FarmPlans.Count == 0)">
                            This is correct — continue
                        </button>
                    </form>
                    break;

                case RhshfProfilingStage.SupportingDocuments:
                    {
                        var missingMandatory = Model.Session.DocumentRequirements
                            .Where(r => r.IsMandatory && !r.IsSatisfied).ToList();

                        <h4 class="mb-3">Supporting documents</h4>
                        <p class="text-muted">
                            Attach the documents below. Items marked <span class="badge bg-danger">Required</span>
                            must be supplied before you can submit.
                        </p>

                        <table class="table table-sm align-middle">
                            <thead><tr><th>Document</th><th>Status</th><th class="text-end">Attach</th></tr></thead>
                            <tbody>
                            @foreach (var req in Model.Session.DocumentRequirements.OrderBy(r => r.SortOrder))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @req.Title
                                            @if (req.IsMandatory)
                                            {
                                                <span class="badge bg-danger ms-1">Required</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-1">Optional</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(req.Description))
                                        {
                                            <div class="small text-muted">@req.Description</div>
                                        }
                                        @if (string.Equals(req.Category.ToString(), "AuditedFinancials", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="small mt-1">
                                                <a href="/api/financial-statements/template" target="_blank" class="text-success">
                                                    <i class="bi bi-download"></i> Download the financial statements template (3 years)
                                                </a>
                                                <div class="text-muted">Fill it in and upload it here so the bank can analyse your financials.</div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (req.IsSatisfied)
                                        {
                                            <span class="badge bg-success">@req.AttachedCount attached</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Not attached</span>
                                        }
                                    </td>
                                    <td class="text-end" style="min-width: 320px;">
                                        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="d-flex gap-2 justify-content-end">
                                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                            <input type="hidden" name="category" value="@req.Category" />
                                            <input type="file" name="file" class="form-control form-control-sm" required />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">Upload</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        @if (Model.Session.SupportingDocuments.Count > 0)
                        {
                            <h6 class="mt-4">Attached files</h6>
                            <ul class="list-group mb-3">
                                @foreach (var doc in Model.Session.SupportingDocuments)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            @doc.FileName
                                            <span class="badge bg-light text-dark border ms-1">@doc.Category</span>
                                        </span>
                                        <span class="d-flex gap-2 align-items-center">
                                            <span class="text-muted small">@((doc.SizeBytes / 1024.0).ToString("N0")) KB</span>
                                            <form method="post" asp-page-handler="RemoveDocument">
                                                <input type="hidden" name="reference" value="@Model.Session.Reference" />
                                                <input type="hidden" name="documentId" value="@doc.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }

                        @if (missingMandatory.Count > 0)
                        {
                            <div class="alert alert-warning">
                                Still required: @string.Join(", ", missingMandatory.Select(r => r.Title))
                            </div>
                        }

                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="reference" value="@Model.Session.Reference" />
                            <input type="hidden" name="stage" value="@RhshfProfilingStage.SupportingDocuments" />
                            <button type="submit" class="btn btn-success" disabled="@(missingMandatory.Count > 0)">Continue</button>
                        </form>
                    }
                    break;

                case RhshfProfilingStage.ReviewAndSubmit:
                    <h4 class="mb-3">Review and submit</h4>
                    <p class="text-muted">Please confirm the summary below before submitting for credit review.</p>
                    <dl class="row">
                        <dt class="col-sm-4">Company</dt><dd class="col-sm-8">@Model.Session.CompanyName</dd>
                        <dt class="col-sm-4">Total EOP value</dt><dd class="col-sm-8">@Model.Session.Currency @Model.Session.TotalEopValue.ToString("N2")</dd>
                        <dt class="col-sm-4">Land under cultivation</dt><dd class="col-sm-8">@Model.Session.FarmPlans.Sum(p => p.Hectares).ToString("N2") ha across @Model.Session.FarmPlans.Count crop(s)</dd>
                        <dt class="col-sm-4">Expected revenue</dt><dd class="col-sm-8">@Model.Session.Currency @Model.Session.FarmPlans.Sum(p => p.ExpectedRevenue).ToString("N2")</dd>
                        <dt class="col-sm-4">Documents attached</dt><dd class="col-sm-8">@Model.Session.SupportingDocuments.Count</dd>
                    </dl>
                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" name="reference" value="@Model.Session.Reference" />
                        <input type="hidden" name="stage" value="@RhshfProfilingStage.ReviewAndSubmit" />
                        <button type="submit" class="btn btn-success">Submit for credit review</button>
                    </form>
                    break;
            }
        </div>
    </div>
}
