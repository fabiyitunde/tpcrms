@page "/rhshf/offer/{reference}"
@model CRMS.Web.Intranet.Pages.Rhshf.OfferModel
@using CRMS.Domain.Enums
@{
    ViewData["Title"] = "Your Offer";
}

@if (Model.IsExpired)
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-3">Your session has expired</h4>
            <p class="text-muted mb-0">
                Please return to the RH-SHF portal and select <strong>&ldquo;Continue on CRMS&rdquo;</strong>
                again to resume — a fresh link will be issued automatically.
            </p>
        </div>
    </div>
}
else if (Model.Workspace is null)
{
    <div class="alert alert-danger">Something went wrong loading this case. Please try again.</div>
}
else if (Model.Offer is null)
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-3">No offer available yet</h4>
            <p class="text-muted mb-0">There is currently no offer to review for this case.</p>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-3">Your RH-SHF Offer</h4>
            <dl class="row">
                <dt class="col-sm-4">Company</dt><dd class="col-sm-8">@Model.Workspace.CompanyName</dd>
                <dt class="col-sm-4">Approved amount</dt><dd class="col-sm-8">@Model.Workspace.Currency @Model.Workspace.TotalEopValue.ToString("N2")</dd>
                <dt class="col-sm-4">Offer generated</dt><dd class="col-sm-8">@Model.Offer.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy")</dd>
            </dl>

            <div class="d-flex gap-2 mb-3">
                <a class="btn btn-outline-success" href="@Url.Page("Offer", "Download", new { reference = Model.Workspace.Reference })">
                    Download offer letter
                </a>
                @if (!string.IsNullOrEmpty(Model.Offer.KfsDocumentPath))
                {
                    <a class="btn btn-outline-success" href="@Url.Page("Offer", "DownloadKfs", new { reference = Model.Workspace.Reference })">
                        Download Key Facts Statement
                    </a>
                }
            </div>
            <p class="text-muted"><small>Sign the offer letter and the Key Facts Statement, then upload the signed copies below.</small></p>

            @if (Model.Offer.Status != RhshfOfferStatus.Generated)
            {
                <div class="alert alert-info">
                    You @(Model.Offer.Status == RhshfOfferStatus.Accepted ? "accepted" : "declined") this offer
                    on @Model.Offer.FacRespondedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm").
                </div>
            }
            else
            {
                var kfsIssued = !string.IsNullOrEmpty(Model.Offer.KfsDocumentPath);
                var hasLetter = Model.Offer.SignedDocuments.Any(d =>
                    d.Kind == RhshfOfferDocumentKind.SignedOfferLetter || d.Kind == RhshfOfferDocumentKind.Other);
                var hasKfs = Model.Offer.SignedDocuments.Any(d => d.Kind == RhshfOfferDocumentKind.SignedKfs);
                var canAccept = hasLetter && (!kfsIssued || hasKfs);

                <hr />
                <h5>Upload your signed documents</h5>
                <p class="text-muted">Sign the document(s) above and upload the signed copies into the matching slots.</p>

                <div class="mb-2 d-flex align-items-center gap-2">
                    <span class="badge @(hasLetter ? "bg-success" : "bg-secondary")">@(hasLetter ? "✓" : "–")</span>
                    <strong>Signed offer letter</strong>
                </div>
                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mb-3 d-flex gap-2">
                    <input type="hidden" name="reference" value="@Model.Workspace.Reference" />
                    <input type="hidden" name="kind" value="@RhshfOfferDocumentKind.SignedOfferLetter" />
                    <input type="file" name="file" class="form-control" required />
                    <button type="submit" class="btn btn-outline-success text-nowrap">Upload</button>
                </form>

                @if (kfsIssued)
                {
                    <div class="mb-2 d-flex align-items-center gap-2">
                        <span class="badge @(hasKfs ? "bg-success" : "bg-secondary")">@(hasKfs ? "✓" : "–")</span>
                        <strong>Signed Key Facts Statement</strong>
                    </div>
                    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mb-3 d-flex gap-2">
                        <input type="hidden" name="reference" value="@Model.Workspace.Reference" />
                        <input type="hidden" name="kind" value="@RhshfOfferDocumentKind.SignedKfs" />
                        <input type="file" name="file" class="form-control" required />
                        <button type="submit" class="btn btn-outline-success text-nowrap">Upload</button>
                    </form>
                }

                @if (Model.Offer.SignedDocuments.Count > 0)
                {
                    <ul class="list-group mb-3">
                        @foreach (var doc in Model.Offer.SignedDocuments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@doc.FileName <span class="badge bg-light text-dark border ms-1">@(doc.Kind == RhshfOfferDocumentKind.SignedOfferLetter ? "Offer letter" : doc.Kind == RhshfOfferDocumentKind.SignedKfs ? "KFS" : "Other")</span></span>
                                <span class="d-flex align-items-center gap-3">
                                    <span class="text-muted">@((doc.SizeBytes / 1024.0).ToString("N0")) KB</span>
                                    <form method="post" asp-page-handler="RemoveDocument" class="m-0"
                                          onsubmit="return confirm('Remove this file? You can then upload a replacement.');">
                                        <input type="hidden" name="reference" value="@Model.Workspace.Reference" />
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove this upload">Remove</button>
                                    </form>
                                </span>
                            </li>
                        }
                    </ul>
                }

                <hr />
                <h5>Your decision</h5>
                <form method="post">
                    <input type="hidden" name="reference" value="@Model.Workspace.Reference" />
                    <div class="mb-2">
                        <label class="form-label">Comment (optional)</label>
                        <textarea class="form-control" rows="2" name="notes" placeholder="Add a note about your decision (applies to whichever you choose)."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" asp-page-handler="Accept" class="btn btn-success" disabled="@(!canAccept)">
                            Accept offer
                        </button>
                        <button type="submit" asp-page-handler="Reject" class="btn btn-outline-danger">Decline offer</button>
                    </div>
                    @if (!canAccept)
                    {
                        <p class="text-muted mt-2"><small>Upload the signed @(kfsIssued ? "offer letter and Key Facts Statement" : "offer letter") above to enable Accept.</small></p>
                    }
                </form>
            }
        </div>
    </div>
}
