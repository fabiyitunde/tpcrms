    <div class="nav-section">
        @if (!Collapsed)
        {
            <div class="nav-section-title">Support</div>
        }
        <NavLink href="/help" class="nav-item">
            <span class="material-symbols-outlined nav-item-icon">help</span>
            @if (!Collapsed) { <span class="nav-item-text">Help & Guide</span> }
        </NavLink>
    </div>
</nav>

@code {
    [Parameter] public bool Collapsed { get; set; }
    
    private int MyQueueCount { get; set; }
    private int OverdueCount { get; set; }
    private int PendingVotesCount { get; set; }

    private UserInfo? User => AuthService.CurrentUser;
    
    private bool CanInitiateLoan => User?.HasAnyRole("SystemAdmin", "LoanOfficer") ?? false;
    private bool CanViewRoleQueues => User?.HasAnyRole("SystemAdmin", "RiskManager", "CreditOfficer", "HOReviewer") ?? false;
    private bool CanViewOverdue => User?.HasAnyRole("SystemAdmin", "RiskManager") ?? false;
    private bool CanViewCommittee => User?.HasAnyRole("SystemAdmin", "CommitteeMember", "CreditOfficer", "RiskManager") ?? false;
    private bool IsCommitteeMember => User?.HasRole("CommitteeMember") ?? false;
    private bool CanViewReports => User?.HasAnyRole("SystemAdmin", "RiskManager", "CreditOfficer", "HOReviewer", "Auditor") ?? false;
    private bool CanViewAudit => User?.HasAnyRole("SystemAdmin", "RiskManager", "Auditor") ?? false;
    private bool IsAdmin => User?.HasRole("SystemAdmin") ?? false;
    private bool IsBillingManager => User?.HasRole("BillingManager") ?? false;
    private bool CanViewBilling => User?.HasAnyRole("SystemAdmin", "BillingManager") ?? false;
    private bool CanViewNamp => User?.HasAnyRole("SystemAdmin", "LoanOfficer", "CreditOfficer",
        "CommitteeMember", "BranchCommitteeMember", "ZonalCommitteeMember", "RegionalCommitteeMember", "HOCommitteeMember",
        "BranchManager", "ZonalManager", "RegionalManager", "MdCeo",
        "FinalApprover", "DeploymentOfficer", "LegalOfficer",
        "BranchRiskOfficer", "ZonalRiskOfficer", "RegionalRiskOfficer", "HORiskOfficer",
        "RiskManager") ?? false;
    // RH-SHF is its own loan track — reuses the same generic CreditOfficer/RiskManager roles NAMP
    // and Corporate already use, but is otherwise independent (own queue, own domain).
    private bool CanViewRhshf => User?.HasAnyRole("SystemAdmin", "CreditOfficer", "RiskManager", "CommitteeMember", "FinalApprover", "LegalOfficer", "DisbursementOfficer") ?? false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCounts();
    }

    // Sequential on purpose. Every ApplicationService call on this circuit shares one scoped
    // DbContext, so running these counts in parallel (as they once did, with Task.Run and
    // Task.WhenAll) collided with whatever else the circuit was doing, including a login, and
    // threw "a second operation was started on this context instance" whenever the database
    // was slow enough for them to overlap.
    private async Task LoadCounts()
    {
        var userId = User?.Id ?? Guid.Empty;
        if (userId == Guid.Empty) return;

        MyQueueCount = await AppService.GetMyQueueCountAsync(userId);

        if (CanViewOverdue)
            OverdueCount = await AppService.GetOverdueCountAsync();

        if (IsCommitteeMember)
            PendingVotesCount = await AppService.GetMyPendingVotesCountAsync(userId);
    }
}
