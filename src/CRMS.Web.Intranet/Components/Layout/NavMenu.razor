                <span class="material-symbols-outlined nav-item-icon">checklist</span>
                @if (!Collapsed) { <span class="nav-item-text">RH-SHF Pre-Deploy Checklist</span> }
            </NavLink>
            <NavLink href="/admin/rhshf-document-requirements" class="nav-item">
                <span class="material-symbols-outlined nav-item-icon">description</span>
                @if (!Collapsed) { <span class="nav-item-text">RH-SHF Document Rules</span> }
            </NavLink>
            <NavLink href="/admin/rhshf-reason-codes" class="nav-item">
