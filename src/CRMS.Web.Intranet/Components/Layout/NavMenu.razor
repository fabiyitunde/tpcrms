            </NavLink>
            <NavLink href="/billing/statements" class="nav-item">
                <span class="material-symbols-outlined nav-item-icon">receipt_long</span>
                @if (!Collapsed) { <span class="nav-item-text">Statements</span> }
            </NavLink>
            @if (IsBillingManager)
