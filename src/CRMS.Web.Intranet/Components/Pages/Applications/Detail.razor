                    var totalCollaterals = application?.Collaterals.Count ?? 0;
                    var docCount = securityPerfectionDocs.Count;
                }
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-4);">
                    <div style="background: @(clearedCount == totalCollaterals && totalCollaterals > 0 ? "var(--success-50)" : "var(--warning-50)"); border: 1px solid @(clearedCount == totalCollaterals && totalCollaterals > 0 ? "var(--success-200)" : "var(--warning-200)"); border-radius: var(--radius-md); padding: var(--space-3); text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: 700; color: @(clearedCount == totalCollaterals && totalCollaterals > 0 ? "var(--success-700)" : "var(--warning-700)");">@clearedCount / @totalCollaterals</div>
                        <div style="font-size: var(--text-xs); color: var(--gray-600);">Collaterals Legally Cleared</div>
                    </div>
                    <div style="background: @(docCount > 0 ? "var(--success-50)" : "var(--gray-50)"); border: 1px solid @(docCount > 0 ? "var(--success-200)" : "var(--gray-200)"); border-radius: var(--radius-md); padding: var(--space-3); text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: 700; color: @(docCount > 0 ? "var(--success-700)" : "var(--gray-500)");">@docCount</div>
                        <div style="font-size: var(--text-xs); color: var(--gray-600);">Security Documents Uploaded</div>
                    </div>
                </div>
                @if (clearedCount < totalCollaterals && totalCollaterals > 0)
                {
                    <div style="padding: var(--space-3); background: var(--warning-50); border: 1px solid var(--warning-200); border-radius: var(--radius-md); margin-bottom: var(--space-4); font-size: var(--text-sm); color: var(--warning-800);">
                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">warning</span>
                        @(totalCollaterals - clearedCount) collateral(s) have not been marked as legally cleared on the Collateral tab.
                        You may still proceed if perfection is in progress, but ensure clearances are completed before disbursement.
                    </div>
                }
                <p style="font-size: var(--text-sm); color: var(--gray-600); margin-bottom: var(--space-3);">
                    By confirming, you attest that all required security instruments have been executed, registered, or lodged
                    as appropriate, and the facility is ready for disbursement.
                </p>
                <div class="form-group">
                    <label class="form-label">Perfection Summary <span style="color: var(--danger-600);">*</span></label>
                    <textarea class="form-control" rows="4" @bind="completeSecurityPerfectionNote"
                        placeholder="Summarise what was done — e.g. CAC charge registered (ref: CHG/2026/001234), mortgage deed filed at Lagos Land Registry, lien placed on fixed deposit account 0012345678..."></textarea>
                </div>
                @if (!string.IsNullOrEmpty(completeSecurityPerfectionError))
                {
                    <div style="color: var(--danger-600); font-size: var(--text-sm);">@completeSecurityPerfectionError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCompleteSecurityPerfectionModal" disabled="@isCompletingSecurityPerfection">Cancel</button>
                <button class="btn btn-success" @onclick="ConfirmCompleteSecurityPerfection"
                    disabled="@(isCompletingSecurityPerfection || string.IsNullOrWhiteSpace(completeSecurityPerfectionNote))">
                    @if (isCompletingSecurityPerfection) { <span class="spinner" style="width: 16px; height: 16px;"></span> }
                    Confirm Security Perfection Complete
                </button>
            </div>
        </div>
    </div>
}

