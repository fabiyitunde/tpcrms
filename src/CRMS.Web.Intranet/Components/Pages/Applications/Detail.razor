    private bool isIssuingOfferLetter;

    private async Task IssueOfferLetter()
    {
        if (!EnsureAuthenticated(out var userId)) return;
        isIssuingOfferLetter = true;
        inlineActionError = null;
        StateHasChanged();
        try
        {
            var userName = AuthService.CurrentUser?.FullName ?? "System";
            var userRole = AuthService.CurrentUser?.PrimaryRole ?? "Operations";

            // Generate the PDF first if not already generated
            if (!offerLetters.Any(l => l.Status == "Generated"))
            {
                var genResult = await AppService.GenerateOfferLetterAsync(Id, userId, userName);
                if (!genResult.Success)
                {
                    inlineActionError = genResult.Error ?? "Failed to generate offer letter PDF.";
                    await JS.InvokeVoidAsync("scrollToElement", "inline-action-error");
                    return;
                }
                offerLetters = await AppService.GetOfferLettersByApplicationAsync(Id);
                // Auto-download
                if (genResult.Data != null)
                {
                    var bytes = await AppService.DownloadGeneratedFileAsync(genResult.Data.StoragePath ?? string.Empty);
                    if (bytes != null)
                        await JS.InvokeVoidAsync("downloadFileFromBytes", genResult.Data.FileName, "application/pdf", bytes);
                }
            }

            // Transition status to OfferGenerated
            var result = application?.Status == AppStatus.Ratification
                ? await AppService.IssueRatifiedOfferLetterAsync(Id, userId, userRole)
                : await AppService.IssueOfferLetterAsync(Id, userId, userRole, null);
            // Always reload so UI reflects true DB state (avoids stale Approved status after partial failure)
            await LoadApplication();
            if (!result.Success)
            {
                inlineActionError = result.Error ?? "Failed to update status.";
                await JS.InvokeVoidAsync("scrollToElement", "inline-action-error");
            }
        }
        finally
        {
            isIssuingOfferLetter = false;
        }
    }

    // Record acceptance modal
    private bool showRecordAcceptanceModal;
    private DateTime acceptanceDate = DateTime.Today;
    private string acceptanceMethod = string.Empty;
    private string acceptanceNotes = string.Empty;
    private bool kfsAcknowledged;
    private string? acceptanceError;
    private bool isRecordingAcceptance;

    private void ShowRecordAcceptanceModalFn()
    {
        acceptanceDate = DateTime.Today;
        acceptanceMethod = string.Empty;
        acceptanceNotes = string.Empty;
        kfsAcknowledged = false;
        acceptanceError = null;
        showRecordAcceptanceModal = true;
    }

    private void CloseRecordAcceptanceModal()
    {
        showRecordAcceptanceModal = false;
        acceptanceError = null;
    }

    private async Task ConfirmRecordAcceptance()
    {
        if (!EnsureAuthenticated(out var userId)) return;
        if (SignedOfferLetterDoc == null || SignedKfsDoc == null)
        {
            acceptanceError = "Both the signed Offer Letter and signed KFS Acknowledgement must be uploaded before acceptance can be recorded.";
            return;
        }
        isRecordingAcceptance = true;
        acceptanceError = null;
        try
        {
            var userRole = AuthService.CurrentUser?.PrimaryRole ?? "Operations";
            var userName = AuthService.CurrentUser?.FullName ?? "Operations Officer";

            if (!Enum.TryParse<CRMS.Domain.Enums.OfferAcceptanceMethod>(acceptanceMethod, out var parsedMethod))
            {
                acceptanceError = "Please select a valid acceptance method.";
                return;
            }

            ApiResponse result;
            if (AuthService.CurrentUser?.HasRole("LoanOfficer") == true)
            {
                result = await AppService.RecordCorporateOfferAcceptanceAsync(
                    Id, userId, userRole, acceptanceDate, parsedMethod, kfsAcknowledged);
                if (result.Success)
                    result = await AppService.AdvanceToSecurityPerfectionAsync(Id, userId, userRole);
            }
            else
            {
                // Old flow: Operations records acceptance; auto-advances to SecurityPerfection
                var comments = $"Customer acceptance recorded. Method: {acceptanceMethod}. Date signed: {acceptanceDate:dd MMM yyyy}." +
                    (string.IsNullOrWhiteSpace(acceptanceNotes) ? "" : $" Notes: {acceptanceNotes}");
                result = await AppService.RecordOfferAcceptanceAsync(
                    Id, userId, userRole, userName, comments,
                    acceptanceDate, parsedMethod, kfsAcknowledged);
            }

            if (result.Success)
            {
                CloseRecordAcceptanceModal();
                await LoadApplication();
            }
            else
            {
                acceptanceError = result.Error ?? "Failed to record acceptance.";
            }
        }
        finally { isRecordingAcceptance = false; }
    }

