    // Signed offer doc upload state
    private bool showSignedDocUploadModal;
    private string _signedDocUploadType = string.Empty; // "offerLetter" or "kfs"
    private IBrowserFile? _signedDocFile;
    private bool _isUploadingSignedDoc;
    private string? _signedDocUploadError;

    private void OpenSignedDocUploadModal(string docType)
    {
        _signedDocUploadType = docType;
        _signedDocFile = null;
        _signedDocUploadError = null;
        showSignedDocUploadModal = true;
    }

    private void CloseSignedDocUploadModal()
    {
        showSignedDocUploadModal = false;
        _signedDocFile = null;
        _signedDocUploadError = null;
    }

    private void HandleSignedDocFileSelected(InputFileChangeEventArgs e)
    {
        _signedDocFile = e.File;
        _signedDocUploadError = null;
    }

    private async Task UploadSignedDoc()
    {
        if (_signedDocFile == null) { _signedDocUploadError = "Please select a file to upload."; return; }
        if (!EnsureAuthenticated(out var userId)) return;

        _isUploadingSignedDoc = true;
        _signedDocUploadError = null;
        try
        {
            const long maxFileSize = 20 * 1024 * 1024;
            using var stream = _signedDocFile.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var category = _signedDocUploadType == "offerLetter" ? "SignedOfferLetter" : "SignedKfsAcknowledgement";
            var description = _signedDocUploadType == "offerLetter" ? "Signed Offer Letter" : "Signed KFS Acknowledgement";

            var result = await AppService.UploadDocumentAsync(new UploadDocumentRequest
            {
                ApplicationId = Id,
                Category = category,
                FileName = _signedDocFile.Name,
                FileContent = new MemoryStream(ms.ToArray()),
                FileSize = _signedDocFile.Size,
                ContentType = string.IsNullOrEmpty(_signedDocFile.ContentType) ? "application/pdf" : _signedDocFile.ContentType,
                Description = description
            }, userId);

            if (!result.Success)
            {
                _signedDocUploadError = result.Error ?? "Upload failed.";
                return;
            }

            CloseSignedDocUploadModal();
            await LoadApplication();
        }
        finally
        {
            _isUploadingSignedDoc = false;
        }
    }

