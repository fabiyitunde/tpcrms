@page "/applications/{Id:guid}"
@using CRMS.Web.Intranet.Components.Pages.Applications.Modals
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(application?.ApplicationNumber ?? "Application") - CRMS</PageTitle>

@if (isLoading)
{
    <div class="card p-6 text-center">
        <div class="spinner" style="margin: 0 auto;"></div>
        <p class="text-muted mt-4">Loading application...</p>
    </div>
}
else if (application == null)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-state-icon">
                <span class="material-symbols-outlined">error</span>
            </div>
            <div class="empty-state-title">Application not found</div>
            <div class="empty-state-text">The application you're looking for doesn't exist or you don't have permission to view it.</div>
            <a href="/applications" class="btn btn-primary">Back to Applications</a>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div style="display: flex; align-items: center; gap: var(--space-4);">
            <button class="btn btn-ghost" @onclick="GoBack">
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <div>
                <div style="display: flex; align-items: center; gap: var(--space-3);">
                    <h1 class="page-title">@application.ApplicationNumber</h1>
                    <span class="badge @GetStatusBadgeClass(application.Status)" style="font-size: var(--text-sm);">
                        @FormatStatus(application.Status)
                    </span>
                </div>
                <p class="page-subtitle">@application.Customer.CompanyName</p>
            </div>
        </div>
        <div style="display: flex; gap: var(--space-3);">
            @if (ShowSubmitForReviewButton)
            {
                <button class="btn btn-primary" @onclick="ShowSubmitForReviewModal" disabled="@isSubmittingForReview">
                    @if (isSubmittingForReview)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                    }
                    Submit for Credit Review
                </button>
            }
            @if (CanGeneratePack)
            {
                <button class="btn btn-outline" @onclick="GenerateLoanPack" disabled="@isGeneratingPack">
                    @if (isGeneratingPack)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">picture_as_pdf</span>
                    }
                    Loan Pack
                </button>
            }
            @if (CanShowGenerateOfferLetterButton)
            {
                <button class="btn btn-primary" @onclick="GenerateOfferLetter" disabled="@isGeneratingOfferLetter">
                    @if (isGeneratingOfferLetter)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">mail</span>
                    }
                    Offer Letter
                </button>
            }
            @if (CanRerunCreditChecks)
            {
                <button class="btn btn-secondary" @onclick="() => RequestBureauCheck()" disabled="@isRunningBureauChecks">
                    @if (isRunningBureauChecks)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">refresh</span>
                    }
                    Re-run Credit Checks
                </button>
            }
            @if (ShowCompleteLegalReviewButton)
            {
                <button class="btn btn-secondary" @onclick="ShowCompleteLegalReviewModalFn">
                    <span class="material-symbols-outlined" style="font-size: 18px;">gavel</span>
                    Legal Review Complete
                </button>
            }
            @if (ShowRatifyButton)
            {
                <button class="btn btn-success" @onclick="ShowRatifyModalFn">
                    <span class="material-symbols-outlined" style="font-size: 18px;">verified</span>
                    Ratify
                </button>
            }
            @if (ShowDeclineRatificationButton)
            {
                <button class="btn btn-danger" @onclick="ShowDeclineRatificationModalFn">
                    <span class="material-symbols-outlined" style="font-size: 18px;">block</span>
                    Decline
                </button>
            }
            @if (ShowCompleteSecurityPerfectionButton)
            {
                <button class="btn btn-success" @onclick="ShowCompleteSecurityPerfectionModalFn">
                    <span class="material-symbols-outlined" style="font-size: 18px;">verified</span>
                    Security Perfection Complete
                </button>
            }
            @if (ShowAdvanceToSecurityPerfectionButton)
            {
                <button class="btn btn-primary" @onclick="ExecuteAdvanceToSecurityPerfection" disabled="@isAdvancingToSecurityPerfection">
                    @if (isAdvancingToSecurityPerfection)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                    }
                    Proceed to Security Perfection
                </button>
            }
            @if (ShowApproveButton)
            {
                <button class="btn btn-success" @onclick="HandleApproveClick" disabled="@isCheckingGate">
                    @if (isCheckingGate)
                    {
                        <span class="material-symbols-outlined spin" style="font-size: 18px;">progress_activity</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">@(application?.Status == AppStatus.CreditReview ? "send" : "check")</span>
                    }
                    @(application?.Status == AppStatus.CreditReview ? "Send to Committee" : "Approve")
                </button>
            }
            @if (ShowReturnButton)
            {
                <button class="btn btn-secondary" @onclick="() => ShowActionModal(ActionType.Return)">
                    <span class="material-symbols-outlined" style="font-size: 18px;">undo</span>
                    Return
                </button>
            }
            @if (ShowRejectButton)
            {
                <button class="btn btn-danger" @onclick="() => ShowActionModal(ActionType.Reject)">
                    <span class="material-symbols-outlined" style="font-size: 18px;">close</span>
                    Reject
                </button>
            }
            @if (ShowIssueOfferLetterButton)
            {
                <button class="btn btn-primary" @onclick="IssueOfferLetter" disabled="@isIssuingOfferLetter">
                    @if (isIssuingOfferLetter)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                    }
                    Issue Offer Letter
                </button>
            }
            @if (ShowRecordAcceptanceButton)
            {
                <button class="btn btn-success" @onclick="ShowRecordAcceptanceModalFn">
                    <span class="material-symbols-outlined" style="font-size: 18px;">how_to_reg</span>
                    Record Customer Acceptance
                </button>
            }
            @if (ShowDisburseButton)
            {
                <button class="btn btn-primary" @onclick="ShowDisburseModalFn">
                    <span class="material-symbols-outlined" style="font-size: 18px;">payments</span>
                    Disburse Loan
                </button>
            }
        </div>
    </div>

    <div class="card mb-6">
        <div class="card-body" style="padding: var(--space-4) var(--space-6);">
            <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-6);">
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Product</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">@application.Loan.ProductName</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Requested Amount</div>
                    <div style="font-weight: 600; margin-top: var(--space-1); color: var(--primary-600);">@FormatCurrency(application.Loan.RequestedAmount)</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Tenor</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">@application.Loan.TenorMonths months</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Interest Rate</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">@application.Loan.InterestRate% @application.Loan.InterestRateType</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Created</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">@application.CreatedAt.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    @if (approvalOverrides.Count > 0)
    {
        <div style="margin-bottom: var(--space-4);">
            @foreach (var override_ in approvalOverrides)
            {
                <div style="border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-2);
                            border-left: 4px solid @(override_.IsResolved ? "var(--gray-300)" : "var(--warning-500)");
                            background: @(override_.IsResolved ? "var(--gray-50)" : "var(--warning-50)");
                            opacity: @(override_.IsResolved ? "0.8" : "1");">
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3);">
                        <div style="display: flex; align-items: flex-start; gap: var(--space-2);">
                            <span class="material-symbols-outlined" style="font-size: 18px; color: @(override_.IsResolved ? "var(--gray-400)" : "var(--warning-600)"); margin-top: 2px;">warning</span>
                            <div>
                                <div style="font-size: var(--text-sm); font-weight: 600; color: @(override_.IsResolved ? "var(--gray-500)" : "var(--warning-800)");">
                                    @(override_.IsResolved ? "[Resolved]" : "") Override at @override_.Stage stage by @override_.ActorName
                                </div>
                                <div style="font-size: var(--text-sm); color: @(override_.IsResolved ? "var(--gray-400)" : "var(--warning-700)"); margin-top: var(--space-1);">
                                    @override_.NoteText
                                </div>
                                <div style="font-size: var(--text-xs); color: var(--gray-400); margin-top: var(--space-1);">
                                    @override_.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    @if (override_.IsResolved && override_.ResolvedAt.HasValue)
                                    {
                                        <span> — Resolved @override_.ResolvedAt.Value.ToString("MMM dd, yyyy") by @override_.ResolvedByName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="tabs">
        <div class="tab @(activeTab == "overview" ? "active" : "")" @onclick='() => activeTab = "overview"'>Overview</div>
        <div class="tab @(activeTab == "parties" ? "active" : "")" @onclick='() => activeTab = "parties"'>Directors & Signatories</div>
        <div class="tab @(activeTab == "documents" ? "active" : "")" @onclick='() => activeTab = "documents"'>Documents</div>
        <div class="tab @(activeTab == "financials" ? "active" : "")" @onclick='() => activeTab = "financials"'>Financial Analysis</div>
        <div class="tab @(activeTab == "statements" ? "active" : "")" @onclick='() => activeTab = "statements"'>Bank Statements</div>
        <div class="tab @(activeTab == "bureau" ? "active" : "")" @onclick='() => activeTab = "bureau"'>Credit Bureau</div>
        <div class="tab @(activeTab == "collateral" ? "active" : "")" @onclick='() => activeTab = "collateral"'>Collateral</div>
        <div class="tab @(activeTab == "guarantors" ? "active" : "")" @onclick='() => activeTab = "guarantors"'>Guarantors</div>
        <div class="tab @(activeTab == "advisory" ? "active" : "")" @onclick='() => activeTab = "advisory"'>AI Advisory</div>
        @if (ShowCreditAppraisalTab)
        {
            <div class="tab @(activeTab == "credit-appraisal" ? "active" : "")" @onclick='() => activeTab = "credit-appraisal"'>Credit Appraisal</div>
        }
        <div class="tab @(activeTab == "committee" ? "active" : "")" @onclick='() => activeTab = "committee"'>Committee</div>
        @if (CanGenerateOfferLetter)
        {
            <div class="tab @(activeTab == "offerletters" ? "active" : "")" @onclick='() => activeTab = "offerletters"'>
                Offer Letters
                @if (offerLetters.Count > 0)
                {
                    <span class="badge badge-primary" style="margin-left: var(--space-2); font-size: var(--text-xs);">@offerLetters.Count</span>
                }
            </div>
        }
        @if (application?.Status is AppStatus.SecurityPerfection or AppStatus.SecurityApproval or
            AppStatus.DisbursementPending or AppStatus.DisbursementHQApproval or AppStatus.Disbursed
            or AppStatus.Disbursement)
        {
            <div class="tab @(activeTab == "security-perfection" ? "active" : "")" @onclick='() => activeTab = "security-perfection"'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">gavel</span>
                Security Perfection
                @if (securityPerfectionDocs.Any())
                {
                    <span class="badge badge-primary" style="margin-left: var(--space-2); font-size: var(--text-xs);">@securityPerfectionDocs.Count</span>
                }
            </div>
        }
        @if (application?.Status is AppStatus.OfferGenerated or AppStatus.OfferAccepted or
            AppStatus.SecurityPerfection or AppStatus.SecurityApproval or
            AppStatus.DisbursementPending or AppStatus.DisbursementHQApproval or AppStatus.Disbursed
            or AppStatus.Disbursement)
        {
            <div class="tab @(activeTab == "checklist" ? "active" : "")" @onclick='() => activeTab = "checklist"'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">checklist</span>
                Disbursement Checklist
            </div>
        }
        @if (application?.Status is AppStatus.Disbursed or AppStatus.Closed)
        {
            <div class="tab @(activeTab == "loan-account" ? "active" : "")"
                 @onclick='async () => { activeTab = "loan-account"; await LoadLoanAccountTab(); }'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">account_balance</span>
                Loan Account
            </div>
        }
        <div class="tab @(activeTab == "comments" ? "active" : "")" @onclick='() => activeTab = "comments"'>Comments</div>
        <div class="tab @(activeTab == "workflow" ? "active" : "")" @onclick='() => activeTab = "workflow"'>Workflow</div>
    </div>

    @if (inlineActionError != null)
    {
        <div class="alert alert-danger" id="inline-action-error" style="margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-2);">
            <span class="material-symbols-outlined" style="font-size: 18px;">error</span>
            @inlineActionError
            <button type="button" style="margin-left: auto; background: none; border: none; cursor: pointer;" @onclick="() => inlineActionError = null">
                <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
            </button>
        </div>
    }

    @if (application.Status == AppStatus.HOReview && application.Committee?.Decision == "Deferred")
    {
        <div style="margin: 0 0 var(--space-4) 0; padding: var(--space-3) var(--space-4); background: var(--warning-50); border: 1px solid var(--warning-200); border-radius: var(--radius-md); display: flex; gap: var(--space-3); align-items: flex-start;">
            <span class="material-symbols-outlined" style="color: var(--warning-600); font-size: 20px; flex-shrink: 0; margin-top: 2px;">undo</span>
            <div>
                <div style="font-weight: 600; color: var(--warning-800); font-size: var(--text-sm);">
                    Returned from Committee — Deferred
                </div>
                <div style="color: var(--warning-700); font-size: var(--text-sm); margin-top: var(--space-1);">
                    The committee deferred this application on @application.Committee.DecisionDate?.ToString("MMM dd, yyyy").
                    @if (!string.IsNullOrWhiteSpace(application.Committee.DecisionComments))
                    {
                        <span>Rationale: <strong>@application.Committee.DecisionComments</strong>.</span>
                    }
                    Review the committee's concerns and take action using the buttons above.
                </div>
            </div>
        </div>
    }

    @switch (activeTab)
    {
        case "overview":
            <OverviewTab Application="application" />
            break;
        case "parties":
            <PartiesTab Directors="application.Directors" Signatories="application.Signatories"
                IsEditable="IsApplicationEditable"
                OnRequestBureauCheck="RequestBureauCheck"
                OnFillPartyInfo="ShowFillPartyInfoModal"
                OnViewPartyBureauReport="ShowBureauReportModal" />
            break;
        case "statements":
            <StatementsTab
                Statements="application.BankStatements"
                IsEditable="IsApplicationEditable"
                CanVerifyStatements="CanVerifyStatements"
                CanAnalyzeStatements="CanAnalyzeStatements"
                OnUpload="ShowUploadStatementModal"
                OnRefetch="RefetchInternalStatement"
                OnEnterTransactions="ShowManageStatementTransactionsModal"
                OnVerify="VerifyStatement"
                OnReject="ShowRejectStatementModal"
                OnAnalyze="AnalyzeStatement"
                OnViewTransactions="ShowViewStatementTransactionsModal"
                OnDelete="ShowDeleteStatementModal" />
            break;
        case "documents":
            <DocumentsTab
                Documents="application.Documents"
                IsEditable="IsApplicationEditable"
                CanVerifyDocuments="CanVerifyDocuments"
                OnUploadDocument="ShowUploadDocumentModal"
                OnVerifyDocument="VerifyDocument"
                OnRejectDocument="ShowRejectDocumentModal"
                OnDeleteDocument="ShowDeleteDocumentModal" />
            break;
        case "financials":
            <FinancialsTab
                Analysis="application.FinancialAnalysis"
                Statements="application.FinancialStatements"
                IncorporationDate="application.Customer.IncorporationDate"
                IsEditable="IsApplicationEditable"
                CanVerifyFinancials="CanVerifyFinancials"
                OnEnterFinancials="ShowFinancialStatementModal"
                OnUploadExcel="ShowExcelUploadModal"
                OnViewStatement="ViewFinancialStatement"
                OnEditStatement="EditFinancialStatement"
                OnDeleteStatement="DeleteFinancialStatement"
                OnVerifyStatement="VerifyFinancialStatement"
                OnRejectStatement="ShowRejectFinancialStatementModal"
                OnDeleteAll="DeleteAllFinancialStatements" />
            break;
        case "bureau":
            <BureauTab Reports="application.BureauReports" OnViewReport="ShowBureauReportModal" />
            break;
        case "collateral":
            <CollateralTab
                Collaterals="application.Collaterals"
                IsEditable="IsApplicationEditable"
                CanManageValuation="CanManageValuation"
                CanClearLegal="CanClearCollateralLegal"
                OnAddCollateral="ShowAddCollateralModal"
                OnViewCollateral="ViewCollateral"
                OnEditCollateral="EditCollateral"
                OnDeleteCollateral="DeleteCollateral"
                OnSetValuation="ShowSetValuationModal"
                OnApproveCollateral="ShowApproveCollateralModal"
                OnRecordLegalClearance="ShowLegalClearanceModal"
                OnUploadDocument="ShowUploadCollateralDocModal" />
            break;
        case "guarantors":
            <GuarantorsTab 
                Guarantors="application.Guarantors" 
                IsEditable="IsApplicationEditable"
                CanManageGuarantors="CanManageGuarantors"
                OnAddGuarantor="ShowAddGuarantorModal"
                OnViewGuarantor="ViewGuarantor"
                OnEditGuarantor="EditGuarantor"
                OnDeleteGuarantor="DeleteGuarantor"
                OnApproveGuarantor="ShowApproveGuarantorModal"
                OnRejectGuarantor="ShowRejectGuarantorModal" />
            break;
        case "advisory":
            <AdvisoryTab Advisory="application.Advisory" OnGenerateAdvisory="GenerateAdvisory" IsGenerating="isGeneratingAdvisory" CanGenerate="CanGenerateAdvisory" />
            break;
        case "credit-appraisal":
            <CreditAppraisalTab
                Appraisal="application.CreditAppraisal"
                CanEdit="CanEditCreditAppraisal"
                IsSaving="isSavingCreditAppraisal"
                OnSave="HandleSaveCreditAppraisal"
                AutoLtv="AutoLtvForAppraisal"
                AutoLeverage="AutoLeverageForAppraisal" />
            break;
        case "committee":
            <CommitteeTab Committee="application.Committee"
                             CurrentUserId="AuthService.CurrentUser?.Id"
                             CanSetupCommittee="@CanSetupCommitteeReview"
                             CanManageCommittee="@CanManageCommitteeReview"
                             CanConfirmDecision="@CanConfirmCommitteeDecision"
                             CanReplaceCommitteeMember="@CanReplaceCommitteeMember"
                             AvailableMemberUsers="committeeUsers"
                             RequestedAmount="application.Loan.RequestedAmount"
                             RequestedInterestRate="application.Loan.InterestRate"
                             RequestedTenorMonths="application.Loan.TenorMonths"
                             OnCastVote="CastVote"
                             OnSetupCommittee="ShowSetupCommitteeModal"
                             OnStartVoting="StartCommitteeVoting"
                             OnReplaceMember="ReplaceCommitteeMember"
                             OnConfirmDecision="ConfirmCommitteeDecision" />
            break;
        case "loan-account":
            <div style="display: flex; justify-content: flex-end; margin-bottom: var(--space-3);">
                <button class="btn btn-outline btn-sm" @onclick='() => LoadLoanAccountTab(force: true)' disabled="@isLoadingLoanAccount">
                    <span class="material-symbols-outlined" style="font-size: 16px;">refresh</span>
                    Refresh
                </button>
            </div>
            @if (isLoadingLoanAccount)
            {
                <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
            }
            else if (!string.IsNullOrEmpty(loanAccountError))
            {
                <div class="alert alert-danger">@loanAccountError</div>
            }
            else if (loanAccount != null)
            {
                <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                    <!-- Header card -->
                    <div class="card">
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;">
                                <div>
                                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Loan Account No.</div>
                                    <div style="font-weight: 700; font-size: 0.9rem; font-family: monospace;">@loanAccount.AccountNo</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">CBA Loan Status</div>
                                    <div style="font-weight: 600; font-size: 0.875rem;">@loanAccount.Status</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Disbursement Date</div>
                                    <div style="font-weight: 500; font-size: 0.875rem;">@(loanAccount.DisbursementDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Maturity Date</div>
                                    <div style="font-weight: 500; font-size: 0.875rem;">@(loanAccount.MaturityDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                </div>
                            </div>
                            @if (application.Status == AppStatus.Disbursed && FineractLoanIsClosed)
                            {
                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem;">
                                    <span class="material-symbols-outlined" style="color: var(--success-600); font-size: 20px;">check_circle</span>
                                    <span style="font-size: 0.875rem; color: var(--success-700);">The CBA reports this loan as closed. Mark the CRMS application as Closed to complete the lifecycle.</span>
                                    <button class="btn btn-success btn-sm" @onclick="MarkCorporateAsClosed" disabled="@isMarkingClosed">
                                        @if (isMarkingClosed) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                                        Mark as Closed
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Summary card -->
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Loan Summary</h3></div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    @CorporateLoanSummaryRow("Principal Disbursed", loanAccount.PrincipalDisbursed)
                                    @CorporateLoanSummaryRow("Principal Paid", loanAccount.PrincipalPaid)
                                    @CorporateLoanSummaryRow("Principal Outstanding", loanAccount.PrincipalOutstanding, highlight: loanAccount.PrincipalOutstanding > 0)
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    @CorporateLoanSummaryRow("Interest Charged", loanAccount.InterestCharged)
                                    @CorporateLoanSummaryRow("Interest Paid", loanAccount.InterestPaid)
                                    @CorporateLoanSummaryRow("Interest Outstanding", loanAccount.InterestOutstanding, highlight: loanAccount.InterestOutstanding > 0)
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    @CorporateLoanSummaryRow("Total Expected", loanAccount.TotalExpectedRepayment)
                                    @CorporateLoanSummaryRow("Total Repaid", loanAccount.TotalRepayment)
                                    @CorporateLoanSummaryRow("Total Outstanding", loanAccount.TotalOutstanding, highlight: loanAccount.TotalOutstanding > 0)
                                    @if (loanAccount.PenaltyChargesOutstanding > 0)
                                    {
                                        @CorporateLoanSummaryRow("Penalty Outstanding", loanAccount.PenaltyChargesOutstanding, highlight: true, danger: true)
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Repayment schedule -->
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Repayment Schedule</h3></div>
                        <div class="card-body" style="padding: 0;">
                            <div class="table-wrapper">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Due Date</th>
                                            <th style="text-align: right;">Principal Due</th>
                                            <th style="text-align: right;">Interest Due</th>
                                            <th style="text-align: right;">Total Due</th>
                                            <th style="text-align: right;">Total Paid</th>
                                            <th style="text-align: right;">Outstanding</th>
                                            <th style="text-align: center;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var period in loanAccount.Schedule)
                                        {
                                            var rowStyle = period.IsOverdue
                                                ? "background: var(--warning-50);"
                                                : period.Complete ? "opacity: 0.7;" : "";
                                            <tr style="@rowStyle">
                                                <td>@period.Period</td>
                                                <td>@period.DueDate.ToString("dd MMM yyyy")</td>
                                                <td style="text-align: right; font-family: monospace;">₦@period.PrincipalDue.ToString("N0")</td>
                                                <td style="text-align: right; font-family: monospace;">₦@period.InterestDue.ToString("N0")</td>
                                                <td style="text-align: right; font-family: monospace; font-weight: 600;">₦@period.TotalDue.ToString("N0")</td>
                                                <td style="text-align: right; font-family: monospace; color: var(--success-700);">₦@period.TotalPaid.ToString("N0")</td>
                                                <td style="text-align: right; font-family: monospace; @(period.TotalOutstanding > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">₦@period.TotalOutstanding.ToString("N0")</td>
                                                <td style="text-align: center;">
                                                    @if (period.Complete)
                                                    {
                                                        <span class="badge badge-success">Paid</span>
                                                    }
                                                    else if (period.IsOverdue)
                                                    {
                                                        <span class="badge badge-warning">Overdue</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-secondary">Pending</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            break;
        case "comments":
            <CommentsTab Comments="application.Comments" OnAddComment="AddComment" IsSubmitting="isAddingComment" SubmitError="commentError" />
            break;
        case "workflow":
            <WorkflowTab History="application.WorkflowHistory" CurrentStatus="application.Status" />
            break;
        case "security-perfection":
            <SecurityPerfectionTab
                ApplicationId="application.Id"
                Documents="securityPerfectionDocs"
                Collaterals="application.Collaterals"
                CanUpload="@CanUploadSecurityDocs"
                OnDocumentChanged="LoadSecurityPerfectionDocs" />
            break;
        case "checklist":
            <OfferAcceptanceTab ApplicationId="application.Id"
                   ApplicationStatus="application.Status"
                   DisbursementMemoStoragePath="application.DisbursementMemoStoragePath"
                   Documents="application.Documents"
                   CanUploadSignedMemo="CanUploadSignedMemo"
                   OnSignedMemoUploaded="LoadApplication"
                   CanRegenerateMemo="CanRegenerateMemo"
                   OnMemoRegenerated="LoadApplication" />
            break;
        case "offerletters":
            <div class="card">
                <div class="card-header" style="display: flex; align-items: center; justify-content: space-between;">
                    <h3 class="card-title">Offer Letters</h3>
                    <button class="btn btn-primary btn-sm" @onclick="GenerateOfferLetter" disabled="@isGeneratingOfferLetter">
                        @if (isGeneratingOfferLetter)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size: 16px;">add</span>
                        }
                        Generate New
                    </button>
                </div>
                <div class="card-body">
                    @if (!offerLetters.Any())
                    {
                        <div class="empty-state" style="padding: var(--space-8) 0;">
                            <div class="empty-state-icon">
                                <span class="material-symbols-outlined">mail</span>
                            </div>
                            <div class="empty-state-title">No offer letters generated yet</div>
                            <div class="empty-state-text">Click "Generate New" to create the first offer letter for this application.</div>
                        </div>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Version</th>
                                    <th>File Name</th>
                                    <th>Size</th>
                                    <th>Status</th>
                                    <th>Generated By</th>
                                    <th>Generated At</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var letter in offerLetters)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge badge-secondary">v@(letter.Version)</span>
                                        </td>
                                        <td style="font-size: var(--text-sm);">@letter.FileName</td>
                                        <td style="font-size: var(--text-sm); color: var(--gray-500);">@FormatFileSize(letter.FileSizeBytes)</td>
                                        <td>
                                            <span class="badge @(letter.Status == "Generated" ? "badge-success" : letter.Status == "Superseded" ? "badge-secondary" : "badge-warning")">
                                                @letter.Status
                                            </span>
                                        </td>
                                        <td style="font-size: var(--text-sm);">@letter.GeneratedByUserName</td>
                                        <td style="font-size: var(--text-sm); color: var(--gray-500);">@letter.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            <button class="btn btn-ghost btn-sm" title="Download Offer Letter"
                                                @onclick="() => DownloadOfferLetter(letter.Id)"
                                                disabled="@(isDownloadingOfferLetter && downloadingOfferLetterId == letter.Id)">
                                                @if (isDownloadingOfferLetter && downloadingOfferLetterId == letter.Id)
                                                {
                                                    <span class="spinner" style="width: 14px; height: 14px;"></span>
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
                                                }
                                            </button>
                                            <button class="btn btn-ghost btn-sm" title="Download Amortisation Schedule"
                                                @onclick="() => DownloadSchedule(letter.Id)"
                                                disabled="@(isDownloadingSchedule && downloadingScheduleId == letter.Id)">
                                                @if (isDownloadingSchedule && downloadingScheduleId == letter.Id)
                                                {
                                                    <span class="spinner" style="width: 14px; height: 14px;"></span>
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined" style="font-size: 18px;">table_chart</span>
                                                }
                                            </button>
                                            <button class="btn btn-ghost btn-sm" title="Download Key Facts Statement"
                                                @onclick="() => DownloadKfs(letter.Id)"
                                                disabled="@(isDownloadingKfs && downloadingKfsId == letter.Id)">
                                                @if (isDownloadingKfs && downloadingKfsId == letter.Id)
                                                {
                                                    <span class="spinner" style="width: 14px; height: 14px;"></span>
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined" style="font-size: 18px;">fact_check</span>
                                                }
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            @* Signed Copies card — visible once at least one offer letter exists *@
            @if (offerLetters.Any())
            {
                <div class="card" style="margin-top: var(--space-4);">
                    <div class="card-header">
                        <div style="display: flex; align-items: center; gap: var(--space-2);">
                            <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary-600);">draw</span>
                            <div>
                                <h3 class="card-title" style="margin: 0;">Signed Copies</h3>
                                <div style="font-size: var(--text-xs); color: var(--gray-500); margin-top: 2px;">Customer-signed and countersigned originals returned to the bank</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body" style="padding: 0;">

                        @* Row 1: Signed Offer Letter *@
                        @{ var signedOL = SignedOfferLetterDoc; }
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--gray-100);">
                            <div style="display: flex; align-items: center; gap: var(--space-3);">
                                <span class="material-symbols-outlined" style="color: @(signedOL != null ? "var(--success-500)" : "var(--gray-300)"); font-size: 20px;">
                                    @(signedOL != null ? "task" : "pending_actions")
                                </span>
                                <div>
                                    <div style="font-size: var(--text-sm); font-weight: 500;">Signed Offer Letter</div>
                                    @if (signedOL != null)
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">@signedOL.Name — uploaded @signedOL.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                    else
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--gray-400); font-style: italic;">Not yet uploaded — print, obtain customer signature, then upload</div>
                                    }
                                </div>
                            </div>
                            <div style="display: flex; gap: var(--space-2); align-items: center;">
                                @if (signedOL != null)
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="() => DownloadSignedDoc(signedOL.Id, signedOL.Name)">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">download</span>
                                        Download
                                    </button>
                                }
                                @if (CanUploadSignedOfferDocs)
                                {
                                    <button class="btn btn-primary btn-sm" @onclick='() => OpenSignedDocUploadModal("offerLetter")'>
                                        <span class="material-symbols-outlined" style="font-size: 16px;">upload</span>
                                        @(signedOL != null ? "Replace" : "Upload")
                                    </button>
                                }
                            </div>
                        </div>

                        @* Row 2: Signed KFS Acknowledgement *@
                        @{ var signedKfs = SignedKfsDoc; }
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) var(--space-4);">
                            <div style="display: flex; align-items: center; gap: var(--space-3);">
                                <span class="material-symbols-outlined" style="color: @(signedKfs != null ? "var(--success-500)" : "var(--gray-300)"); font-size: 20px;">
                                    @(signedKfs != null ? "task" : "pending_actions")
                                </span>
                                <div>
                                    <div style="font-size: var(--text-sm); font-weight: 500;">Signed KFS Acknowledgement</div>
                                    @if (signedKfs != null)
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">@signedKfs.Name — uploaded @signedKfs.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                    else
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--gray-400); font-style: italic;">Not yet uploaded — CBN regulations require the signed KFS before offer acceptance</div>
                                    }
                                </div>
                            </div>
                            <div style="display: flex; gap: var(--space-2); align-items: center;">
                                @if (signedKfs != null)
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="() => DownloadSignedDoc(signedKfs.Id, signedKfs.Name)">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">download</span>
                                        Download
                                    </button>
                                }
                                @if (CanUploadSignedOfferDocs)
                                {
                                    <button class="btn btn-primary btn-sm" @onclick='() => OpenSignedDocUploadModal("kfs")'>
                                        <span class="material-symbols-outlined" style="font-size: 16px;">upload</span>
                                        @(signedKfs != null ? "Replace" : "Upload")
                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
            break;
    }
}

@if (showSignedDocUploadModal)
{
    <div class="modal-backdrop show" @onclick="CloseSignedDocUploadModal"></div>
    <div class="modal" style="max-width: 480px; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1001;" @onclick:stopPropagation>
        <div class="modal-header">
            <h3 class="modal-title">@(_signedDocUploadType == "offerLetter" ? "Upload Signed Offer Letter" : "Upload Signed KFS Acknowledgement")</h3>
            <button class="btn btn-ghost btn-sm" @onclick="CloseSignedDocUploadModal">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="modal-body">
            <p style="font-size: var(--text-sm); color: var(--gray-600); margin-bottom: var(--space-4);">
                @if (_signedDocUploadType == "offerLetter")
                {
                    <span>Upload the offer letter signed by both the customer (authorised signatory) and the bank officer.</span>
                }
                else
                {
                    <span>Upload the Key Facts Statement signed by the customer confirming they have read and understood all loan costs and terms, as required by CBN Consumer Protection Regulations 2022.</span>
                }
            </p>
            <div class="form-group">
                <label class="form-label">Document (PDF, JPG, PNG) <span style="color: var(--danger-600);">*</span></label>
                <InputFile OnChange="HandleSignedDocFileSelected" accept=".pdf,.jpg,.jpeg,.png" class="form-control" style="padding: var(--space-2);" />
                @if (_signedDocFile != null)
                {
                    <div style="font-size: var(--text-xs); color: var(--gray-500); margin-top: 4px;">
                        Selected: @_signedDocFile.Name (@FormatFileSize(_signedDocFile.Size))
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(_signedDocUploadError))
            {
                <div style="color: var(--danger-600); font-size: var(--text-sm); margin-top: var(--space-3);">@_signedDocUploadError</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="CloseSignedDocUploadModal" disabled="@_isUploadingSignedDoc">Cancel</button>
            <button class="btn btn-primary" @onclick="UploadSignedDoc" disabled="@_isUploadingSignedDoc">
                @if (_isUploadingSignedDoc) { <span class="spinner" style="width: 16px; height: 16px;"></span> }
                Upload
            </button>
        </div>
    </div>
}

<ApprovalGateModal IsVisible="showApprovalGateModal"
                   GateResult="approvalGateResult"
                   OnCancel="CloseApprovalGateModal"
                   OnProceed="HandleGateProceed" />

@if (showActionModal)
{
    <div class="modal-backdrop show" @onclick="CloseActionModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@GetActionTitle()</h3>
                <button class="modal-close" @onclick="CloseActionModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                @* Loan summary — shown for all action modal contexts *@
                <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: var(--space-3); margin-bottom: var(--space-4);">
                    <div style="font-weight: 700; font-size: var(--text-base); color: var(--gray-900); margin-bottom: var(--space-1);">@application?.Customer.CompanyName</div>
                    <div style="display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--text-sm); color: var(--gray-600); margin-bottom: var(--space-2);">
                        <span><strong style="color: var(--gray-700);">Ref:</strong> @application?.ApplicationNumber</span>
                        <span><strong style="color: var(--gray-700);">Product:</strong> @application?.Loan.ProductName</span>
                    </div>
                    @if (!string.IsNullOrEmpty(application?.Loan.Purpose))
                    {
                        <div style="font-size: var(--text-sm); color: var(--gray-600); margin-bottom: var(--space-2);"><strong style="color: var(--gray-700);">Purpose:</strong> @application.Loan.Purpose</div>
                    }
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--gray-200);">
                        <div>
                            <div style="font-size: var(--text-xs); color: var(--gray-400); text-transform: uppercase;">Amount</div>
                            <div style="font-weight: 600; color: var(--gray-700);">@FormatCurrency(application?.Loan.ApprovedAmount ?? application?.Loan.RequestedAmount ?? 0)</div>
                        </div>
                        <div>
                            <div style="font-size: var(--text-xs); color: var(--gray-400); text-transform: uppercase;">Tenor</div>
                            <div style="font-weight: 600; color: var(--gray-700);">@(application?.Loan.TenorMonths) months</div>
                        </div>
                        <div>
                            <div style="font-size: var(--text-xs); color: var(--gray-400); text-transform: uppercase;">Rate</div>
                            <div style="font-weight: 600; color: var(--gray-700);">@((application?.Loan.InterestRate ?? 0m).ToString("0.##"))% p.a.</div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Comments @(currentAction == ActionType.Approve ? "(Optional)" : "(Required)")</label>
                    <textarea class="form-control" rows="4" @bind="actionComments" placeholder="Enter your comments..."></textarea>
                </div>
                @if (actionError != null)
                {
                    <div class="alert alert-danger mt-3">@actionError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseActionModal">Cancel</button>
                <button class="btn @GetActionButtonClass()" @onclick="ExecuteAction" disabled="@isExecutingAction">
                    @if (isExecutingAction)
                    {
                        <span class="spinner"></span>
                    }
                    @GetActionButtonText()
                </button>
            </div>
        </div>
    </div>
}

@if (showCollateralModal)
{
    <AddCollateralModal 
        ApplicationId="Id" 
        OnClose="CloseCollateralModal" 
        OnSuccess="OnCollateralAdded" />
