@if (showRecordAcceptanceModal)
{
    <div class="modal-backdrop show" @onclick="CloseRecordAcceptanceModal">
        <div class="modal" style="max-width: 500px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Record Customer Acceptance</h3>
                <button class="btn btn-ghost btn-sm" @onclick="CloseRecordAcceptanceModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                @{ var _missingOL = SignedOfferLetterDoc == null; var _missingKfs = SignedKfsDoc == null; }
                @if (_missingOL || _missingKfs)
                {
                    <div style="padding: var(--space-3) var(--space-4); background: var(--danger-50); border: 1px solid var(--danger-200); border-radius: var(--radius-md); margin-bottom: var(--space-4);">
                        <div style="display: flex; gap: var(--space-2); align-items: center; margin-bottom: var(--space-2);">
                            <span class="material-symbols-outlined" style="color: var(--danger-600); font-size: 18px;">block</span>
                            <span style="font-size: var(--text-sm); font-weight: 600; color: var(--danger-700);">Signed copies required before acceptance can be recorded</span>
                        </div>
                        <ul style="margin: 0; padding-left: var(--space-5); font-size: var(--text-sm); color: var(--danger-700);">
                            @if (_missingOL) { <li>Signed Offer Letter not uploaded</li> }
                            @if (_missingKfs) { <li>Signed KFS Acknowledgement not uploaded</li> }
                        </ul>
                        <div style="font-size: var(--text-xs); color: var(--danger-600); margin-top: var(--space-2);">Upload both documents from the <strong>Offer Letters</strong> tab, then return here.</div>
                    </div>
                }
                <p style="font-size: var(--text-sm); color: var(--gray-600); margin-bottom: var(--space-4);">
                    Record that the customer has reviewed and signed the offer letter and all accompanying acceptance documents. Ensure all signed copies have been received and filed before proceeding.
                </p>
                <div class="form-group">
                    <label class="form-label">Date Customer Signed *</label>
                    <input type="date" class="form-control" @bind="acceptanceDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label class="form-label">Acceptance Method *</label>
                    <select class="form-control" @bind="acceptanceMethod">
                        <option value="">— Select —</option>
                        <option value="InBranchSigning">In-Branch Signing</option>
                        <option value="Courier">Courier</option>
                        <option value="Electronic">Electronic</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Reference / Notes</label>
                    <textarea class="form-control" rows="2" @bind="acceptanceNotes" placeholder="e.g. Signed copy received via courier, ref: OL-2026-001..."></textarea>
                </div>
                <div style="padding: var(--space-3) var(--space-4); background: var(--warning-50); border: 1px solid var(--warning-200); border-radius: var(--radius-md); margin-top: var(--space-2);">
                    <label style="display: flex; gap: var(--space-3); align-items: flex-start; cursor: pointer;">
                        <input type="checkbox" @bind="kfsAcknowledged" style="margin-top: 2px; flex-shrink: 0;" />
                        <span style="font-size: var(--text-sm); color: var(--warning-800);">
                            I confirm that the Key Facts Statement (KFS) and all documents specified under the Conditions Precedent checklist were presented to, reviewed, and acknowledged by the customer prior to signing, in accordance with CBN Consumer Protection Regulations 2022. All signed copies have been received and are on file.
                        </span>
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(acceptanceError))
                {
                    <div style="color: var(--danger-600); font-size: var(--text-sm); margin-top: var(--space-3);">@acceptanceError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseRecordAcceptanceModal" disabled="@isRecordingAcceptance">Cancel</button>
                <button class="btn btn-success" @onclick="ConfirmRecordAcceptance"
                    disabled="@(isRecordingAcceptance || acceptanceDate == default || string.IsNullOrEmpty(acceptanceMethod) || !kfsAcknowledged || SignedOfferLetterDoc == null || SignedKfsDoc == null)">
                    @if (isRecordingAcceptance) { <span class="spinner" style="width: 16px; height: 16px;"></span> }
                    Confirm Acceptance
                </button>
            </div>
        </div>
    </div>
}

