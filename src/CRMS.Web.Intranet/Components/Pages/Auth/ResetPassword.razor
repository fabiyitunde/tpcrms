@page "/reset-password"
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-left">
        <div class="login-brand">
            <img src="https://tpclientassets.s3.eu-central-1.amazonaws.com/bankofagriculture/logo.png"
                 alt="Bank of Agriculture" class="login-brand-icon" />
            <span class="login-brand-text">Bank of Agriculture</span>
        </div>
        <h1 class="login-tagline">
            Credit Risk<br />
            Management<br />
            System
        </h1>
        <p class="login-description">
            AI-augmented credit governance platform for corporate and retail lending operations.
        </p>
    </div>
    <div class="login-right">
        <div class="login-form">
            @if (string.IsNullOrEmpty(Token))
            {
                <h2>Invalid link</h2>
                <p>This password reset link is incomplete or invalid. Please request a new one.</p>
                <p style="margin-top: var(--space-6);"><a href="/forgot-password">Request a new link</a></p>
            }
            else if (done)
            {
                <h2>Password updated</h2>
                <p>Your password has been reset. Redirecting you to sign in…</p>
                <a href="/login" class="btn btn-primary btn-lg" style="width: 100%; margin-top: var(--space-4);">Go to sign in now</a>
            }
            else
            {
                <h2>Set a new password</h2>
                <p>Choose a new password for your account.</p>

                <EditForm Model="@model" OnValidSubmit="Submit">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" style="background: var(--danger-50); color: var(--danger-600); padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); margin-bottom: var(--space-4); font-size: var(--text-sm);">
                            <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: var(--space-2);">error</span>
                            @errorMessage
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <InputText @bind-Value="model.NewPassword" type="password" class="form-control" placeholder="Min 8 chars, with uppercase, lowercase & number" disabled="@isLoading" />
                        <ValidationMessage For="@(() => model.NewPassword)" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirm Password</label>
                        <InputText @bind-Value="model.ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" disabled="@isLoading" />
                        <ValidationMessage For="@(() => model.ConfirmPassword)" class="form-error" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Reset password</span>
                        }
                    </button>
                </EditForm>

                <p style="margin-top: var(--space-8); text-align: center; font-size: var(--text-sm); color: var(--gray-500);">
                    <a href="/login">Back to sign in</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    private string? Token;

    private readonly Model model = new();
    private bool done;
    private bool isLoading;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(uri.Query)
            .TryGetValue("token", out var t);
        Token = t;
    }

    private async Task Submit()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var result = await AuthService.ResetPasswordAsync(Token!, model.NewPassword);
            if (result.Success)
            {
                done = true;
                isLoading = false;
                StateHasChanged();
                await Task.Delay(2500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.Error ?? "Failed to reset password. Please try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect to server. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class Model
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.RegularExpression(
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$",
            ErrorMessage = "Password must be at least 8 characters and include an uppercase letter, a lowercase letter, and a number.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
