@page "/forgot-password"
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<div class="login-page">
    <div class="login-left">
        <div class="login-brand">
            <img src="https://tpclientassets.s3.eu-central-1.amazonaws.com/bankofagriculture/logo.png"
                 alt="Bank of Agriculture" class="login-brand-icon" />
            <span class="login-brand-text">Bank of Agriculture</span>
        </div>
        <h1 class="login-tagline">
            Credit Risk<br />
            Management<br />
            System
        </h1>
        <p class="login-description">
            AI-augmented credit governance platform for corporate and retail lending operations.
        </p>
    </div>
    <div class="login-right">
        <div class="login-form">
            @if (!submitted)
            {
                <h2>Forgot your password?</h2>
                <p>Enter your account email and we'll send you a link to reset it.</p>

                <EditForm Model="@model" OnValidSubmit="Submit">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" style="background: var(--danger-50); color: var(--danger-600); padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); margin-bottom: var(--space-4); font-size: var(--text-sm);">
                            <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: var(--space-2);">error</span>
                            @errorMessage
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <InputText @bind-Value="model.Email" class="form-control" placeholder="name@company.com" disabled="@isLoading" />
                        <ValidationMessage For="@(() => model.Email)" class="form-error" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send reset link</span>
                        }
                    </button>
                </EditForm>
            }
            else
            {
                <h2>Check your email</h2>
                <p>
                    If an account exists for <strong>@model.Email</strong>, a password reset link has been sent.
                    The link expires in 60 minutes.
                </p>
                <p style="font-size: var(--text-sm); color: var(--gray-500);">
                    Didn't get it? Check your spam folder, or
                    <a href="#" @onclick="Reset" @onclick:preventDefault="true">try again</a>.
                </p>
            }

            <p style="margin-top: var(--space-8); text-align: center; font-size: var(--text-sm); color: var(--gray-500);">
                <a href="/login">Back to sign in</a>
            </p>
        </div>
    </div>
</div>

@code {
    private readonly Model model = new();
    private bool submitted;
    private bool isLoading;
    private string? errorMessage;

    private async Task Submit()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var configured = Configuration["WebsiteUrl"]?.TrimEnd('/');
            var siteBase = string.IsNullOrWhiteSpace(configured)
                ? Navigation.BaseUri.TrimEnd('/')
                : configured;
            var resetUrlBase = $"{siteBase}/reset-password";
            var result = await AuthService.RequestPasswordResetAsync(model.Email.Trim(), resetUrlBase);
            if (result.Success)
                submitted = true;
            else
                errorMessage = result.Error ?? "Something went wrong. Please try again.";
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect to server. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Reset()
    {
        submitted = false;
        errorMessage = null;
    }

    private class Model
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;
    }
}
