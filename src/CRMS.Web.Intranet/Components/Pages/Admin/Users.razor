@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SystemAdmin")]
@using CRMS.Web.Intranet.Models
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>User Management - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Manage system users and access</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
        Add User
    </button>
</div>

@if (!string.IsNullOrEmpty(resetMessage))
{
    <div class="alert @(resetIsError ? "alert-danger" : "alert-success")" style="margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-2);">
        <span class="material-symbols-outlined" style="font-size: 18px;">@(resetIsError ? "error" : "mark_email_read")</span>
        <span style="flex: 1;">@resetMessage</span>
        <button class="btn btn-ghost btn-sm" @onclick="() => resetMessage = null">✕</button>
    </div>
}

<div class="card mb-6">
    <div class="card-body" style="padding: var(--space-4);">
        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: flex-end;">
            <div style="flex: 1; min-width: 200px;">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" placeholder="Name, email..." @bind="searchTerm" />
            </div>
            <div style="width: 200px;">
                <label class="form-label">Role</label>
                <select class="form-control" @bind="selectedRole">
                    <option value="">All Roles</option>
                    <optgroup label="── Corporate ──">
                        <option value="SystemAdmin">System Admin</option>
                        <option value="LoanOfficer">Loan Officer</option>
                        <option value="CreditOfficer">Credit Officer</option>
                        <option value="BranchApprover">Branch Approver</option>
                        <option value="HOReviewer">HO Reviewer</option>
                        <option value="CommitteeMember">Committee Member</option>
                        <option value="FinalApprover">Final Approver</option>
                        <option value="RiskManager">Risk Manager</option>
                        <option value="Operations">Operations</option>
                        <option value="GMFinance">GM Finance</option>
                        <option value="LegalOfficer">Legal Officer</option>
                        <option value="HeadOfLegal">Head of Legal</option>
                        <option value="Auditor">Auditor</option>
                    </optgroup>
                    <optgroup label="── NAMP ──">
                        <option value="BranchManager">Branch Manager</option>
                        <option value="ZonalManager">Zonal Manager</option>
                        <option value="RegionalManager">Regional Manager</option>
                        <option value="MdCeo">MD / CEO</option>
                        <option value="BranchCommitteeMember">Branch Committee Member</option>
                        <option value="ZonalCommitteeMember">Zonal Committee Member</option>
                        <option value="RegionalCommitteeMember">Regional Committee Member</option>
                        <option value="HOCommitteeMember">HO Committee Member</option>
                        <option value="DeploymentOfficer">Deployment Officer</option>
                    </optgroup>
                </select>
            </div>
            <div style="width: 140px;">
                <label class="form-label">Status</label>
                <select class="form-control" @bind="selectedStatus">
                    <option value="">All</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <button class="btn btn-primary" @onclick="Search">Search</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (isLoading)
        {
            <div class="p-6 text-center">
                <div class="spinner" style="margin: 0 auto;"></div>
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Roles</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in PagedUsers)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--space-3);">
                                    <div class="user-avatar">@user.Initials</div>
                                    <div>
                                        <div style="font-weight: 500;">@user.FullName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge @GetRoleBadgeClass(role)" style="font-size: 0.7rem;">@FormatRoleName(role)</span>
                                    }
                                    @if (user.Roles.Count == 0)
                                    {
                                        <span class="text-muted" style="font-size: var(--text-sm);">No role</span>
                                    }
                                </div>
                            </td>
                            <td>@(user.Branch ?? "-")</td>
                            <td>
                                <span class="badge @(user.IsActive ? "badge-success" : "badge-gray")">
                                    <span class="status-dot @(user.IsActive ? "success" : "gray")"></span>
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (user.LastLogin.HasValue)
                                {
                                    <span style="font-size: var(--text-sm);">@user.LastLogin.Value.ToString("MMM dd, HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: var(--space-2);">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => EditUser(user)" title="Edit">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ToggleUserStatus(user)" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">@(user.IsActive ? "block" : "check_circle")</span>
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ResetPassword(user)" title="Reset Password">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">lock_reset</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (TotalPages > 1)
            {
                <div class="pagination-bar">
                    <span class="pagination-info">@((currentPage - 1) * PageSize + 1)–@(Math.Min(currentPage * PageSize, users.Count)) of @users.Count</span>
                    <div class="pagination-controls">
                        <button class="btn btn-ghost btn-sm" @onclick="() => currentPage--" disabled="@(currentPage == 1)">
                            <span class="material-symbols-outlined" style="font-size: 18px;">chevron_left</span>
                        </button>
                        <span style="font-size: var(--text-sm); padding: 0 var(--space-2);">@currentPage / @TotalPages</span>
                        <button class="btn btn-ghost btn-sm" @onclick="() => currentPage++" disabled="@(currentPage == TotalPages)">
                            <span class="material-symbols-outlined" style="font-size: 18px;">chevron_right</span>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (showUserModal)
{
    <div class="modal-backdrop show" @onclick="CloseModal">
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(isEditing ? "Edit User" : "Add New User")</h3>
                <button class="modal-close" @onclick="CloseModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <div class="form-group">
                    <label class="form-label">First Name *</label>
                    <input type="text" class="form-control" @bind="editingUser.FirstName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Last Name *</label>
                    <input type="text" class="form-control" @bind="editingUser.LastName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email *</label>
                    <input type="email" class="form-control" @bind="editingUser.Email" disabled="@isEditing" />
                </div>

                <div class="form-group">
                    <label class="form-label">Roles * <small style="font-weight:400; color: var(--gray-500);">(select one or more)</small></label>
                    <div class="role-checkbox-list">
                        <div class="role-group-label">Corporate Loan Roles</div>
                        @foreach (var (value, label) in CorporateRoles)
                        {
                            <label class="role-checkbox-item">
                                <input type="checkbox"
                                       checked="@editingUser.Roles.Contains(value)"
                                       @onchange="e => ToggleRole(value, (bool)e.Value!)" />
                                <span>@label</span>
                            </label>
                        }
                        <div class="role-group-label" style="margin-top: 0.75rem;">NAMP Roles</div>
                        @foreach (var (value, label) in NampRoles)
                        {
                            <label class="role-checkbox-item">
                                <input type="checkbox"
                                       checked="@editingUser.Roles.Contains(value)"
                                       @onchange="e => ToggleRole(value, (bool)e.Value!)" />
                                <span>@label</span>
                            </label>
                        }
                    </div>
                    @if (editingUser.Roles.Count == 0)
                    {
                        <small style="color: var(--danger-500);">At least one role is required.</small>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Location</label>
                    <select class="form-control" @bind="editingUser.LocationId">
                        <option value="">— No location —</option>
                        @foreach (var loc in availableLocations)
                        {
                            <option value="@loc.Id">@loc.DisplayName (@loc.Type)</option>
                        }
                    </select>
                    <small class="form-hint">Assign a Branch to scope the user to that branch. For cross-branch (bank-wide) visibility, assign the Head Office location — not "No location".</small>
                </div>
            </div>
            <div class="modal-footer">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="alert alert-danger" style="margin: 0; flex: 1; font-size: var(--text-sm);">@saveError</div>
                }
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveUser" disabled="@(isSaving || editingUser.Roles.Count == 0)">
                    @if (isSaving)
                    {
                        <span class="spinner"></span>
                    }
                    @(isEditing ? "Update" : "Create") User
                </button>
            </div>
        </div>
    </div>
}

<style>
    .pagination-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-3) var(--space-4);
        border-top: 1px solid var(--gray-100);
    }
    .pagination-info { font-size: var(--text-sm); color: var(--gray-500); }
    .pagination-controls { display: flex; align-items: center; gap: var(--space-1); }

    .role-checkbox-list {
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 0.75rem;
        max-height: 260px;
        overflow-y: auto;
        background: var(--gray-50);
    }
    .role-group-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--gray-500);
        margin-bottom: 0.5rem;
    }
    .role-checkbox-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.3rem 0.25rem;
        cursor: pointer;
        font-size: 0.875rem;
        border-radius: var(--radius-sm);
    }
    .role-checkbox-item:hover { background: var(--gray-100); }
    .role-checkbox-item input[type="checkbox"] { cursor: pointer; }
</style>

@code {
    private List<UserModel> users = [];
    private string searchTerm = string.Empty;
    private string selectedRole = string.Empty;
    private string selectedStatus = string.Empty;
    private bool isLoading = true;
    private int currentPage = 1;
    private const int PageSize = 15;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(users.Count / (double)PageSize));
    private IEnumerable<UserModel> PagedUsers => users.Skip((currentPage - 1) * PageSize).Take(PageSize);
    private bool showUserModal;
    private bool isEditing;
    private bool isSaving;
    private string? saveError;
    private UserModel editingUser = new();
    private List<LocationInfo> availableLocations = [];

    private static readonly (string Value, string Label)[] CorporateRoles =
    [
        ("SystemAdmin",      "System Admin"),
        ("LoanOfficer",      "Loan Officer"),
        ("CreditOfficer",    "Credit Officer"),
        ("BranchApprover",   "Branch Approver"),
        ("HOReviewer",       "HO Reviewer"),
        ("CommitteeMember",  "Committee Member"),
        ("FinalApprover",    "Final Approver"),
        ("RiskManager",      "Risk Manager"),
        ("Operations",       "Operations"),
        ("GMFinance",        "GM Finance"),
        ("LegalOfficer",     "Legal Officer"),
        ("HeadOfLegal",      "Head of Legal"),
        ("Auditor",          "Auditor"),
    ];

    private static readonly (string Value, string Label)[] NampRoles =
    [
        ("BranchManager",           "Branch Manager"),
        ("ZonalManager",            "Zonal Manager"),
        ("RegionalManager",         "Regional Manager"),
        ("MdCeo",                   "MD / CEO"),
        ("BranchCommitteeMember",   "Branch Committee Member"),
        ("ZonalCommitteeMember",    "Zonal Committee Member"),
        ("RegionalCommitteeMember", "Regional Committee Member"),
        ("HOCommitteeMember",       "HO Committee Member"),
        ("DeploymentOfficer",       "Deployment Officer"),
    ];

    protected override async Task OnInitializedAsync()
    {
        availableLocations = await AppService.GetAllActiveLocationsForPickerAsync();
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        currentPage = 1;
        try
        {
            var dbUsers = await AppService.GetUsersAsync();
            if (dbUsers.Count > 0)
            {
                var query = dbUsers.AsEnumerable();

                if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    var term = searchTerm.Trim().ToLowerInvariant();
                    query = query.Where(u =>
                        u.FirstName.ToLowerInvariant().Contains(term) ||
                        u.LastName.ToLowerInvariant().Contains(term) ||
                        u.Email.ToLowerInvariant().Contains(term));
                }

                if (!string.IsNullOrWhiteSpace(selectedRole))
                    query = query.Where(u => u.Roles.Contains(selectedRole));

                if (!string.IsNullOrWhiteSpace(selectedStatus))
                {
                    var isActive = selectedStatus == "Active";
                    query = query.Where(u => u.IsActive == isActive);
                }

                users = query.Select(u => new UserModel
                {
                    Id = u.Id,
                    FirstName = u.FirstName,
                    LastName = u.LastName,
                    Email = u.Email,
                    Roles = u.Roles,
                    IsActive = u.IsActive,
                    LocationId = u.LocationId,
                    Branch = u.LocationId.HasValue
                        ? availableLocations.FirstOrDefault(l => l.Id == u.LocationId)?.DisplayName
                        : null
                }).ToList();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Search() => await LoadUsers();

    private void OpenCreateModal()
    {
        editingUser = new();
        saveError = null;
        isEditing = false;
        showUserModal = true;
    }

    private void EditUser(UserModel user)
    {
        editingUser = new()
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            Roles = [.. user.Roles],
            Branch = user.Branch,
            LocationId = user.LocationId
        };
        isEditing = true;
        showUserModal = true;
    }

    private void CloseModal()
    {
        showUserModal = false;
        editingUser = new();
        saveError = null;
    }

    private void ToggleRole(string role, bool add)
    {
        if (add && !editingUser.Roles.Contains(role))
            editingUser.Roles.Add(role);
        else if (!add)
            editingUser.Roles.Remove(role);
    }

    private async Task SaveUser()
    {
        if (editingUser.Roles.Count == 0)
        {
            saveError = "At least one role must be selected.";
            return;
        }

        isSaving = true;
        saveError = null;
        try
        {
            ApiResponse result;
            if (isEditing)
            {
                result = await AppService.UpdateUserAsync(editingUser.Id, editingUser.FirstName, editingUser.LastName, null, editingUser.LocationId, editingUser.Roles);
            }
            else
            {
                result = await AppService.CreateUserAsync(editingUser.Email, editingUser.FirstName, editingUser.LastName, null, editingUser.LocationId, editingUser.Roles);
            }

            if (result.Success)
            {
                CloseModal();
                await LoadUsers();
            }
            else
            {
                saveError = result.Error ?? "Failed to save user";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleUserStatus(UserModel user)
    {
        var result = await AppService.ToggleUserStatusAsync(user.Id, user.IsActive);
        if (result.Success)
            await LoadUsers();
    }

    private string? resetMessage;
    private bool resetIsError;

    private async Task ResetPassword(UserModel user)
    {
        resetMessage = null;
        var resetUrlBase = $"{Navigation.BaseUri}reset-password";
        var result = await AuthService.RequestPasswordResetAsync(user.Email, resetUrlBase);
        resetIsError = !result.Success;
        resetMessage = result.Success
            ? $"A password reset link has been sent to {user.Email}."
            : (result.Error ?? "Failed to send the reset link. Please try again.");
        StateHasChanged();
    }

    private static string GetRoleBadgeClass(string role) => role switch
    {
        "SystemAdmin"                                        => "badge-danger",
        "RiskManager" or "AuditOfficer"                     => "badge-warning",
        "BranchManager" or "ZonalManager" or
        "RegionalManager" or "MdCeo"                        => "badge-primary",
        "BranchCommitteeMember" or "ZonalCommitteeMember" or
        "RegionalCommitteeMember" or "HOCommitteeMember" or
        "CommitteeMember"                                   => "badge-info",
        "Auditor" or "Customer"                             => "badge-gray",
        _                                                   => "badge-secondary"
    };

    private static string FormatRoleName(string role) => role switch
    {
        "SystemAdmin"             => "Admin",
        "LoanOfficer"             => "Loan Officer",
        "CreditOfficer"           => "Credit Officer",
        "BranchApprover"          => "Branch Approver",
        "HOReviewer"              => "HO Reviewer",
        "CommitteeMember"         => "Committee",
        "FinalApprover"           => "Final Approver",
        "RiskManager"             => "Risk Manager",
        "GMFinance"               => "GM Finance",
        "LegalOfficer"            => "Legal Officer",
        "HeadOfLegal"             => "Head of Legal",
        "BranchManager"           => "Branch Mgr",
        "ZonalManager"            => "Zonal Mgr",
        "RegionalManager"         => "Regional Mgr",
        "MdCeo"                   => "MD/CEO",
        "BranchCommitteeMember"   => "Branch Cmte",
        "ZonalCommitteeMember"    => "Zonal Cmte",
        "RegionalCommitteeMember" => "Regional Cmte",
        "HOCommitteeMember"       => "HO Cmte",
        "DeploymentOfficer"       => "Deployment",
        _                         => role
    };

    private class UserModel
    {
        public Guid Id { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = [];
        public string? Branch { get; set; }
        public Guid? LocationId { get; set; }
        public bool IsActive { get; set; }
        public DateTime? LastLogin { get; set; }
        public string FullName => $"{FirstName} {LastName}";
        public string Initials => $"{FirstName?.FirstOrDefault()}{LastName?.FirstOrDefault()}";
    }
}
