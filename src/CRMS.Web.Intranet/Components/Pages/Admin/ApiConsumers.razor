@page "/admin/api-consumers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SystemAdmin")]
@inject ApplicationService AppService
@inject AuthService AuthService
@using CRMS.Application.CustomerCheck
@using CRMS.Application.CustomerCheck.Commands
@using CRMS.Application.CustomerCheck.DTOs

<PageTitle>API Consumers - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">API Consumers</h1>
        <p class="page-subtitle">Third-party systems allowed to run customer checks (credit, fraud, accounts, advisory) on the bank's behalf</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreate">
        <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
        Add Consumer
    </button>
</div>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; padding: var(--space-12);">
        <span class="material-symbols-outlined spinning" style="font-size: 32px; color: var(--primary-500);">progress_activity</span>
    </div>
}
else if (consumers.Count == 0)
{
    <div class="empty-state">
        <span class="material-symbols-outlined empty-state-icon">key</span>
        <h3>No API consumers yet</h3>
        <p>Add a consumer to issue a key for the customer-check API.</p>
    </div>
}
else
{
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Key</th>
                    <th>Sections</th>
                    <th>Limit / min</th>
                    <th>Callback</th>
                    <th>Bureau reuse</th>
                    <th>Last used</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in consumers)
                {
                    <tr>
                        <td>
                            <div style="font-weight: 500;">@c.Name</div>
                            @if (!string.IsNullOrEmpty(c.Notes))
                            {
                                <div style="font-size: var(--text-sm); color: var(--gray-500);">@c.Notes</div>
                            }
                        </td>
                        <td><code style="font-size: var(--text-sm);">@c.KeyPrefix…</code></td>
                        <td style="font-size: var(--text-sm);">@(c.AllowedSections.Count == CustomerCheckSections.All.Count ? "All" : string.Join(", ", c.AllowedSections))</td>
                        <td>@c.PerMinuteLimit</td>
                        <td style="font-size: var(--text-sm);">
                            @if (string.IsNullOrEmpty(c.CallbackUrl))
                            {
                                <span style="color: var(--gray-500);">@(c.AllowedCallbackHosts.Count > 0 ? $"Per request ({c.AllowedCallbackHosts.Count} host{(c.AllowedCallbackHosts.Count == 1 ? "" : "s")})" : "Polling only")</span>
                            }
                            else
                            {
                                <span title="@c.CallbackUrl">@HostOf(c.CallbackUrl)</span>
                            }
                            <div style="color: var(--gray-500);">Secret <code>@(c.CallbackSecretPrefix ?? "none")…</code></div>
                        </td>
                        <td>@(c.ReuseBureauReports ? $"Up to {c.BureauReuseMaxAgeDays} days" : "Off")</td>
                        <td style="font-size: var(--text-sm);">@(c.LastUsedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                        <td>
                            <span class="badge @(c.IsActive ? "badge-success" : "badge-gray")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <div style="display: flex; gap: var(--space-2); justify-content: flex-end; flex-wrap: wrap;">
                                <button class="btn btn-outline btn-sm" @onclick="() => OpenEdit(c)">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
                                    Edit
                                </button>
                                <button class="btn btn-outline btn-sm" @onclick="() => ConfirmRotate(c, RotateKind.Key)" disabled="@isSaving">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">autorenew</span>
                                    Rotate key
                                </button>
                                <button class="btn btn-outline btn-sm" @onclick="() => ConfirmRotate(c, RotateKind.Secret)" disabled="@isSaving">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">enhanced_encryption</span>
                                    Rotate secret
                                </button>
                                <button class="btn btn-ghost btn-sm" @onclick="() => Toggle(c)" disabled="@isSaving">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">@(c.IsActive ? "pause" : "play_arrow")</span>
                                    @(c.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop show" @onclick="CloseModal">
        <div class="modal" style="max-width: 640px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(editing == null ? "Add API Consumer" : "Edit API Consumer")</h3>
                <button type="button" class="modal-close" @onclick="CloseModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="alert alert-danger mb-4">@modalError</div>
                }

                <div class="form-group">
                    <label class="form-label">Name *</label>
                    <input type="text" class="form-control" @bind="form.Name" placeholder="e.g., AgriPay Ltd" />
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <input type="text" class="form-control" @bind="form.Notes" placeholder="Contact, purpose, agreement reference" />
                </div>

                <div class="form-group">
                    <label class="form-label">Sections this consumer may ask for *</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);">
                        @foreach (var section in CustomerCheckSections.All)
                        {
                            var s = section;
                            <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm);">
                                <input type="checkbox" checked="@form.Sections.Contains(s)" @onchange="e => SetSection(s, (bool)e.Value!)" />
                                @SectionLabel(s)
                            </label>
                        }
                    </div>
                    <div class="form-hint">Bureau, score, fraud, identity and advisory calls are billed per call.</div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Requests per minute *</label>
                        <input type="number" class="form-control" @bind="form.PerMinuteLimit" min="1" max="10000" step="1" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Checks waiting at once *</label>
                        <input type="number" class="form-control" @bind="form.MaxQueuedJobs" min="1" max="10000" step="1" />
                        <div class="form-hint">Queued or running checks allowed before new ones are refused.</div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Callback URL</label>
                    <input type="url" class="form-control" @bind="form.CallbackUrl" placeholder="https://partner.example.com/crms/customer-check" />
                    <div class="form-hint">Where results are posted, signed with the consumer's secret. Leave blank for a consumer that only polls.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Other allowed callback hosts</label>
                    <input type="text" class="form-control" @bind="form.AllowedCallbackHosts" placeholder="api.partner.example.com, staging.partner.example.com" />
                    <div class="form-hint">A request may name its own callbackUrl only on one of these hosts, or on the callback URL's host. Comma-separated.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Reuse bureau reports</label>
                    <label style="display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2);">
                        <input type="checkbox" @bind="form.ReuseBureauReports" />
                        <span style="font-size: var(--text-sm);">Serve a stored report instead of billing again</span>
                    </label>
                </div>

                @if (form.ReuseBureauReports)
                {
                    <div class="form-group">
                        <label class="form-label">Reuse a report up to (days)</label>
                        <input type="number" class="form-control" @bind="form.BureauReuseMaxAgeDays" min="1" max="365" step="1" style="max-width: 140px;" />
                        <div class="form-hint">A report older than this is fetched again.</div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModal" disabled="@isSaving">Cancel</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@(isSaving || !IsFormValid)">
                    @if (isSaving)
                    {
                        <span class="material-symbols-outlined spinning" style="font-size: 18px;">sync</span>
                    }
                    <span>@(editing == null ? "Create and issue key" : "Save Changes")</span>
                </button>
            </div>
        </div>
    </div>
}

@if (issued != null)
{
    <div class="modal-backdrop show">
        <div class="modal" style="max-width: 600px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(issued.Key != null && issued.CallbackSecret != null ? "Key and secret" : issued.Key != null ? "Key" : "Callback secret") for @issued.Consumer.Name</h3>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-4">
                    Copy @(issued.Key != null && issued.CallbackSecret != null ? "these" : "this") now. @(issued.Key != null && issued.CallbackSecret != null ? "They are" : "It is") shown once and cannot be recovered. If lost, rotate.
                </div>
                @if (issued.Key != null)
                {
                    <div class="form-group">
                        <label class="form-label">X-Api-Key</label>
                        <input type="text" class="form-control" value="@issued.Key" readonly style="font-family: monospace;" />
                        <div class="form-hint">Sent as the <code>X-Api-Key</code> header on every call to <code>/api/v1/customer-check</code>.</div>
                    </div>
                }
                @if (issued.CallbackSecret != null)
                {
                    <div class="form-group">
                        <label class="form-label">Callback signing secret</label>
                        <input type="text" class="form-control" value="@issued.CallbackSecret" readonly style="font-family: monospace;" />
                        <div class="form-hint">The consumer verifies <code>X-CRMS-Signature-V2</code> on each callback with it: HMAC-SHA256 over the timestamp, a dot, and the body. See docs/Customer_Check.md.</div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="() => issued = null">I have copied @(issued.Key != null && issued.CallbackSecret != null ? "them" : "it")</button>
            </div>
        </div>
    </div>
}

@if (rotating != null)
{
    <div class="modal-backdrop show" @onclick="() => rotating = null">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(rotateKind == RotateKind.Key ? "Rotate key" : "Rotate callback secret") for @rotating.Name?</h3>
            </div>
            <div class="modal-body">
                @if (rotateKind == RotateKind.Key)
                {
                    <p>The current key stops working immediately. The consumer must switch to the new key before it can call the API again.</p>
                }
                else
                {
                    <p>Callbacks sent from now on are signed with the new secret. The consumer must switch its verifier over, or it will reject them.</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="() => rotating = null" disabled="@isSaving">Cancel</button>
                <button class="btn btn-primary" @onclick="Rotate" disabled="@isSaving">@(rotateKind == RotateKind.Key ? "Rotate key" : "Rotate secret")</button>
            </div>
        </div>
    </div>
}

<style>
    .spinning { animation: spin 1s linear infinite; }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

@code {
    private enum RotateKind { Key, Secret }

    private List<ApiConsumerDto> consumers = [];
    private bool isLoading = true;
    private bool isSaving;
    private bool showModal;
    private string? modalError;
    private ApiConsumerDto? editing;
    private ApiConsumerDto? rotating;
    private RotateKind rotateKind;
    private ApiConsumerKeyIssuedDto? issued;
    private ConsumerForm form = new();

    private bool IsFormValid => !string.IsNullOrWhiteSpace(form.Name)
        && form.Sections.Count > 0
        && form.PerMinuteLimit is >= 1 and <= 10000
        && form.MaxQueuedJobs is >= 1 and <= 10000
        && (!form.ReuseBureauReports || form.BureauReuseMaxAgeDays is >= 1 and <= 365);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await AppService.GetApiConsumersAsync();
        if (result.Success && result.Data != null)
            consumers = result.Data;
        isLoading = false;
    }

    private static string SectionLabel(string section) => section switch
    {
        CustomerCheckSections.Identity => "Identity (BVN verification)",
        CustomerCheckSections.CreditBureau => "Credit bureau report",
        CustomerCheckSections.FraudCheck => "Fraud check",
        CustomerCheckSections.BankAccounts => "Bank accounts",
        CustomerCheckSections.BankLoans => "Bank loans",
        CustomerCheckSections.CrmsFacilities => "CRMS facilities",
        CustomerCheckSections.AiAdvisory => "AI advisory (scores and narrative)",
        _ => section,
    };

    private static string HostOf(string url) => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : url;

    private void SetSection(string section, bool on)
    {
        if (on) { if (!form.Sections.Contains(section)) form.Sections.Add(section); }
        else form.Sections.Remove(section);
    }

    private void OpenCreate()
    {
        editing = null;
        form = new ConsumerForm();
        modalError = null;
        showModal = true;
    }

    private void OpenEdit(ApiConsumerDto c)
    {
        editing = c;
        form = new ConsumerForm
        {
            Name = c.Name,
            Notes = c.Notes,
            Sections = c.AllowedSections.ToList(),
            PerMinuteLimit = c.PerMinuteLimit,
            ReuseBureauReports = c.ReuseBureauReports,
            BureauReuseMaxAgeDays = c.BureauReuseMaxAgeDays,
            CallbackUrl = c.CallbackUrl,
            AllowedCallbackHosts = string.Join(", ", c.AllowedCallbackHosts),
            MaxQueuedJobs = c.MaxQueuedJobs,
        };
        modalError = null;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private ApiConsumerCallbackSettings CallbackSettings() => new(
        string.IsNullOrWhiteSpace(form.CallbackUrl) ? null : form.CallbackUrl.Trim(),
        (form.AllowedCallbackHosts ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
        form.MaxQueuedJobs);

    private async Task Save()
    {
        isSaving = true;
        modalError = null;
        try
        {
            var userId = AuthService.CurrentUser?.Id ?? Guid.Empty;
            if (editing == null)
            {
                var result = await AppService.CreateApiConsumerAsync(
                    form.Name, form.Notes, form.Sections, form.PerMinuteLimit, form.ReuseBureauReports, form.BureauReuseMaxAgeDays, userId, CallbackSettings());
                if (result.Success && result.Data != null)
                {
                    showModal = false;
                    issued = result.Data;
                    await LoadAsync();
                }
                else
                {
                    modalError = result.Error ?? "Failed to save";
                }
            }
            else
            {
                var result = await AppService.UpdateApiConsumerAsync(
                    editing.Id, form.Name, form.Notes, form.Sections, form.PerMinuteLimit, form.ReuseBureauReports, form.BureauReuseMaxAgeDays, userId, CallbackSettings());
                if (result.Success)
                {
                    showModal = false;
                    await LoadAsync();
                }
                else
                {
                    modalError = result.Error ?? "Failed to save";
                }
            }
        }
        catch (Exception ex)
        {
            modalError = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Toggle(ApiConsumerDto c)
    {
        isSaving = true;
        try
        {
            var userId = AuthService.CurrentUser?.Id ?? Guid.Empty;
            var result = await AppService.SetApiConsumerActiveAsync(c.Id, !c.IsActive, userId);
            if (result.Success) await LoadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmRotate(ApiConsumerDto c, RotateKind kind)
    {
        rotating = c;
        rotateKind = kind;
    }

    private async Task Rotate()
    {
        if (rotating == null) return;
        isSaving = true;
        try
        {
            var userId = AuthService.CurrentUser?.Id ?? Guid.Empty;
            var result = rotateKind == RotateKind.Key
                ? await AppService.RotateApiConsumerKeyAsync(rotating.Id, userId)
                : await AppService.RotateApiConsumerCallbackSecretAsync(rotating.Id, userId);
            rotating = null;
            if (result.Success && result.Data != null)
            {
                issued = result.Data;
                await LoadAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private class ConsumerForm
    {
        public string Name { get; set; } = string.Empty;
        public string? Notes { get; set; }
        public List<string> Sections { get; set; } = CustomerCheckSections.All.ToList();
        public int PerMinuteLimit { get; set; } = 30;
        public bool ReuseBureauReports { get; set; }
        public int BureauReuseMaxAgeDays { get; set; } = 30;
        public string? CallbackUrl { get; set; }
        public string? AllowedCallbackHosts { get; set; }
        public int MaxQueuedJobs { get; set; } = 100;
    }
}
