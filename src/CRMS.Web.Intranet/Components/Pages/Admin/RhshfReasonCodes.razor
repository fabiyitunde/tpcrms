@page "/admin/rhshf-reason-codes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SystemAdmin")]
@using CRMS.Application.Rhshf.Commands
@using CRMS.Domain.Enums
@inject ApplicationService AppService
@inject AuthService AuthService

<PageTitle>RH-SHF Reason Codes - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">RH-SHF Reason Codes</h1>
        <p class="page-subtitle">Reasons staff pick when they send a case back to the FAC or decline it. The portal receives the code beside the officer's note.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
        Add Reason
    </button>
</div>

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger">@pageError</div>
}

<div class="alert alert-info" style="font-size: 0.85rem;">
    A code cannot be renamed or deleted once created, because the portal stores it and past cases carry it.
    Switch off a reason you no longer want; staff then cannot pick it, and past cases keep it.
    OTHER is offered for both returns and declines and cannot be switched off.
</div>

@foreach (var type in Enum.GetValues<RhshfReasonCodeType>())
{
    var rows = codes.Where(c => c.Type == type).OrderBy(c => c.SortOrder).ThenBy(c => c.Code).ToList();
    <div class="card" style="margin-bottom: var(--space-4);">
        <div class="card-header">
            <h3 class="card-title">@(type == RhshfReasonCodeType.Correction ? "Returned to the FAC" : "Declined")</h3>
        </div>
        <div class="card-body" style="padding: 0;">
            @if (isLoading)
            {
                <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
            }
            else if (rows.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-title">No reasons</div>
                    <div class="empty-state-text">Add one to get started.</div>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="table" style="margin-bottom: 0;">
                        <thead>
                            <tr><th>Code</th><th>Wording</th><th>Sort</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in rows)
                            {
                                <tr>
                                    <td><code>@c.Code</code></td>
                                    <td>@c.Label</td>
                                    <td>@c.SortOrder</td>
                                    <td><span class="badge @(c.IsActive ? "badge-success" : "badge-gray")">@(c.IsActive ? "Active" : "Switched off")</span></td>
                                    <td style="white-space: nowrap;">
                                        <button class="btn btn-ghost btn-sm" @onclick="() => OpenEditModal(c)">Edit</button>
                                        @if (c.Code != "OTHER")
                                        {
                                            <button class="btn btn-ghost btn-sm" @onclick="() => Toggle(c)">@(c.IsActive ? "Switch off" : "Switch on")</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop show" @onclick="CloseModal">
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(isEditing ? "Edit Reason" : "Add Reason")</h3>
                <button class="modal-close" @onclick="CloseModal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Code *</label>
                    <input class="form-control" @bind="form.Code" disabled="@isEditing" placeholder="e.g. DOCUMENT_MISSING" />
                    <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 4px;">
                        Capital letters, digits and underscores. Fixed once created.
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Used when a case is</label>
                    <select class="form-control" @bind="form.Type" disabled="@isEditing">
                        <option value="@RhshfReasonCodeType.Correction">Returned to the FAC</option>
                        <option value="@RhshfReasonCodeType.Decline">Declined</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Wording *</label>
                    <input class="form-control" @bind="form.Label" maxlength="200" />
                    <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 4px;">
                        What staff pick from, and what the portal may show the FAC.
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Sort Order</label>
                    <input type="number" class="form-control" @bind="form.SortOrder" />
                </div>
            </div>
            <div class="modal-footer">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="alert alert-danger" style="margin: 0; flex: 1; font-size: 0.85rem;">@saveError</div>
                }
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    @(isEditing ? "Update" : "Create")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<RhshfReasonCodeDto> codes = [];
    private bool isLoading = true;
    private bool isSaving;
    private bool showModal;
    private bool isEditing;
    private bool editingActive = true;
    private string? saveError;
    private string? pageError;
    private FormModel form = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        pageError = null;
        try { codes = await AppService.GetRhshfReasonCodesAsync(); }
        finally { isLoading = false; }
    }

    private string ActorName => AuthService.CurrentUser?.Username ?? "Admin";

    private void OpenCreateModal()
    {
        form = new();
        isEditing = false;
        editingActive = true;
        saveError = null;
        showModal = true;
    }

    private void OpenEditModal(RhshfReasonCodeDto c)
    {
        form = new() { Code = c.Code, Type = c.Type, Label = c.Label, SortOrder = c.SortOrder };
        isEditing = true;
        editingActive = c.IsActive;
        saveError = null;
        showModal = true;
    }

    private void CloseModal() { showModal = false; saveError = null; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Code)) { saveError = "Code is required."; return; }
        if (string.IsNullOrWhiteSpace(form.Label)) { saveError = "Wording is required."; return; }
        if (!isEditing && codes.Any(c => string.Equals(c.Code, form.Code.Trim(), StringComparison.OrdinalIgnoreCase)))
        { saveError = "That code already exists. Edit it instead."; return; }

        isSaving = true;
        saveError = null;
        try
        {
            var result = await AppService.SaveRhshfReasonCodeAsync(form.Code, form.Type, form.Label, form.SortOrder, editingActive, ActorName);
            if (result.Success) { CloseModal(); await Load(); }
            else saveError = result.Error ?? "Failed to save";
        }
        finally { isSaving = false; }
    }

    private async Task Toggle(RhshfReasonCodeDto c)
    {
        var result = await AppService.SaveRhshfReasonCodeAsync(c.Code, c.Type, c.Label, c.SortOrder, !c.IsActive, ActorName);
        if (result.Success) await Load();
        else pageError = result.Error ?? "Failed to update status";
    }

    private class FormModel
    {
        public string Code { get; set; } = string.Empty;
        public RhshfReasonCodeType Type { get; set; } = RhshfReasonCodeType.Correction;
        public string Label { get; set; } = string.Empty;
        public int SortOrder { get; set; } = 100;
    }
}
