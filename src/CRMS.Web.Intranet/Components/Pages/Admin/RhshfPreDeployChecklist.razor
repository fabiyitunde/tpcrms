@page "/admin/rhshf-predeploy-checklist"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SystemAdmin")]
@using CRMS.Application.Rhshf.DTOs
@inject ApplicationService AppService

<PageTitle>RH-SHF Pre-Deploy Checklist - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">RH-SHF Pre-Deployment Checklist</h1>
        <p class="page-subtitle">Gate items the Disbursement Officer confirms before funds release</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
        Add Item
    </button>
</div>

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger">@pageError</div>
}

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (isLoading)
        {
            <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
        }
        else if (templates.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="material-symbols-outlined">checklist</span></div>
                <div class="empty-state-title">No checklist items</div>
                <div class="empty-state-text">Add an item to get started.</div>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table" style="margin-bottom: 0;">
                    <thead>
                        <tr><th>Title</th><th>Mandatory</th><th>Sort</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in templates.OrderBy(t => t.SortOrder))
                        {
                            <tr>
                                <td>
                                    <div style="font-weight: 500;">@t.Title</div>
                                    @if (!string.IsNullOrEmpty(t.Description))
                                    {
                                        <div style="font-size: 0.8rem; color: var(--gray-500);">@t.Description</div>
                                    }
                                </td>
                                <td><span class="badge @(t.IsMandatory ? "badge-warning" : "badge-gray")">@(t.IsMandatory ? "Mandatory" : "Optional")</span></td>
                                <td>@t.SortOrder</td>
                                <td><span class="badge @(t.IsActive ? "badge-success" : "badge-gray")">@(t.IsActive ? "Active" : "Inactive")</span></td>
                                <td style="white-space: nowrap;">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => OpenEditModal(t)">Edit</button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ToggleTemplate(t)">@(t.IsActive ? "Deactivate" : "Activate")</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop show" @onclick="CloseModal">
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(isEditing ? "Edit Checklist Item" : "Add Checklist Item")</h3>
                <button class="modal-close" @onclick="CloseModal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Title *</label>
                    <input class="form-control" @bind="form.Title" />
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
                </div>
                <div class="form-group">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="checkbox" @bind="form.IsMandatory" />
                        <span>Mandatory (blocks completion until confirmed)</span>
                    </label>
                </div>
                <div class="form-group">
                    <label class="form-label">Sort Order</label>
                    <input type="number" class="form-control" @bind="form.SortOrder" />
                </div>
            </div>
            <div class="modal-footer">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="alert alert-danger" style="margin: 0; flex: 1; font-size: 0.85rem;">@saveError</div>
                }
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    @(isEditing ? "Update" : "Create")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<RhshfPreDeploymentChecklistTemplateDto> templates = [];
    private bool isLoading = true;
    private bool isSaving;
    private bool showModal;
    private bool isEditing;
    private string? saveError;
    private string? pageError;
    private Guid editingId;
    private FormModel form = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        pageError = null;
        try { templates = await AppService.GetRhshfPreDeployTemplatesAsync(); }
        finally { isLoading = false; }
    }

    private void OpenCreateModal()
    {
        form = new();
        editingId = Guid.Empty;
        isEditing = false;
        saveError = null;
        showModal = true;
    }

    private void OpenEditModal(RhshfPreDeploymentChecklistTemplateDto t)
    {
        form = new() { Title = t.Title, Description = t.Description ?? string.Empty, IsMandatory = t.IsMandatory, SortOrder = t.SortOrder };
        editingId = t.Id;
        isEditing = true;
        saveError = null;
        showModal = true;
    }

    private void CloseModal() { showModal = false; saveError = null; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        { saveError = "Title is required."; return; }

        isSaving = true;
        saveError = null;
        try
        {
            var result = isEditing
                ? await AppService.UpdateRhshfPreDeployTemplateAsync(editingId, form.Title, form.Description, form.IsMandatory, form.SortOrder)
                : await AppService.CreateRhshfPreDeployTemplateAsync(form.Title, form.Description, form.IsMandatory, form.SortOrder);

            if (result.Success) { CloseModal(); await Load(); }
            else saveError = result.Error ?? "Failed to save";
        }
        finally { isSaving = false; }
    }

    private async Task ToggleTemplate(RhshfPreDeploymentChecklistTemplateDto t)
    {
        var result = await AppService.ToggleRhshfPreDeployTemplateAsync(t.Id, !t.IsActive);
        if (result.Success) await Load();
        else pageError = result.Error ?? "Failed to update status";
    }

    private class FormModel
    {
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsMandatory { get; set; } = true;
        public int SortOrder { get; set; } = 0;
    }
}
