@page "/admin/rhshf-routing"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SystemAdmin")]
@using CRMS.Application.Rhshf.DTOs
@inject ApplicationService AppService
@inject AuthService AuthService

<PageTitle>RH-SHF Routing Config - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">RH-SHF Routing Config</h1>
        <p class="page-subtitle">Define committee tier routing bands by total EOP value</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
        Add Band
    </button>
</div>

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger">@pageError</div>
}

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (isLoading)
        {
            <div class="p-6 text-center">
                <div class="spinner" style="margin: 0 auto;"></div>
            </div>
        }
        else if (configs.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="material-symbols-outlined">route</span></div>
                <div class="empty-state-title">No routing configs</div>
                <div class="empty-state-text">Add a band to get started.</div>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table" style="margin-bottom: 0;">
                    <thead>
                        <tr>
                            <th>Committee Tier</th>
                            <th style="text-align: right;">Min EOP Value (₦)</th>
                            <th style="text-align: right;">Max EOP Value (₦)</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cfg in configs.OrderBy(c => c.Priority))
                        {
                            <tr>
                                <td><span class="badge badge-primary">@FormatTier(cfg.Tier)</span></td>
                                <td style="text-align: right;">@cfg.MinEopValue.ToString("N0")</td>
                                <td style="text-align: right;">@(cfg.MaxEopValue >= decimal.MaxValue / 2 ? "Unlimited" : cfg.MaxEopValue.ToString("N0"))</td>
                                <td>@cfg.Priority</td>
                                <td>
                                    <span class="badge @(cfg.IsActive ? "badge-success" : "badge-gray")">
                                        @(cfg.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="white-space: nowrap;">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => OpenEditModal(cfg)">Edit</button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ToggleConfig(cfg)">
                                        @(cfg.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop show" @onclick="CloseModal">
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@(isEditing ? "Edit Routing Band" : "Add Routing Band")</h3>
                <button class="modal-close" @onclick="CloseModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                @if (!isEditing)
                {
                    <div class="form-group">
                        <label class="form-label">Committee Tier *</label>
                        <select class="form-control" @bind="form.Tier">
                            <option value="">-- Select --</option>
                            <option value="BranchCredit">Branch</option>
                            <option value="ZonalCredit">Zonal</option>
                            <option value="RegionalCredit">Regional</option>
                            <option value="HeadOfficeCredit">Head Office</option>
                        </select>
                    </div>
                }
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Min EOP Value (₦) *</label>
                        <input type="number" class="form-control" min="0" @bind="form.MinValue" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Max EOP Value (₦) *</label>
                        <input type="number" class="form-control" min="1" @bind="form.MaxValue" />
                        <small class="form-hint">Use 999999999999 for unlimited</small>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Priority</label>
                    <input type="number" class="form-control" min="0" @bind="form.Priority" />
                    <small class="form-hint">Lower number = higher priority when bands overlap</small>
                </div>
            </div>
            <div class="modal-footer">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="alert alert-danger" style="margin: 0; flex: 1; font-size: 0.85rem;">@saveError</div>
                }
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    @(isEditing ? "Update" : "Create")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<RhshfRoutingConfigDto> configs = [];
    private bool isLoading = true;
    private bool isSaving;
    private bool showModal;
    private bool isEditing;
    private string? saveError;
    private string? pageError;
    private Guid editingId;

    private FormModel form = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        pageError = null;
        try { configs = await AppService.GetRhshfRoutingConfigsAsync(); }
        finally { isLoading = false; }
    }

    private void OpenCreateModal()
    {
        form = new();
        editingId = Guid.Empty;
        isEditing = false;
        saveError = null;
        showModal = true;
    }

    private void OpenEditModal(RhshfRoutingConfigDto cfg)
    {
        form = new()
        {
            Tier = cfg.Tier,
            MinValue = cfg.MinEopValue,
            MaxValue = cfg.MaxEopValue >= decimal.MaxValue / 2 ? 999_999_999_999m : cfg.MaxEopValue,
            Priority = cfg.Priority
        };
        editingId = cfg.Id;
        isEditing = true;
        saveError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        saveError = null;
    }

    private async Task Save()
    {
        if (!isEditing && string.IsNullOrEmpty(form.Tier))
        { saveError = "Committee tier is required."; return; }
        if (form.MaxValue <= form.MinValue)
        { saveError = "Max value must be greater than min value."; return; }

        isSaving = true;
        saveError = null;
        var userId = AuthService.CurrentUser?.Id ?? Guid.Empty;

        try
        {
            var result = isEditing
                ? await AppService.UpdateRhshfRoutingConfigAsync(editingId, form.MinValue, form.MaxValue, form.Priority, userId)
                : await AppService.CreateRhshfRoutingConfigAsync(form.Tier, form.MinValue, form.MaxValue, form.Priority, userId);

            if (result.Success) { CloseModal(); await Load(); }
            else saveError = result.Error ?? "Failed to save";
        }
        finally { isSaving = false; }
    }

    private async Task ToggleConfig(RhshfRoutingConfigDto cfg)
    {
        var userId = AuthService.CurrentUser?.Id ?? Guid.Empty;
        var result = await AppService.ToggleRhshfRoutingConfigAsync(cfg.Id, !cfg.IsActive, userId);
        if (result.Success) await Load();
        else pageError = result.Error ?? "Failed to update status";
    }

    private static string FormatTier(string raw) => raw switch
    {
        "BranchCredit" => "Branch",
        "ZonalCredit" => "Zonal",
        "RegionalCredit" => "Regional",
        "HeadOfficeCredit" => "Head Office",
        _ => raw
    };

    private class FormModel
    {
        public string Tier { get; set; } = string.Empty;
        public decimal MinValue { get; set; } = 0;
        public decimal MaxValue { get; set; } = 2_000_000;
        public int Priority { get; set; } = 0;
    }
}
