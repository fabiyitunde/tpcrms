@page "/admin/diagnostics"
@using CRMS.Web.Intranet.Services
@inject ApplicationService AppService
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Diagnostics - CRMS</PageTitle>

@if (!(User?.HasRole("SystemAdmin") ?? false))
{
    <div class="alert alert-danger">Access denied. SystemAdmin role required.</div>
    return;
}

<div style="max-width: 720px; margin: var(--space-6) auto;">
    <h2 style="margin-bottom: var(--space-6);">Diagnostics</h2>

    <div class="tabs" style="margin-bottom: var(--space-6);">
        <button class="tab @(diagTab == "cac" ? "active" : "")" @onclick='() => diagTab = "cac"'>SmartComply CAC</button>
        <button class="tab @(diagTab == "biz" ? "active" : "")" @onclick='() => diagTab = "biz"'>Business Credit</button>
        <button class="tab @(diagTab == "cbs" ? "active" : "")" @onclick='() => diagTab = "cbs"'>Core Banking</button>
        <button class="tab @(diagTab == "email" ? "active" : "")" @onclick="OpenEmailTab">Email</button>
    </div>

    @if (diagTab == "email")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Email Sending</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Sends one of the system's emails to an address of your choice through the real sender, with sample values in place of the real ones, and reports what the provider answered. The subject starts with "[Test]" and the email is listed under Outbound Email too.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                @if (emailInfo == null)
                {
                    <div style="color: var(--text-secondary); font-size: var(--text-sm);">@(emailError ?? "Loading…")</div>
                }
                else
                {
                    @if (emailInfo.Sender.IsMock)
                    {
                        <div class="alert alert-warning" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">
                            <b>This server uses the mock sender.</b> Nothing leaves it; a test here only proves the template renders. Email:UseMock is on in this host's settings.
                        </div>
                    }
                    else
                    {
                        <div style="font-size: var(--text-sm); color: var(--text-secondary);">
                            Sender: <b>@emailInfo.Sender.Provider</b> (@emailInfo.Sender.Region), from <b>@(string.IsNullOrEmpty(emailInfo.Sender.FromName) ? emailInfo.Sender.FromAddress : $"{emailInfo.Sender.FromName} <{emailInfo.Sender.FromAddress}>")</b>
                        </div>
                    }
                    <div class="form-group">
                        <label class="form-label">Send to</label>
                        <input class="form-control" type="email" @bind="emailTo" placeholder="name@example.com" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email to send</label>
                        <select class="form-control" @bind="emailTemplate">
                            @foreach (var t in emailInfo.Templates)
                            {
                                <option value="@t.Code">@t.Name (@t.Code)</option>
                            }
                        </select>
                        @if (SelectedTemplate is { } sel)
                        {
                            <div style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-1);">
                                Subject: @sel.Subject
                                @if (sel.Placeholders.Count > 0)
                                {
                                    <span> · sample values will fill @string.Join(", ", sel.Placeholders)</span>
                                }
                            </div>
                        }
                    </div>
                    @if (emailError != null)
                    {
                        <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@emailError</div>
                    }
                    <div>
                        <button class="btn btn-primary" @onclick="SendTestEmail" disabled="@(emailBusy || emailInfo.Templates.Count == 0)">
                            @if (emailBusy)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Sending…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">send</span>
                                <span>Send test email</span>
                            }
                        </button>
                    </div>
                    @foreach (var r in emailResults)
                    {
                        <div class="alert @(r.Accepted ? "alert-success" : "alert-danger")" style="padding: var(--space-3); font-size: var(--text-sm); margin: 0;">
                            @if (r.Accepted)
                            {
                                <div><b>Accepted by @r.Provider</b> in @r.ElapsedMs ms · "@r.Subject" to @r.ToAddress</div>
                                <div style="margin-top: 4px;">Check that inbox, and its spam folder. Message id <span style="font-family: monospace; font-size: var(--text-xs); word-break: break-all;">@r.MessageId</span></div>
                                @if (emailInfo.Sender.IsMock)
                                {
                                    <div style="margin-top: 4px;">Accepted by the mock means logged on the server, not delivered.</div>
                                }
                            }
                            else
                            {
                                <div><b>Not sent</b> · "@r.Subject" to @r.ToAddress</div>
                                <div style="margin-top: 4px;">@r.FailureReason</div>
                                <div style="margin-top: 4px;">
                                    @(r.Status == "Retry" && r.NextRetryAt is { } next
                                        ? $"The system will try again on its own at {next.ToLocalTime():HH:mm}."
                                        : "The system will not try this one again.")
                                    Watch it under <a href="/admin/outbound-email">Outbound Email</a>.
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (diagTab == "cac")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">SmartComply CAC Raw Response</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Downloads the unprocessed JSON from the CAC Advanced endpoint — use this to inspect fields not yet mapped in the DTO.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="form-group">
                    <label class="form-label">RC Number</label>
                    <input class="form-control" @bind="cacRcNumber" placeholder="e.g. 1234567" />
                </div>
                <div class="form-group">
                    <label class="form-label">Company Name</label>
                    <input class="form-control" @bind="cacCompanyName" placeholder="e.g. ACME NIGERIA LIMITED" />
                </div>
                <div class="form-group">
                    <label class="form-label">Company Type</label>
                    <select class="form-control" @bind="cacCompanyType">
                        <option value="RC">RC — Private/Public Limited Company</option>
                        <option value="BN">BN — Business Name</option>
                        <option value="IT">IT — Incorporated Trustee</option>
                    </select>
                </div>
                @if (cacError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@cacError</div>
                }
                <div>
                    <button class="btn btn-primary" @onclick="DownloadCacResponse" disabled="@cacBusy">
                        @if (cacBusy)
                        {
                            <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                            <span>Fetching…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                            <span>Download Raw JSON</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (diagTab == "biz")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Business Credit Reports (SmartComply)</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Downloads the raw JSON from SmartComply's business credit endpoints. All three take the same RC number — use to compare bureau coverage or debug missing data.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="form-group">
                    <label class="form-label">RC Number</label>
                    <input class="form-control" @bind="bizRcNumber" placeholder="e.g. 1275857 or RC1275857" style="max-width: 320px;" />
                </div>
                @if (bizError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@bizError</div>
                }
                <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
                    <div style="display: flex; flex-direction: column; gap: var(--space-1);">
                        <div style="font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">CRC Bureau</div>
                        <button class="btn btn-primary" @onclick='() => DownloadBizCredit("crc")' disabled="@bizBusy_crc">
                            @if (bizBusy_crc)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Fetching…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                                <span>Download CRC</span>
                            }
                        </button>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-1);">
                        <div style="font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">First Central Bureau</div>
                        <button class="btn btn-primary" @onclick='() => DownloadBizCredit("first_central")' disabled="@bizBusy_first_central">
                            @if (bizBusy_first_central)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Fetching…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                                <span>Download First Central</span>
                            }
                        </button>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-1);">
                        <div style="font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Premium Bureau</div>
                        <button class="btn btn-primary" @onclick='() => DownloadBizCredit("premium")' disabled="@bizBusy_premium">
                            @if (bizBusy_premium)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Fetching…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                                <span>Download Premium</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (diagTab == "cbs")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Core Banking Account Raw Response</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Downloads the unprocessed JSON from the CBS fulldetailsbynuban endpoint — use this to inspect fields returned by the core banking gateway.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="form-group">
                    <label class="form-label">Account Number (NUBAN)</label>
                    <input class="form-control" @bind="cbsAccountNumber" placeholder="e.g. 0000000029" />
                </div>
                @if (cbsError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@cbsError</div>
                }
                <div>
                    <button class="btn btn-primary" @onclick="DownloadCbsResponse" disabled="@cbsBusy">
                        @if (cbsBusy)
                        {
                            <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                            <span>Fetching…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                            <span>Download Raw JSON</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserInfo? User => AuthService.CurrentUser;

    private string diagTab = "cac";

    private string cacRcNumber = "";
    private string cacCompanyName = "";
    private string cacCompanyType = "RC";
    private bool cacBusy;
    private string? cacError;

    private string bizRcNumber = "";
    private bool bizBusy_crc;
    private bool bizBusy_first_central;
    private bool bizBusy_premium;
    private string? bizError;

    private string cbsAccountNumber = "";
    private bool cbsBusy;
    private string? cbsError;

    private CRMS.Application.Notification.Commands.EmailDiagnosticsDto? emailInfo;
    private string emailTo = "";
    private string emailTemplate = "";
    private bool emailBusy;
    private string? emailError;
    private readonly List<CRMS.Application.Notification.Commands.DiagnosticEmailResultDto> emailResults = [];

    private CRMS.Application.Notification.Commands.EmailTemplateChoiceDto? SelectedTemplate =>
        emailInfo?.Templates.FirstOrDefault(t => t.Code == emailTemplate);

    private async Task OpenEmailTab()
    {
        diagTab = "email";
        if (emailInfo != null) return;
        emailError = null;
        var result = await AppService.GetEmailDiagnosticsAsync();
        if (!result.Success || result.Data == null)
        {
            emailError = result.Error ?? "The email settings could not be read.";
            return;
        }
        emailInfo = result.Data;
        if (string.IsNullOrEmpty(emailTo)) emailTo = User?.Email ?? "";
        if (string.IsNullOrEmpty(emailTemplate))
            emailTemplate = emailInfo.Templates.FirstOrDefault(t => t.Code == "PASSWORD_RESET")?.Code
                ?? emailInfo.Templates.FirstOrDefault()?.Code ?? "";
    }

    private async Task SendTestEmail()
    {
        emailError = null;
        if (string.IsNullOrWhiteSpace(emailTo))
        {
            emailError = "Enter the address to send to.";
            return;
        }
        emailBusy = true;
        try
        {
            var result = await AppService.SendDiagnosticEmailAsync(emailTo.Trim(), emailTemplate, User?.Id ?? Guid.Empty, User?.FullName ?? "");
            if (!result.Success || result.Data == null)
            {
                emailError = result.Error ?? "The test email could not be sent.";
                return;
            }
            emailResults.Insert(0, result.Data);
        }
        catch (Exception ex)
        {
            emailError = ex.Message;
        }
        finally
        {
            emailBusy = false;
        }
    }

    private async Task DownloadBizCredit(string bureau)
    {
        if (string.IsNullOrWhiteSpace(bizRcNumber))
        {
            bizError = "RC Number is required.";
            return;
        }

        bizError = null;
        switch (bureau)
        {
            case "crc": bizBusy_crc = true; break;
            case "first_central": bizBusy_first_central = true; break;
            case "premium": bizBusy_premium = true; break;
        }
        try
        {
            var result = await AppService.DownloadBusinessCreditRawAsync(bureau, bizRcNumber.Trim());
            if (!result.Success || result.Data == null)
            {
                bizError = result.Error ?? "Failed to fetch response.";
                return;
            }
            var fileName = $"biz_credit_{bureau}_{bizRcNumber.Trim()}_{DateTime.Now:yyyyMMddHHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/json", result.Data);
        }
        catch (Exception ex)
        {
            bizError = ex.Message;
        }
        finally
        {
            switch (bureau)
            {
                case "crc": bizBusy_crc = false; break;
                case "first_central": bizBusy_first_central = false; break;
                case "premium": bizBusy_premium = false; break;
            }
        }
    }

    private async Task DownloadCbsResponse()
    {
        if (string.IsNullOrWhiteSpace(cbsAccountNumber))
        {
            cbsError = "Account number is required.";
            return;
        }

        cbsBusy = true;
        cbsError = null;
        try
        {
            var result = await AppService.DownloadCoreBankingAccountAsync(cbsAccountNumber.Trim());
            if (!result.Success || result.Data == null)
            {
                cbsError = result.Error ?? "Failed to fetch account response.";
                return;
            }

            var fileName = $"cbs_account_{cbsAccountNumber.Trim()}_{DateTime.Now:yyyyMMddHHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/json", result.Data);
        }
        catch (Exception ex)
        {
            cbsError = ex.Message;
        }
        finally
        {
            cbsBusy = false;
        }
    }

    private async Task DownloadCacResponse()
    {
        if (string.IsNullOrWhiteSpace(cacRcNumber) || string.IsNullOrWhiteSpace(cacCompanyName))
        {
            cacError = "RC Number and Company Name are required.";
            return;
        }

        cacBusy = true;
        cacError = null;
        try
        {
            var result = await AppService.DownloadCacRawResponseAsync(cacRcNumber.Trim(), cacCompanyName.Trim(), cacCompanyType);
            if (!result.Success || result.Data == null)
            {
                cacError = result.Error ?? "Failed to fetch CAC response.";
                return;
            }

            var fileName = $"smartcomply_cac_{cacRcNumber.Trim()}_{DateTime.Now:yyyyMMddHHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/json", result.Data);
        }
        catch (Exception ex)
        {
            cacError = ex.Message;
        }
        finally
        {
            cacBusy = false;
        }
    }
}
