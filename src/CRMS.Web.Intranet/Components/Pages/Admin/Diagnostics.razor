    private CRMS.Domain.Interfaces.SmartComplyIndividualCreditProbe? indProbe;

    // SmartComply only has score endpoints for CRC and First Central.
    private bool IndBureauHasScore => indBureau is "crc" or "first_central";

    private void OnIndBureauChanged()
    {
        if (!IndBureauHasScore) indKind = "report";
    }

    private static string IndBureauLabel(string bureau) => bureau switch
    {
        "FirstCentral" => "First Central",
        "CreditRegistry" => "Credit Registry",
        "CreditPremium" => "Premium",
        _ => bureau
    };

    private async Task RunIndividualProbe()
    {
        var bvn = indBvn.Trim();
        if (bvn.Length != 11 || !bvn.All(char.IsDigit))
        {
            indError = "Enter an 11-digit BVN.";
            return;
        }

        indError = null;
        indProbe = null;
        indBusy = true;
        try
        {
            var result = await AppService.ProbeIndividualCreditAsync(indBureau, indKind, bvn);
            if (!result.Success || result.Data == null)
            {
                indError = result.Error ?? "The credit check could not be run.";
                return;
            }
            indProbe = result.Data;
        }
        catch (Exception ex)
        {
            indError = ex.Message;
        }
        finally
        {
            indBusy = false;
        }
    }

    private async Task DownloadIndividualRaw()
    {
        if (indProbe == null) return;
        var fileName = $"individual_credit_{indProbe.Bureau}_{indProbe.Kind}_{DateTime.Now:yyyyMMddHHmmss}.json";
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/json",
            System.Text.Encoding.UTF8.GetBytes(PrettyJson(indProbe.RawJson)));
    }

    private static string PrettyJson(string raw)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
        }
        catch (System.Text.Json.JsonException)
        {
            return raw;
        }
    }

    private static RenderFragment IndRow(string label, string? value) => __builder =>
    {
        __builder.OpenElement(0, "tr");
        __builder.OpenElement(1, "td");
        __builder.AddAttribute(2, "style", "color: var(--text-secondary); width: 45%;");
        __builder.AddContent(3, label);
        __builder.CloseElement();
        __builder.OpenElement(4, "td");
        __builder.AddContent(5, string.IsNullOrWhiteSpace(value) ? "—" : value);
        __builder.CloseElement();
        __builder.CloseElement();
    };

    private CRMS.Application.Notification.Commands.EmailDiagnosticsDto? emailInfo;
    private string emailTo = "";
    private string emailTemplate = "";
    private bool emailBusy;
    private string? emailError;
    private readonly List<CRMS.Application.Notification.Commands.DiagnosticEmailResultDto> emailResults = [];

    private CRMS.Application.Notification.Commands.EmailTemplateChoiceDto? SelectedTemplate =>
        emailInfo?.Templates.FirstOrDefault(t => t.Code == emailTemplate);

    private async Task OpenEmailTab()
    {
        diagTab = "email";
        if (emailInfo != null) return;
        emailError = null;
        var result = await AppService.GetEmailDiagnosticsAsync();
        if (!result.Success || result.Data == null)
        {
            emailError = result.Error ?? "The email settings could not be read.";
            return;
        }
        emailInfo = result.Data;
        if (string.IsNullOrEmpty(emailTo)) emailTo = User?.Email ?? "";
        if (string.IsNullOrEmpty(emailTemplate))
            emailTemplate = emailInfo.Templates.FirstOrDefault(t => t.Code == "PASSWORD_RESET")?.Code
                ?? emailInfo.Templates.FirstOrDefault()?.Code ?? "";
    }

    private async Task SendTestEmail()
    {
        emailError = null;
        if (string.IsNullOrWhiteSpace(emailTo))
        {
            emailError = "Enter the address to send to.";
            return;
        }
        emailBusy = true;
        try
        {
            var result = await AppService.SendDiagnosticEmailAsync(emailTo.Trim(), emailTemplate, User?.Id ?? Guid.Empty, User?.FullName ?? "");
            if (!result.Success || result.Data == null)
            {
                emailError = result.Error ?? "The test email could not be sent.";
                return;
            }
            emailResults.Insert(0, result.Data);
        }
        catch (Exception ex)
        {
            emailError = ex.Message;
        }
        finally
        {
            emailBusy = false;
        }
    }

    private async Task DownloadBizCredit(string bureau)
    {
        if (string.IsNullOrWhiteSpace(bizRcNumber))
        {
            bizError = "RC Number is required.";
            return;
        }

        bizError = null;
        switch (bureau)
        {
            case "crc": bizBusy_crc = true; break;
            case "first_central": bizBusy_first_central = true; break;
            case "premium": bizBusy_premium = true; break;
        }
        try
        {
            var result = await AppService.DownloadBusinessCreditRawAsync(bureau, bizRcNumber.Trim());
            if (!result.Success || result.Data == null)
            {
                bizError = result.Error ?? "Failed to fetch response.";
                return;
            }
            var fileName = $"biz_credit_{bureau}_{bizRcNumber.Trim()}_{DateTime.Now:yyyyMMddHHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/json", result.Data);
        }
        catch (Exception ex)
        {
            bizError = ex.Message;
        }
        finally
        {
            switch (bureau)
            {
                case "crc": bizBusy_crc = false; break;
                case "first_central": bizBusy_first_central = false; break;
                case "premium": bizBusy_premium = false; break;
            }
        }
    }

