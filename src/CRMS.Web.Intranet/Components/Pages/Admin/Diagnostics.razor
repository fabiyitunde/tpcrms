@page "/admin/diagnostics"
@using CRMS.Web.Intranet.Services
@inject ApplicationService AppService
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Diagnostics - CRMS</PageTitle>

@if (!(User?.HasRole("SystemAdmin") ?? false))
{
    <div class="alert alert-danger">Access denied. SystemAdmin role required.</div>
    return;
}

<div style="max-width: 720px; margin: var(--space-6) auto;">
    <h2 style="margin-bottom: var(--space-6);">Diagnostics</h2>

    <div class="tabs" style="margin-bottom: var(--space-6);">
        <button class="tab @(diagTab == "cac" ? "active" : "")" @onclick='() => diagTab = "cac"'>SmartComply CAC</button>
        <button class="tab @(diagTab == "biz" ? "active" : "")" @onclick='() => diagTab = "biz"'>Business Credit</button>
        <button class="tab @(diagTab == "ind" ? "active" : "")" @onclick='() => diagTab = "ind"'>Individual Credit</button>
        <button class="tab @(diagTab == "cbs" ? "active" : "")" @onclick='() => diagTab = "cbs"'>Core Banking</button>
        <button class="tab @(diagTab == "email" ? "active" : "")" @onclick="OpenEmailTab">Email</button>
    </div>

    @if (diagTab == "email")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Email Sending</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Sends one of the system's emails to an address of your choice through the real sender, with sample values in place of the real ones, and reports what the provider answered. The subject starts with "[Test]" and the email is listed under Outbound Email too.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                @if (emailInfo == null)
                {
                    <div style="color: var(--text-secondary); font-size: var(--text-sm);">@(emailError ?? "Loading…")</div>
                }
                else
                {
                    @if (emailInfo.Sender.IsMock)
                    {
                        <div class="alert alert-warning" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">
                            <b>This server uses the mock sender.</b> Nothing leaves it; a test here only proves the template renders. Email:UseMock is on in this host's settings.
                        </div>
                    }
                    else
                    {
                        <div style="font-size: var(--text-sm); color: var(--text-secondary);">
                            Sender: <b>@emailInfo.Sender.Provider</b> (@emailInfo.Sender.Region), from <b>@(string.IsNullOrEmpty(emailInfo.Sender.FromName) ? emailInfo.Sender.FromAddress : $"{emailInfo.Sender.FromName} <{emailInfo.Sender.FromAddress}>")</b>
                        </div>
                    }
                    <div class="form-group">
                        <label class="form-label">Send to</label>
                        <input class="form-control" type="email" @bind="emailTo" placeholder="name@example.com" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email to send</label>
                        <select class="form-control" @bind="emailTemplate">
                            @foreach (var t in emailInfo.Templates)
                            {
                                <option value="@t.Code">@t.Name (@t.Code)</option>
                            }
                        </select>
                        @if (SelectedTemplate is { } sel)
                        {
                            <div style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-1);">
                                Subject: @sel.Subject
                                @if (sel.Placeholders.Count > 0)
                                {
                                    <span> · sample values will fill @string.Join(", ", sel.Placeholders)</span>
                                }
                            </div>
                        }
                    </div>
                    @if (emailError != null)
                    {
                        <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@emailError</div>
                    }
                    <div>
                        <button class="btn btn-primary" @onclick="SendTestEmail" disabled="@(emailBusy || emailInfo.Templates.Count == 0)">
                            @if (emailBusy)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Sending…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">send</span>
                                <span>Send test email</span>
                            }
                        </button>
                    </div>
                    @foreach (var r in emailResults)
                    {
                        <div class="alert @(r.Accepted ? "alert-success" : "alert-danger")" style="padding: var(--space-3); font-size: var(--text-sm); margin: 0;">
                            @if (r.Accepted)
                            {
                                <div><b>Accepted by @r.Provider</b> in @r.ElapsedMs ms · "@r.Subject" to @r.ToAddress</div>
                                <div style="margin-top: 4px;">Check that inbox, and its spam folder. Message id <span style="font-family: monospace; font-size: var(--text-xs); word-break: break-all;">@r.MessageId</span></div>
                                @if (emailInfo.Sender.IsMock)
                                {
                                    <div style="margin-top: 4px;">Accepted by the mock means logged on the server, not delivered.</div>
                                }
                            }
                            else
                            {
                                <div><b>Not sent</b> · "@r.Subject" to @r.ToAddress</div>
                                <div style="margin-top: 4px;">@r.FailureReason</div>
                                <div style="margin-top: 4px;">
                                    @(r.Status == "Retry" && r.NextRetryAt is { } next
                                        ? $"The system will try again on its own at {next.ToLocalTime():HH:mm}."
                                        : "The system will not try this one again.")
                                    Watch it under <a href="/admin/outbound-email">Outbound Email</a>.
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (diagTab == "cac")
    {
        <div class="card" style="margin-bottom: var(--space-4);">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">SmartComply API Key</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Asks SmartComply whether this server's key is accepted, with a request that names no subject, so nothing is looked up and nothing is billed. Every credit bureau and CAC call from this server uses this key. The API host has its own copy of the key; its standing shows in the API's connectivity probe.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-3);">
                <div>
                    <button class="btn btn-outline" @onclick="CheckSmartComplyKey" disabled="@keyBusy">
                        @if (keyBusy)
                        {
                            <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                            <span>Checking…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">key</span>
                            <span>Check API key</span>
                        }
                    </button>
                </div>
                @if (keyError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm); margin: 0;">@keyError</div>
                }
                @if (keyCheck != null)
                {
                    <div class="alert @(keyCheck.Accepted ? "alert-success" : "alert-danger")" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm); margin: 0;">
                        <b>@(keyCheck.Accepted ? "Accepted" : "Rejected")</b> · @keyCheck.Summary
                        <div style="margin-top: 4px; color: var(--text-secondary);">Key @keyCheck.KeyHint · server @keyCheck.Host · @keyCheck.BaseUrl</div>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">SmartComply CAC Raw Response</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Downloads the unprocessed JSON from the CAC Advanced endpoint — use this to inspect fields not yet mapped in the DTO.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="form-group">
                    <label class="form-label">RC Number</label>
                    <input class="form-control" @bind="cacRcNumber" placeholder="e.g. 1234567" />
                </div>
                <div class="form-group">
                    <label class="form-label">Company Name</label>
                    <input class="form-control" @bind="cacCompanyName" placeholder="e.g. ACME NIGERIA LIMITED" />
                </div>
                <div class="form-group">
                    <label class="form-label">Company Type</label>
                    <select class="form-control" @bind="cacCompanyType">
                        <option value="RC">RC — Private/Public Limited Company</option>
                        <option value="BN">BN — Business Name</option>
                        <option value="IT">IT — Incorporated Trustee</option>
                    </select>
                </div>
                @if (cacError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@cacError</div>
                }
                <div>
                    <button class="btn btn-primary" @onclick="DownloadCacResponse" disabled="@cacBusy">
                        @if (cacBusy)
                        {
                            <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                            <span>Fetching…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                            <span>Download Raw JSON</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (diagTab == "biz")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Business Credit Reports (SmartComply)</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Downloads the raw JSON from SmartComply's business credit endpoints. All three take the same RC number — use to compare bureau coverage or debug missing data.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="form-group">
                    <label class="form-label">RC Number</label>
                    <input class="form-control" @bind="bizRcNumber" placeholder="e.g. 1275857 or RC1275857" style="max-width: 320px;" />
                </div>
                @if (bizError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@bizError</div>
                }
                <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
                    <div style="display: flex; flex-direction: column; gap: var(--space-1);">
                        <div style="font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">CRC Bureau</div>
                        <button class="btn btn-primary" @onclick='() => DownloadBizCredit("crc")' disabled="@bizBusy_crc">
                            @if (bizBusy_crc)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Fetching…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                                <span>Download CRC</span>
                            }
                        </button>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-1);">
                        <div style="font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">First Central Bureau</div>
                        <button class="btn btn-primary" @onclick='() => DownloadBizCredit("first_central")' disabled="@bizBusy_first_central">
                            @if (bizBusy_first_central)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Fetching…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                                <span>Download First Central</span>
                            }
                        </button>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-1);">
                        <div style="font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Premium Bureau</div>
                        <button class="btn btn-primary" @onclick='() => DownloadBizCredit("premium")' disabled="@bizBusy_premium">
                            @if (bizBusy_premium)
                            {
                                <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                <span>Fetching…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                                <span>Download Premium</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (diagTab == "ind")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Individual Credit Check (SmartComply)</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Runs one individual credit pull by BVN and shows what the loan checks would read from it, next to the raw response. Loan checks use CRC first and fall back to First Central.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="alert alert-warning" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">
                    Each pull is a real, billed SmartComply call and is recorded on the Billing dashboard under Diagnostics.
                </div>
                <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: flex-end;">
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label">BVN</label>
                        <input class="form-control" @bind="indBvn" maxlength="11" placeholder="11 digits" style="width: 180px;" />
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label">Bureau</label>
                        <select class="form-control" @bind="indBureau" @bind:after="OnIndBureauChanged" style="width: 180px;">
                            <option value="crc">CRC</option>
                            <option value="first_central">First Central</option>
                            <option value="credit_registry">Credit Registry</option>
                            <option value="premium">Premium</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label">Pull</label>
                        <select class="form-control" @bind="indKind" style="width: 150px;">
                            <option value="report">Full report</option>
                            @if (IndBureauHasScore)
                            {
                                <option value="score">Credit score</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary" @onclick="RunIndividualProbe" disabled="@indBusy">
                        @if (indBusy)
                        {
                            <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                            <span>Fetching…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">play_arrow</span>
                            <span>Run check</span>
                        }
                    </button>
                </div>
                @if (indError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm); word-break: break-word;">@indError</div>
                }
            </div>
        </div>

        @if (indProbe is { } probe)
        {
            <div class="card" style="margin-top: var(--space-4);">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
                    <h3 class="card-title" style="margin: 0;">What the CRMS read: @IndBureauLabel(probe.Bureau) @(probe.Kind == "score" ? "score" : "report")</h3>
                    <button class="btn btn-secondary btn-sm" @onclick="DownloadIndividualRaw">
                        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                        <span>Raw JSON</span>
                    </button>
                </div>
                <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                    @if (probe.ParseError != null)
                    {
                        <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">
                            The response came back but the CRMS could not read it: @probe.ParseError
                        </div>
                    }

                    @if (probe.Report is { } r)
                    {
                        <table class="table" style="font-size: var(--text-sm);">
                            <tbody>
                                @IndRow("Report ID", r.Id)
                                @IndRow("Name", r.Name)
                                @IndRow("BVN", r.Bvn)
                                @IndRow("Date of birth", r.DateOfBirth)
                                @IndRow("Gender", r.Gender)
                                @IndRow("Phone", r.Phone)
                                @IndRow("Email", r.Email)
                                @IndRow("Address", r.Address)
                                @IndRow("Searched", r.SearchedDate?.ToString("dd MMM yyyy HH:mm"))
                                @IndRow("Bureau reference", r.Summary.ReportOrderNumber)
                                @IndRow("Total loans", r.Summary.TotalNoOfLoans.ToString())
                                @IndRow("Institutions", r.Summary.TotalNoOfInstitutions.ToString())
                                @IndRow("Active loans", r.Summary.TotalNoOfActiveLoans.ToString())
                                @IndRow("Closed loans", r.Summary.TotalNoOfClosedLoans.ToString())
                                @IndRow("Performing loans", r.Summary.TotalNoOfPerformingLoans.ToString())
                                @IndRow("Delinquent facilities", r.Summary.TotalNoOfDelinquentFacilities.ToString())
                                @IndRow("Highest loan amount", $"₦{r.Summary.HighestLoanAmount:N2}")
                                @IndRow("Total borrowed", $"₦{r.Summary.TotalBorrowed:N2}")
                                @IndRow("Total outstanding", $"₦{r.Summary.TotalOutstanding:N2}")
                                @IndRow("Total overdue", $"₦{r.Summary.TotalOverdue:N2}")
                                @IndRow("Monthly instalments", $"₦{r.Summary.TotalMonthlyInstallment:N2}")
                                @IndRow("Max days overdue", r.Summary.MaxNoOfDays.ToString())
                                @IndRow("Loan performance rows", r.LoanPerformance.Count.ToString())
                                @IndRow("Loan history rows", r.LoanHistory.Count.ToString())
                                @IndRow("Creditors", r.Creditors.Count.ToString())
                                @IndRow("Credit enquiries", r.CreditEnquiries.Count.ToString())
                            </tbody>
                        </table>
                        @if (r.LoanPerformance.Count > 0)
                        {
                            <div style="font-weight: 600; font-size: var(--text-sm);">Loan performance (as read)</div>
                            <div class="table-wrapper">
                                <table class="table" style="font-size: var(--text-xs);">
                                    <thead><tr><th>Lender</th><th>Type</th><th>Amount</th><th>Outstanding</th><th>Overdue</th><th>Status</th><th>Performance</th><th>Opened</th></tr></thead>
                                    <tbody>
                                        @foreach (var lp in r.LoanPerformance)
                                        {
                                            <tr>
                                                <td>@(lp.LoanProvider ?? "—")</td>
                                                <td>@(lp.Type ?? "—")</td>
                                                <td>@lp.LoanAmount.ToString("N2")</td>
                                                <td>@lp.OutstandingBalance.ToString("N2")</td>
                                                <td>@lp.OverdueAmount.ToString("N2")</td>
                                                <td>@(lp.Status ?? "—")</td>
                                                <td>@(lp.PerformanceStatus ?? "—")</td>
                                                <td>@(lp.DateAccountOpened?.ToString("dd MMM yyyy") ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }

                    @if (probe.Score is { } s)
                    {
                        <table class="table" style="font-size: var(--text-sm);">
                            <tbody>
                                @IndRow("Score", s.Score > 0 ? s.Score.ToString() : "0 (no score on file)")
                                @IndRow("Grade / rating", s.Grade)
                                @IndRow("Generated", s.GeneratedDate?.ToString("dd MMM yyyy HH:mm"))
                            </tbody>
                        </table>
                    }

                    <div>
                        <div style="font-weight: 600; font-size: var(--text-sm); margin-bottom: var(--space-1);">Fields in the response the CRMS does not read (@probe.UnreadFields.Count)</div>
                        @if (probe.UnreadFields.Count == 0)
                        {
                            <div style="font-size: var(--text-sm); color: var(--text-secondary);">None. Every field in the response maps to something.</div>
                        }
                        else
                        {
                            <div style="font-size: var(--text-xs); color: var(--text-secondary); margin-bottom: var(--space-2);">
                                If a figure above is 0 or blank while the raw response carries it under one of these names, the mapping needs fixing.
                            </div>
                            <div style="font-family: var(--font-mono, monospace); font-size: var(--text-xs); max-height: 220px; overflow: auto; background: var(--gray-50); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: var(--space-2);">
                                @foreach (var f in probe.UnreadFields)
                                {
                                    <div>@f</div>
                                }
                            </div>
                        }
                    </div>

                    <details>
                        <summary style="cursor: pointer; font-weight: 600; font-size: var(--text-sm);">Raw response</summary>
                        <pre style="font-size: var(--text-xs); max-height: 420px; overflow: auto; background: var(--gray-50); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: var(--space-2); margin-top: var(--space-2); white-space: pre-wrap; word-break: break-word;">@PrettyJson(probe.RawJson)</pre>
                    </details>
                </div>
            </div>
        }
    }

    @if (diagTab == "cbs")
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin: 0;">Core Banking Account Raw Response</h3>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-1);">
                    Downloads the unprocessed JSON from the CBS fulldetailsbynuban endpoint — use this to inspect fields returned by the core banking gateway.
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <div class="form-group">
                    <label class="form-label">Account Number (NUBAN)</label>
                    <input class="form-control" @bind="cbsAccountNumber" placeholder="e.g. 0000000029" />
                </div>
                @if (cbsError != null)
                {
                    <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@cbsError</div>
                }
                <div>
                    <button class="btn btn-primary" @onclick="DownloadCbsResponse" disabled="@cbsBusy">
                        @if (cbsBusy)
                        {
                            <span class="spinner-sm" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                            <span>Fetching…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;margin-right:4px;">download</span>
                            <span>Download Raw JSON</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserInfo? User => AuthService.CurrentUser;

    private string diagTab = "cac";

    private bool keyBusy;
    private string? keyError;
    private CRMS.Domain.Interfaces.SmartComplyAccessCheck? keyCheck;

    private async Task CheckSmartComplyKey()
    {
        keyBusy = true;
        keyError = null;
        keyCheck = null;
        try
        {
            var result = await AppService.CheckSmartComplyAccessAsync();
            if (!result.Success || result.Data == null) keyError = result.Error ?? "The key could not be checked.";
            else keyCheck = result.Data;
        }
        finally
        {
            keyBusy = false;
        }
    }

