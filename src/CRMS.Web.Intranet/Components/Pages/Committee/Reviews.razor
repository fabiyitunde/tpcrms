@page "/committee/reviews"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApplicationService AppService
@inject NavigationManager Navigation

<PageTitle>Committee Reviews - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Committee Reviews</h1>
        <p class="page-subtitle">All committee review sessions</p>
    </div>
</div>

<div class="card mb-6">
    <div class="card-body" style="padding: var(--space-4);">
        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: flex-end;">
            <div style="flex: 1; min-width: 200px;">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" placeholder="Application #, Customer..."
                       @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKey" />
            </div>
            <div style="width: 180px;">
                <label class="form-label">Status</label>
                <select class="form-control" @bind="selectedStatus">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="InProgress">Voting in progress</option>
                    <option value="VotingComplete">Voting complete</option>
                    <option value="Decided">Decided</option>
                    <option value="Closed">Closed</option>
                </select>
            </div>
            <div style="width: 180px;">
                <label class="form-label">Committee</label>
                <select class="form-control" @bind="selectedCommittee">
                    <option value="">All Committees</option>
                    <option value="BranchCredit">Branch Credit</option>
                    <option value="ZonalCredit">Zonal Credit</option>
                    <option value="RegionalCredit">Regional Credit</option>
                    <option value="HeadOfficeCredit">Head Office Credit</option>
                    <option value="ManagementCredit">Management Credit</option>
                    <option value="BoardCredit">Board Credit</option>
                </select>
            </div>
            <button class="btn btn-primary" @onclick="Search">Search</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (isLoading)
        {
            <div class="p-6 text-center">
                <div class="spinner" style="margin: 0 auto;"></div>
            </div>
        }
        else if (!reviews.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <span class="material-symbols-outlined">groups</span>
                </div>
                <div class="empty-state-title">No reviews found</div>
                <div class="empty-state-text">Try adjusting your filters.</div>
            </div>
        }
        else
        {
            <table class="table table-clickable">
                <thead>
                    <tr>
                        <th>Application</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Committee</th>
                        <th>Status</th>
                        <th>Votes</th>
                        <th>Decision</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in reviews)
                    {
                        var reviewUrl = review.DetailUrl;
                        var rowStyle = reviewUrl is null ? null : "cursor: pointer;";
                        var rowTitle = reviewUrl is null ? "The application behind this review could not be found." : null;
                        <tr @onclick="() => ViewApplication(reviewUrl)" style="@rowStyle" title="@rowTitle">
                            <td>
                                <span style="font-weight: 600; color: var(--primary-600);">@review.ApplicationNumber</span>
                            </td>
                            <td>@review.CustomerName</td>
                            <td style="font-weight: 500;">₦@FormatAmount(review.Amount)</td>
                            <td>
                                <span class="badge @GetCommitteeBadgeClass(review.CommitteeType)">@FormatCommittee(review.CommitteeType)</span>
                            </td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(review.Status)">
                                    <span class="status-dot @GetStatusDotClass(review.Status)"></span>
                                    @FormatStatus(review.Status)
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--space-2);">
                                    <div class="vote-progress">
                                        <div class="vote-progress-bar" style="width: @(review.VotesCast * 100 / review.TotalMembers)%"></div>
                                    </div>
                                    <span style="font-size: var(--text-sm);">@review.VotesCast/@review.TotalMembers</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(review.Decision))
                                {
                                    <span class="badge @GetDecisionBadgeClass(review.Decision)">@review.Decision</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-ghost btn-sm">
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .vote-progress {
        width: 60px;
        height: 6px;
        background: var(--gray-200);
        border-radius: var(--radius-full);
        overflow: hidden;
    }
    
    .vote-progress-bar {
        height: 100%;
        background: var(--primary-500);
        border-radius: var(--radius-full);
    }
</style>

@code {
    private List<CommitteeReview> reviews = [];
    private string searchTerm = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedCommittee = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        isLoading = true;
        try
        {
            var dbReviews = await AppService.GetCommitteeReviewsByStatusAsync(string.IsNullOrEmpty(selectedStatus) ? null : selectedStatus);
            if (dbReviews.Any())
            {
                reviews = dbReviews.Select(r => new CommitteeReview
                {
                    ApplicationId = r.ApplicationId,
                    DetailUrl = r.DetailUrl,
                    ApplicationNumber = r.ApplicationNumber,
                    CustomerName = string.IsNullOrWhiteSpace(r.CustomerName) ? "N/A" : r.CustomerName,
                    Amount = r.Amount,
                    CommitteeType = r.CommitteeType,
                    Status = r.Status,
                    VotesCast = r.VotesCast,
                    TotalMembers = r.TotalMembers > 0 ? r.TotalMembers : 1,
                    Decision = r.FinalDecision ?? ""
                }).ToList();

                reviews = ApplyFilters(reviews);
            }
            else
            {
                reviews = [];
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Search()
    {
        await LoadReviews();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadReviews();
        }
    }

    /// <summary>
    /// Narrows the loaded rows by the search box and the committee picker.
    /// <para>
    /// Both controls were bound to fields nothing ever read, so typing an application number and
    /// pressing Search changed nothing at all. The query itself only understands status; the rows for
    /// one status are few enough that narrowing them here costs nothing and keeps the query simple.
    /// </para>
    /// </summary>
    private List<CommitteeReview> ApplyFilters(List<CommitteeReview> rows)
    {
        if (!string.IsNullOrWhiteSpace(selectedCommittee))
        {
            rows = rows
                .Where(r => string.Equals(r.CommitteeType, selectedCommittee, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        var term = searchTerm?.Trim();
        if (!string.IsNullOrEmpty(term))
        {
            // Application number or customer, the two things printed on the row.
            rows = rows
                .Where(r => r.ApplicationNumber.Contains(term, StringComparison.OrdinalIgnoreCase)
                            || r.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        return rows;
    }

    // NAMP cases live under /namp/{id} and corporate ones under /applications/{id}, so the row is told
    // where to go rather than assuming a corporate path. A null url means the case behind the review
    // could not be resolved; clicking then does nothing, instead of landing on "Application not found".
    private void ViewApplication(string? detailUrl)
    {
        if (!string.IsNullOrEmpty(detailUrl))
        {
            Navigation.NavigateTo(detailUrl);
        }
    }

    private static string FormatAmount(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000:0.##}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000:0.##}M";
        return $"{amount:N0}";
    }

    // Keyed on the CommitteeType names the DTO emits. These used to read "Credit Committee" and
    // friends, which that enum has never contained, so every committee badge rendered grey.
    // The colour climbs with the tier, so the committee a case reached is readable at a glance.
    private static string GetCommitteeBadgeClass(string type) => type switch
    {
        "BoardCredit" => "badge-danger",
        "ManagementCredit" => "badge-warning",
        "HeadOfficeCredit" => "badge-warning",
        "RegionalCredit" => "badge-info",
        "ZonalCredit" => "badge-info",
        "BranchCredit" => "badge-primary",
        _ => "badge-gray"
    };

    private static string FormatCommittee(string type) => type switch
    {
        "BranchCredit" => "Branch Credit",
        "ZonalCredit" => "Zonal Credit",
        "RegionalCredit" => "Regional Credit",
        "HeadOfficeCredit" => "Head Office Credit",
        "ManagementCredit" => "Management Credit",
        "BoardCredit" => "Board Credit",
        _ => type
    };

    // Keyed on the CommitteeReviewStatus names the DTO actually emits. They used to be keyed on
    // "Voting" and "Completed", which are not members of that enum, so every status but Pending
    // fell through to grey.
    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Decided" => "badge-success",
        "Closed" => "badge-success",
        "VotingComplete" => "badge-info",
        "InProgress" => "badge-primary",
        "Pending" => "badge-warning",
        _ => "badge-gray"
    };
    private static string GetStatusDotClass(string status) => status switch
    {
        "Decided" => "success",
        "Closed" => "success",
        "VotingComplete" => "info",
        "InProgress" => "info",
        "Pending" => "warning",
        _ => "gray"
    };

    // The stored names read like internals; the list shows the plain-language equivalent.
    private static string FormatStatus(string status) => status switch
    {
        "InProgress" => "Voting in progress",
        "VotingComplete" => "Voting complete",
        _ => status
    };

    private static string GetDecisionBadgeClass(string decision) => decision switch
    {
        "Approved" => "badge-success",
        "Rejected" => "badge-danger",
        _ => "badge-gray"
    };

    private class CommitteeReview
    {
        public Guid ApplicationId { get; set; }
        public string? DetailUrl { get; set; }
        public string ApplicationNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string CommitteeType { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int VotesCast { get; set; }
        public int TotalMembers { get; set; }
        public string Decision { get; set; } = string.Empty;
    }
}
