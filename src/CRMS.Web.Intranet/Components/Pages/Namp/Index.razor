                            <div style="display: flex; gap: var(--space-2);">
                                <button class="btn btn-outline btn-sm" disabled="@(myQueuePage <= 1)" @onclick="() => myQueuePage--">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">chevron_left</span>
                                    Previous
                                </button>
                                <button class="btn btn-outline btn-sm" disabled="@(myQueuePage >= totalPages)" @onclick="() => myQueuePage++">
                                    Next
                                    <span class="material-symbols-outlined" style="font-size: 18px;">chevron_right</span>
                                </button>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
}

