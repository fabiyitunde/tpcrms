@page "/namp"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CRMS.Application.Namp.DTOs
@using CRMS.Web.Intranet.Models
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>NAMP Applications - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">NAMP Applications</h1>
        <p class="page-subtitle">New Agricultural Mechanisation Programme — @QueueSubtitle</p>
    </div>
    <button class="btn btn-ghost btn-sm" @onclick="LoadAll" disabled="@isLoading" title="Refresh queue">
        <span class="material-symbols-outlined" style="font-size: 18px; @(isLoading ? "animation: spin 1s linear infinite;" : "")">refresh</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger" style="margin-bottom: 1rem;">@pageError</div>
}

<!-- Tab bar -->
<div class="tabs">
    @if (IsLoanOfficer || IsAdmin)
    {
        <div class="tab @(activeTab == "staging" ? "active" : "")" @onclick='() => SwitchTab("staging")'>
            Staging Queue
            @if (stagingQueue.Count > 0)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@stagingQueue.Count</span>
            }
        </div>
    }
    <div class="tab @(activeTab == "apps" ? "active" : "")" @onclick='() => SwitchTab("apps")'>
        My Queue
        @if (myQueue.Count > 0)
        {
            <span class="badge badge-info" style="margin-left: 6px;">@myQueue.Count</span>
        }
    </div>
    <div class="tab @(activeTab == "myapps" ? "active" : "")" @onclick='() => SwitchTab("myapps")'>
        My Applications
        @if (myApps.Count > 0)
        {
            <span class="badge badge-secondary" style="margin-left: 6px;">@myApps.Count</span>
        }
    </div>
    @if (IsAdmin)
    {
        <div class="tab @(activeTab == "all" ? "active" : "")" @onclick='() => SwitchTab("all")'>
            All Applications
        </div>
    }
</div>

<!-- ── Staging Queue Tab ── -->
@if (activeTab == "staging")
{
    <div class="card mb-4">
        <div class="card-body" style="padding: var(--space-4);">
            <div style="display: flex; gap: var(--space-4); align-items: flex-end;">
                <div style="flex: 1;">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" placeholder="PAYS reference, applicant, BOA account…"
                           @bind="stagingSearch" @bind:event="oninput" @bind:after="() => stagingPage = 1" />
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body" style="padding: 0;">
            @if (isLoading)
            {
                <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
            }
            else if (stagingQueue.Count == 0)
            {
                <div class="p-6 text-center text-muted">
                    <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3;">inbox</span>
                    <div style="margin-top: 0.5rem;">No pending recalls in staging queue.</div>
                </div>
            }
            else
            {
                var filtered = FilteredStaging;
                var paged = filtered.Skip((stagingPage - 1) * PageSize).Take(PageSize).ToList();
                var totalPages = (int)Math.Ceiling(filtered.Count / (double)PageSize);

                @if (filtered.Count == 0)
                {
                    <div class="p-6 text-center text-muted">No records match your search.</div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="table table-clickable">
                            <thead>
                                <tr>
                                    <th>PAYS Reference</th>
                                    <th>Applicant</th>
                                    <th>BOA Account</th>
                                    <th>Category</th>
                                    <th>Equipment</th>
                                    <th>Value (₦)</th>
                                    <th>Received</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rec in paged)
                                {
                                    <tr>
                                        <td style="font-weight: 600; color: var(--primary-600);">@rec.ApplicationReference</td>
                                        <td>@rec.ApplicantName</td>
                                        <td style="font-family: monospace; font-size: var(--text-sm);">@rec.BoaAccountNumber</td>
                                        <td><span class="badge badge-info">@FormatCategory(rec.ApplicantCategory)</span></td>
                                        <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@rec.EquipmentDescription</td>
                                        <td style="font-weight: 500;">@rec.EquipmentValue.ToString("N0")</td>
                                        <td style="white-space: nowrap; font-size: var(--text-sm); color: var(--text-secondary);">@rec.ReceivedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm" @onclick="() => OpenRecallModal(rec)">
                                                Recall
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: var(--text-sm); color: var(--gray-500);">
                                Showing @((stagingPage - 1) * PageSize + 1)–@Math.Min(stagingPage * PageSize, filtered.Count) of @filtered.Count
                            </span>
                            <div style="display: flex; gap: var(--space-2);">
                                <button class="btn btn-outline btn-sm" disabled="@(stagingPage <= 1)" @onclick="() => stagingPage--">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">chevron_left</span>
                                    Previous
                                </button>
                                <button class="btn btn-outline btn-sm" disabled="@(stagingPage >= totalPages)" @onclick="() => stagingPage++">
                                    Next
                                    <span class="material-symbols-outlined" style="font-size: 18px;">chevron_right</span>
                                </button>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
}

