<!-- ── Recall Modal ── -->
@if (showRecallModal && recallingRecord != null)
{
    <div class="modal-backdrop show" @onclick="CloseRecallModal">
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Recall Application</h3>
                <button class="modal-close" @onclick="CloseRecallModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                <div style="background: var(--gray-50); border-radius: var(--radius-md); padding: 1rem; font-size: 0.875rem;">
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">@recallingRecord.ApplicantName</div>
                    <div style="color: var(--text-secondary);">@recallingRecord.ApplicationReference · @recallingRecord.BoaAccountNumber</div>
                    <div style="color: var(--text-secondary); margin-top: 0.25rem;">@recallingRecord.EquipmentDescription — ₦@recallingRecord.EquipmentValue.ToString("N0")</div>
                </div>
            </div>
            <div class="modal-footer">
                @if (!string.IsNullOrEmpty(recallError))
                {
                    <div class="alert alert-danger" style="margin: 0; flex: 1; font-size: 0.85rem;">@recallError</div>
                }
                <button class="btn btn-secondary" @onclick="CloseRecallModal">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmRecall" disabled="@isRecalling">
                    @if (isRecalling) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Recall Application
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 15;

    private string activeTab = "staging";
    private bool isLoading = true;
    private bool isLoadingAll = false;
    private bool isLoadingMyApps = false;
    private string? pageError;

    // Data
    private List<NampStagingRecordSummaryDto> stagingQueue = [];
    private List<NampApplicationSummaryDto> myQueue = [];
    private List<NampApplicationSummaryDto> myApps = [];
    private List<NampApplicationSummaryDto> allApps = [];
    private string filterStatus = "";

    // Search state (per tab)
    private string stagingSearch = "";
    private string myQueueSearch = "";
    private string myAppsSearch = "";
    private string allAppsSearch = "";

    // Pagination state (per tab)
    private int stagingPage = 1;
    private int myQueuePage = 1;
    private int myAppsPage = 1;
    private int allAppsPage = 1;

    // Recall modal
    private bool showRecallModal;
    private bool isRecalling;
    private NampStagingRecordSummaryDto? recallingRecord;
    private string? recallError;

    // Role helpers
    private bool IsLoanOfficer => User?.HasAnyRole("LoanOfficer", "SystemAdmin") ?? false;
    private bool IsAdmin => User?.HasRole("SystemAdmin") ?? false;
    private UserInfo? User => AuthService.CurrentUser;

    private string QueueSubtitle => activeTab switch
    {
        "staging"  => $"{stagingQueue.Count} pending recall{(stagingQueue.Count == 1 ? "" : "s")}",
        "apps"     => $"{myQueue.Count} pending action{(myQueue.Count == 1 ? "" : "s")}",
        "myapps"   => $"{myApps.Count} application{(myApps.Count == 1 ? "" : "s")} you have contributed to",
        _          => "All applications"
    };

    // Filtered views
    private List<NampStagingRecordSummaryDto> FilteredStaging
    {
        get
        {
            if (string.IsNullOrWhiteSpace(stagingSearch)) return stagingQueue;
            var q = stagingSearch.Trim().ToLowerInvariant();
            return stagingQueue.Where(r =>
                r.ApplicationReference.ToLowerInvariant().Contains(q) ||
                r.ApplicantName.ToLowerInvariant().Contains(q) ||
                r.BoaAccountNumber.ToLowerInvariant().Contains(q) ||
                r.EquipmentDescription.ToLowerInvariant().Contains(q)
            ).ToList();
        }
    }

    private List<NampApplicationSummaryDto> FilteredMyQueue
    {
        get
        {
            if (string.IsNullOrWhiteSpace(myQueueSearch)) return myQueue;
            var q = myQueueSearch.Trim().ToLowerInvariant();
            return myQueue.Where(a =>
                a.ApplicationNumber.ToLowerInvariant().Contains(q) ||
                a.ApplicantName.ToLowerInvariant().Contains(q) ||
                FormatStatus(a.Status).ToLowerInvariant().Contains(q)
            ).ToList();
        }
    }

    private List<NampApplicationSummaryDto> FilteredMyApps
    {
        get
        {
            if (string.IsNullOrWhiteSpace(myAppsSearch)) return myApps;
            var q = myAppsSearch.Trim().ToLowerInvariant();
            return myApps.Where(a =>
                a.ApplicationNumber.ToLowerInvariant().Contains(q) ||
                a.ApplicantName.ToLowerInvariant().Contains(q) ||
                FormatStatus(a.Status).ToLowerInvariant().Contains(q)
            ).ToList();
        }
    }

    private List<NampApplicationSummaryDto> FilteredAllApps
    {
        get
        {
            if (string.IsNullOrWhiteSpace(allAppsSearch)) return allApps;
            var q = allAppsSearch.Trim().ToLowerInvariant();
            return allApps.Where(a =>
                a.ApplicationNumber.ToLowerInvariant().Contains(q) ||
                a.ApplicantName.ToLowerInvariant().Contains(q) ||
                FormatStatus(a.Status).ToLowerInvariant().Contains(q)
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!IsLoanOfficer && !IsAdmin) activeTab = "apps";
        await LoadAll();
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "all" && allApps.Count == 0) await LoadAdminAll();
        if (tab == "myapps" && myApps.Count == 0) await LoadMyApplications();
    }

    private async Task LoadAll()
    {
        isLoading = true;
        pageError = null;
        try
        {
            // Head-office-domiciled actors see all branches; branch actors are scoped to their branch.
            var stagingBranchId = IsLoanOfficer && !IsAdmin && !(User?.IsHeadOffice ?? false) ? User?.LocationId : (Guid?)null;
            await LoadStagingQueue(stagingBranchId);
            await LoadMyQueue();
            if (activeTab == "all") await LoadAdminAll();
        }
        finally { isLoading = false; }
    }

    private async Task LoadStagingQueue(Guid? branchId)
    {
        stagingQueue = await AppService.GetNampStagingQueueAsync(branchId);
        stagingPage = 1;
    }

    private async Task LoadMyApplications()
    {
        if (User == null) { myApps = []; return; }
        isLoadingMyApps = true;
        try
        {
            myApps = await AppService.GetMyNampApplicationsAsync(User.Id);
            myAppsPage = 1;
        }
        finally { isLoadingMyApps = false; }
    }

    private async Task LoadMyQueue()
    {
        var user = User;
        if (user == null) { myQueue = []; return; }

        var results = new List<NampApplicationSummaryDto>();

        // Head-office-domiciled actors see every branch; branch actors are scoped to their own branch.
        var queueBranchId = user.IsHeadOffice ? (Guid?)null : user.LocationId;

        // Branch-filtered statuses: only apps in the user's branch (or all branches for HO actors)
        var branchStatuses = GetBranchScopedStatuses(user);
        if (branchStatuses.Length > 0)
        {
            var branchApps = await AppService.GetNampApplicationsByStatusesAsync(branchStatuses, queueBranchId);
            results.AddRange(branchApps);
        }

        // Global statuses: higher-level committee circulation (no branch filter)
        var globalStatuses = GetGlobalStatuses(user);
        if (globalStatuses.Length > 0)
        {
            var globalApps = await AppService.GetNampApplicationsByStatusesAsync(globalStatuses, null);
            results.AddRange(globalApps);
        }

        // Committee members: load via actual committee review membership (not role+branch filter)
        if (IsCommitteeMemberRole(user))
        {
            var committeeApps = await AppService.GetNampApplicationsByCommitteeMembershipAsync(user.Id);
            results.AddRange(committeeApps);
        }

        // Ratification: filtered by the manager's tier (BranchManager sees Branch-tier ratifications, etc.)
        var ratificationTier = GetRatificationTier(user);
        if (ratificationTier != null)
        {
            // Branch managers see only their branch's ratification apps; HO-domiciled managers and higher tiers see all
            var ratBranchId = user.HasRole("BranchManager") && !user.IsHeadOffice ? user.LocationId : (Guid?)null;
            var ratApps = await AppService.GetNampApplicationsByStatusAndTierAsync("Ratification", ratificationTier, ratBranchId);
            results.AddRange(ratApps);
        }

        // Deduplicate by Id (user may hold multiple roles that overlap statuses)
        myQueue = results.DistinctBy(a => a.Id).OrderByDescending(a => a.CreatedAt).ToList();
        myQueuePage = 1;
    }

    /// <summary>Branch-scoped statuses the user should see (filtered by their LocationId).</summary>
    private static string[] GetBranchScopedStatuses(UserInfo user)
    {
        var statuses = new HashSet<string>();

        if (user.HasAnyRole("LoanOfficer", "SystemAdmin"))
            statuses.UnionWith(["Draft", "OfferGenerated"]);
        if (user.HasAnyRole("CreditOfficer", "SystemAdmin"))
            statuses.UnionWith(["Submitted", "FinancialAppraisal", "BranchCommitteeCirculation"]);
        if (user.HasAnyRole("DeploymentOfficer", "SystemAdmin"))
            statuses.UnionWith(["OfferAccepted", "PreDeploymentVerification", "Deployment"]);

        return [.. statuses];
    }

    /// <summary>Global statuses (no branch filter) — higher-level committee circulation for CreditOfficers/Admins.</summary>
    private static string[] GetGlobalStatuses(UserInfo user)
    {
        var statuses = new HashSet<string>();

        if (user.HasAnyRole("CreditOfficer", "SystemAdmin"))
            statuses.UnionWith(["ZonalCommitteeCirculation", "RegionalCommitteeCirculation", "HOCommitteeCirculation"]);

        return [.. statuses];
    }

    /// <summary>Returns true if the user has any committee member role (queue is loaded via membership query instead).</summary>
    private static bool IsCommitteeMemberRole(UserInfo user) =>
        user.HasAnyRole("CommitteeMember", "BranchCommitteeMember", "ZonalCommitteeMember", "RegionalCommitteeMember", "HOCommitteeMember");

    /// <summary>Returns the CommitteeTier string for ratification if this user is a tier manager; null otherwise.</summary>
    private static string? GetRatificationTier(UserInfo user)
    {
        if (user.HasRole("MdCeo"))       return "HeadOffice";
        if (user.HasRole("RegionalManager")) return "Regional";
        if (user.HasRole("ZonalManager"))    return "Zonal";
        if (user.HasRole("BranchManager"))   return "Branch";
        if (user.HasRole("SystemAdmin"))     return null; // Admin sees all via GetGlobalStatuses; skip here to avoid duplication
        return null;
    }

    private async Task LoadAdminAll()
    {
        isLoadingAll = true;
        allAppsPage = 1;
        try
        {
            if (string.IsNullOrEmpty(filterStatus))
            {
                var activeStatuses = new[] { "Draft", "Submitted", "FinancialAppraisal",
                    "BranchCommitteeCirculation", "ZonalCommitteeCirculation", "RegionalCommitteeCirculation",
                    "HOCommitteeCirculation", "Ratification", "OfferGenerated", "OfferAccepted",
                    "PreDeploymentVerification", "Deployment", "Active" };
                allApps = await AppService.GetNampApplicationsByStatusesAsync(activeStatuses);
            }
            else
            {
                allApps = await AppService.GetNampApplicationsByStatusAsync(filterStatus);
            }
        }
        finally { isLoadingAll = false; }
    }

    private void OpenRecallModal(NampStagingRecordSummaryDto rec)
    {
        recallingRecord = rec;
        recallError = null;
        showRecallModal = true;
    }

    private void CloseRecallModal() { showRecallModal = false; recallingRecord = null; recallError = null; }

    private async Task ConfirmRecall()
    {
        isRecalling = true;
        recallError = null;
        try
        {
            var userId = User?.Id ?? Guid.Empty;
            var result = await AppService.RecallNampApplicationAsync(recallingRecord!.Id, userId);
            if (result.Success)
            {
                CloseRecallModal();
                await LoadAll();
                if (result.Data != null)
                    Navigation.NavigateTo($"/namp/{result.Data.Id}");
            }
            else recallError = result.Error ?? "Recall failed";
        }
        finally { isRecalling = false; }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Draft"                                                      => "badge-gray",
        "Submitted" or "FinancialAppraisal"                          => "badge-warning",
        var s when s.Contains("CommitteeCirculation")                => "badge-info",
        "Ratification"                                               => "badge-primary",
        "OfferGenerated" or "OfferAccepted"                          => "badge-info",
        "PreDeploymentVerification" or "Deployment"                  => "badge-primary",
        "Active"                                                     => "badge-success",
        var s when s.Contains("Declined") || s.Contains("Lapsed")   => "badge-danger",
        "Closed"                                                     => "badge-success",
        _                                                            => "badge-gray"
    };

    private static string FormatStatusDisplay(NampApplicationSummaryDto app)
    {
        // After circulation (CommitteeReviewId set), show "Voting" to distinguish from pre-circulation
        if (app.CurrentCommitteeReviewId != null && app.Status.EndsWith("CommitteeCirculation"))
        {
            return app.Status switch
            {
                "BranchCommitteeCirculation"   => "Branch Committee Voting",
                "ZonalCommitteeCirculation"    => "Zonal Committee Voting",
                "RegionalCommitteeCirculation" => "Regional Committee Voting",
                "HOCommitteeCirculation"       => "HO Committee Voting",
                _                              => FormatStatus(app.Status)
            };
        }
        return FormatStatus(app.Status);
    }

    private static string FormatStatus(string status) => status switch
    {
        "BranchCommitteeCirculation"   => "Branch Committee",
        "ZonalCommitteeCirculation"    => "Zonal Committee",
        "RegionalCommitteeCirculation" => "Regional Committee",
        "HOCommitteeCirculation"       => "HO Committee",
        "BranchCommitteeDeclined"      => "Branch Declined",
        "ZonalCommitteeDeclined"       => "Zonal Declined",
        "RegionalCommitteeDeclined"    => "Regional Declined",
        "HOCommitteeDeclined"          => "HO Declined",
        "FinancialDeclined"            => "Financial Declined",
        "RatificationDeclined"         => "Ratification Declined",
        "PreDeploymentVerification"    => "Pre-Deployment",
        "OfferGenerated"               => "Offer Sent",
        "OfferAccepted"                => "Offer Accepted",
        "OfferLapsed"                  => "Offer Lapsed",
        _                              => status
    };

    private static string FormatCategory(string cat) => cat switch
    {
        "YouthAgripreneur"   => "Youth",
        "WomenAgripreneur"   => "Women",
        "AgroServiceCompany" => "Agro-Service",
        _                    => cat
    };
}
