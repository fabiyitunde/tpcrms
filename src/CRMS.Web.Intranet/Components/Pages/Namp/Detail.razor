    private static List<StageInfo> StageProgression =>
    [
        new(1, "Draft / Recall", "Loan Officer", a => IsAfter(a, "Draft"), a => a.Status == "Draft"),
        new(2, "Technical Appraisal", "Agricultural Engineer", a => IsAfter(a, "TechnicalAppraisal"), a => a.Status is "Submitted" or "TechnicalAppraisal"),
        new(3, "Financial Appraisal", "Credit Officer", a => IsAfter(a, "FinancialAppraisal"), a => a.Status == "FinancialAppraisal"),
        new(4, "Committee Review", "Committee Members", a => IsAfter(a, "Ratification"), a => a.Status is "BranchCommitteeCirculation" or "ZonalCommitteeCirculation" or "RegionalCommitteeCirculation" or "HOCommitteeCirculation"),
        new(5, "Ratification", "Final Approver", a => IsAfter(a, "OfferGenerated"), a => a.Status == "Ratification"),
        new(6, "Offer Letter", "Loan Officer", a => IsAfter(a, "OfferAccepted"), a => a.Status is "OfferGenerated" or "OfferAccepted"),
        new(7, "Pre-Deployment", "Compliance Officer", a => IsAfter(a, "Training"), a => a.Status is "OfferAccepted" or "PreDeploymentVerification"),
        new(8, "Training", "Training Coordinator", a => IsAfter(a, "Deployment"), a => a.Status == "Training"),
        new(9, "Deployment", "Deployment Officer", a => a.Status == "Active", a => a.Status == "Deployment"),
    ];

    private static readonly string[] StatusOrder = [
        "Draft", "Submitted", "TechnicalAppraisal", "FinancialAppraisal",
        "BranchCommitteeCirculation", "ZonalCommitteeCirculation", "RegionalCommitteeCirculation", "HOCommitteeCirculation",
        "Ratification", "OfferGenerated", "OfferAccepted", "PreDeploymentVerification",
        "Training", "Deployment", "Active", "Closed"
    ];

    private static bool IsAfter(NampApplicationDto a, string marker)
    {
        var idx = Array.IndexOf(StatusOrder, a.Status);
        var markerIdx = Array.IndexOf(StatusOrder, marker);
        return idx > markerIdx;
    }

