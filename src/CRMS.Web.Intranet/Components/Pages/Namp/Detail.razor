    private async Task SubmitFinDecision()
    {
        if (!finDecisionApproved && string.IsNullOrWhiteSpace(finDecisionNote))
        { finDecisionError = "A note is required when declining."; return; }

        if (string.IsNullOrWhiteSpace(finRepaymentRating) || string.IsNullOrWhiteSpace(finCreditRecommendation))
        { finDecisionError = "Complete and save the report before submitting a decision."; return; }

        isSubmittingFinDecision = true; finDecisionError = null;
        try
        {
            var saveResult = await AppService.SaveNampFinancialAppraisalReportAsync(
                Id, User?.Id ?? Guid.Empty,
                finMonthlyIncome, finDscr, finLtv,
                finRepaymentRating, NullIfEmpty(finEquityNote), NullIfEmpty(finBureauSummary),
                finCreditRecommendation, NullIfEmpty(finSummaryNotes));
            if (!saveResult.Success) { finDecisionError = saveResult.Error ?? "Failed to save report"; return; }

            var result = await AppService.SubmitNampFinancialAppraisalAsync(Id, User?.Id ?? Guid.Empty, finDecisionApproved, NullIfEmpty(finDecisionNote));
            if (result.Success) { showFinDecisionModal = false; await Load(); }
            else finDecisionError = result.Error ?? "Decision submission failed";
        }
        finally { isSubmittingFinDecision = false; }
    }

