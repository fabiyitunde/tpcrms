    private static string FormatCategoryName(string category) => category switch
    {
        "CreditHistory" => "Credit History",
        "FinancialHealth" => "Financial Health",
        "CashflowStability" => "Cashflow",
        "DebtServiceCapacity" => "DSCR",
        "TechnicalViability" => "Technical Viability",
        _ => category,
    };

    private void PopulateFormFields()
    {
        if (app == null) return;
        // Pre-deployment checklist dictionaries
        checklistConfirmed.Clear(); checklistNotes.Clear();
        foreach (var item in app.PreDeploymentChecklist)
        {
            checklistConfirmed[item.Id] = item.IsConfirmed;
            checklistNotes[item.Id] = item.Notes;
        }

        var fr = app.FinancialAppraisalReport;
        if (fr != null)
        {
            finMonthlyIncome = fr.MonthlyDisposableIncome;
            finDscr = fr.DebtServiceCoverageRatio;
            finLtv = fr.LoanToValueRatio;
            finRepaymentRating = fr.RepaymentCapacityRating;
            finEquityNote = fr.EquityAssessmentNote;
            finBureauSummary = fr.CreditBureauSummary;
            finCreditRecommendation = fr.CreditOfficerRecommendation;
            finSummaryNotes = fr.SummaryNotes;
            finRepaymentSource = fr.RepaymentSource;
            finProjectedRentalRevenue = fr.ProjectedMonthlyRentalRevenue;
            finUtilisationRate = fr.UtilisationRateAssumption;
            finDemandEvidence = fr.DemandEvidenceNote;
        }

        // Auto-populate bureau summary if not already saved and reports are available
        if (string.IsNullOrWhiteSpace(finBureauSummary) && app.BureauReports.Count > 0)
        {
            var lines = app.BureauReports.Select(r =>
            {
                var type = r.SubjectType == "NampApplicant" ? "Applicant" : "Guarantor";
                var score = r.CreditScore.HasValue ? $"{r.CreditScore} ({r.ScoreGrade ?? "N/A"})" : "Pending";
                var outstanding = r.TotalOutstanding.HasValue ? $"₦{r.TotalOutstanding:N0}" : "N/A";
                var delinquent = r.DelinquentFacilities.HasValue ? r.DelinquentFacilities.ToString() : "N/A";
                return $"[{type}] {r.SubjectName} | BVN: {r.Bvn} | Score: {score} | Delinquent Facilities: {delinquent} | Total Outstanding: {outstanding}";
            });
            finBureauSummary = string.Join("\n", lines);
        }
    }

