    };

    private static string FormatDocStage(string stage) => stage switch
    {
        "TechnicalAppraisal" => "Technical",
        "FinancialAppraisal" => "Financial",
        _ => stage
    };

    private static string FormatDocCategory(string cat) => cat switch
    {
        "TechnicalReport" => "Technical Report",
        "SitePhoto" => "Site Photo",
        "SoilTestResult" => "Soil Test",
        "FinancialModel" => "Financial Model",
        "CreditReport" => "Credit Report",
        "SupportingDocument" => "Supporting Doc",
        _ => cat
    };

    private static string GetDocIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "picture_as_pdf",
            ".doc" or ".docx" => "description",
            ".xls" or ".xlsx" => "table_chart",
            ".jpg" or ".jpeg" or ".png" => "image",
            _ => "insert_drive_file"
        };
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:0.#} MB";
        if (bytes >= 1_024) return $"{bytes / 1_024.0:0.#} KB";
        return $"{bytes} B";
    }

    private record StageInfo(int Order, string Name, string Role, Func<NampApplicationDto, bool> IsCompleted, Func<NampApplicationDto, bool> IsCurrent);

    private static string GetBureauScoreClass(int? score) => score switch
    {
        >= 750 => "excellent",
        >= 700 => "good",
        >= 650 => "fair",
        null => "",
        _ => "poor"
    };

    private static string FormatBureauAmount(decimal amount)
    {
        if (amount >= 1_000_000) return $"{amount / 1_000_000:0.##}M";
        if (amount >= 1_000) return $"{amount / 1_000:0.#}K";
        return $"{amount:N0}";
    }

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;
}
