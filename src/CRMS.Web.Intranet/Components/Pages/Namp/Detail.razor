    <!-- ══════════════════════════════════════════════
         LEGAL CLEARANCE TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "legal-clearance")
    {
        <div class="card">
            <div class="card-header">
                <div style="display: flex; align-items: center; gap: var(--space-2);">
                    <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary-600);">gavel</span>
                    <div>
                        <h3 class="card-title" style="margin: 0;">Legal Clearance</h3>
                        <div style="font-size: var(--text-xs); color: var(--gray-500); margin-top: 2px;">Legal Officer review before pre-deployment</div>
                    </div>
                </div>
            </div>
            <div class="card-body">

                @if (app.LegalClearedAt.HasValue)
                {
                    <div style="padding: var(--space-3) var(--space-4); background: var(--success-50); border: 1px solid var(--success-200); border-radius: var(--radius-md); margin-bottom: var(--space-4);">
                        <div style="font-weight: 600; color: var(--success-700); margin-bottom: 4px;">Clearance Granted</div>
                        <div style="font-size: var(--text-sm); color: var(--success-800);">
                            Cleared on @app.LegalClearedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(app.LegalClearanceNote)) { <span> — @app.LegalClearanceNote</span> }
                        </div>
                    </div>
                }

                @if (app.Status == "LegalReturned")
                {
                    <div style="padding: var(--space-3) var(--space-4); background: var(--warning-50); border: 1px solid var(--warning-200); border-radius: var(--radius-md); margin-bottom: var(--space-4);">
                        <div style="font-weight: 600; color: var(--warning-700); margin-bottom: 4px;">Returned by Legal Officer</div>
                        <div style="font-size: var(--text-sm); color: var(--warning-800);">@app.LegalReturnNote</div>
                    </div>
                }

                @if (app.Status == "LegalDeclined")
                {
                    <div style="padding: var(--space-3) var(--space-4); background: var(--danger-50); border: 1px solid var(--danger-200); border-radius: var(--radius-md); margin-bottom: var(--space-4);">
                        <div style="font-weight: 600; color: var(--danger-700); margin-bottom: 4px;">Declined by Legal Officer</div>
                        <div style="font-size: var(--text-sm); color: var(--danger-800);">@app.LegalDeclineNote</div>
                    </div>
                }

                <!-- Documents upload during legal clearance / returned stages -->
                @if (app.Status is "LegalClearance" or "LegalReturned")
                {
                    <div style="margin-top: var(--space-4);">
                        <div style="font-size: var(--text-sm); font-weight: 600; color: var(--gray-700); margin-bottom: var(--space-2);">Upload Supporting Documents</div>
                        <div style="font-size: var(--text-xs); color: var(--gray-500); margin-bottom: var(--space-3);">
                            You may upload pre-deployment documents (equity deposit receipt, lease agreement, GPS consent, etc.) now so they are ready when verification begins.
                        </div>
                        <button class="btn btn-outline" @onclick="OpenLegalDocUpload">
                            <span class="material-symbols-outlined" style="font-size: 16px;">upload_file</span>
                            Upload Document
                        </button>
                    </div>

                    @if (app.Documents.Any(d => d.Stage == "LegalClearance"))
                    {
                        <div style="margin-top: var(--space-4);">
                            <div style="font-size: var(--text-sm); font-weight: 600; color: var(--gray-700); margin-bottom: var(--space-2);">Documents Uploaded at This Stage</div>
                            @foreach (var doc in app.Documents.Where(d => d.Stage == "LegalClearance"))
                            {
                                <div style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) 0; border-bottom: 1px solid var(--gray-100);">
                                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--gray-400);">description</span>
                                    <span style="flex: 1; font-size: var(--text-sm);">@doc.FileName</span>
                                    <a href="@doc.StoragePath" target="_blank" class="btn btn-xs btn-outline">View</a>
                                </div>
                            }
                        </div>
                    }
                }

                @if (app.Status is "LegalReturned" && ShowResubmitToLegalButton)
                {
                    <div style="margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--gray-200);">
                        <div style="font-size: var(--text-sm); color: var(--gray-600); margin-bottom: var(--space-3);">
                            Address the reason for return above, then resubmit to Legal Officer.
                        </div>
                        <button class="btn btn-primary" @onclick="ResubmitToLegal">Resubmit to Legal</button>
                    </div>
                }

            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         PRE-DEPLOYMENT TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "pre-deployment")
    {
        // Deployment Officer controls gate checkboxes and saves the checklist
        var canEditGates = app.Status == "PreDeploymentVerification" &&
                           (User?.HasAnyRole("DeploymentOfficer", "SystemAdmin") ?? false);
        // Branch staff (Loan Officer) can upload evidence documents collected from the applicant
        var canUploadGateDocs = app.Status == "PreDeploymentVerification" &&
                                (User?.HasAnyRole("LoanOfficer", "DeploymentOfficer", "SystemAdmin") ?? false);

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            @if (!canEditGates && app.PreDeploymentVerifiedAt.HasValue)
            {
                <div style="padding: var(--space-3) var(--space-4); background: var(--success-50); border: 1px solid var(--success-200); border-radius: var(--radius-md); display: flex; gap: var(--space-3); align-items: center;">
                    <span class="material-symbols-outlined" style="color: var(--success-600); font-size: 20px;">verified</span>
                    <span style="font-size: var(--text-sm); color: var(--success-800);">
                        All 4 gate conditions verified on @app.PreDeploymentVerifiedAt.Value.ToLocalTime().ToString("dd MMM yyyy").
                        @if (!string.IsNullOrEmpty(app.PreDeploymentNote)) { <span>Note: @app.PreDeploymentNote</span> }
                    </span>
                </div>
            }

            @* Checklist items *@
            @if (!app.PreDeploymentChecklist.Any())
            {
                <div class="card">
                    <div class="card-body text-center" style="color: var(--text-secondary); padding: 2rem;">
                        No checklist items have been seeded. Ask a System Administrator to configure the pre-deployment checklist template.
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in app.PreDeploymentChecklist.OrderBy(i => i.SortOrder))
                {
                    // Match by category across all stages so documents uploaded by the LO
                    // at OfferAccepted/LegalClearance (stage "Other") are visible here too.
                    var itemDocs = !string.IsNullOrEmpty(item.DocumentCategory)
                        ? app.Documents.Where(d => d.Category == item.DocumentCategory).ToList()
                        : new List<CRMS.Application.Namp.DTOs.NampDocumentDto>();

                    <div class="card">
                        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center; gap: var(--space-2);">
                                <span class="material-symbols-outlined" style="font-size: 20px; color: @(item.IsConfirmed == true ? "var(--success-600)" : "var(--gray-400)");">task_alt</span>
                                <div>
                                    <h3 class="card-title" style="margin: 0;">@item.Title</h3>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    { <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 2px;">@item.Description</div> }
                                </div>
                                @if (!item.IsMandatory) { <span class="badge badge-secondary">Optional</span> }
                                @if (item.IsConfirmed == true) { <span class="badge badge-success">Confirmed</span> }
                                else if (item.IsConfirmed == false) { <span class="badge badge-danger">Not Confirmed</span> }
                                else { <span class="badge badge-secondary">Pending</span> }
                            </div>
                            @if (canUploadGateDocs && item.RequiresDocumentUpload && !string.IsNullOrEmpty(item.DocumentCategory))
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => OpenChecklistDocUpload(item.Id, item.DocumentCategory!)">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">upload</span> Upload Document
                                </button>
                            }
                        </div>
                        <div class="card-body">
                            @if (canEditGates)
                            {
                                <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem;">
                                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; font-weight: 500; padding-top: 2px;">
                                        <input type="checkbox"
                                               checked="@(GetItemConfirmed(item.Id) == true)"
                                               @onchange="e => SetItemConfirmed(item.Id, (bool)e.Value!)" />
                                        I confirm this condition has been satisfied
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Notes</label>
                                    <textarea class="form-control" rows="2"
                                              value="@GetItemNote(item.Id)"
                                              @onchange="e => SetItemNote(item.Id, e.Value?.ToString())"
                                              placeholder="Optional notes..."></textarea>
                                </div>
                                @if (!string.IsNullOrEmpty(GetItemError(item.Id)))
                                { <div class="alert alert-danger" style="margin-bottom: 0.5rem;">@GetItemError(item.Id)</div> }
                                <button class="btn btn-secondary btn-sm" @onclick="() => SaveChecklistItem(item.Id)" disabled="@IsItemSaving(item.Id)">
                                    @if (IsItemSaving(item.Id)) { <span class="spinner" style="width: 12px; height: 12px;"></span> }
                                    Save
                                </button>
                            }
                            else if (item.IsConfirmed.HasValue)
                            {
                                <div style="font-size: 0.875rem; color: var(--text-secondary);">
                                    @if (!string.IsNullOrEmpty(item.Notes)) { <span>@item.Notes</span> }
                                    else { <span style="font-style: italic;">No notes recorded.</span> }
                                </div>
                                @if (item.ConfirmedAt.HasValue)
                                {
                                    <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem;">
                                        Confirmed on @item.ConfirmedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>
                                }
                            }

                            @if (itemDocs.Any())
                            {
                                <div style="margin-top: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.5rem;">Uploaded Evidence</div>
                                    @foreach (var doc in itemDocs)
                                    {
                                        var capturedDoc = doc;
                                        var preDeployStage = "PreDeploymentVerification";
                                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid var(--gray-100);">
                                            <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0;">
                                                <span class="material-symbols-outlined" style="font-size: 16px; color: var(--text-secondary); flex-shrink: 0;">@GetDocIcon(capturedDoc.FileName)</span>
                                                <div style="min-width: 0;">
                                                    <div style="font-size: 0.875rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@capturedDoc.FileName</div>
                                                    <div style="font-size: 0.75rem; color: var(--text-secondary);">@capturedDoc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @FormatFileSize(capturedDoc.FileSize)</div>
                                                </div>
                                            </div>
                                            <div style="display: flex; gap: 0.25rem; flex-shrink: 0;">
                                                <button class="btn btn-ghost btn-sm" title="View" @onclick="() => OpenDocView(capturedDoc.Id, capturedDoc.FileName, capturedDoc.ContentType)">
                                                    <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                                </button>
                                                @if (canUploadGateDocs)
                                                {
                                                    <button class="btn btn-ghost btn-sm" title="Edit" @onclick="() => OpenEditDoc(capturedDoc.Id, capturedDoc.Category, capturedDoc.Description, preDeployStage, capturedDoc.FileName, capturedDoc.FileSize, capturedDoc.ContentType)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
                                                    </button>
                                                    <button class="btn btn-ghost btn-sm" title="Delete" style="color: var(--danger-600);" @onclick="() => OpenDeleteDoc(capturedDoc.Id)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @* Checklist document upload modal *@
            @if (showChecklistDocModal)
            {
                <div class="modal-backdrop show" @onclick="CloseChecklistDocModal">
                    <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
                        <div class="modal-header">
                            <h3 class="modal-title">Upload Document</h3>
                            <button class="modal-close" @onclick="CloseChecklistDocModal"><span class="material-symbols-outlined">close</span></button>
                        </div>
                        <div class="modal-body">
                            <InputFile OnChange="OnChecklistDocSelected" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" class="form-control" />
                            @if (checklistDocFile != null)
                            {
                                <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-secondary);">
                                    @checklistDocFile.Name · @FormatFileSize(checklistDocFile.Size)
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(checklistDocError))
                            { <div class="alert alert-danger" style="margin-top: 0.75rem;">@checklistDocError</div> }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CloseChecklistDocModal">Cancel</button>
                            <button class="btn btn-primary" @onclick="UploadChecklistDoc" disabled="@(checklistDocFile == null || isUploadingChecklistDoc)">
                                @if (isUploadingChecklistDoc) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                                Upload
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════
         AI ADVISORY TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "advisory")
    {
        <div class="card">
            <div class="card-body">

                @if (advisoryLoading)
                {
                    <div class="p-4 text-center"><div class="spinner" style="margin: 0 auto;"></div><div class="mt-2 text-muted">Loading advisory…</div></div>
                }
                else if (advisoryGenerating)
                {
                    <div class="p-4 text-center"><div class="spinner" style="margin: 0 auto;"></div><div class="mt-2 text-muted">Generating AI Advisory — this may take up to 30 seconds…</div></div>
                }
                else if (!string.IsNullOrEmpty(advisoryError))
                {
                    <div class="alert alert-danger">@advisoryError</div>
                    <button class="btn btn-secondary btn-sm" @onclick="LoadAdvisory">Retry</button>
                }
                else if (nampAdvisory == null)
                {
                    <div class="p-4 text-center" style="color: var(--text-secondary);">
                        <span class="material-symbols-outlined" style="font-size: 48px; margin-bottom: 12px; display: block; opacity: 0.4;">psychology</span>
                        <div style="font-size: 1rem; font-weight: 600; margin-bottom: 8px;">No Advisory Generated</div>
                        <div style="font-size: 0.875rem; max-width: 420px; margin: 0 auto 16px;">
                            Generate an AI credit advisory combining bureau data, financial appraisal ratios, collateral coverage, and guarantor profiles.
                        </div>
                        @if (CanGenerateAdvisory)
                        {
                            <button class="btn btn-primary" @onclick="GenerateAdvisory">
                                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 6px; vertical-align: middle;">auto_awesome</span>
                                Generate Advisory
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-warning" style="text-align: left; max-width: 460px; margin: 0 auto;">
                                Advisory can only be generated at the Financial Appraisal stage once bureau reports are available.
                            </div>
                        }
                    </div>
                }
                else
                {
                    var circleCircumference = 2 * Math.PI * 32;
                    var scoreFill = (double)nampAdvisory.OverallScore / 100.0;
                    var circleDashOffset = circleCircumference * (1 - scoreFill);
                    var scoreArcColor = nampAdvisory.OverallRating switch
                    {
                        "VeryLow" or "Low" => "#22c55e",
                        "Medium" => "#f59e0b",
                        _ => "#ef4444"
                    };
                    var recPillColor = nampAdvisory.Recommendation switch
                    {
                        "Approve" => "#16a34a",
                        "ConditionalApprove" => "#d97706",
                        "Decline" => "#dc2626",
                        _ => "#64748b"
                    };
                    var recLabel = nampAdvisory.Recommendation switch
                    {
                        "ConditionalApprove" => "Conditional Approve",
                        _ => nampAdvisory.Recommendation
                    };

                    <!-- ── Hero Header ── -->
                    <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 12px; padding: 1.5rem 1.75rem; margin-bottom: 1.5rem; color: white;">
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                            <div style="display: flex; align-items: center; gap: 1.5rem;">
                                <!-- Circular score ring -->
                                <div style="position: relative; width: 80px; height: 80px; flex-shrink: 0;">
                                    <svg viewBox="0 0 80 80" style="width: 80px; height: 80px; transform: rotate(-90deg);">
                                        <circle cx="40" cy="40" r="32" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="7"/>
                                        <circle cx="40" cy="40" r="32" fill="none" stroke="@scoreArcColor" stroke-width="7"
                                                stroke-dasharray="@circleCircumference.ToString("N1")"
                                                stroke-dashoffset="@circleDashOffset.ToString("N1")"
                                                stroke-linecap="round"/>
                                    </svg>
                                    <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1;">
                                        <span style="font-size: 1.3rem; font-weight: 800;">@nampAdvisory.OverallScore.ToString("N0")</span>
                                        <span style="font-size: 0.6rem; opacity: 0.5; margin-top: 1px;">/100</span>
                                    </div>
                                </div>
                                <div>
                                    <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.5; margin-bottom: 3px;">AI Credit Advisory</div>
                                    <div style="font-size: 1.2rem; font-weight: 700; margin-bottom: 8px;">@nampAdvisory.OverallRating Risk Profile</div>
                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                                        <span style="background: @recPillColor; color: white; padding: 3px 12px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;">@recLabel</span>
                                        @if (nampAdvisory.HasCriticalRedFlags)
                                        {
                                            <span style="background: #ef4444; color: white; padding: 3px 12px; border-radius: 20px; font-size: 0.72rem; font-weight: 700;">⚠ Critical Red Flags</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.625rem;">
                                @if (CanGenerateAdvisory)
                                {
                                    <button @onclick="GenerateAdvisory" style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; padding: 5px 12px; font-size: 0.8rem; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 14px;">refresh</span>
                                        Regenerate
                                    </button>
                                }
                                <div style="font-size: 0.68rem; opacity: 0.4; text-align: right; line-height: 1.6;">
                                    @nampAdvisory.GeneratedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")<br/>
                                    @nampAdvisory.ModelVersion
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Recommended Terms (if present) ── -->
                    @if (nampAdvisory.RecommendedAmount.HasValue)
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
                            <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 10px; padding: 1rem; text-align: center;">
                                <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-secondary); margin-bottom: 4px;">Recommended Amount</div>
                                <div style="font-size: 1.05rem; font-weight: 700;">NGN @nampAdvisory.RecommendedAmount.Value.ToString("N0")</div>
                            </div>
                            @if (nampAdvisory.RecommendedTenorMonths.HasValue)
                            {
                                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 10px; padding: 1rem; text-align: center;">
                                    <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-secondary); margin-bottom: 4px;">Tenor</div>
                                    <div style="font-size: 1.05rem; font-weight: 700;">@nampAdvisory.RecommendedTenorMonths months</div>
                                </div>
                            }
                            @if (nampAdvisory.RecommendedInterestRate.HasValue)
                            {
                                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 10px; padding: 1rem; text-align: center;">
                                    <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-secondary); margin-bottom: 4px;">Interest Rate</div>
                                    <div style="font-size: 1.05rem; font-weight: 700;">@nampAdvisory.RecommendedInterestRate.Value.ToString("N2")%</div>
                                </div>
                            }
                        </div>
                    }

                    <!-- ── Risk Score Cards ── -->
                    @if (nampAdvisory.RiskScores.Any())
                    {
                        <div style="margin-bottom: 1.5rem;">
                            <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-secondary); margin-bottom: 0.75rem;">Risk Category Breakdown</div>
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 0.75rem;">
                                @foreach (var score in nampAdvisory.RiskScores)
                                {
                                    var cardColor  = score.Score >= 65 ? "#16a34a" : score.Score >= 40 ? "#d97706" : "#dc2626";
                                    var cardBg     = score.Score >= 65 ? "#f0fdf4" : score.Score >= 40 ? "#fffbeb" : "#fef2f2";
                                    var cardBorder = score.Score >= 65 ? "#bbf7d0" : score.Score >= 40 ? "#fde68a" : "#fecaca";
                                    var cardText   = score.Score >= 65 ? "#14532d" : score.Score >= 40 ? "#78350f" : "#7f1d1d";
                                    <div style="background: @cardBg; border: 1px solid @cardBorder; border-radius: 10px; padding: 1rem;">
                                        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
                                            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-secondary);">@FormatCategoryName(score.Category)</span>
                                            <span style="font-size: 1.15rem; font-weight: 800; color: @cardColor;">@score.Score.ToString("N0")</span>
                                        </div>
                                        <div style="height: 5px; background: rgba(0,0,0,0.07); border-radius: 3px; overflow: hidden; margin-bottom: 6px;">
                                            <div style="height: 100%; width: @(Math.Min(100, score.Score))%; background: @cardColor; border-radius: 3px;"></div>
                                        </div>
                                        <div style="font-size: 0.7rem; font-weight: 700; color: @cardColor; margin-bottom: @(!string.IsNullOrEmpty(score.Rationale) ? "6px" : "0");">@score.Rating Risk</div>
                                        @if (!string.IsNullOrEmpty(score.Rationale))
                                        {
                                            <div style="font-size: 0.72rem; color: @cardText; line-height: 1.45; opacity: 0.85;">@score.Rationale</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- ── Critical Red Flags ── -->
                    @if (nampAdvisory.HasCriticalRedFlags && nampAdvisory.RedFlags.Any())
                    {
                        <div style="background: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #ef4444; border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
                            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 0.5rem;">
                                <span class="material-symbols-outlined" style="font-size: 16px; color: #991b1b;">warning</span>
                                <span style="font-size: 0.78rem; font-weight: 700; color: #991b1b; text-transform: uppercase; letter-spacing: 0.05em;">Critical Red Flags</span>
                            </div>
                            <ul style="margin: 0; padding-left: 18px; font-size: 0.85rem; color: #7f1d1d; line-height: 1.8;">
                                @foreach (var flag in nampAdvisory.RedFlags) { <li>@flag</li> }
                            </ul>
                        </div>
                    }

                    <!-- ── Executive Summary ── -->
                    @if (!string.IsNullOrEmpty(nampAdvisory.ExecutiveSummary))
                    {
                        <div style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.25rem; margin-bottom: 1.25rem;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.75rem;">
                                <span class="material-symbols-outlined" style="font-size: 17px; color: #6366f1;">summarize</span>
                                <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #6366f1;">Executive Summary</span>
                            </div>
                            <div style="font-size: 0.9rem; line-height: 1.75; color: var(--text-primary);">@nampAdvisory.ExecutiveSummary</div>
                        </div>
                    }

                    <!-- ── Strengths & Weaknesses ── -->
                    @if (!string.IsNullOrEmpty(nampAdvisory.StrengthsAnalysis) || !string.IsNullOrEmpty(nampAdvisory.WeaknessesAnalysis))
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                            @if (!string.IsNullOrEmpty(nampAdvisory.StrengthsAnalysis))
                            {
                                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 1.1rem;">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 0.625rem;">
                                        <span class="material-symbols-outlined" style="font-size: 16px; color: #16a34a;">thumb_up</span>
                                        <span style="font-size: 0.72rem; font-weight: 700; color: #166534; text-transform: uppercase; letter-spacing: 0.06em;">Strengths</span>
                                    </div>
                                    <div style="font-size: 0.875rem; line-height: 1.65; color: #166534;">@nampAdvisory.StrengthsAnalysis</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(nampAdvisory.WeaknessesAnalysis))
                            {
                                <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 1.1rem;">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 0.625rem;">
                                        <span class="material-symbols-outlined" style="font-size: 16px; color: #dc2626;">thumb_down</span>
                                        <span style="font-size: 0.72rem; font-weight: 700; color: #991b1b; text-transform: uppercase; letter-spacing: 0.06em;">Weaknesses</span>
                                    </div>
                                    <div style="font-size: 0.875rem; line-height: 1.65; color: #991b1b;">@nampAdvisory.WeaknessesAnalysis</div>
                                </div>
                            }
                        </div>
                    }

                    <!-- ── Mitigating Factors & Key Risks ── -->
                    @if (!string.IsNullOrEmpty(nampAdvisory.MitigatingFactors) || !string.IsNullOrEmpty(nampAdvisory.KeyRisks))
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                            @if (!string.IsNullOrEmpty(nampAdvisory.MitigatingFactors))
                            {
                                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 1.1rem;">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 0.625rem;">
                                        <span class="material-symbols-outlined" style="font-size: 16px; color: #2563eb;">shield</span>
                                        <span style="font-size: 0.72rem; font-weight: 700; color: #1e40af; text-transform: uppercase; letter-spacing: 0.06em;">Mitigating Factors</span>
                                    </div>
                                    <div style="font-size: 0.875rem; line-height: 1.65; color: #1e3a8a;">@nampAdvisory.MitigatingFactors</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(nampAdvisory.KeyRisks))
                            {
                                <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 1.1rem;">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 0.625rem;">
                                        <span class="material-symbols-outlined" style="font-size: 16px; color: #d97706;">report_problem</span>
                                        <span style="font-size: 0.72rem; font-weight: 700; color: #92400e; text-transform: uppercase; letter-spacing: 0.06em;">Key Risks</span>
                                    </div>
                                    <div style="font-size: 0.875rem; line-height: 1.65; color: #78350f;">@nampAdvisory.KeyRisks</div>
                                </div>
                            }
                        </div>
                    }

                    <!-- ── Conditions & Covenants ── -->
                    @if (nampAdvisory.Conditions.Any() || nampAdvisory.Covenants.Any())
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            @if (nampAdvisory.Conditions.Any())
                            {
                                <div style="border: 1px solid #e9d5ff; background: #faf5ff; border-radius: 10px; padding: 1.1rem;">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 0.75rem;">
                                        <span class="material-symbols-outlined" style="font-size: 16px; color: #7c3aed;">checklist</span>
                                        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #6d28d9;">Precedent Conditions</span>
                                    </div>
                                    <ol style="margin: 0; padding-left: 18px; font-size: 0.85rem; line-height: 1.85; color: #4c1d95;">
                                        @foreach (var c in nampAdvisory.Conditions) { <li>@c</li> }
                                    </ol>
                                </div>
                            }
                            @if (nampAdvisory.Covenants.Any())
                            {
                                <div style="border: 1px solid #a5f3fc; background: #ecfeff; border-radius: 10px; padding: 1.1rem;">
                                    <div style="display: flex; align-items: center; gap: 7px; margin-bottom: 0.75rem;">
                                        <span class="material-symbols-outlined" style="font-size: 16px; color: #0891b2;">gavel</span>
                                        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #0e7490;">Ongoing Covenants</span>
                                    </div>
                                    <ol style="margin: 0; padding-left: 18px; font-size: 0.85rem; line-height: 1.85; color: #164e63;">
                                        @foreach (var c in nampAdvisory.Covenants) { <li>@c</li> }
                                    </ol>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         LOAN ACCOUNT TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "loan-account")
    {
        <div style="display: flex; justify-content: flex-end; margin-bottom: var(--space-3);">
            <button class="btn btn-outline btn-sm" @onclick='() => LoadLoanAccountTab(force: true)' disabled="@isLoadingLoanAccount">
                <span class="material-symbols-outlined" style="font-size: 16px;">refresh</span>
                Refresh
            </button>
        </div>
        @if (isLoadingLoanAccount)
        {
            <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
        }
        else if (!string.IsNullOrEmpty(loanAccountError))
        {
            <div class="alert alert-danger">@loanAccountError</div>
        }
        else if (loanAccount != null)
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <!-- Header card -->
                <div class="card">
                    <div class="card-body">
                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;">
                            <div>
                                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Loan Account No.</div>
                                <div style="font-weight: 700; font-size: 0.9rem; font-family: monospace;">@loanAccount.AccountNo</div>
                            </div>
                            <div>
                                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">CBA Loan Status</div>
                                <div style="font-weight: 600; font-size: 0.875rem;">@loanAccount.Status</div>
                            </div>
                            <div>
                                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Disbursement Date</div>
                                <div style="font-weight: 500; font-size: 0.875rem;">@(loanAccount.DisbursementDate?.ToString("dd MMM yyyy") ?? "—")</div>
                            </div>
                            <div>
                                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Maturity Date</div>
                                <div style="font-weight: 500; font-size: 0.875rem;">@(loanAccount.MaturityDate?.ToString("dd MMM yyyy") ?? "—")</div>
                            </div>
                        </div>

                        @if (app.Status == "Active" && FineractLoanIsClosed)
                        {
                            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem;">
                                <span class="material-symbols-outlined" style="color: var(--success-600); font-size: 20px;">check_circle</span>
                                <span style="font-size: 0.875rem; color: var(--success-700);">The CBA reports this loan as closed. Mark the CRMS application as Closed to complete the lifecycle.</span>
                                <button class="btn btn-success btn-sm" @onclick="MarkAsClosed" disabled="@isMarkingClosed">
                                    @if (isMarkingClosed) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                                    Mark as Closed
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Summary card -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Loan Summary</h3></div>
                    <div class="card-body">
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                @LoanSummaryRow("Principal Disbursed", loanAccount.PrincipalDisbursed)
                                @LoanSummaryRow("Principal Paid", loanAccount.PrincipalPaid)
                                @LoanSummaryRow("Principal Outstanding", loanAccount.PrincipalOutstanding, highlight: loanAccount.PrincipalOutstanding > 0)
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                @LoanSummaryRow("Interest Charged", loanAccount.InterestCharged)
                                @LoanSummaryRow("Interest Paid", loanAccount.InterestPaid)
                                @LoanSummaryRow("Interest Outstanding", loanAccount.InterestOutstanding, highlight: loanAccount.InterestOutstanding > 0)
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                @LoanSummaryRow("Total Expected", loanAccount.TotalExpectedRepayment)
                                @LoanSummaryRow("Total Repaid", loanAccount.TotalRepayment)
                                @LoanSummaryRow("Total Outstanding", loanAccount.TotalOutstanding, highlight: loanAccount.TotalOutstanding > 0)
                                @if (loanAccount.PenaltyChargesOutstanding > 0)
                                {
                                    @LoanSummaryRow("Penalty Outstanding", loanAccount.PenaltyChargesOutstanding, highlight: true, danger: true)
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Repayment schedule -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Repayment Schedule</h3></div>
                    <div class="card-body" style="padding: 0;">
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Due Date</th>
                                        <th style="text-align: right;">Principal Due</th>
                                        <th style="text-align: right;">Interest Due</th>
                                        <th style="text-align: right;">Total Due</th>
                                        <th style="text-align: right;">Total Paid</th>
                                        <th style="text-align: right;">Outstanding</th>
                                        <th style="text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var period in loanAccount.Schedule)
                                    {
                                        var rowStyle = period.IsOverdue
                                            ? "background: var(--warning-50);"
                                            : period.Complete ? "opacity: 0.7;" : "";
                                        <tr style="@rowStyle">
                                            <td>@period.Period</td>
                                            <td>@period.DueDate.ToString("dd MMM yyyy")</td>
                                            <td style="text-align: right; font-family: monospace;">₦@period.PrincipalDue.ToString("N0")</td>
                                            <td style="text-align: right; font-family: monospace;">₦@period.InterestDue.ToString("N0")</td>
                                            <td style="text-align: right; font-family: monospace; font-weight: 600;">₦@period.TotalDue.ToString("N0")</td>
                                            <td style="text-align: right; font-family: monospace; color: var(--success-700);">₦@period.TotalPaid.ToString("N0")</td>
                                            <td style="text-align: right; font-family: monospace; @(period.TotalOutstanding > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">₦@period.TotalOutstanding.ToString("N0")</td>
                                            <td style="text-align: center;">
                                                @if (period.Complete)
                                                {
                                                    <span class="badge badge-success">Paid</span>
                                                }
                                                else if (period.IsOverdue)
                                                {
                                                    <span class="badge badge-warning">Overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ══════════════════════════════════════════════
         WORKFLOW TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "workflow")
    {
        <div class="card">
            <div class="card-body">
                @if (!app.StatusHistory.Any())
                {
                    <div class="p-4 text-center text-muted">No status history recorded.</div>
                }
                else
                {
                    <div style="position: relative;">
                        @foreach (var h in app.StatusHistory.OrderByDescending(x => x.ChangedAt))
                        {
                            <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: flex-start;">
                                <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--primary-500); flex-shrink: 0; margin-top: 6px;"></div>
                                <div style="flex: 1;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <span class="badge @GetStatusBadgeClass(h.Status)">@FormatStatus(h.Status)</span>
                                        <span style="font-size: 0.8rem; color: var(--text-secondary);">@h.ChangedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.Note))
                                    {
                                        <div style="font-size: 0.875rem; margin-top: 0.375rem; color: var(--text-secondary); padding: 0.5rem 0.75rem; background: var(--gray-50); border-radius: var(--radius-sm); border-left: 3px solid var(--primary-200);">@h.Note</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }


<!-- ══════════════════════════════════════════════
     MODALS (unchanged)
══════════════════════════════════════════════ -->

<!-- Simple Confirm Modal -->
@if (showConfirmModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 440px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@modalTitle</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <p>@modalMessage</p>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger" style="margin-top: 0.75rem;">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-primary" @onclick="ExecuteConfirm" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<!-- Note Modal -->
@if (showNoteModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@modalTitle</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">@modalMessage</label>
                    <textarea class="form-control" rows="3" @bind="noteText" placeholder="Enter notes..."></textarea>
                </div>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-primary" @onclick="ExecuteNoteAction" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<!-- Appraisal Modal -->
@if (showAppraisalModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 500px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@modalTitle</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Decision *</label>
                    <div style="display: flex; gap: 1rem;">
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                            <input type="radio" name="appraisal-decision" @onchange="() => appraisalApproved = true" checked="@appraisalApproved" />
                            <span class="badge badge-success">Approve</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                            <input type="radio" name="appraisal-decision" @onchange="() => appraisalApproved = false" checked="@(!appraisalApproved)" />
                            <span class="badge badge-danger">Decline</span>
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Notes @(appraisalApproved ? "" : "*")</label>
                    <textarea class="form-control" rows="3" @bind="noteText" placeholder="@(appraisalApproved ? "Optional notes..." : "Required — state reason for declining")"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn @(appraisalApproved ? "btn-success" : "btn-danger")" @onclick="ExecuteAppraisal" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    @(appraisalApproved ? "Approve" : "Decline")
                </button>
            </div>
        </div>
    </div>
}

<!-- Committee Circulation Modal -->
@if (showCommitteeModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 600px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Circulate to @app!.CommitteeTier Committee</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="alert alert-danger">@modalError</div>
                }
                else
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Required Votes</div>
                            <div style="font-weight: 600;">@committeeRequiredVotes</div>
                        </div>
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Min. Approval Votes</div>
                            <div style="font-weight: 600;">@committeeMinApprovalVotes</div>
                        </div>
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Deadline</div>
                            <div style="font-weight: 600;">@committeeDeadlineHours hours</div>
                        </div>
                    </div>
                    @if (committeeMembers.Count > 0)
                    {
                        <div style="font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem;">Members (@committeeMembers.Count)</div>
                        <table class="table">
                            <thead><tr><th>Member</th><th>Role</th><th>Chair?</th></tr></thead>
                            <tbody>
                                @foreach (var m in committeeMembers)
                                {
                                    <tr>
                                        <td>@m.UserName</td>
                                        <td>@m.Role</td>
                                        <td>@(m.IsChairperson ? "Yes" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">No members configured for this standing committee. Add members in Admin &gt; Committees first.</div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-primary" @onclick="ExecuteCirculate"
                    disabled="@(isProcessing || !string.IsNullOrEmpty(modalError) || committeeMembers.Count == 0)">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Circulate
                </button>
            </div>
        </div>
    </div>
}

<!-- Ratify Modal -->
@if (showRatifyModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Ratify Committee Decision</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <p>
                    Ratifying this decision will <strong>generate the NAMP Offer Letter</strong> as a PDF and make it available for download.
                    The applicant will proceed to offer acceptance once you confirm.
                </p>
                <div class="form-group">
                    <label class="form-label">Note <span class="text-muted">(optional)</span></label>
                    <textarea class="form-control" rows="3" @bind="ratifyNote" placeholder="Any remarks or conditions for the ratification record..."></textarea>
                </div>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-success" @onclick="ExecuteRatify" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Ratify &amp; Generate Offer Letter
                </button>
            </div>
        </div>
    </div>
}

<!-- Financial Appraisal Decision Modal -->
@if (showFinDecisionModal)
{
    var finDocs2 = app!.Documents.Where(d => d.Stage == "FinancialAppraisal").ToList();
    var hasFinDoc = finDocs2.Any(d => d.Category == "CreditReport");
    var blocked = app.FinancialAppraisalReport == null || !hasFinDoc;
    <div class="modal-backdrop show" @onclick="CloseFinDecisionModal">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Financial Appraisal Decision</h3>
                <button class="modal-close" @onclick="CloseFinDecisionModal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                @if (blocked)
                {
                    <div class="alert alert-warning">
                        <strong>Cannot submit decision yet:</strong>
                        <ul style="margin: 0.5rem 0 0 1rem; padding: 0;">
                            @if (app.FinancialAppraisalReport == null) { <li>Save the financial appraisal report first.</li> }
                            @if (!hasFinDoc) { <li>Upload at least one document categorised as <strong>Financial Model</strong>.</li> }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Decision *</label>
                        <div style="display: flex; gap: 1rem;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="fin-decision" @onchange="() => finDecisionApproved = true" checked="@finDecisionApproved" />
                                <span class="badge badge-success">Approve</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="fin-decision" @onchange="() => finDecisionApproved = false" checked="@(!finDecisionApproved)" />
                                <span class="badge badge-danger">Decline</span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Decision Note @(finDecisionApproved ? "(optional)" : "*")</label>
                        <textarea class="form-control" rows="3" @bind="finDecisionNote"
                            placeholder="@(finDecisionApproved ? "Optional notes..." : "Required — state reason for declining")"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(finDecisionError))
                    { <div class="alert alert-danger">@finDecisionError</div> }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseFinDecisionModal">Cancel</button>
                @if (!blocked)
                {
                    <button class="btn @(finDecisionApproved ? "btn-success" : "btn-danger")" @onclick="SubmitFinDecision" disabled="@isSubmittingFinDecision">
                        @if (isSubmittingFinDecision) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                        @(finDecisionApproved ? "Approve — Pass to Committee" : "Decline Application")
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Document View Modal -->
@if (showDocViewModal)
{
    <div class="modal-backdrop show" style="z-index: 1100;" @onclick="CloseDocView">
        <div class="modal" style="max-width: 860px; height: 90vh; display: flex; flex-direction: column; z-index: 1101;" @onclick:stopPropagation>
            <div class="modal-header" style="flex-shrink: 0;">
                <h3 class="modal-title" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 700px;">@viewDocName</h3>
                <button class="modal-close" @onclick="CloseDocView"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div style="flex: 1; overflow: hidden; background: var(--gray-100);">
                @if (viewDocContentType.StartsWith("image/"))
                {
                    <div style="height: 100%; display: flex; align-items: center; justify-content: center; padding: 1rem;">
                        <img src="@viewDocUrl" alt="@viewDocName" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                    </div>
                }
                else if (viewDocContentType == "application/pdf" || viewDocContentType.Contains("pdf"))
                {
                    <iframe src="@viewDocUrl" style="width: 100%; height: 100%; border: none;"></iframe>
                }
                else
                {
                    <div style="height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: var(--text-secondary);">
                        <span class="material-symbols-outlined" style="font-size: 64px; opacity: 0.4;">insert_drive_file</span>
                        <div style="font-size: 0.875rem;">Preview not available for this file type.</div>
                        <a href="@viewDocUrl" target="_blank" class="btn btn-primary btn-sm">
                            <span class="material-symbols-outlined" style="font-size: 16px;">open_in_new</span> Open in new tab
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Edit Document Modal (metadata + optional file replacement) -->
@if (showEditDocModal)
{
    <div class="modal-backdrop show" @onclick="CloseEditDoc">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Edit Document</h3>
                <button class="modal-close" @onclick="CloseEditDoc"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                @if (editDocStage != "PreDeploymentVerification")
                {
                    <div class="form-group">
                        <label class="form-label">Category *</label>
                        <select class="form-control" @bind="editDocCategory">
                            <option value="TechnicalReport">Technical Report</option>
                            <option value="SitePhoto">Site Photo</option>
                            <option value="SoilTestResult">Soil Test Result</option>
                            <option value="FinancialModel">Financial Model</option>
                            <option value="CreditReport">Credit Report</option>
                            <option value="SupportingDocument">Supporting Document</option>
                            <option value="General">General</option>
                        </select>
                    </div>
                }
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" @bind="editDocDescription" placeholder="Optional description..." />
                </div>
                <div class="form-group">
                    <label class="form-label">Current file</label>
