                            <div style="font-size: 0.75rem; color: var(--text-secondary);">@FormatFileSize(editDocExistingFileSize)</div>
                        </div>
                        <button class="btn btn-ghost btn-sm" title="Preview" @onclick="() => OpenDocView(editDocId, editDocExistingFileName, editDocExistingContentType)" style="flex-shrink: 0;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
