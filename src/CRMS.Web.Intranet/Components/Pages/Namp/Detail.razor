    private void CloseEditDoc() { showEditDocModal = false; editDocError = null; }

    private async Task HandleEditDocFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024) { editDocError = "File exceeds 10MB limit."; editDocNewFile = null; editDocNewFileBytes = null; return; }
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            editDocNewFileBytes = ms.ToArray();
            editDocNewFile = file;
            editDocError = null;
        }
        catch (Exception ex) { editDocError = $"Error reading file: {ex.Message}"; editDocNewFile = null; editDocNewFileBytes = null; }
    }

    private async Task SaveDocEdit()
    {
        isSavingDocEdit = true; editDocError = null;
        var uid = User?.Id ?? Guid.Empty;
        try
        {
            if (editDocNewFile != null && editDocNewFileBytes != null)
            {
                // Upload new file, then delete old one
                using var ms = new MemoryStream(editDocNewFileBytes);
                var uploadResult = await AppService.UploadNampDocumentAsync(
                    Id, uid, editDocStage,
                    editDocNewFile.Name, editDocNewFile.ContentType, editDocNewFile.Size,
                    ms, editDocCategory, NullIfEmpty(editDocDescription));
                if (!uploadResult.Success) { editDocError = uploadResult.Error ?? "Upload failed"; return; }
                await AppService.DeleteNampDocumentAsync(Id, editDocId, uid);
            }
            else
            {
                // Metadata-only update
                var result = await AppService.UpdateNampDocumentAsync(editDocId, uid, editDocCategory, NullIfEmpty(editDocDescription));
                if (!result.Success) { editDocError = result.Error ?? "Save failed"; return; }
            }
            CloseEditDoc(); await Load();
        }
        finally { isSavingDocEdit = false; }
    }

