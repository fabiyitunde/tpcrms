    private async Task ExecuteCirculate()
    {
        if (committeeMembers.Count == 0) { modalError = "Add at least one committee member."; return; }
        if (committeeRequiredVotes < 1 || committeeMinApprovalVotes < 1) { modalError = "Vote counts must be at least 1."; return; }
        if (committeeMinApprovalVotes > committeeRequiredVotes) { modalError = "Minimum approval votes cannot exceed required votes."; return; }
        isProcessing = true; modalError = null;
        try
        {
            var result = await AppService.CirculateNampToCommitteeAsync(
                Id, User?.Id ?? Guid.Empty,
                committeeMembers,
                committeeRequiredVotes, committeeMinApprovalVotes, committeeDeadlineHours);
            if (result.Success) { CloseModals(); await Load(); }
            else modalError = result.Error ?? "Circulation failed";
        }
        finally { isProcessing = false; }
