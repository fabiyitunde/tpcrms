                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: var(--space-2);">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary-600);">folder_open</span>
                        <div>
                            <h3 class="card-title" style="margin: 0;">Supporting Documents</h3>
                            <div style="font-size: var(--text-xs); color: var(--gray-500); margin-top: 2px;">Pre-deployment documents uploaded by Loan Officer</div>
