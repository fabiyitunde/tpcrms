                <button class="btn btn-secondary" @onclick="CloseDirectorModals">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveAddDirector" disabled="@(isSavingDirector || string.IsNullOrWhiteSpace(newDirName))">
                    @if (isSavingDirector) { <span class="spinner"></span> }
                    Add
                </button>
            </div>
        </div>
    </div>
}

@if (editingDirector is not null)
{
    <div class="modal-backdrop show" @onclick="CloseDirectorModals">
        <div class="modal" style="max-width: 420px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Complete Info — @editingDirector.FullName</h3>
                <button class="modal-close" @onclick="CloseDirectorModals">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: 0.75rem;">
                    Fill in the BVN and shareholding that were not available from CAC. These are preserved if CAC is refreshed.
                </p>
                <div class="form-group">
                    <label class="form-label">BVN</label>
                    <input class="form-control" @bind="editDirBvn" placeholder="11-digit BVN" maxlength="11" />
                    @if (!string.IsNullOrEmpty(editDirBvn) && editDirBvn.Length != 11)
                    {
                        <div class="form-error" style="font-size: var(--text-xs); color: var(--danger-600);">BVN must be exactly 11 digits</div>
                    }
                </div>
                <div class="form-group">
                    <label class="form-label">Shareholding % (0–100)</label>
                    <input type="number" class="form-control" @bind="editDirShareholding" min="0" max="100" step="0.01" />
                </div>
                @if (!string.IsNullOrEmpty(directorError))
                {
                    <div class="alert alert-danger" style="font-size: var(--text-sm);">@directorError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDirectorModals">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveDirectorEdit" disabled="@isSavingDirector">
                    @if (isSavingDirector) { <span class="spinner"></span> }
                    Save
                </button>
            </div>
        </div>
    </div>
}

