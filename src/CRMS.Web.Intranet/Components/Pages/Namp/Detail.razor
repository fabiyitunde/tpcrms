    private void OpenSubmitModal() => OpenConfirmModal("submit", "Submit for Financial Appraisal", "Submit this application to the Credit Officer for financial appraisal? Credit bureau checks will be queued automatically.");
    private async Task HandleCastVote()
    {
        if (string.IsNullOrEmpty(selectedVote) || app?.CurrentCommitteeReviewId == null) return;
        var uid = User?.Id;
        if (uid == null) return;
        isCastingVote = true;
        voteError = null;
        var result = await AppService.CastNampCommitteeVoteAsync(
            app.CurrentCommitteeReviewId.Value, uid.Value, selectedVote,
            string.IsNullOrWhiteSpace(voteComment) ? null : voteComment);
        if (result.Success && result.Data != null)
        {
            committeeReview = result.Data;
            selectedVote = "";
            voteComment = "";
        }
        else
        {
            voteError = result.Error ?? "Failed to cast vote.";
        }
        isCastingVote = false;
    }

