    private async Task SubmitTechDecision()
    {
        if (!techDecisionApproved && string.IsNullOrWhiteSpace(techDecisionNote))
        { techDecisionError = "A note is required when declining."; return; }

        // Domain rule: NotViable viability forces a Decline decision
        if (techViabilityRating == "NotViable" && techDecisionApproved)
        { techDecisionError = "Cannot approve — viability is rated Not Viable. Change the rating or select Decline."; return; }

        if (string.IsNullOrWhiteSpace(techFarmLocation) || string.IsNullOrWhiteSpace(techSoilRating) ||
            string.IsNullOrWhiteSpace(techWaterSource) || string.IsNullOrWhiteSpace(techEquipSuitability) ||
            string.IsNullOrWhiteSpace(techViabilityRating))
        {
            techDecisionError = "Complete and save the report before submitting a decision.";
            return;
        }

        isSubmittingTechDecision = true; techDecisionError = null;
        try
        {
            var saveResult = await AppService.SaveNampTechnicalAppraisalReportAsync(
                Id, User?.Id ?? Guid.Empty,
                techFarmLocation, NullIfEmpty(techGpsCoords), techLandArea,
                techSoilRating, techWaterSource, techEquipSuitability,
                NullIfEmpty(techInfraNotes), NullIfEmpty(techRisks), NullIfEmpty(techMitigations),
                techViabilityRating, techDecisionApproved ? "Pass" : "Fail",
                NullIfEmpty(techSummaryNotes));
            if (!saveResult.Success) { techDecisionError = saveResult.Error ?? "Failed to save report"; return; }

            var result = await AppService.SubmitNampTechnicalAppraisalAsync(Id, User?.Id ?? Guid.Empty, techDecisionApproved, NullIfEmpty(techDecisionNote));
            if (result.Success) { showTechDecisionModal = false; await Load(); }
            else techDecisionError = result.Error ?? "Decision submission failed";
        }
        finally { isSubmittingTechDecision = false; }
    }

