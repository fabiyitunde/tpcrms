    private static string ExtractReadableError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error)) return string.Empty;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(error);
            var root = doc.RootElement;
            foreach (var key in new[] { "message", "error", "description", "detail", "msg" })
            {
                if (root.TryGetProperty(key, out var val) && val.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var s = val.GetString();
                    if (!string.IsNullOrWhiteSpace(s)) return s;
                }
            }
            // If it's JSON but no known key, return a generic message
            return "An error occurred during the credit check. See tooltip for details.";
        }
        catch
        {
            return error;
        }
    }
