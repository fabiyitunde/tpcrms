                    </div>
                    <button class="btn btn-outline" @onclick="OpenLoDocUpload">
                        <span class="material-symbols-outlined" style="font-size: 16px;">upload_file</span>
                        Upload Document
                    </button>
                    @if (app.Documents.Any(d => d.Stage == "Other"))
                    {
                        <div style="margin-top: var(--space-4);">
                            <div style="font-size: var(--text-sm); font-weight: 600; color: var(--gray-700); margin-bottom: var(--space-2);">Uploaded Documents</div>
                            @foreach (var doc in app.Documents.Where(d => d.Stage == "Other").OrderByDescending(d => d.UploadedAt))
                            {
                                <div style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) 0; border-bottom: 1px solid var(--gray-100);">
                                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--gray-400);">description</span>
                                    <div style="flex: 1; min-width: 0;">
