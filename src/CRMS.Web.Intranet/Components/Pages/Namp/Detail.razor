                                    {
                                        <span class="badge badge-success" style="font-size: 10px;">Accepted</span>
                                    }
                                    else if (app.OfferLapsedAt.HasValue)
                                    {
                                        <span class="badge badge-secondary" style="font-size: 10px;">Lapsed</span>
                                    }
                                    else
