@code {
    [Parameter] public Guid Id { get; set; }

    private NampApplicationDto? app;
    private bool isLoading = true;
    private string? actionError;
    private string detailTab = "overview";

    // Modal state
    private bool showConfirmModal;
    private bool showNoteModal;
    private bool showAppraisalModal;
    private bool showCommitteeModal;
    private bool showRatifyModal;
    private bool showDeploymentModal;
    private bool isProcessing;
    private string modalTitle = "";
    private string modalMessage = "";
    private string? modalError;
    private string pendingAction = "";
    private string noteText = "";
    private bool appraisalApproved = true;
    private string appraisalType = "";
    private string ratifyOfferPath = "";
    private bool deployGpsActivated = true;

    // Committee modal
    private List<NampCommitteeMemberInput> committeeMembers = [];
    private int committeeRequiredVotes = 3;
    private int committeeMinApprovalVotes = 2;
    private int committeeDeadlineHours = 72;

    // Technical Appraisal form
    private string techFarmLocation = "";
    private string? techGpsCoords;
    private decimal? techLandArea;
    private string techSoilRating = "";
    private string techWaterSource = "";
    private string techEquipSuitability = "";
    private string? techInfraNotes;
    private string? techRisks;
    private string? techMitigations;
    private string techViabilityRating = "";
    private string? techSummaryNotes;
    private bool isSavingTechReport;
    private string? techReportError;
    private bool techDecisionApproved = true;
    private string? techDecisionNote;
    private bool isSubmittingTechDecision;
    private string? techDecisionError;
    private bool showTechDecisionModal;
    private bool showFinDecisionModal;

    // Financial Appraisal form
    private decimal? finMonthlyIncome;
    private decimal? finDscr;
    private decimal? finLtv;
    private string finRepaymentRating = "";
    private string? finEquityNote;
    private string? finBureauSummary;
    private string finCreditRecommendation = "";
    private string? finSummaryNotes;
    private bool isSavingFinReport;
    private string? finReportError;
    private bool finDecisionApproved = true;
    private string? finDecisionNote;
    private bool isSubmittingFinDecision;
    private string? finDecisionError;

    // Document upload / replace
    private bool showTechDocUploadModal;
    private bool showFinDocUploadModal;
    private string uploadDocCategory = "TechnicalReport";
    private string? uploadDocDescription;
    private IBrowserFile? uploadSelectedFile;
    private byte[]? uploadFileBytes;
    private bool isUploadingDoc;
    private string? uploadDocError;
    // Document view modal
    private bool showDocViewModal;
    private string viewDocUrl = "";
    private string viewDocName = "";
    private string viewDocContentType = "";

    // Edit document modal (metadata + optional file replacement)
    private bool showEditDocModal;
    private Guid editDocId;
    private string editDocCategory = "";
    private string? editDocDescription;
    private string editDocStage = "";
    private string editDocExistingFileName = "";
    private long editDocExistingFileSize;
    private string editDocExistingContentType = "";
    private IBrowserFile? editDocNewFile;
    private byte[]? editDocNewFileBytes;
    private bool isSavingDocEdit;
    private string? editDocError;

    // Delete document
    private bool showDeleteDocModal;
    private Guid deleteDocId;
    private bool isDeletingDoc;
    private string? deleteDocError;

    private UserInfo? User => AuthService.CurrentUser;

    // ── Role-gated action visibility ──────────────────────────────────────

    private bool ShowSubmitButton =>
        app?.Status == "Draft" &&
        (User?.HasAnyRole("LoanOfficer", "SystemAdmin") ?? false);

    private bool ShowTechnicalAppraisalButton =>
        (app?.Status == "Submitted" || app?.Status == "TechnicalAppraisal") &&
        (User?.HasAnyRole("AgriculturalEngineer", "SystemAdmin") ?? false);

    private bool ShowFinancialAppraisalButton =>
        app?.Status == "FinancialAppraisal" &&
        (User?.HasAnyRole("CreditOfficer", "SystemAdmin") ?? false);

    private bool ShowTechnicalAppraisalTab =>
        app?.Status is "Submitted" or "TechnicalAppraisal" or "TechnicalDeclined" ||
        IsAfter(app!, "TechnicalAppraisal") ||
        app?.TechnicalAppraisalReport != null;

    private bool ShowFinancialAppraisalTab =>
        app?.Status == "FinancialAppraisal" || app?.Status == "FinancialDeclined" ||
        IsAfter(app!, "FinancialAppraisal") ||
        app?.FinancialAppraisalReport != null;

    private bool TechDecisionBlocked =>
        app?.TechnicalAppraisalReport == null ||
        !app.Documents.Any(d => d.Stage == "TechnicalAppraisal" && d.Category == "TechnicalReport");

    private bool FinDecisionBlocked =>
        app?.FinancialAppraisalReport == null ||
        !app.Documents.Any(d => d.Stage == "FinancialAppraisal" && d.Category == "CreditReport");

    private bool IsCommitteeStatus => app?.Status is
        "BranchCommitteeCirculation" or "ZonalCommitteeCirculation" or
        "RegionalCommitteeCirculation" or "HOCommitteeCirculation";

    private bool ShowCirculateButton =>
        IsCommitteeStatus && app?.CurrentCommitteeReviewId == null &&
        (User?.HasAnyRole("CreditOfficer", "SystemAdmin") ?? false);

    private bool ShowRecordOutcomeButton =>
        IsCommitteeStatus && app?.CurrentCommitteeReviewId != null &&
        (IsCommitteeMemberForCurrentStatus || (User?.HasRole("SystemAdmin") ?? false));

    private bool IsCommitteeMemberForCurrentStatus => app?.Status switch
    {
        "BranchCommitteeCirculation"   => User?.HasRole("BranchCommitteeMember") ?? false,
        "ZonalCommitteeCirculation"    => User?.HasRole("ZonalCommitteeMember") ?? false,
        "RegionalCommitteeCirculation" => User?.HasRole("RegionalCommitteeMember") ?? false,
        "HOCommitteeCirculation"       => User?.HasRole("HOCommitteeMember") ?? false,
        _                              => false
    };

    private bool ShowRatifyButton =>
        app?.Status == "Ratification" &&
        (IsRatifierForCurrentTier || (User?.HasRole("SystemAdmin") ?? false));

    private bool IsRatifierForCurrentTier => app?.CommitteeTier switch
    {
        "Branch"     => User?.HasRole("BranchManager") ?? false,
        "Zonal"      => User?.HasRole("ZonalManager") ?? false,
        "Regional"   => User?.HasRole("RegionalManager") ?? false,
        "HeadOffice" => User?.HasRole("MdCeo") ?? false,
        _            => false
    };

    private bool ShowOfferButtons =>
        app?.Status == "OfferGenerated" &&
        (User?.HasAnyRole("LoanOfficer", "SystemAdmin") ?? false);

    private bool ShowBeginPreDeploymentButton =>
        app?.Status == "OfferAccepted" &&
        (User?.HasAnyRole("ComplianceOfficer", "SystemAdmin") ?? false);

    private bool ShowCompletePreDeploymentButton =>
        app?.Status == "PreDeploymentVerification" &&
        (User?.HasAnyRole("ComplianceOfficer", "SystemAdmin") ?? false);

    private bool ShowTrainingButton =>
        app?.Status == "Training" &&
        (User?.HasAnyRole("TrainingCoordinator", "SystemAdmin") ?? false);

    private bool ShowDeploymentButton =>
        app?.Status == "Deployment" &&
        (User?.HasAnyRole("DeploymentOfficer", "SystemAdmin") ?? false);

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        try
        {
            app = await AppService.GetNampApplicationByIdAsync(Id);
            if (app != null) PopulateFormFields();
        }
        finally { isLoading = false; }
    }

    private void PopulateFormFields()
    {
        if (app == null) return;
        var tr = app.TechnicalAppraisalReport;
        if (tr != null)
        {
            techFarmLocation = tr.FarmLocationDescription;
            techGpsCoords = tr.GpsCoordinates;
            techLandArea = tr.LandAreaAssessedHectares;
            techSoilRating = tr.SoilConditionRating;
            techWaterSource = tr.WaterSourceAvailability;
            techEquipSuitability = tr.ProposedEquipmentSuitability;
            techInfraNotes = tr.InfrastructureNotes;
            techRisks = tr.RisksIdentified;
            techMitigations = tr.RecommendedMitigations;
            techViabilityRating = tr.OverallViabilityRating;
            techSummaryNotes = tr.SummaryNotes;
        }
        var fr = app.FinancialAppraisalReport;
        if (fr != null)
        {
            finMonthlyIncome = fr.MonthlyDisposableIncome;
            finDscr = fr.DebtServiceCoverageRatio;
            finLtv = fr.LoanToValueRatio;
            finRepaymentRating = fr.RepaymentCapacityRating;
            finEquityNote = fr.EquityAssessmentNote;
            finBureauSummary = fr.CreditBureauSummary;
            finCreditRecommendation = fr.CreditOfficerRecommendation;
            finSummaryNotes = fr.SummaryNotes;
        }

        // Auto-populate bureau summary if not already saved and reports are available
        if (string.IsNullOrWhiteSpace(finBureauSummary) && app.BureauReports.Count > 0)
        {
            var lines = app.BureauReports.Select(r =>
            {
                var type = r.SubjectType == "NampApplicant" ? "Applicant" : "Guarantor";
                var score = r.CreditScore.HasValue ? $"{r.CreditScore} ({r.ScoreGrade ?? "N/A"})" : "Pending";
                var outstanding = r.TotalOutstanding.HasValue ? $"₦{r.TotalOutstanding:N0}" : "N/A";
                var delinquent = r.DelinquentFacilities.HasValue ? r.DelinquentFacilities.ToString() : "N/A";
                return $"[{type}] {r.SubjectName} | BVN: {r.Bvn} | Score: {score} | Delinquent Facilities: {delinquent} | Total Outstanding: {outstanding}";
            });
            finBureauSummary = string.Join("\n", lines);
        }
    }

