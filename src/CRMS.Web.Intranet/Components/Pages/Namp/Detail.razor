    // ── Stage progression ─────────────────────────────────────────────────

    private static List<StageInfo> StageProgression =>
    [
        new(1, "Draft / Recall", "Loan Officer", a => IsAfter(a, "Draft"), a => a.Status == "Draft"),
        new(2, "Financial Appraisal", "Credit Officer", a => IsAfter(a, "FinancialAppraisal"), a => a.Status is "Submitted" or "FinancialAppraisal"),
        new(3, "Committee Review", "Committee Members", a => IsAfter(a, "Ratification"), a => a.Status is "BranchCommitteeCirculation" or "ZonalCommitteeCirculation" or "RegionalCommitteeCirculation" or "HOCommitteeCirculation"),
        new(4, "Ratification", "Final Approver", a => IsAfter(a, "OfferGenerated"), a => a.Status == "Ratification"),
        new(5, "Offer Letter", "Loan Officer", a => IsAfter(a, "OfferAccepted"), a => a.Status is "OfferGenerated" or "OfferAccepted"),
        new(6, "Legal Clearance", "Legal Officer", a => IsAfter(a, "LegalClearance"), a => a.Status is "LegalClearance" or "LegalReturned"),
        new(7, "Pre-Deployment", "Deployment Officer", a => IsAfter(a, "Deployment"), a => a.Status == "PreDeploymentVerification"),
        new(8, "Deployment", "Deployment Officer", a => a.Status == "Active", a => a.Status == "Deployment"),
    ];

    private static readonly string[] StatusOrder = [
        "Draft", "Submitted", "FinancialAppraisal",
        "BranchCommitteeCirculation", "ZonalCommitteeCirculation", "RegionalCommitteeCirculation", "HOCommitteeCirculation",
        "Ratification", "OfferGenerated", "OfferAccepted", "LegalClearance", "PreDeploymentVerification",
        "Deployment", "Active", "Closed"
    ];

    private static bool IsAfter(NampApplicationDto a, string marker)
    {
        var idx = Array.IndexOf(StatusOrder, a.Status);
        var markerIdx = Array.IndexOf(StatusOrder, marker);
        return idx > markerIdx;
    }

