        {
            <div style="padding: var(--space-3) var(--space-4); background: var(--warning-50); border: 1px solid var(--warning-200); border-radius: var(--radius-md); display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-4);">
                <span class="material-symbols-outlined" style="color: var(--warning-600); font-size: 20px;">pending_actions</span>
                <span style="font-size: var(--text-sm); color: var(--warning-800);">
