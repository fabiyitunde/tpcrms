    private void OpenReturnFromLegalModal() { returnLegalNote = ""; legalActionError = null; showReturnFromLegalModal = true; }
    private void OpenDeclineLegalModal() { declineLegalNote = ""; legalActionError = null; showDeclineLegalModal = true; }

