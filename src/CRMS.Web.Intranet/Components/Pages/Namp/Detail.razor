                            <span class="material-symbols-outlined" style="color: @(signedGpsDoc != null ? "var(--success-500)" : "var(--gray-300)"); font-size: 20px;">@(signedGpsDoc != null ? "task" : "pending_actions")</span>
                            <div>
                                <div style="font-size: var(--text-sm); font-weight: 500;">Signed Copy</div>
                                @if (signedGpsDoc != null)
                                {
                                    <div style="font-size: var(--text-xs); color: var(--gray-500);">@signedGpsDoc.FileName — uploaded @signedGpsDoc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                }
                                else
                                {
                                    <div style="font-size: var(--text-xs); color: var(--gray-400); font-style: italic;">Print, get applicant signature, then upload</div>
                                }
