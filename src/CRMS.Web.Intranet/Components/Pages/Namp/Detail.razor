@page "/namp/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CRMS.Application.Namp.Commands
@using CRMS.Application.Namp.DTOs
@using System.Text.Json
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Config

<PageTitle>@(app?.ApplicationNumber ?? "NAMP Application") - CRMS</PageTitle>

@if (isLoading)
{
    <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
}
else if (app == null)
{
    <div class="alert alert-danger">Application not found.</div>
}
else
{
    <!-- ── Header ── -->
    <div class="page-header" style="margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <button class="btn btn-ghost btn-sm" @onclick='() => Navigation.NavigateTo("/namp")'>
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            </button>
            <div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <h1 class="page-title" style="margin: 0;">@app.ApplicationNumber</h1>
                    <span class="badge @GetStatusBadgeClass(app.Status)" style="font-size: 0.8rem;">@FormatStatus(app.Status)</span>
                </div>
                <p class="page-subtitle" style="margin: 0;">PAYS Ref: @app.ApplicationReference · @app.ApplicantName</p>
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            @if (ShowSubmitButton)
            {
                <button class="btn btn-primary" @onclick="OpenSubmitModal">Submit for Appraisal</button>
            }
            @if (ShowFinancialAppraisalButton)
            {
                <button class="btn btn-success" @onclick="OpenFinDecisionModal">Financial Appraisal Decision</button>
            }
            @if (ShowCirculateButton)
            {
                <button class="btn btn-primary" @onclick="OpenCommitteeModal">Circulate to Committee</button>
            }
            @if (ShowRatifyButton)
            {
                <button class="btn btn-success" @onclick="OpenRatifyModal">Ratify Decision</button>
                <button class="btn btn-danger" @onclick="OpenDeclineRatifyModal">Decline</button>
            }
            @if (ShowOfferButtons)
            {
                <button class="btn btn-success" @onclick="OpenOfferAcceptModal">Record Acceptance</button>
                <button class="btn btn-danger" @onclick="OpenOfferLapseModal">Lapse Offer</button>
            }
            @if (ShowGrantLegalClearanceButton)
            {
                <button class="btn btn-success" @onclick="OpenGrantLegalModal">Grant Clearance</button>
                <button class="btn btn-warning" @onclick="OpenReturnFromLegalModal">Return to LO</button>
                <button class="btn btn-danger" @onclick="OpenDeclineLegalModal">Decline</button>
            }
            @if (ShowResubmitToLegalButton)
            {
                <button class="btn btn-primary" @onclick="ResubmitToLegal">Resubmit to Legal</button>
            }
            @if (ShowCompletePreDeploymentButton)
            {
                <button class="btn btn-success" @onclick="OpenCompletePreDeployModal">Complete Verification</button>
            }
            @if (ShowDeploymentButton)
            {
                <button class="btn btn-success" @onclick="OpenDeploymentModal">Confirm Deployment</button>
            }
            @if (CanGenerateLoanPack)
            {
                <button class="btn btn-outline" @onclick="GenerateNampLoanPack" disabled="@isGeneratingLoanPack">
                    @if (isGeneratingLoanPack)
                    {
                        <span class="spinner" style="width: 14px; height: 14px;"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 16px;">inventory_2</span>
                    }
                    Loan Pack
                </button>
            }
        </div>
    </div>

    <!-- ── Persistent Summary Card ── -->
    <div class="card" style="margin-bottom: 1rem;">
        <div class="card-body" style="padding: 0.875rem 1.25rem;">
            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.25rem;">
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Applicant</div>
                    <div style="font-weight: 600; font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@app.ApplicantName</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Category</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@FormatCategory(app.ApplicantCategory)</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Loan Amount</div>
                    <div style="font-weight: 700; font-size: 0.875rem; color: var(--primary-600);">@(app.LoanAmount.HasValue ? $"₦{app.LoanAmount:N0}" : "—")</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Equipment Value</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@(app.EquipmentValue > 0 ? $"₦{app.EquipmentValue:N0}" : "—")</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Tenor</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@(app.RequestedTenorMonths.HasValue ? $"{app.RequestedTenorMonths} months" : "—")</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Committee Tier</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@(app.CommitteeTier ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionError))
    {
        <div class="alert alert-danger" style="margin-bottom: 1rem;">
            @actionError
            <button style="float: right; background: none; border: none; cursor: pointer;" @onclick="() => actionError = null">✕</button>
        </div>
    }

    <!-- ── Tabs ── -->
    <div class="tabs">
        <div class="tab @(detailTab == "overview" ? "active" : "")" @onclick='() => detailTab = "overview"'>Overview</div>
        <div class="tab @(detailTab == "equipment" ? "active" : "")" @onclick='() => detailTab = "equipment"'>Equipment</div>
        @if (app.Guarantors.Count > 0)
        {
            <div class="tab @(detailTab == "guarantors" ? "active" : "")" @onclick='() => detailTab = "guarantors"'>
                Guarantors <span class="badge badge-secondary" style="margin-left: 4px;">@app.Guarantors.Count</span>
            </div>
        }
        <div class="tab @(detailTab == "collateral" ? "active" : "")" @onclick='() => detailTab = "collateral"'>
            Collateral <span class="badge badge-secondary" style="margin-left: 4px;">@(app.Collaterals.Count + 1)</span>
        </div>
        <div class="tab @(detailTab == "documents" ? "active" : "")" @onclick='() => detailTab = "documents"'>
            Documents
            @if (app.Documents.Count > 0)
            { <span class="badge badge-secondary" style="margin-left: 4px;">@app.Documents.Count</span> }
        </div>
        @if (app.ApplicantCategory == "AgroServiceCompany")
        {
            <div class="tab @(detailTab == "financials" ? "active" : "")" @onclick='() => detailTab = "financials"'>
                Financials
                @if (app.FinancialStatements.Count > 0)
                { <span class="badge badge-secondary" style="margin-left: 4px;">@app.FinancialStatements.Count</span> }
            </div>
        }
        @if (app.BureauReports.Count > 0 || ShowFinancialAppraisalTab)
        {
            <div class="tab @(detailTab == "credit-bureau" ? "active" : "")" @onclick='() => detailTab = "credit-bureau"'>
                Credit Bureau
                @if (app.BureauReports.Count > 0) { <span class="badge badge-secondary" style="margin-left: 4px;">@app.BureauReports.Count</span> }
            </div>
        }
        @if (ShowFinancialAppraisalTab)
        {
            <div class="tab @(detailTab == "financial-appraisal" ? "active" : "")" @onclick='() => detailTab = "financial-appraisal"'>
                Financial Appraisal
                @if (app.FinancialAppraisalReport != null) { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
            </div>
        }
        @if (ShowAdvisoryTab)
        {
            <div class="tab @(detailTab == "advisory" ? "active" : "")" @onclick="SwitchToAdvisoryTab">
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">psychology</span>
                AI Advisory
                @if (nampAdvisory?.Status == "Completed") { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
                else if (advisoryLoading) { <span class="badge badge-secondary" style="margin-left: 4px;">…</span> }
            </div>
        }
        @if (app.CurrentCommitteeReviewId != null || IsCommitteeStatus || IsAfter(app!, "BranchCommitteeCirculation"))
        {
            <div class="tab @(detailTab == "committee" ? "active" : "")" @onclick='() => detailTab = "committee"'>
                Committee
                @if (app.CommitteeDecisionAt != null) { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
                else if (app.CurrentCommitteeReviewId != null) { <span class="badge badge-warning" style="margin-left: 4px;">In Progress</span> }
            </div>
        }
        @if (app.OfferLetterStoragePath != null)
        {
            <div class="tab @(detailTab == "offer-letter" ? "active" : "")" @onclick='() => detailTab = "offer-letter"'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">mail</span>
                Offer Letter
            </div>
        }
        @if (ShowLegalClearanceTab)
        {
            <div class="tab @(detailTab == "legal-clearance" ? "active" : "")" @onclick='() => detailTab = "legal-clearance"'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">gavel</span>
                Legal Clearance
                @if (app.LegalClearedAt.HasValue) { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
                else if (app.Status == "LegalClearance") { <span class="badge badge-warning" style="margin-left: 4px;">Pending</span> }
                else if (app.Status == "LegalReturned") { <span class="badge badge-danger" style="margin-left: 4px;">Returned</span> }
            </div>
        }
        @if (ShowPreDeploymentTab)
        {
            <div class="tab @(detailTab == "pre-deployment" ? "active" : "")" @onclick='() => detailTab = "pre-deployment"'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">checklist</span>
                Pre-Deployment
                @if (app.PreDeploymentVerifiedAt != null) { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
                else if (app.Status == "PreDeploymentVerification") { <span class="badge badge-warning" style="margin-left: 4px;">In Progress</span> }
            </div>
        }
        @if (ShowLoanAccountTab)
        {
            <div class="tab @(detailTab == "loan-account" ? "active" : "")" @onclick='() => LoadLoanAccountTab()'>
                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">account_balance</span>
                Loan Account
                @if (app.Status == "Closed") { <span class="badge badge-secondary" style="margin-left: 4px;">Closed</span> }
            </div>
        }
        <div class="tab @(detailTab == "workflow" ? "active" : "")" @onclick='() => detailTab = "workflow"'>
            Workflow <span class="badge badge-secondary" style="margin-left: 4px;">@app.StatusHistory.Count</span>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════
         OVERVIEW TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "overview")
    {
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">

            <!-- LEFT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <!-- Applicant Information -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Applicant Information</h3></div>
                    <div class="card-body">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            @InfoField("Full Name", app.ApplicantName)
                            @InfoField("Category", FormatCategory(app.ApplicantCategory))
                            @InfoField("Phone", app.ApplicantPhone)
                            @InfoField("Email", app.ApplicantEmail)
                            @InfoField("BOA Account Number", app.BoaAccountNumber)
                            @InfoField("BOA Account Name", app.BoaAccountName)
                            @InfoField("NIN", app.Nin)
                            @InfoField("BVN", app.Bvn)
                            @InfoField("Date of Birth", app.DateOfBirth)
                            @InfoField("State of Residence", app.StateOfResidence)
                            @InfoField("Local Government Area", app.LocalGovernmentArea)
                            @InfoField("Loan Purpose", app.LoanPurpose)
                            @InfoField("Industry Sector", app.IndustrySector)
                        </div>
                    </div>
                </div>

                <!-- Company Details (Agro-Service only) -->
                @if (app.ApplicantCategory == "AgroServiceCompany")
                {
                    <!-- Core Banking Record -->
                    <div class="card">
                        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                            <h3 class="card-title">Core Banking Record</h3>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                @if (!string.IsNullOrEmpty(cbsError))
                                {
                                    <span style="font-size: 0.8rem; color: var(--danger-600);">@cbsError</span>
                                }
                                <button class="btn btn-outline btn-sm" @onclick="FetchCbsRecord" disabled="@isFetchingCbs">
                                    @if (isFetchingCbs)
                                    {
                                        <span class="spinner-sm" style="width:12px;height:12px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:4px;"></span>
                                        <span>Fetching…</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle; margin-right: 4px;">refresh</span>
                                        <span>Refresh</span>
                                    }
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (isFetchingCbs && cbsRecord == null)
                            {
                                <div style="text-align: center; padding: 1.5rem; color: var(--text-secondary); font-size: 0.875rem;">
                                    <span class="spinner-sm" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:6px;"></span>
                                    Loading core banking record…
                                </div>
                            }
                            else if (cbsRecord == null)
                            {
                                <div style="text-align: center; padding: 1.5rem; color: var(--text-secondary); font-size: 0.875rem;">
                                    @(string.IsNullOrEmpty(cbsError) ? "No core banking record loaded." : "Failed to load. Use Refresh to retry.")
                                </div>
                            }
                            else
                            {
                                <!-- Company Account Summary -->
                                <div style="margin-bottom: 1.25rem;">
                                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem;">Company Account</div>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                        @{
                                            var cbsNameMatchesAccountName = string.Equals(cbsRecord.CompanyName?.Trim(), app.BoaAccountName?.Trim(), StringComparison.OrdinalIgnoreCase);
                                            var cbsNameMatchesCompanyName = string.Equals(cbsRecord.CompanyName?.Trim(), app.CompanyName?.Trim(), StringComparison.OrdinalIgnoreCase);
                                        }
                                        <div>
                                            <div style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 0.2rem;">Account Name (CBS)</div>
                                            <div style="font-size: 0.875rem; font-weight: 500;">
                                                @(cbsRecord.CompanyName ?? "—")
                                                @if (!cbsNameMatchesAccountName && !string.IsNullOrEmpty(app.BoaAccountName))
                                                {
                                                    <span class="badge badge-warning" style="margin-left: 4px; font-size: 0.7rem;" title="Portal submitted: @app.BoaAccountName">Differs from portal</span>
                                                }
                                                @if (!cbsNameMatchesCompanyName && !string.IsNullOrEmpty(app.CompanyName))
                                                {
                                                    <span class="badge badge-warning" style="margin-left: 4px; font-size: 0.7rem;" title="Company name on application: @app.CompanyName">≠ Company name</span>
                                                }
                                            </div>
                                        </div>
                                        @InfoField("Phone", cbsRecord.Phone)
                                        @InfoField("Email", cbsRecord.Email)
                                        @InfoField("Address", cbsRecord.Address)
                                    </div>
                                </div>

                                <!-- CBS Directors -->
                                @if (cbsRecord.CbsDirectors.Count > 0)
                                {
                                    <div style="margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color);">
                                        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem;">
                                            Directors on CBS Record (@cbsRecord.CbsDirectors.Count)
                                        </div>
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>BVN</th>
                                                    <th>Email</th>
                                                    <th>Phone</th>
                                                    <th>On Application</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var d in cbsRecord.CbsDirectors)
                                                {
                                                    var matchByBvn = !string.IsNullOrEmpty(d.BVN) && app.Directors.Any(pd => pd.Bvn == d.BVN);
                                                    var matchByName = app.Directors.Any(pd => string.Equals(pd.FullName.Trim(), d.FullName.Trim(), StringComparison.OrdinalIgnoreCase));
                                                    var isOnApplication = matchByBvn || matchByName;
                                                    <tr>
                                                        <td style="font-weight: 500;">@d.FullName</td>
                                                        <td style="font-size: 0.8rem; font-family: monospace;">
                                                            @if (!string.IsNullOrEmpty(d.BVN))
                                                            { @d.BVN }
                                                            else
                                                            { <span class="badge badge-warning">Missing</span> }
                                                        </td>
                                                        <td style="font-size: 0.8rem;">@(d.Email ?? "—")</td>
                                                        <td style="font-size: 0.8rem;">@(d.PhoneNumber ?? "—")</td>
                                                        <td>
                                                            @if (isOnApplication)
                                                            { <span class="badge badge-success">Yes</span> }
                                                            else
                                                            { <span class="badge badge-danger">Not found</span> }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <!-- CBS Signatories -->
                                @if (cbsRecord.Signatories.Count > 0)
                                {
                                    <div style="margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color);">
                                        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem;">
                                            Account Signatories on CBS Record (@cbsRecord.Signatories.Count)
                                        </div>
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>BVN</th>
                                                    <th>Mandate</th>
                                                    <th>Designation</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in cbsRecord.Signatories)
                                                {
                                                    <tr>
                                                        <td style="font-weight: 500;">@s.FullName</td>
                                                        <td style="font-size: 0.8rem; font-family: monospace;">
                                                            @if (!string.IsNullOrEmpty(s.BVN))
                                                            { @s.BVN }
                                                            else
                                                            { <span class="badge badge-warning">Missing</span> }
                                                        </td>
                                                        <td>@(s.MandateType ?? "—")</td>
                                                        <td style="font-size: 0.8rem;">@(s.Designation ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                            <h3 class="card-title">Company Details</h3>
                            @if (CanManageDirectors)
                            {
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    @if (!string.IsNullOrEmpty(cacError))
                                    {
                                        <span style="font-size: 0.8rem; color: var(--danger-600);">@cacError</span>
                                    }
                                    <button class="btn btn-outline btn-sm" @onclick="FetchCac" disabled="@isFetchingCac">
                                        @if (isFetchingCac)
                                        {
                                            <span class="spinner-sm" style="width:12px;height:12px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:4px;"></span>
                                            <span>Fetching…</span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle; margin-right: 4px;">cloud_download</span>
                                            <span>@(app.CacFetchedAt.HasValue ? "Refresh from CAC" : "Fetch from CAC")</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                @InfoField("Company Name", app.CompanyName)
                                @InfoField("RC Number", app.RcNumber)
                                @if (app.CacFetchedAt.HasValue)
                                {
                                    @InfoField("CAC Status", app.CacStatus)
                                    @InfoField("Entity Type", app.CacEntityType)
                                    @InfoField("Registration Date", app.CacRegistrationDate)
                                    @InfoField("Nature of Business", app.CacNatureOfBusiness)
                                    @InfoField("Share Capital", FormatMoney(app.CacShareCapital))
                                    @InfoField("Registered Address", app.CacAddress)
                                }
                            </div>
                            @if (app.CacFetchedAt.HasValue)
                            {
                                <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 0.5rem;">
                                    CAC data fetched @app.CacFetchedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Directors & Shareholders -->
                    <div class="card">
                        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                            <h3 class="card-title">
                                Directors &amp; Shareholders
                                @if (app.Directors.Count > 0)
                                {
                                    <span class="badge badge-secondary" style="margin-left: 4px;">@app.Directors.Count</span>
                                }
                            </h3>
                            @if (CanManageDirectors)
                            {
                                <button class="btn btn-outline btn-sm" @onclick="OpenAddDirectorModal">
                                    <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle; margin-right: 4px;">add</span>
                                    Add Manually
                                </button>
                            }
                        </div>
                        <div class="card-body">
                            @if (app.Directors.Count == 0)
                            {
                                <div style="text-align: center; padding: 1.5rem; color: var(--text-secondary); font-size: 0.875rem;">
                                    No directors or shareholders on record.
                                    @if (CanManageDirectors)
                                    {
                                        <span>Use "Fetch from CAC" or add them manually.</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Role</th>
                                            <th>Shares</th>
                                            <th>Shareholding</th>
                                            <th>BVN</th>
                                            <th>Source</th>
                                            @if (CanManageDirectors)
                                            {
                                                <th style="width: 80px;"></th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in app.Directors)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="font-weight: 600;">@d.FullName</div>
                                                    @if (!string.IsNullOrEmpty(d.Occupation))
                                                    {
                                                        <div style="font-size: 0.75rem; color: var(--gray-500);">@d.Occupation</div>
                                                    }
                                                </td>
                                                <td>
                                                    @if (d.IsChairman)
                                                    {
                                                        <span class="badge badge-info">Chairman</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@(string.IsNullOrEmpty(d.AffiliateType) ? "Director" : d.AffiliateType)</span>
                                                    }
                                                </td>
                                                <td>
                                                    @(d.NumSharesAllotted?.ToString("N0") ?? "—")
                                                    @if (!string.IsNullOrEmpty(d.TypeOfShares))
                                                    {
                                                        <div style="font-size: 0.7rem; color: var(--gray-500);">@d.TypeOfShares</div>
                                                    }
                                                </td>
                                                <td>@(d.ShareholdingPercent.HasValue ? $"{d.ShareholdingPercent:0.##}%" : "—")</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(d.Bvn))
                                                    {
                                                        <span class="badge badge-success">Provided</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning">Missing</span>
                                                    }
                                                </td>
                                                <td><span style="font-size: 0.8rem; color: var(--gray-500);">@(d.SourcedFromCac ? "CAC" : "Manual")</span></td>
                                                @if (CanManageDirectors)
                                                {
                                                    <td>
                                                        <button class="btn btn-ghost btn-sm" title="Complete info" @onclick="() => OpenDirectorEdit(d)">
                                                            <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
                                                        </button>
                                                        @if (!d.SourcedFromCac)
                                                        {
                                                            <button class="btn btn-ghost btn-sm" title="Remove" style="color: var(--danger-600);" @onclick="() => RemoveDirector(d.Id)">
                                                                <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                                            </button>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (app.Directors.Any(d => string.IsNullOrEmpty(d.Bvn)))
                                {
                                    <div class="alert alert-warning" style="margin-top: 0.75rem; font-size: var(--text-sm);">
                                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle;">warning</span>
                                        Some directors/shareholders are missing a BVN. Bureau checks run automatically on submission and cover every director — complete the missing BVNs before submitting.
                                    </div>
                                }
                            }
                        </div>
                    </div>

                }

                <!-- Individual Credit Profile (Youth / Women) -->
                @if (app.ApplicantCategory != "AgroServiceCompany")
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Credit Profile</h3></div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                @InfoField("Occupation", app.Occupation)
                                @InfoField("Employer", app.EmployerName)
                                @InfoField("Employment Status", app.EmploymentStatus)
                                @InfoField("Years of Experience", app.YearsOfExperience?.ToString())
                                @InfoField("Number of Dependants", app.NumberOfDependants?.ToString())
                                @InfoField("Estimated Monthly Income", FormatMoney(app.EstimatedMonthlyIncome))
                                @InfoField("Other Income Source", app.OtherIncomeSource)
                                @InfoField("Other Monthly Income", FormatMoney(app.OtherMonthlyIncome))
                                @InfoField("Monthly Living Expenses", FormatMoney(app.MonthlyLivingExpenses))
                                @InfoField("Estimated Net Worth", FormatMoney(app.EstimatedNetWorth))
                            </div>
                            @if (!string.IsNullOrWhiteSpace(app.OwnedAssetsDescription))
                            {
                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Owned Assets</div>
                                    <div style="font-size: 0.875rem;">@app.OwnedAssetsDescription</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(app.ExistingLoanObligations))
                            {
                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Existing Loan Obligations</div>
                                    <div style="font-size: 0.875rem;">@app.ExistingLoanObligations</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Appraisal Notes (appear as completed) -->
                @if (app.FinancialAppraisalAt.HasValue || app.CommitteeDecisionAt.HasValue || app.RatifiedAt.HasValue)
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Appraisal & Decision Notes</h3></div>
                        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
                            @if (app.FinancialAppraisalAt.HasValue)
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Financial Appraisal — @app.FinancialAppraisalAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 0.875rem; margin-top: 0.25rem;">@(app.FinancialAppraisalNote ?? "No notes recorded.")</div>
                                </div>
                            }
                            @if (app.CommitteeDecisionAt.HasValue)
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Committee Decision — @app.CommitteeDecisionAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 0.875rem; margin-top: 0.25rem;">@(app.CommitteeDecisionNote ?? "No notes recorded.")</div>
                                </div>
                            }
                            @if (app.RatifiedAt.HasValue)
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Ratification — @app.RatifiedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    @if (app.OfferGeneratedAt.HasValue)
                                    {
                                        <div style="font-size: 0.875rem; color: var(--success-600); margin-top: 0.25rem;">Offer letter generated @app.OfferGeneratedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                    @if (app.OfferAcceptedAt.HasValue)
                                    {
                                        <div style="font-size: 0.875rem; color: var(--success-600); margin-top: 0.25rem;">Offer accepted @app.OfferAcceptedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                    @if (app.OfferLapsedAt.HasValue)
                                    {
                                        <div style="font-size: 0.875rem; color: var(--danger-600); margin-top: 0.25rem;">Offer lapsed @app.OfferLapsedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <!-- Loan & Equity Summary -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Loan & Equity</h3></div>
                    <div class="card-body" style="display: flex; flex-direction: column; gap: 0.75rem;">
                        @SideInfoField("Requested Tenor", app.RequestedTenorMonths.HasValue ? $"{app.RequestedTenorMonths} months" : null)
                        @SideInfoField("Equipment Value", FormatMoney(app.EquipmentValue))
                        @SideInfoField("Cart Total", FormatMoney(app.CartTotal))
                        @SideInfoField("Equity (%)", app.EquityPercent.HasValue ? $"{app.EquityPercent:0.##}%" : null)
                        @SideInfoField("Equity Amount", FormatMoney(app.EquityAmount))
                        @SideInfoField("Loan Amount", app.LoanAmount.HasValue ? $"₦{app.LoanAmount:N0}" : null)
                        @SideInfoField("Committee Tier", app.CommitteeTier)
                    </div>
                </div>

                <!-- Stage Progression -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Stage Progression</h3></div>
                    <div class="card-body" style="padding: 0;">
                        @foreach (var stage in StageProgression)
                        {
                            var completed = stage.IsCompleted(app);
                            var current = stage.IsCurrent(app);
                            <div style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 1rem; border-bottom: 1px solid var(--border-color); @(current ? "background: var(--primary-50);" : "")">
                                <div style="width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 11px; font-weight: 700;
                                    background: @(completed ? "var(--success-500)" : current ? "var(--primary-500)" : "var(--gray-200)");
                                    color: @(completed || current ? "white" : "var(--gray-500)");">
                                    @if (completed)
                                    { <span class="material-symbols-outlined" style="font-size: 14px;">check</span> }
                                    else
                                    { <span>@stage.Order</span> }
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 0.8rem; @(current ? "color: var(--primary-700);" : "")">@stage.Name</div>
                                    <div style="font-size: 0.75rem; color: var(--text-secondary);">@stage.Role</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         EQUIPMENT TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "equipment")
    {
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- Equipment Summary -->
            <div class="card">
                <div class="card-header"><h3 class="card-title">Equipment Summary</h3></div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                        @InfoField("Description", app.EquipmentDescription)
                        @InfoField("Equipment Value", FormatMoney(app.EquipmentValue))
                        @InfoField("Cart Total", FormatMoney(app.CartTotal))
                        @InfoField("Equity (%)", app.EquityPercent.HasValue ? $"{app.EquityPercent:0.##}%" : null)
                        @InfoField("Equity Amount", FormatMoney(app.EquityAmount))
                        @InfoField("Loan Amount", app.LoanAmount.HasValue ? $"₦{app.LoanAmount:N0}" : null)
                    </div>
                </div>
            </div>

            <!-- Equipment Cart Items -->
            <div class="card">
                <div class="card-header"><h3 class="card-title">Equipment Cart Items</h3></div>
                <div class="card-body" style="padding: 0;">
                    @{
                        var cartItems = ParseCartItems(app.EquipmentCartJson);
                    }
                    @if (cartItems == null || cartItems.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">No detailed cart items available.</div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr>
                                        @foreach (var key in cartItems[0].Keys)
                                        {
                                            <th>@FormatCartKey(key)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cartItems)
                                    {
                                        <tr>
                                            @foreach (var val in item.Values)
                                            {
                                                <td>@val</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         GUARANTORS TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "guarantors")
    {
        @if (app.Guarantors.Count == 0)
        {
            <div class="card"><div class="p-6 text-center text-muted">No guarantors recorded.</div></div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                @foreach (var g in app.Guarantors)
                {
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title" style="margin: 0;">@g.FullName</h3>
                                <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <span class="badge badge-info">@g.GuarantorType</span>
                                    <span class="badge badge-secondary">@g.GuaranteeType</span>
                                    @if (g.IsDirector) { <span class="badge badge-warning">Director</span> }
                                    @if (g.IsShareholder) { <span class="badge badge-warning">Shareholder</span> }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                @InfoField("BVN", g.Bvn)
                                @InfoField("NIN", g.Nin)
                                @InfoField("Date of Birth", g.DateOfBirth)
                                @InfoField("Gender", g.Gender)
                                @InfoField("Phone", g.Phone)
                                @InfoField("Email", g.Email)
                                @InfoField("Relationship to Applicant", g.RelationshipToApplicant)
                                @InfoField("Occupation", g.Occupation)
                                @InfoField("Employer", g.EmployerName)
                                @InfoField("Monthly Income", FormatMoney(g.MonthlyIncome))
                                @InfoField("Declared Net Worth", FormatMoney(g.DeclaredNetWorth))
                                @InfoField("Shareholding (%)", g.ShareholdingPercentage.HasValue ? $"{g.ShareholdingPercentage:0.##}%" : null)
                                @InfoField("Guarantee Limit", g.IsUnlimited ? "Unlimited" : FormatMoney(g.GuaranteeLimit))
                            </div>
                            @if (!string.IsNullOrWhiteSpace(g.Address))
                            {
                                <div style="padding-top: 0.75rem; border-top: 1px solid var(--border-color);">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Address</div>
                                    <div style="font-size: 0.875rem;">@g.Address</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(g.CompanyName))
                            {
                                <div style="padding-top: 0.75rem; border-top: 1px solid var(--border-color); margin-top: 0.75rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Company</div>
                                    <div style="font-size: 0.875rem;">@g.CompanyName @(!string.IsNullOrEmpty(g.CompanyRegistrationNumber) ? $"· RC: {g.CompanyRegistrationNumber}" : "")</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- ══════════════════════════════════════════════
         COLLATERAL TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "collateral")
    {
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- ── Primary Collateral: Equipment ───────────────────────── -->
            <div class="card" style="border-top: 3px solid #388e3c;">
                <div class="card-header">
                    <div>
                        <h3 class="card-title" style="margin: 0;">@app.EquipmentDescription</h3>
                        <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem;">
                            <span class="badge badge-success">Primary Collateral</span>
                            <span class="badge badge-info">Equipment</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                        @InfoField("Market Value", FormatMoney(app.EquipmentValue))
                        @InfoField("Ownership Basis", "Hire-Purchase / Bank-Financed")
                        @InfoField("Coverage Ratio", app.LoanAmount.HasValue && app.LoanAmount > 0
                            ? $"{(app.EquipmentValue / app.LoanAmount.Value * 100):N1}% of loan"
                            : "—")
                    </div>
                </div>
            </div>

            <!-- ── Supplementary Collaterals ────────────────────────────── -->
            @if (app.Collaterals.Count == 0)
            {
                <div style="font-size: var(--text-sm); color: var(--text-secondary); padding: var(--space-2) 0;">
                    No supplementary collateral recorded.
                </div>
            }
            else
            {
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
                    Supplementary Collateral
                </div>
                @foreach (var c in app.Collaterals)
                {
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title" style="margin: 0;">@c.Description</h3>
                                <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem;">
                                    <span class="badge badge-info">@c.CollateralType</span>
                                    @if (c.IsInsured) { <span class="badge badge-success">Insured</span> }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                                @InfoField("Asset Identifier", c.AssetIdentifier)
                                @InfoField("Location", c.Location)
                                @InfoField("Owner Name", c.OwnerName)
                                @InfoField("Ownership Type", c.OwnershipType)
                                @InfoField("Market Value", FormatMoney(c.MarketValue))
                                @InfoField("Forced Sale Value", FormatMoney(c.ForcedSaleValue))
                                @InfoField("Lien Type", c.LienType)
                                @InfoField("Lien Reference", c.LienReference)
                                @InfoField("Lien Registration Authority", c.LienRegistrationAuthority)
                                @if (c.IsInsured)
                                {
                                    @InfoField("Insurance Company", c.InsuranceCompany)
                                    @InfoField("Policy Number", c.InsurancePolicyNumber)
                                    @InfoField("Insured Value", FormatMoney(c.InsuredValue))
                                    @InfoField("Insurance Expiry", c.InsuranceExpiryDate)
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════
         FINANCIALS TAB (Agro-Service only)
    ══════════════════════════════════════════════ -->
    @if (detailTab == "financials")
    {
        @if (app.FinancialStatements.Count == 0)
        {
            <div class="card"><div class="p-6 text-center text-muted">No financial statements available.</div></div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                @foreach (var fs in app.FinancialStatements.OrderByDescending(f => f.FinancialYear))
                {
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title" style="margin: 0;">FY @fs.FinancialYear</h3>
                                <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem;">
                                    <span class="badge badge-secondary">@fs.FinancialYearType</span>
                                    <span class="badge badge-info">@fs.Currency</span>
                                    @if (!string.IsNullOrEmpty(fs.AuditOpinion)) { <span class="badge badge-success">@fs.AuditOpinion</span> }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- P&L Summary -->
                            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem;">Income Statement</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                                @InfoField("Revenue", FormatMoney(fs.Revenue))
                                @InfoField("Gross Profit", FormatMoney(fs.GrossProfit))
                                @InfoField("EBITDA", FormatMoney(fs.Ebitda))
                                @InfoField("Net Profit", FormatMoney(fs.NetProfit))
                            </div>

                            <!-- Balance Sheet Summary -->
                            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">Balance Sheet</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                                @InfoField("Total Assets", FormatMoney(fs.TotalAssets))
                                @InfoField("Total Liabilities", FormatMoney(fs.TotalLiabilities))
                                @InfoField("Total Equity", FormatMoney(fs.TotalEquity))
                            </div>

                            <!-- Cash Flow Summary -->
                            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">Cash Flow</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                                @InfoField("Net Cash from Operations", FormatMoney(fs.NetCashFromOperating))
                                @InfoField("Year End Date", fs.YearEndDate)
                            </div>

                            @if (!string.IsNullOrEmpty(fs.AuditorName) || !string.IsNullOrEmpty(fs.AuditorFirm))
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 0.75rem; font-size: 0.85rem; color: var(--text-secondary);">
                                    Audited by <strong>@fs.AuditorFirm</strong>@(!string.IsNullOrEmpty(fs.AuditorName) ? $" — {fs.AuditorName}" : "")
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    }

    <!-- ══════════════════════════════════════════════
         FINANCIAL APPRAISAL TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "financial-appraisal")
    {
        var finReport = app.FinancialAppraisalReport;
        var finDocs = app.Documents.Where(d => d.Stage == "FinancialAppraisal").ToList();
        var hasFinModelDoc = finDocs.Any(d => d.Category == "CreditReport");
        var canEditFin = (app.Status == "FinancialAppraisal" || app.Status == "Submitted") &&
                         (User?.HasAnyRole("CreditOfficer", "SystemAdmin") ?? false);

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- Report Form -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Financial Appraisal Report</h3>
                    @if (finReport != null && !canEditFin)
                    { <span class="badge badge-success">Submitted @app.FinancialAppraisalAt?.ToLocalTime().ToString("dd MMM yyyy")</span> }
                </div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Repayment Source *</label>
                            <select class="form-control" @bind="finRepaymentSource" disabled="@(!canEditFin)">
                                <option value="PrimaryIncome">Primary Income (salary / farm)</option>
                                <option value="RentalHireRevenue">Rental / Hire Revenue</option>
                                <option value="Mixed">Mixed (income + rental)</option>
                                <option value="CompanyCashFlow">Company Cash Flow</option>
                            </select>
                        </div>
                        @if (finRepaymentSource is "RentalHireRevenue" or "Mixed")
                        {
                            <div class="form-group">
                                <label class="form-label">Projected Monthly Rental Revenue (₦)</label>
                                <input type="number" class="form-control" step="0.01" @bind="finProjectedRentalRevenue" disabled="@(!canEditFin)" placeholder="e.g. 500000" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Utilisation Rate Assumption (%)</label>
                                <input type="number" class="form-control" step="0.1" @bind="finUtilisationRate" disabled="@(!canEditFin)" placeholder="e.g. 65.0" />
                            </div>
                            <div class="form-group" style="grid-column: 1 / -1;">
                                <label class="form-label">Demand Evidence Note</label>
                                <textarea class="form-control" rows="2" @bind="finDemandEvidence" disabled="@(!canEditFin)" placeholder="e.g. 3 signed hire agreements with Ogun cooperative..."></textarea>
                            </div>
                        }
                        <div class="form-group">
                            <label class="form-label">Monthly Disposable Income (₦)</label>
                            <input type="number" class="form-control" step="0.01" @bind="finMonthlyIncome" disabled="@(!canEditFin)" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Debt Service Coverage Ratio</label>
                            <input type="number" class="form-control" step="0.01" @bind="finDscr" disabled="@(!canEditFin)" placeholder="e.g. 1.25" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Loan-to-Value Ratio (%)</label>
                            <input type="number" class="form-control" step="0.01" @bind="finLtv" disabled="@(!canEditFin)" placeholder="e.g. 65.00" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Repayment Capacity Rating *</label>
                            <select class="form-control" @bind="finRepaymentRating" disabled="@(!canEditFin)">
                                <option value="">-- Select --</option>
                                <option value="Strong">Strong</option>
                                <option value="Adequate">Adequate</option>
                                <option value="Marginal">Marginal</option>
                                <option value="Insufficient">Insufficient</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Credit Officer Recommendation *</label>
                            <select class="form-control" @bind="finCreditRecommendation" disabled="@(!canEditFin)">
                                <option value="">-- Select --</option>
                                <option value="Pass">Pass</option>
                                <option value="Fail">Fail</option>
                            </select>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Equity Assessment Note</label>
                            <textarea class="form-control" rows="2" @bind="finEquityNote" disabled="@(!canEditFin)" placeholder="Equity contribution assessment..."></textarea>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Credit Bureau Summary</label>
                            <textarea class="form-control" rows="3" @bind="finBureauSummary" disabled="@(!canEditFin)" placeholder="Summary of bureau results (auto-populated if credit check ran)..."></textarea>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Summary Notes</label>
                            <textarea class="form-control" rows="2" @bind="finSummaryNotes" disabled="@(!canEditFin)" placeholder="Overall financial assessment..."></textarea>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(finReportError))
                    { <div class="alert alert-danger" style="margin-top: 0.75rem;">@finReportError</div> }
                    @if (canEditFin)
                    {
                        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                            <button class="btn btn-secondary" @onclick="SaveFinReport" disabled="@isSavingFinReport">
                                @if (isSavingFinReport) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                                Save Report Draft
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Documents for this stage -->
            <div class="card">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <h3 class="card-title">Supporting Documents</h3>
                    @if (canEditFin)
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="OpenFinDocUpload">
                            <span class="material-symbols-outlined" style="font-size: 16px;">upload</span> Upload
                        </button>
                    }
                </div>
                <div class="card-body" style="padding: 0;">
                    @if (!finDocs.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <span class="material-symbols-outlined" style="font-size: 36px; opacity: 0.3;">folder_open</span>
                            <div style="margin-top: 0.5rem; font-size: 0.875rem;">No documents uploaded for this stage yet.</div>
                            @if (canEditFin) { <div style="font-size: 0.8rem; color: var(--danger-600); margin-top: 0.25rem;">At least one Financial Model document is required before approving.</div> }
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr><th>Category</th><th>File Name</th><th>Description</th><th>Size</th><th>Uploaded</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in finDocs.OrderBy(d => d.Category).ThenByDescending(d => d.UploadedAt))
                                    {
                                        var capturedDoc = doc;
                                        var finStage = "FinancialAppraisal";
                                        <tr>
                                            <td><span class="badge @(doc.Category == "CreditReport" ? "badge-primary" : "badge-secondary")">@FormatDocCategory(doc.Category)</span></td>
                                            <td>
                                                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--text-secondary);">attach_file</span>
                                                @doc.FileName
                                            </td>
                                            <td style="font-size: var(--text-sm); color: var(--text-secondary);">@(doc.Description ?? "—")</td>
                                            <td style="font-size: var(--text-sm); color: var(--text-secondary);">@FormatFileSize(doc.FileSize)</td>
                                            <td style="font-size: var(--text-sm); color: var(--text-secondary); white-space: nowrap;">@doc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            <td style="white-space: nowrap;">
                                                <button class="btn btn-ghost btn-sm" title="View" @onclick="() => OpenDocView(capturedDoc.Id, capturedDoc.FileName, capturedDoc.ContentType)">
                                                    <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                                </button>
                                                @if (canEditFin)
                                                {
                                                    <button class="btn btn-ghost btn-sm" title="Edit" @onclick="() => OpenEditDoc(capturedDoc.Id, capturedDoc.Category, capturedDoc.Description, finStage, capturedDoc.FileName, capturedDoc.FileSize, capturedDoc.ContentType)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
                                                    </button>
                                                    <button class="btn btn-ghost btn-sm" title="Delete" style="color: var(--danger-600);" @onclick="() => OpenDeleteDoc(capturedDoc.Id)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Decision Record (read-only, shown after decision submitted) -->
            @if (app.FinancialAppraisalAt.HasValue)
            {
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Appraisal Decision</h3></div>
                    <div class="card-body">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            @if (app.Status == "FinancialDeclined")
                            {
                                <span class="badge badge-danger" style="font-size: 0.95rem;">Declined</span>
                            }
                            else
                            {
                                <span class="badge badge-success" style="font-size: 0.95rem;">Approved</span>
                            }
                            <span style="font-size: 0.875rem; color: var(--text-secondary);">@app.FinancialAppraisalAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(app.FinancialAppraisalNote))
                        { <div style="margin-top: 0.5rem; font-size: 0.875rem;">@app.FinancialAppraisalNote</div> }
                    </div>
                </div>
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════
         CREDIT BUREAU TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "credit-bureau")
    {
        var applicantReports = app.BureauReports.Where(r => r.SubjectType == "NampApplicant").ToList();
        var companyReports = app.BureauReports.Where(r => r.SubjectType == "NampCompany").ToList();
        var directorReports = app.BureauReports.Where(r => r.SubjectType == "NampDirector").ToList();
        var guarantorReports = app.BureauReports.Where(r => r.SubjectType != "NampApplicant" && r.SubjectType != "NampCompany" && r.SubjectType != "NampDirector").ToList();

        <!-- Bureau tab header with optional Recheck button -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <div style="font-size: 0.8rem; color: var(--text-secondary);">
                @app.BureauReports.Count report(s) on file
            </div>
            @if (ShowBureauRecheckButton && (User?.HasAnyRole("CreditOfficer", "SystemAdmin") ?? false))
            {
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    @if (!string.IsNullOrEmpty(bureauRecheckError))
                    {
                        <span style="font-size: 0.8rem; color: var(--danger-600);">@bureauRecheckError</span>
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RunBureauRecheck" disabled="@bureauRechecking">
                        @if (bureauRechecking)
                        {
                            <span class="spinner-sm" style="width:12px;height:12px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:4px;"></span>
                            <span>Running…</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle; margin-right: 4px;">refresh</span>
                            <span>Recheck Bureau</span>
                        }
                    </button>
                </div>
            }
        </div>

        @if (app.BureauReports.Count == 0)
        {
            <div class="card">
                <div class="card-body" style="text-align: center; padding: 3rem; color: var(--text-secondary);">
                    <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.25; display: block; margin-bottom: 0.75rem;">fact_check</span>
                    <div style="font-weight: 500; margin-bottom: 0.375rem;">No credit bureau reports yet</div>
                    <div style="font-size: 0.875rem;">Checks are automatically triggered when the application reaches Financial Appraisal status.</div>
                </div>
            </div>
        }
        else
        {

            @if (applicantReports.Count > 0)
            {
                <div style="margin-bottom: 1.5rem;">
                    <h4 style="margin: 0 0 0.75rem 0; font-size: var(--text-sm); font-weight: 600; color: var(--gray-700);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">person</span>
                        Applicant
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1rem;">
                        @foreach (var r in applicantReports)
                        {
                            <div class="namp-bureau-card">
                                <div class="namp-bureau-card-header">
                                    <div>
                                        <div style="font-weight: 600;">@r.SubjectName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">BVN: @r.Bvn</div>
                                    </div>
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="width:56px;height:56px;border-radius:50%;background:var(--gray-100);border:2px dashed var(--gray-300);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <span class="material-symbols-outlined" style="font-size:20px;color:var(--gray-400);">person_search</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-score @GetBureauScoreClass(r.CreditScore)">
                                            @(r.CreditScore?.ToString() ?? "N/A")
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-body">
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="grid-column:1/-1;text-align:center;padding:0.75rem 0.25rem;">
                                            <span class="material-symbols-outlined" style="font-size:36px;color:var(--gray-300);display:block;margin-bottom:0.5rem;">manage_search</span>
                                            <div style="font-weight:600;font-size:0.8rem;color:var(--gray-600);margin-bottom:0.25rem;">No Credit File Registered</div>
                                            <div style="font-size:0.75rem;color:var(--gray-500);line-height:1.5;">No formal credit history found in CRC. Assessment must rely on financial statements, collateral, and guarantors.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Score Grade</span>
                                            @if (r.ScoreGrade != null)
                                            {
                                                var gc = r.ScoreGrade is "A+" or "A" ? "badge-success" : r.ScoreGrade is "B" or "C" ? "badge-warning" : "badge-danger";
                                                <span class="badge @gc">@r.ScoreGrade</span>
                                            }
                                            else { <span class="namp-bureau-stat-value">—</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Delinquent Facilities</span>
                                            @if (r.DelinquentFacilities > 0)
                                            { <span class="badge badge-danger">@r.DelinquentFacilities</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "None" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Outstanding</span>
                                            <span class="namp-bureau-stat-value">@(r.TotalOutstanding > 0 ? $"₦{FormatBureauAmount(r.TotalOutstanding ?? 0)}" : "—")</span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Overdue</span>
                                            <span class="namp-bureau-stat-value" style="@(r.TotalOverdue > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">
                                                @(r.TotalOverdue > 0 ? $"₦{FormatBureauAmount(r.TotalOverdue ?? 0)}" : (r.Status == "Completed" ? "None" : "—"))
                                            </span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Fraud Recommendation</span>
                                            @if (!string.IsNullOrEmpty(r.FraudRecommendation))
                                            { <span class="badge badge-danger" title="@r.FraudRecommendation">@r.FraudRecommendation</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "Clear" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Check Date</span>
                                            <span class="namp-bureau-stat-value">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-footer">
                                    @if (r.Status == "Completed")
                                    { <span class="badge badge-success"><span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span> Completed</span> }
                                    else if (r.Status == "Failed")
                                    { <span class="badge badge-danger" title="@r.ErrorMessage"><span class="material-symbols-outlined" style="font-size: 13px;">error</span> Failed</span> }
                                    else if (r.Status == "NotFound")
                                    { <span class="badge" style="background:var(--warning-100,#fef3c7);color:var(--warning-700,#b45309);border:1px solid var(--warning-200,#fde68a);"><span class="material-symbols-outlined" style="font-size:13px;">info</span> No Credit File</span> }
                                    else
                                    { <span class="badge badge-warning">@r.Status</span> }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        var readableErr = ExtractReadableError(r.ErrorMessage);
                                        <span style="font-size: var(--text-xs); color: var(--danger-600); margin-left: 0.5rem;" title="@r.ErrorMessage">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">info</span>
                                            @(readableErr.Length > 80 ? readableErr[..77] + "…" : readableErr)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Company Reports (AgroService business credit) *@
            @if (companyReports.Count > 0)
            {
                <div style="margin-bottom: 1.5rem;">
                    <h4 style="margin: 0 0 0.75rem 0; font-size: var(--text-sm); font-weight: 600; color: var(--gray-700);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">domain</span>
                        Company (Business Credit)
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1rem;">
                        @foreach (var r in companyReports)
                        {
                            <div class="namp-bureau-card">
                                <div class="namp-bureau-card-header">
                                    <div>
                                        <div style="font-weight: 600;">@r.SubjectName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">Business credit history (CRC)</div>
                                    </div>
                                </div>
                                <div class="namp-bureau-card-body">
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="grid-column:1/-1;text-align:center;padding:0.75rem 0.25rem;">
                                            <span class="material-symbols-outlined" style="font-size:36px;color:var(--gray-300);display:block;margin-bottom:0.5rem;">manage_search</span>
                                            <div style="font-weight:600;font-size:0.8rem;color:var(--gray-600);margin-bottom:0.25rem;">No Credit File Registered</div>
                                            <div style="font-size:0.75rem;color:var(--gray-500);line-height:1.5;">No formal business credit history found in CRC. Assessment must rely on financial statements and collateral.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Delinquent Facilities</span>
                                            @if (r.DelinquentFacilities > 0)
                                            { <span class="badge badge-danger">@r.DelinquentFacilities</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "None" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Outstanding</span>
                                            <span class="namp-bureau-stat-value">@(r.TotalOutstanding > 0 ? $"₦{FormatBureauAmount(r.TotalOutstanding ?? 0)}" : "—")</span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Overdue</span>
                                            <span class="namp-bureau-stat-value" style="@(r.TotalOverdue > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">
                                                @(r.TotalOverdue > 0 ? $"₦{FormatBureauAmount(r.TotalOverdue ?? 0)}" : (r.Status == "Completed" ? "None" : "—"))
                                            </span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Check Date</span>
                                            <span class="namp-bureau-stat-value">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-footer">
                                    @if (r.Status == "Completed")
                                    { <span class="badge badge-success"><span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span> Completed</span> }
                                    else if (r.Status == "Failed")
                                    { <span class="badge badge-danger" title="@r.ErrorMessage"><span class="material-symbols-outlined" style="font-size: 13px;">error</span> Failed</span> }
                                    else if (r.Status == "NotFound")
                                    { <span class="badge" style="background:var(--warning-100,#fef3c7);color:var(--warning-700,#b45309);border:1px solid var(--warning-200,#fde68a);"><span class="material-symbols-outlined" style="font-size:13px;">info</span> No Credit File</span> }
                                    else
                                    { <span class="badge badge-warning">@r.Status</span> }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        var readableErr = ExtractReadableError(r.ErrorMessage);
                                        <span style="font-size: var(--text-xs); color: var(--danger-600); margin-left: 0.5rem;" title="@r.ErrorMessage">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">info</span>
                                            @(readableErr.Length > 80 ? readableErr[..77] + "…" : readableErr)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Director Reports (individual bureau on company directors/shareholders) *@
            @if (directorReports.Count > 0)
            {
                <div style="margin-bottom: 1.5rem;">
                    <h4 style="margin: 0 0 0.75rem 0; font-size: var(--text-sm); font-weight: 600; color: var(--gray-700);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">groups</span>
                        Directors &amp; Shareholders (@directorReports.Count)
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1rem;">
                        @foreach (var r in directorReports)
                        {
                            <div class="namp-bureau-card">
                                <div class="namp-bureau-card-header">
                                    <div>
                                        <div style="font-weight: 600;">@r.SubjectName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">BVN: @r.Bvn</div>
                                    </div>
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="width:56px;height:56px;border-radius:50%;background:var(--gray-100);border:2px dashed var(--gray-300);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <span class="material-symbols-outlined" style="font-size:20px;color:var(--gray-400);">person_search</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-score @GetBureauScoreClass(r.CreditScore)">
                                            @(r.CreditScore?.ToString() ?? "N/A")
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-body">
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="grid-column:1/-1;text-align:center;padding:0.75rem 0.25rem;">
                                            <span class="material-symbols-outlined" style="font-size:36px;color:var(--gray-300);display:block;margin-bottom:0.5rem;">manage_search</span>
                                            <div style="font-weight:600;font-size:0.8rem;color:var(--gray-600);margin-bottom:0.25rem;">No Credit File Registered</div>
                                            <div style="font-size:0.75rem;color:var(--gray-500);line-height:1.5;">No formal credit history found in CRC. Assessment must rely on financial statements, collateral, and guarantors.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Score Grade</span>
                                            @if (r.ScoreGrade != null)
                                            {
                                                var gc = r.ScoreGrade is "A+" or "A" ? "badge-success" : r.ScoreGrade is "B" or "C" ? "badge-warning" : "badge-danger";
                                                <span class="badge @gc">@r.ScoreGrade</span>
                                            }
                                            else { <span class="namp-bureau-stat-value">—</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Delinquent Facilities</span>
                                            @if (r.DelinquentFacilities > 0)
                                            { <span class="badge badge-danger">@r.DelinquentFacilities</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "None" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Outstanding</span>
                                            <span class="namp-bureau-stat-value">@(r.TotalOutstanding > 0 ? $"₦{FormatBureauAmount(r.TotalOutstanding ?? 0)}" : "—")</span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Overdue</span>
                                            <span class="namp-bureau-stat-value" style="@(r.TotalOverdue > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">
                                                @(r.TotalOverdue > 0 ? $"₦{FormatBureauAmount(r.TotalOverdue ?? 0)}" : (r.Status == "Completed" ? "None" : "—"))
                                            </span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Fraud Recommendation</span>
                                            @if (!string.IsNullOrEmpty(r.FraudRecommendation))
                                            { <span class="badge badge-danger" title="@r.FraudRecommendation">@r.FraudRecommendation</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "Clear" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Check Date</span>
                                            <span class="namp-bureau-stat-value">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-footer">
                                    @if (r.Status == "Completed")
                                    { <span class="badge badge-success"><span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span> Completed</span> }
                                    else if (r.Status == "Failed")
                                    { <span class="badge badge-danger" title="@r.ErrorMessage"><span class="material-symbols-outlined" style="font-size: 13px;">error</span> Failed</span> }
                                    else if (r.Status == "NotFound")
                                    { <span class="badge" style="background:var(--warning-100,#fef3c7);color:var(--warning-700,#b45309);border:1px solid var(--warning-200,#fde68a);"><span class="material-symbols-outlined" style="font-size:13px;">info</span> No Credit File</span> }
                                    else
                                    { <span class="badge badge-warning">@r.Status</span> }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        var readableErr = ExtractReadableError(r.ErrorMessage);
                                        <span style="font-size: var(--text-xs); color: var(--danger-600); margin-left: 0.5rem;" title="@r.ErrorMessage">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">info</span>
                                            @(readableErr.Length > 80 ? readableErr[..77] + "…" : readableErr)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Guarantor Reports *@
            @if (guarantorReports.Count > 0)
            {
                <div>
                    <h4 style="margin: 0 0 0.75rem 0; font-size: var(--text-sm); font-weight: 600; color: var(--gray-700);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">shield_person</span>
                        Guarantors (@guarantorReports.Count)
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1rem;">
                        @foreach (var r in guarantorReports)
                        {
                            <div class="namp-bureau-card">
                                <div class="namp-bureau-card-header">
                                    <div>
                                        <div style="font-weight: 600;">@r.SubjectName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">BVN: @r.Bvn</div>
                                    </div>
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="width:56px;height:56px;border-radius:50%;background:var(--gray-100);border:2px dashed var(--gray-300);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <span class="material-symbols-outlined" style="font-size:20px;color:var(--gray-400);">person_search</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-score @GetBureauScoreClass(r.CreditScore)">
                                            @(r.CreditScore?.ToString() ?? "N/A")
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-body">
                                    @if (r.Status == "NotFound")
                                    {
                                        <div style="grid-column:1/-1;text-align:center;padding:0.75rem 0.25rem;">
                                            <span class="material-symbols-outlined" style="font-size:36px;color:var(--gray-300);display:block;margin-bottom:0.5rem;">manage_search</span>
                                            <div style="font-weight:600;font-size:0.8rem;color:var(--gray-600);margin-bottom:0.25rem;">No Credit File Registered</div>
                                            <div style="font-size:0.75rem;color:var(--gray-500);line-height:1.5;">No formal credit history found in CRC. Assessment must rely on financial statements, collateral, and guarantors.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Score Grade</span>
                                            @if (r.ScoreGrade != null)
                                            {
                                                var gc = r.ScoreGrade is "A+" or "A" ? "badge-success" : r.ScoreGrade is "B" or "C" ? "badge-warning" : "badge-danger";
                                                <span class="badge @gc">@r.ScoreGrade</span>
                                            }
                                            else { <span class="namp-bureau-stat-value">—</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Delinquent Facilities</span>
                                            @if (r.DelinquentFacilities > 0)
                                            { <span class="badge badge-danger">@r.DelinquentFacilities</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "None" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Outstanding</span>
                                            <span class="namp-bureau-stat-value">@(r.TotalOutstanding > 0 ? $"₦{FormatBureauAmount(r.TotalOutstanding ?? 0)}" : "—")</span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Total Overdue</span>
                                            <span class="namp-bureau-stat-value" style="@(r.TotalOverdue > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">
                                                @(r.TotalOverdue > 0 ? $"₦{FormatBureauAmount(r.TotalOverdue ?? 0)}" : (r.Status == "Completed" ? "None" : "—"))
                                            </span>
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Fraud Recommendation</span>
                                            @if (!string.IsNullOrEmpty(r.FraudRecommendation))
                                            { <span class="badge badge-danger" title="@r.FraudRecommendation">@r.FraudRecommendation</span> }
                                            else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "Clear" : "—")</span> }
                                        </div>
                                        <div class="namp-bureau-stat">
                                            <span class="namp-bureau-stat-label">Check Date</span>
                                            <span class="namp-bureau-stat-value">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        </div>
                                    }
                                </div>
                                <div class="namp-bureau-card-footer">
                                    @if (r.Status == "Completed")
                                    { <span class="badge badge-success"><span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span> Completed</span> }
                                    else if (r.Status == "Failed")
                                    { <span class="badge badge-danger" title="@r.ErrorMessage"><span class="material-symbols-outlined" style="font-size: 13px;">error</span> Failed</span> }
                                    else if (r.Status == "NotFound")
                                    { <span class="badge" style="background:var(--warning-100,#fef3c7);color:var(--warning-700,#b45309);border:1px solid var(--warning-200,#fde68a);"><span class="material-symbols-outlined" style="font-size:13px;">info</span> No Credit File</span> }
                                    else
                                    { <span class="badge badge-warning">@r.Status</span> }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        var readableErr = ExtractReadableError(r.ErrorMessage);
                                        <span style="font-size: var(--text-xs); color: var(--danger-600); margin-left: 0.5rem;" title="@r.ErrorMessage">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">info</span>
                                            @(readableErr.Length > 80 ? readableErr[..77] + "…" : readableErr)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }

    <!-- ══════════════════════════════════════════════
         COMMITTEE TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "committee")
    {
        var myMember = committeeReview?.Members.FirstOrDefault(m => m.UserId == (User?.Id ?? Guid.Empty));
        var iAmCommitteeMember = myMember != null;
        var iHaveVoted = myMember?.Vote != null;
        var reviewInProgress = committeeReview?.Status == "InProgress";
        var reviewVotingComplete = committeeReview?.Status == "VotingComplete";
        var decisionRecorded = app.CommitteeDecisionAt != null;
        var committeeDecisionIsApproved = decisionRecorded &&
            app.Status != "BranchCommitteeDeclined" &&
            app.Status != "ZonalCommitteeDeclined" &&
            app.Status != "RegionalCommitteeDeclined" &&
            app.Status != "HOCommitteeDeclined";
        <div style="display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; align-items: start;">
            @* Left: members + vote table *@
            <div class="card">
                <div class="card-header">
                    <div>
                        <h3 class="card-title">Committee Members</h3>
                        @if (committeeReview != null)
                        {
                            <div style="font-size: var(--text-xs); color: var(--gray-500); margin-top: 2px;">
                                @committeeReview.CommitteeType.Replace("Credit", "") Committee ·
                                Circulated @committeeReview.CirculatedAt.ToString("MMM dd, yyyy")
                                @if (committeeReview.DeadlineAt.HasValue)
                                {
                                    <span> · Deadline @committeeReview.DeadlineAt.Value.ToString("MMM dd, yyyy")</span>
                                }
                            </div>
                        }
                    </div>
                    <span class="badge @(decisionRecorded ? "badge-success" : (reviewVotingComplete ? "badge-info" : (reviewInProgress ? "badge-warning" : "badge-gray")))">
                        @(decisionRecorded ? "Decided" : (reviewVotingComplete ? "All Voted" : (reviewInProgress ? "Voting" : "Not Started")))
                    </span>
                </div>
                @if (committeeReview == null || committeeReview.Members.Count == 0)
                {
                    <div class="empty-state" style="padding: var(--space-8);">
                        <div class="empty-state-icon"><span class="material-symbols-outlined">groups</span></div>
                        <div class="empty-state-title">No committee members</div>
                        <div class="empty-state-text">The committee has not been circulated yet.</div>
                    </div>
                }
                else
                {
                    <div class="card-body" style="padding: 0;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Role</th>
                                    <th>Vote</th>
                                    <th>Voted At</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in committeeReview.Members)
                                {
                                    <tr>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: var(--space-3);">
                                                <div class="user-avatar" style="width: 32px; height: 32px; font-size: var(--text-xs);">
                                                    @GetInitials(m.UserName)
                                                </div>
                                                <div>
                                                    <span style="font-weight: 500;">@m.UserName</span>
                                                    @if (m.IsChairperson)
                                                    {
                                                        <span style="font-size: var(--text-xs); color: var(--primary-600); margin-left: var(--space-2);">Chair</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td style="font-size: var(--text-sm); color: var(--gray-600);">@m.Role</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(m.Vote))
                                            {
                                                <span class="badge @GetCommitteeVoteBadgeClass(m.Vote)">
                                                    <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">@GetCommitteeVoteIcon(m.Vote)</span>
                                                    @m.Vote
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-gray">Pending</span>
                                            }
                                        </td>
                                        <td style="font-size: var(--text-sm); color: var(--gray-500);">
                                            @(m.VotedAt.HasValue ? m.VotedAt.Value.ToString("MMM dd, HH:mm") : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @* Vote tally (if any votes cast) *@
                    @if (committeeReview.ApprovalVotes + committeeReview.RejectionVotes + committeeReview.AbstainVotes > 0)
                    {
                        <div class="card-footer" style="padding: var(--space-3) var(--space-4);">
                            <div style="display: flex; gap: var(--space-6); font-size: var(--text-sm);">
                                <span style="color: var(--success-700); font-weight: 600;">✓ @committeeReview.ApprovalVotes Approve</span>
                                <span style="color: var(--danger-700); font-weight: 600;">✗ @committeeReview.RejectionVotes Reject</span>
                                <span style="color: var(--gray-500);">— @committeeReview.AbstainVotes Abstain</span>
                                @if (committeeReview.PendingVotes > 0)
                                {
                                    <span style="color: var(--warning-600);">⧗ @committeeReview.PendingVotes Pending</span>
                                }
                            </div>
                            <div style="font-size: var(--text-xs); color: var(--gray-400); margin-top: 4px;">
                                Quorum: @committeeReview.RequiredVotes votes required · Minimum @committeeReview.MinimumApprovalVotes to approve
                            </div>
                        </div>
                    }
                }
            </div>

            @* Right panel *@
            <div style="display: flex; flex-direction: column; gap: var(--space-4);">
                @* Cast Vote — for committee members who haven't voted yet *@
                @if (iAmCommitteeMember && reviewInProgress && !iHaveVoted && !decisionRecorded)
                {
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Cast Your Vote</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label class="form-label">Your Decision</label>
                                <select class="form-control" @bind="selectedVote">
                                    <option value="">Select your vote</option>
                                    <option value="Approve">Approve</option>
                                    <option value="Reject">Reject</option>
                                    <option value="Abstain">Abstain</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Comments (Optional)</label>
                                <textarea class="form-control" rows="3" @bind="voteComment" placeholder="Add your comments..."></textarea>
                            </div>
                            @if (!string.IsNullOrEmpty(voteError))
                            {
                                <div class="alert alert-danger" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@voteError</div>
                            }
                            <button class="btn btn-primary" style="width: 100%;"
                                    @onclick="HandleCastVote"
                                    disabled="@(string.IsNullOrEmpty(selectedVote) || isCastingVote)">
                                @if (isCastingVote) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                                else { <span class="material-symbols-outlined" style="font-size: 16px;">how_to_vote</span> }
                                Submit Vote
                            </button>
                        </div>
                    </div>
                }
                else if (iAmCommitteeMember && iHaveVoted)
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Your Vote</h3></div>
                        <div class="card-body text-center" style="padding: var(--space-5);">
                            <span class="material-symbols-outlined" style="font-size: 36px; display: block; margin-bottom: var(--space-2); color: var(--success-500);">how_to_vote</span>
                            <p style="font-weight: 500; margin-bottom: var(--space-2);">You have voted</p>
                            <span class="badge @GetCommitteeVoteBadgeClass(myMember!.Vote!) " style="font-size: var(--text-sm);">@myMember!.Vote</span>
                            @if (!string.IsNullOrEmpty(myMember.VoteComment))
                            {
                                <p style="font-size: var(--text-sm); color: var(--gray-500); margin-top: var(--space-3); font-style: italic;">"@myMember.VoteComment"</p>
                            }
                        </div>
                    </div>
                }

                @* Decision outcome card *@
                @if (decisionRecorded)
                {
                    <div class="card" style="border: 1px solid @(committeeDecisionIsApproved ? "var(--success-200)" : "var(--danger-200)");">
                        <div class="card-header" style="background: @(committeeDecisionIsApproved ? "var(--success-50)" : "var(--danger-50)");">
                            <h3 class="card-title" style="color: @(committeeDecisionIsApproved ? "var(--success-800)" : "var(--danger-800)");">Committee Decision</h3>
                        </div>
                        <div class="card-body">
                            <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
                                <span class="material-symbols-outlined" style="font-size: 28px; color: @(committeeDecisionIsApproved ? "var(--success-600)" : "var(--danger-600)");">
                                    @(committeeDecisionIsApproved ? "check_circle" : "cancel")
                                </span>
                                <div>
                                    <div style="font-weight: 700; font-size: var(--text-lg); color: @(committeeDecisionIsApproved ? "var(--success-800)" : "var(--danger-800)");">
                                        @(committeeDecisionIsApproved ? "Approved" : "Declined")
                                    </div>
                                    <div style="font-size: var(--text-xs); color: var(--gray-500);">@app.CommitteeDecisionAt!.Value.ToString("MMM dd, yyyy 'at' HH:mm")</div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(app.CommitteeDecisionNote))
                            {
                                <div style="font-size: var(--text-xs); font-weight: 600; color: var(--gray-500); text-transform: uppercase; margin-bottom: 4px;">Notes</div>
                                <p style="font-size: var(--text-sm); color: var(--gray-700); font-style: italic; margin: 0;">"@app.CommitteeDecisionNote"</p>
                            }
                        </div>
                    </div>
                }
                else if (!iAmCommitteeMember && !decisionRecorded)
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Decision Status</h3></div>
                        <div class="card-body text-center" style="padding: var(--space-6);">
                            <span class="material-symbols-outlined" style="font-size: 36px; display: block; margin-bottom: var(--space-2); opacity: 0.4;">pending</span>
                            <div style="font-size: var(--text-sm); color: var(--gray-500);">
                                @(reviewVotingComplete ? "All votes cast. Awaiting CO confirmation." : "Voting in progress...")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         DOCUMENTS TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "documents")
    {
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h3 class="card-title" style="margin: 0;">Documents</h3>
                <div style="display: flex; gap: var(--space-2); align-items: center;">
                    @if (!(app.Status is "Closed" or "TechnicalDeclined" or "FinancialDeclined" or
                           "BranchCommitteeDeclined" or "ZonalCommitteeDeclined" or "RegionalCommitteeDeclined" or
                           "HOCommitteeDeclined" or "RatificationDeclined" or "Declined" or "OfferLapsed") &&
                         (User?.HasAnyRole("LoanOfficer", "SystemAdmin") ?? false))
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="RetryPortalDocuments" disabled="@docRetrying" title="Re-import any origination documents that failed to download during recall">
                            @if (docRetrying)
                            {
                                <span class="spinner-sm" style="width:12px;height:12px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:4px;"></span>
                                <span>Retrying…</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size: 16px;">cloud_download</span>
                                <span>Retry Portal Docs</span>
                            }
                        </button>
                    }
                    @if (CanUploadLoDoc)
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="OpenLoDocUpload">
                            <span class="material-symbols-outlined" style="font-size: 16px;">upload_file</span>
                            Upload Document
                        </button>
                    }
                </div>
            </div>
            @if (docRetryMessage != null)
            {
                <div class="alert alert-success" style="margin: var(--space-3) var(--space-4); padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@docRetryMessage</div>
            }
            @if (docRetryError != null)
            {
                <div class="alert alert-danger" style="margin: var(--space-3) var(--space-4); padding: var(--space-2) var(--space-3); font-size: var(--text-sm);">@docRetryError</div>
            }
            <div class="card-body" style="padding: 0;">
                @if (!app.Documents.Any())
                {
                    <div class="p-6 text-center text-muted">
                        <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3;">folder_open</span>
                        <div style="margin-top: 0.5rem;">No documents uploaded yet.</div>
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Stage</th>
                                    <th>Category</th>
                                    <th>File Name</th>
                                    <th>Description</th>
                                    <th>Size</th>
                                    <th>Uploaded</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in app.Documents.OrderBy(d => d.Stage).ThenByDescending(d => d.UploadedAt))
                                {
                                    <tr>
                                        <td><span class="badge badge-secondary">@FormatDocStage(doc.Stage)</span></td>
                                        <td><span class="badge badge-info" style="font-size: 0.7rem;">@FormatDocCategory(doc.Category)</span></td>
                                        <td>
                                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--text-secondary);">attach_file</span>
                                            @doc.FileName
                                        </td>
                                        <td style="font-size: var(--text-sm); color: var(--text-secondary);">@(doc.Description ?? "—")</td>
                                        <td style="font-size: var(--text-sm); color: var(--text-secondary);">@FormatFileSize(doc.FileSize)</td>
                                        <td style="font-size: var(--text-sm); color: var(--text-secondary); white-space: nowrap;">@doc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td>
                                            <button class="btn btn-ghost btn-sm" title="View" @onclick="() => OpenDocView(doc.Id, doc.FileName, doc.ContentType)">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
