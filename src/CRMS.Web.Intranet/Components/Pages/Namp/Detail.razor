                                            <div style="font-size: var(--text-xs); color: var(--gray-500);">@doc.Description</div>
                                        }
                                    </div>
                                    <a href="@doc.StoragePath" target="_blank" class="btn btn-xs btn-outline">View</a>
                                </div>
                            }
