    @if (detailTab == "credit-bureau")
    {
        var applicantReports = app.BureauReports.Where(r => r.SubjectType == "NampApplicant").ToList();
        var guarantorReports = app.BureauReports.Where(r => r.SubjectType != "NampApplicant").ToList();

        @if (app.BureauReports.Count == 0)
        {
            <div class="card">
                <div class="card-body" style="text-align: center; padding: 3rem; color: var(--text-secondary);">
                    <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.25; display: block; margin-bottom: 0.75rem;">fact_check</span>
                    <div style="font-weight: 500; margin-bottom: 0.375rem;">No credit bureau reports yet</div>
                    <div style="font-size: 0.875rem;">Checks are automatically triggered when the application reaches Financial Appraisal status.</div>
                </div>
            </div>
        }
        else
        {

            @if (applicantReports.Count > 0)
            {
                <div style="margin-bottom: 1.5rem;">
                    <h4 style="margin: 0 0 0.75rem 0; font-size: var(--text-sm); font-weight: 600; color: var(--gray-700);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">person</span>
                        Applicant
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1rem;">
                        @foreach (var r in applicantReports)
                        {
                            <div class="namp-bureau-card">
                                <div class="namp-bureau-card-header">
                                    <div>
                                        <div style="font-weight: 600;">@r.SubjectName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">BVN: @r.Bvn</div>
                                    </div>
                                    <div class="namp-bureau-score @GetBureauScoreClass(r.CreditScore)">
                                        @(r.CreditScore?.ToString() ?? "N/A")
                                    </div>
                                </div>
                                <div class="namp-bureau-card-body">
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Score Grade</span>
                                        @if (r.ScoreGrade != null)
                                        {
                                            var gc = r.ScoreGrade is "A+" or "A" ? "badge-success" : r.ScoreGrade is "B" or "C" ? "badge-warning" : "badge-danger";
                                            <span class="badge @gc">@r.ScoreGrade</span>
                                        }
                                        else { <span class="namp-bureau-stat-value">—</span> }
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Delinquent Facilities</span>
                                        @if (r.DelinquentFacilities > 0)
                                        { <span class="badge badge-danger">@r.DelinquentFacilities</span> }
                                        else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "None" : "—")</span> }
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Total Outstanding</span>
                                        <span class="namp-bureau-stat-value">@(r.TotalOutstanding > 0 ? $"₦{FormatBureauAmount(r.TotalOutstanding ?? 0)}" : "—")</span>
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Total Overdue</span>
                                        <span class="namp-bureau-stat-value" style="@(r.TotalOverdue > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">
                                            @(r.TotalOverdue > 0 ? $"₦{FormatBureauAmount(r.TotalOverdue ?? 0)}" : (r.Status == "Completed" ? "None" : "—"))
                                        </span>
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Fraud Recommendation</span>
                                        @if (!string.IsNullOrEmpty(r.FraudRecommendation))
                                        { <span class="badge badge-danger" title="@r.FraudRecommendation">@r.FraudRecommendation</span> }
                                        else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "Clear" : "—")</span> }
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Check Date</span>
                                        <span class="namp-bureau-stat-value">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="namp-bureau-card-footer">
                                    @if (r.Status == "Completed")
                                    { <span class="badge badge-success"><span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span> Completed</span> }
                                    else if (r.Status == "Failed")
                                    { <span class="badge badge-danger" title="@r.ErrorMessage"><span class="material-symbols-outlined" style="font-size: 13px;">error</span> Failed</span> }
                                    else if (r.Status == "NotFound")
                                    { <span class="badge badge-gray"><span class="material-symbols-outlined" style="font-size: 13px;">search_off</span> Not Found</span> }
                                    else
                                    { <span class="badge badge-warning">@r.Status</span> }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        <span style="font-size: var(--text-xs); color: var(--danger-600); margin-left: 0.5rem;" title="@r.ErrorMessage">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">info</span>
                                            @(r.ErrorMessage.Length > 60 ? r.ErrorMessage[..57] + "…" : r.ErrorMessage)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Guarantor Reports *@
            @if (guarantorReports.Count > 0)
            {
                <div>
                    <h4 style="margin: 0 0 0.75rem 0; font-size: var(--text-sm); font-weight: 600; color: var(--gray-700);">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">shield_person</span>
                        Guarantors (@guarantorReports.Count)
                    </h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1rem;">
                        @foreach (var r in guarantorReports)
                        {
                            <div class="namp-bureau-card">
                                <div class="namp-bureau-card-header">
                                    <div>
                                        <div style="font-weight: 600;">@r.SubjectName</div>
                                        <div style="font-size: var(--text-xs); color: var(--gray-500);">BVN: @r.Bvn</div>
                                    </div>
                                    <div class="namp-bureau-score @GetBureauScoreClass(r.CreditScore)">
                                        @(r.CreditScore?.ToString() ?? "N/A")
                                    </div>
                                </div>
                                <div class="namp-bureau-card-body">
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Score Grade</span>
                                        @if (r.ScoreGrade != null)
                                        {
                                            var gc = r.ScoreGrade is "A+" or "A" ? "badge-success" : r.ScoreGrade is "B" or "C" ? "badge-warning" : "badge-danger";
                                            <span class="badge @gc">@r.ScoreGrade</span>
                                        }
                                        else { <span class="namp-bureau-stat-value">—</span> }
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Delinquent Facilities</span>
                                        @if (r.DelinquentFacilities > 0)
                                        { <span class="badge badge-danger">@r.DelinquentFacilities</span> }
                                        else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "None" : "—")</span> }
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Total Outstanding</span>
                                        <span class="namp-bureau-stat-value">@(r.TotalOutstanding > 0 ? $"₦{FormatBureauAmount(r.TotalOutstanding ?? 0)}" : "—")</span>
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Total Overdue</span>
                                        <span class="namp-bureau-stat-value" style="@(r.TotalOverdue > 0 ? "color: var(--danger-600); font-weight: 600;" : "")">
                                            @(r.TotalOverdue > 0 ? $"₦{FormatBureauAmount(r.TotalOverdue ?? 0)}" : (r.Status == "Completed" ? "None" : "—"))
                                        </span>
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Fraud Recommendation</span>
                                        @if (!string.IsNullOrEmpty(r.FraudRecommendation))
                                        { <span class="badge badge-danger" title="@r.FraudRecommendation">@r.FraudRecommendation</span> }
                                        else { <span class="namp-bureau-stat-value" style="color: var(--success-600);">@(r.Status == "Completed" ? "Clear" : "—")</span> }
                                    </div>
                                    <div class="namp-bureau-stat">
                                        <span class="namp-bureau-stat-label">Check Date</span>
                                        <span class="namp-bureau-stat-value">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="namp-bureau-card-footer">
                                    @if (r.Status == "Completed")
                                    { <span class="badge badge-success"><span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span> Completed</span> }
                                    else if (r.Status == "Failed")
                                    { <span class="badge badge-danger" title="@r.ErrorMessage"><span class="material-symbols-outlined" style="font-size: 13px;">error</span> Failed</span> }
                                    else if (r.Status == "NotFound")
                                    { <span class="badge badge-gray"><span class="material-symbols-outlined" style="font-size: 13px;">search_off</span> Not Found</span> }
                                    else
                                    { <span class="badge badge-warning">@r.Status</span> }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        <span style="font-size: var(--text-xs); color: var(--danger-600); margin-left: 0.5rem;" title="@r.ErrorMessage">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">info</span>
                                            @(r.ErrorMessage.Length > 60 ? r.ErrorMessage[..57] + "…" : r.ErrorMessage)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }

    <!-- ══════════════════════════════════════════════
         DOCUMENTS TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "documents")
    {
        <div class="card">
            <div class="card-body" style="padding: 0;">
                @if (!app.Documents.Any())
                {
                    <div class="p-6 text-center text-muted">
                        <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3;">folder_open</span>
                        <div style="margin-top: 0.5rem;">No documents uploaded yet.</div>
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Stage</th>
                                    <th>Category</th>
                                    <th>File Name</th>
                                    <th>Description</th>
                                    <th>Size</th>
                                    <th>Uploaded</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in app.Documents.OrderBy(d => d.Stage).ThenByDescending(d => d.UploadedAt))
                                {
                                    <tr>
                                        <td><span class="badge badge-secondary">@FormatDocStage(doc.Stage)</span></td>
                                        <td><span class="badge badge-info" style="font-size: 0.7rem;">@FormatDocCategory(doc.Category)</span></td>
                                        <td>
                                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--text-secondary);">attach_file</span>
                                            @doc.FileName
                                        </td>
                                        <td style="font-size: var(--text-sm); color: var(--text-secondary);">@(doc.Description ?? "—")</td>
                                        <td style="font-size: var(--text-sm); color: var(--text-secondary);">@FormatFileSize(doc.FileSize)</td>
                                        <td style="font-size: var(--text-sm); color: var(--text-secondary); white-space: nowrap;">@doc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td>
                                            <button class="btn btn-ghost btn-sm" title="View" @onclick="() => OpenDocView(doc.Id, doc.FileName, doc.ContentType)">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         WORKFLOW TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "workflow")
    {
        <div class="card">
            <div class="card-body">
                @if (!app.StatusHistory.Any())
                {
                    <div class="p-4 text-center text-muted">No status history recorded.</div>
                }
                else
                {
                    <div style="position: relative;">
                        @foreach (var h in app.StatusHistory.OrderByDescending(x => x.ChangedAt))
                        {
                            <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: flex-start;">
                                <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--primary-500); flex-shrink: 0; margin-top: 6px;"></div>
                                <div style="flex: 1;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <span class="badge @GetStatusBadgeClass(h.Status)">@FormatStatus(h.Status)</span>
                                        <span style="font-size: 0.8rem; color: var(--text-secondary);">@h.ChangedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.Note))
                                    {
                                        <div style="font-size: 0.875rem; margin-top: 0.375rem; color: var(--text-secondary); padding: 0.5rem 0.75rem; background: var(--gray-50); border-radius: var(--radius-sm); border-left: 3px solid var(--primary-200);">@h.Note</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

<!-- ══════════════════════════════════════════════
     MODALS (unchanged)
══════════════════════════════════════════════ -->

<!-- Simple Confirm Modal -->
@if (showConfirmModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 440px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@modalTitle</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <p>@modalMessage</p>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger" style="margin-top: 0.75rem;">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-primary" @onclick="ExecuteConfirm" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<!-- Note Modal -->
@if (showNoteModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@modalTitle</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">@modalMessage</label>
                    <textarea class="form-control" rows="3" @bind="noteText" placeholder="Enter notes..."></textarea>
                </div>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-primary" @onclick="ExecuteNoteAction" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<!-- Appraisal Modal -->
@if (showAppraisalModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 500px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@modalTitle</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Decision *</label>
                    <div style="display: flex; gap: 1rem;">
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                            <input type="radio" name="appraisal-decision" @onchange="() => appraisalApproved = true" checked="@appraisalApproved" />
                            <span class="badge badge-success">Approve</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                            <input type="radio" name="appraisal-decision" @onchange="() => appraisalApproved = false" checked="@(!appraisalApproved)" />
                            <span class="badge badge-danger">Decline</span>
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Notes @(appraisalApproved ? "" : "*")</label>
                    <textarea class="form-control" rows="3" @bind="noteText" placeholder="@(appraisalApproved ? "Optional notes..." : "Required — state reason for declining")"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn @(appraisalApproved ? "btn-success" : "btn-danger")" @onclick="ExecuteAppraisal" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    @(appraisalApproved ? "Approve" : "Decline")
                </button>
            </div>
        </div>
    </div>
}

<!-- Committee Circulation Modal -->
@if (showCommitteeModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 600px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Circulate to @app!.CommitteeTier Committee</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="alert alert-danger">@modalError</div>
                }
                else
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Required Votes</div>
                            <div style="font-weight: 600;">@committeeRequiredVotes</div>
                        </div>
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Min. Approval Votes</div>
                            <div style="font-weight: 600;">@committeeMinApprovalVotes</div>
                        </div>
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Deadline</div>
                            <div style="font-weight: 600;">@committeeDeadlineHours hours</div>
                        </div>
                    </div>
                    @if (committeeMembers.Count > 0)
                    {
                        <div style="font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem;">Members (@committeeMembers.Count)</div>
                        <table class="table">
                            <thead><tr><th>Member</th><th>Role</th><th>Chair?</th></tr></thead>
                            <tbody>
                                @foreach (var m in committeeMembers)
                                {
                                    <tr>
                                        <td>@m.UserName</td>
                                        <td>@m.Role</td>
                                        <td>@(m.IsChairperson ? "Yes" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">No members configured for this standing committee. Add members in Admin &gt; Committees first.</div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-primary" @onclick="ExecuteCirculate"
                    disabled="@(isProcessing || !string.IsNullOrEmpty(modalError) || committeeMembers.Count == 0)">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Circulate
                </button>
            </div>
        </div>
    </div>
}

<!-- Ratify Modal -->
@if (showRatifyModal)
{
    <div class="modal-backdrop show" @onclick="CloseModals">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Ratify Committee Decision</h3>
                <button class="modal-close" @onclick="CloseModals"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Offer Letter Storage Path (optional)</label>
                    <input type="text" class="form-control" @bind="ratifyOfferPath" placeholder="e.g. namp/offers/NAMP2024...pdf" />
                    <small class="form-text text-muted">Leave blank if offer letter will be uploaded separately.</small>
                </div>
                @if (!string.IsNullOrEmpty(modalError))
                { <div class="alert alert-danger">@modalError</div> }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                <button class="btn btn-success" @onclick="ExecuteRatify" disabled="@isProcessing">
                    @if (isProcessing) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                    Ratify &amp; Generate Offer
                </button>
            </div>
        </div>
    </div>
}

<!-- Technical Appraisal Decision Modal -->
@if (showTechDecisionModal)
{
    var techDocs = app!.Documents.Where(d => d.Stage == "TechnicalAppraisal").ToList();
    var hasTechDoc = techDocs.Any(d => d.Category == "TechnicalReport");
    var blocked = app.TechnicalAppraisalReport == null || !hasTechDoc;
    <div class="modal-backdrop show" @onclick="CloseTechDecisionModal">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Technical Appraisal Decision</h3>
                <button class="modal-close" @onclick="CloseTechDecisionModal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                @if (blocked)
                {
                    <div class="alert alert-warning">
                        <strong>Cannot submit decision yet:</strong>
                        <ul style="margin: 0.5rem 0 0 1rem; padding: 0;">
                            @if (app.TechnicalAppraisalReport == null) { <li>Save the technical appraisal report first.</li> }
                            @if (!hasTechDoc) { <li>Upload at least one document categorised as <strong>Technical Report</strong>.</li> }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Decision *</label>
                        <div style="display: flex; gap: 1rem;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="tech-decision" @onchange="() => techDecisionApproved = true" checked="@techDecisionApproved" />
                                <span class="badge badge-success">Approve</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="tech-decision" @onchange="() => techDecisionApproved = false" checked="@(!techDecisionApproved)" />
                                <span class="badge badge-danger">Decline</span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Decision Note @(techDecisionApproved ? "(optional)" : "*")</label>
                        <textarea class="form-control" rows="3" @bind="techDecisionNote"
                            placeholder="@(techDecisionApproved ? "Optional notes..." : "Required — state reason for declining")"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(techDecisionError))
                    { <div class="alert alert-danger">@techDecisionError</div> }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseTechDecisionModal">Cancel</button>
                @if (!blocked)
                {
                    <button class="btn @(techDecisionApproved ? "btn-success" : "btn-danger")" @onclick="SubmitTechDecision" disabled="@isSubmittingTechDecision">
                        @if (isSubmittingTechDecision) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                        @(techDecisionApproved ? "Approve — Pass to Financial Appraisal" : "Decline Application")
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Financial Appraisal Decision Modal -->
@if (showFinDecisionModal)
{
    var finDocs2 = app!.Documents.Where(d => d.Stage == "FinancialAppraisal").ToList();
    var hasFinDoc = finDocs2.Any(d => d.Category == "CreditReport");
    var blocked = app.FinancialAppraisalReport == null || !hasFinDoc;
    <div class="modal-backdrop show" @onclick="CloseFinDecisionModal">
        <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">Financial Appraisal Decision</h3>
                <button class="modal-close" @onclick="CloseFinDecisionModal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                @if (blocked)
                {
                    <div class="alert alert-warning">
                        <strong>Cannot submit decision yet:</strong>
                        <ul style="margin: 0.5rem 0 0 1rem; padding: 0;">
                            @if (app.FinancialAppraisalReport == null) { <li>Save the financial appraisal report first.</li> }
                            @if (!hasFinDoc) { <li>Upload at least one document categorised as <strong>Financial Model</strong>.</li> }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Decision *</label>
                        <div style="display: flex; gap: 1rem;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="fin-decision" @onchange="() => finDecisionApproved = true" checked="@finDecisionApproved" />
                                <span class="badge badge-success">Approve</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="radio" name="fin-decision" @onchange="() => finDecisionApproved = false" checked="@(!finDecisionApproved)" />
                                <span class="badge badge-danger">Decline</span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Decision Note @(finDecisionApproved ? "(optional)" : "*")</label>
                        <textarea class="form-control" rows="3" @bind="finDecisionNote"
                            placeholder="@(finDecisionApproved ? "Optional notes..." : "Required — state reason for declining")"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(finDecisionError))
                    { <div class="alert alert-danger">@finDecisionError</div> }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseFinDecisionModal">Cancel</button>
                @if (!blocked)
                {
                    <button class="btn @(finDecisionApproved ? "btn-success" : "btn-danger")" @onclick="SubmitFinDecision" disabled="@isSubmittingFinDecision">
                        @if (isSubmittingFinDecision) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                        @(finDecisionApproved ? "Approve — Pass to Committee" : "Decline Application")
                    </button>
                }
            </div>
        </div>
    </div>
}

