@page "/namp/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CRMS.Application.Namp.Commands
@using CRMS.Application.Namp.DTOs
@using System.Text.Json
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>@(app?.ApplicationNumber ?? "NAMP Application") - CRMS</PageTitle>

@if (isLoading)
{
    <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
}
else if (app == null)
{
    <div class="alert alert-danger">Application not found.</div>
}
else
{
    <!-- ── Header ── -->
    <div class="page-header" style="margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <button class="btn btn-ghost btn-sm" @onclick='() => Navigation.NavigateTo("/namp")'>
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            </button>
            <div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <h1 class="page-title" style="margin: 0;">@app.ApplicationNumber</h1>
                    <span class="badge @GetStatusBadgeClass(app.Status)" style="font-size: 0.8rem;">@FormatStatus(app.Status)</span>
                </div>
                <p class="page-subtitle" style="margin: 0;">PAYS Ref: @app.ApplicationReference · @app.ApplicantName</p>
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            @if (ShowSubmitButton)
            {
                <button class="btn btn-primary" @onclick="OpenSubmitModal">Submit for Appraisal</button>
            }
            @if (ShowTechnicalAppraisalButton)
            {
                <button class="btn btn-success" @onclick="OpenTechDecisionModal">Technical Appraisal Decision</button>
            }
            @if (ShowFinancialAppraisalButton)
            {
                <button class="btn btn-success" @onclick="OpenFinDecisionModal">Financial Appraisal Decision</button>
            }
            @if (ShowCirculateButton)
            {
                <button class="btn btn-primary" @onclick="OpenCommitteeModal">Circulate to Committee</button>
            }
            @if (ShowRecordOutcomeButton)
            {
                <button class="btn btn-warning" @onclick="OpenCommitteeOutcomeModal">Record Committee Outcome</button>
            }
            @if (ShowRatifyButton)
            {
                <button class="btn btn-success" @onclick="OpenRatifyModal">Ratify Decision</button>
                <button class="btn btn-danger" @onclick="OpenDeclineRatifyModal">Decline</button>
            }
            @if (ShowOfferButtons)
            {
                <button class="btn btn-success" @onclick="OpenOfferAcceptModal">Record Acceptance</button>
                <button class="btn btn-danger" @onclick="OpenOfferLapseModal">Lapse Offer</button>
            }
            @if (ShowBeginPreDeploymentButton)
            {
                <button class="btn btn-primary" @onclick="OpenBeginPreDeployModal">Begin Pre-Deployment</button>
            }
            @if (ShowCompletePreDeploymentButton)
            {
                <button class="btn btn-success" @onclick="OpenCompletePreDeployModal">Complete Verification</button>
            }
            @if (ShowTrainingButton)
            {
                <button class="btn btn-success" @onclick="OpenTrainingModal">Complete Training</button>
            }
            @if (ShowDeploymentButton)
            {
                <button class="btn btn-success" @onclick="OpenDeploymentModal">Confirm Deployment</button>
            }
        </div>
    </div>

    <!-- ── Persistent Summary Card ── -->
    <div class="card" style="margin-bottom: 1rem;">
        <div class="card-body" style="padding: 0.875rem 1.25rem;">
            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.25rem;">
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Applicant</div>
                    <div style="font-weight: 600; font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@app.ApplicantName</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Category</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@FormatCategory(app.ApplicantCategory)</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Loan Amount</div>
                    <div style="font-weight: 700; font-size: 0.875rem; color: var(--primary-600);">@(app.LoanAmount.HasValue ? $"₦{app.LoanAmount:N0}" : "—")</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Equipment Value</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@(app.EquipmentValue > 0 ? $"₦{app.EquipmentValue:N0}" : "—")</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Tenor</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@(app.RequestedTenorMonths.HasValue ? $"{app.RequestedTenorMonths} months" : "—")</div>
                </div>
                <div>
                    <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Committee Tier</div>
                    <div style="font-weight: 500; font-size: 0.875rem;">@(app.CommitteeTier ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionError))
    {
        <div class="alert alert-danger" style="margin-bottom: 1rem;">
            @actionError
            <button style="float: right; background: none; border: none; cursor: pointer;" @onclick="() => actionError = null">✕</button>
        </div>
    }

    <!-- ── Tabs ── -->
    <div class="tabs">
        <div class="tab @(detailTab == "overview" ? "active" : "")" @onclick='() => detailTab = "overview"'>Overview</div>
        <div class="tab @(detailTab == "equipment" ? "active" : "")" @onclick='() => detailTab = "equipment"'>Equipment</div>
        @if (app.Guarantors.Count > 0)
        {
            <div class="tab @(detailTab == "guarantors" ? "active" : "")" @onclick='() => detailTab = "guarantors"'>
                Guarantors <span class="badge badge-secondary" style="margin-left: 4px;">@app.Guarantors.Count</span>
            </div>
        }
        @if (app.Collaterals.Count > 0)
        {
            <div class="tab @(detailTab == "collateral" ? "active" : "")" @onclick='() => detailTab = "collateral"'>
                Collateral <span class="badge badge-secondary" style="margin-left: 4px;">@app.Collaterals.Count</span>
            </div>
        }
        @if (app.ApplicantCategory == "AgroServiceCompany")
        {
            <div class="tab @(detailTab == "financials" ? "active" : "")" @onclick='() => detailTab = "financials"'>
                Financials
                @if (app.FinancialStatements.Count > 0)
                { <span class="badge badge-secondary" style="margin-left: 4px;">@app.FinancialStatements.Count</span> }
            </div>
        }
        @if (ShowTechnicalAppraisalTab)
        {
            <div class="tab @(detailTab == "technical-appraisal" ? "active" : "")" @onclick='() => detailTab = "technical-appraisal"'>
                Technical Appraisal
                @if (app.TechnicalAppraisalReport != null) { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
            </div>
        }
        @if (ShowFinancialAppraisalTab)
        {
            <div class="tab @(detailTab == "financial-appraisal" ? "active" : "")" @onclick='() => detailTab = "financial-appraisal"'>
                Financial Appraisal
                @if (app.FinancialAppraisalReport != null) { <span class="badge badge-success" style="margin-left: 4px;">✓</span> }
            </div>
        }
        @if (app.BureauReports.Count > 0 || ShowFinancialAppraisalTab)
        {
            <div class="tab @(detailTab == "credit-bureau" ? "active" : "")" @onclick='() => detailTab = "credit-bureau"'>
                Credit Bureau
                @if (app.BureauReports.Count > 0) { <span class="badge badge-secondary" style="margin-left: 4px;">@app.BureauReports.Count</span> }
            </div>
        }
        <div class="tab @(detailTab == "documents" ? "active" : "")" @onclick='() => detailTab = "documents"'>
            Documents
            @if (app.Documents.Count > 0)
            { <span class="badge badge-secondary" style="margin-left: 4px;">@app.Documents.Count</span> }
        </div>
        <div class="tab @(detailTab == "workflow" ? "active" : "")" @onclick='() => detailTab = "workflow"'>
            Workflow <span class="badge badge-secondary" style="margin-left: 4px;">@app.StatusHistory.Count</span>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════
         OVERVIEW TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "overview")
    {
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">

            <!-- LEFT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <!-- Applicant Information -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Applicant Information</h3></div>
                    <div class="card-body">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            @InfoField("Full Name", app.ApplicantName)
                            @InfoField("Category", FormatCategory(app.ApplicantCategory))
                            @InfoField("Phone", app.ApplicantPhone)
                            @InfoField("Email", app.ApplicantEmail)
                            @InfoField("BOA Account Number", app.BoaAccountNumber)
                            @InfoField("BOA Account Name", app.BoaAccountName)
                            @InfoField("NIN", app.Nin)
                            @InfoField("BVN", app.Bvn)
                            @InfoField("Date of Birth", app.DateOfBirth)
                            @InfoField("State of Residence", app.StateOfResidence)
                            @InfoField("Local Government Area", app.LocalGovernmentArea)
                            @InfoField("Loan Purpose", app.LoanPurpose)
                            @InfoField("Industry Sector", app.IndustrySector)
                        </div>
                    </div>
                </div>

                <!-- Company Details (Agro-Service only) -->
                @if (app.ApplicantCategory == "AgroServiceCompany")
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Company Details</h3></div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                @InfoField("Company Name", app.CompanyName)
                                @InfoField("RC Number", app.RcNumber)
                            </div>
                        </div>
                    </div>
                }

                <!-- Individual Credit Profile (Youth / Women) -->
                @if (app.ApplicantCategory != "AgroServiceCompany")
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Credit Profile</h3></div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                @InfoField("Occupation", app.Occupation)
                                @InfoField("Employer", app.EmployerName)
                                @InfoField("Employment Status", app.EmploymentStatus)
                                @InfoField("Years of Experience", app.YearsOfExperience?.ToString())
                                @InfoField("Number of Dependants", app.NumberOfDependants?.ToString())
                                @InfoField("Estimated Monthly Income", FormatMoney(app.EstimatedMonthlyIncome))
                                @InfoField("Other Income Source", app.OtherIncomeSource)
                                @InfoField("Other Monthly Income", FormatMoney(app.OtherMonthlyIncome))
                                @InfoField("Monthly Living Expenses", FormatMoney(app.MonthlyLivingExpenses))
                                @InfoField("Estimated Net Worth", FormatMoney(app.EstimatedNetWorth))
                            </div>
                            @if (!string.IsNullOrWhiteSpace(app.OwnedAssetsDescription))
                            {
                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Owned Assets</div>
                                    <div style="font-size: 0.875rem;">@app.OwnedAssetsDescription</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(app.ExistingLoanObligations))
                            {
                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Existing Loan Obligations</div>
                                    <div style="font-size: 0.875rem;">@app.ExistingLoanObligations</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Appraisal Notes (appear as completed) -->
                @if (app.TechnicalAppraisalAt.HasValue || app.FinancialAppraisalAt.HasValue || app.CommitteeDecisionAt.HasValue || app.RatifiedAt.HasValue)
                {
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Appraisal & Decision Notes</h3></div>
                        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
                            @if (app.TechnicalAppraisalAt.HasValue)
                            {
                                <div>
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Technical Appraisal — @app.TechnicalAppraisalAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 0.875rem; margin-top: 0.25rem;">@(app.TechnicalAppraisalNote ?? "No notes recorded.")</div>
                                </div>
                            }
                            @if (app.FinancialAppraisalAt.HasValue)
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Financial Appraisal — @app.FinancialAppraisalAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 0.875rem; margin-top: 0.25rem;">@(app.FinancialAppraisalNote ?? "No notes recorded.")</div>
                                </div>
                            }
                            @if (app.CommitteeDecisionAt.HasValue)
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Committee Decision — @app.CommitteeDecisionAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 0.875rem; margin-top: 0.25rem;">@(app.CommitteeDecisionNote ?? "No notes recorded.")</div>
                                </div>
                            }
                            @if (app.RatifiedAt.HasValue)
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Ratification — @app.RatifiedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    @if (app.OfferGeneratedAt.HasValue)
                                    {
                                        <div style="font-size: 0.875rem; color: var(--success-600); margin-top: 0.25rem;">Offer letter generated @app.OfferGeneratedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                    @if (app.OfferAcceptedAt.HasValue)
                                    {
                                        <div style="font-size: 0.875rem; color: var(--success-600); margin-top: 0.25rem;">Offer accepted @app.OfferAcceptedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                    @if (app.OfferLapsedAt.HasValue)
                                    {
                                        <div style="font-size: 0.875rem; color: var(--danger-600); margin-top: 0.25rem;">Offer lapsed @app.OfferLapsedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <!-- Loan & Equity Summary -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Loan & Equity</h3></div>
                    <div class="card-body" style="display: flex; flex-direction: column; gap: 0.75rem;">
                        @SideInfoField("Requested Tenor", app.RequestedTenorMonths.HasValue ? $"{app.RequestedTenorMonths} months" : null)
                        @SideInfoField("Equipment Value", FormatMoney(app.EquipmentValue))
                        @SideInfoField("Cart Total", FormatMoney(app.CartTotal))
                        @SideInfoField("Equity (%)", app.EquityPercent.HasValue ? $"{app.EquityPercent:0.##}%" : null)
                        @SideInfoField("Equity Amount", FormatMoney(app.EquityAmount))
                        @SideInfoField("Loan Amount", app.LoanAmount.HasValue ? $"₦{app.LoanAmount:N0}" : null)
                        @SideInfoField("Committee Tier", app.CommitteeTier)
                    </div>
                </div>

                <!-- Stage Progression -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Stage Progression</h3></div>
                    <div class="card-body" style="padding: 0;">
                        @foreach (var stage in StageProgression)
                        {
                            var completed = stage.IsCompleted(app);
                            var current = stage.IsCurrent(app);
                            <div style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 1rem; border-bottom: 1px solid var(--border-color); @(current ? "background: var(--primary-50);" : "")">
                                <div style="width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 11px; font-weight: 700;
                                    background: @(completed ? "var(--success-500)" : current ? "var(--primary-500)" : "var(--gray-200)");
                                    color: @(completed || current ? "white" : "var(--gray-500)");">
                                    @if (completed)
                                    { <span class="material-symbols-outlined" style="font-size: 14px;">check</span> }
                                    else
                                    { <span>@stage.Order</span> }
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 0.8rem; @(current ? "color: var(--primary-700);" : "")">@stage.Name</div>
                                    <div style="font-size: 0.75rem; color: var(--text-secondary);">@stage.Role</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         EQUIPMENT TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "equipment")
    {
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- Equipment Summary -->
            <div class="card">
                <div class="card-header"><h3 class="card-title">Equipment Summary</h3></div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                        @InfoField("Description", app.EquipmentDescription)
                        @InfoField("Equipment Value", FormatMoney(app.EquipmentValue))
                        @InfoField("Cart Total", FormatMoney(app.CartTotal))
                        @InfoField("Equity (%)", app.EquityPercent.HasValue ? $"{app.EquityPercent:0.##}%" : null)
                        @InfoField("Equity Amount", FormatMoney(app.EquityAmount))
                        @InfoField("Loan Amount", app.LoanAmount.HasValue ? $"₦{app.LoanAmount:N0}" : null)
                    </div>
                </div>
            </div>

            <!-- Equipment Cart Items -->
            <div class="card">
                <div class="card-header"><h3 class="card-title">Equipment Cart Items</h3></div>
                <div class="card-body" style="padding: 0;">
                    @{
                        var cartItems = ParseCartItems(app.EquipmentCartJson);
                    }
                    @if (cartItems == null || cartItems.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">No detailed cart items available.</div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr>
                                        @foreach (var key in cartItems[0].Keys)
                                        {
                                            <th>@FormatCartKey(key)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cartItems)
                                    {
                                        <tr>
                                            @foreach (var val in item.Values)
                                            {
                                                <td>@val</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════
         GUARANTORS TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "guarantors")
    {
        @if (app.Guarantors.Count == 0)
        {
            <div class="card"><div class="p-6 text-center text-muted">No guarantors recorded.</div></div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                @foreach (var g in app.Guarantors)
                {
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title" style="margin: 0;">@g.FullName</h3>
                                <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <span class="badge badge-info">@g.GuarantorType</span>
                                    <span class="badge badge-secondary">@g.GuaranteeType</span>
                                    @if (g.IsDirector) { <span class="badge badge-warning">Director</span> }
                                    @if (g.IsShareholder) { <span class="badge badge-warning">Shareholder</span> }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                @InfoField("BVN", g.Bvn)
                                @InfoField("NIN", g.Nin)
                                @InfoField("Date of Birth", g.DateOfBirth)
                                @InfoField("Gender", g.Gender)
                                @InfoField("Phone", g.Phone)
                                @InfoField("Email", g.Email)
                                @InfoField("Relationship to Applicant", g.RelationshipToApplicant)
                                @InfoField("Occupation", g.Occupation)
                                @InfoField("Employer", g.EmployerName)
                                @InfoField("Monthly Income", FormatMoney(g.MonthlyIncome))
                                @InfoField("Declared Net Worth", FormatMoney(g.DeclaredNetWorth))
                                @InfoField("Shareholding (%)", g.ShareholdingPercentage.HasValue ? $"{g.ShareholdingPercentage:0.##}%" : null)
                                @InfoField("Guarantee Limit", g.IsUnlimited ? "Unlimited" : FormatMoney(g.GuaranteeLimit))
                            </div>
                            @if (!string.IsNullOrWhiteSpace(g.Address))
                            {
                                <div style="padding-top: 0.75rem; border-top: 1px solid var(--border-color);">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Address</div>
                                    <div style="font-size: 0.875rem;">@g.Address</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(g.CompanyName))
                            {
                                <div style="padding-top: 0.75rem; border-top: 1px solid var(--border-color); margin-top: 0.75rem;">
                                    <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.25rem;">Company</div>
                                    <div style="font-size: 0.875rem;">@g.CompanyName @(!string.IsNullOrEmpty(g.CompanyRegistrationNumber) ? $"· RC: {g.CompanyRegistrationNumber}" : "")</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- ══════════════════════════════════════════════
         COLLATERAL TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "collateral")
    {
        @if (app.Collaterals.Count == 0)
        {
            <div class="card"><div class="p-6 text-center text-muted">No collateral recorded.</div></div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                @foreach (var c in app.Collaterals)
                {
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title" style="margin: 0;">@c.Description</h3>
                                <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem;">
                                    <span class="badge badge-info">@c.CollateralType</span>
                                    @if (c.IsInsured) { <span class="badge badge-success">Insured</span> }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                                @InfoField("Asset Identifier", c.AssetIdentifier)
                                @InfoField("Location", c.Location)
                                @InfoField("Owner Name", c.OwnerName)
                                @InfoField("Ownership Type", c.OwnershipType)
                                @InfoField("Market Value", FormatMoney(c.MarketValue))
                                @InfoField("Forced Sale Value", FormatMoney(c.ForcedSaleValue))
                                @InfoField("Lien Type", c.LienType)
                                @InfoField("Lien Reference", c.LienReference)
                                @InfoField("Lien Registration Authority", c.LienRegistrationAuthority)
                                @if (c.IsInsured)
                                {
                                    @InfoField("Insurance Company", c.InsuranceCompany)
                                    @InfoField("Policy Number", c.InsurancePolicyNumber)
                                    @InfoField("Insured Value", FormatMoney(c.InsuredValue))
                                    @InfoField("Insurance Expiry", c.InsuranceExpiryDate)
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- ══════════════════════════════════════════════
         FINANCIALS TAB (Agro-Service only)
    ══════════════════════════════════════════════ -->
    @if (detailTab == "financials")
    {
        @if (app.FinancialStatements.Count == 0)
        {
            <div class="card"><div class="p-6 text-center text-muted">No financial statements available.</div></div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                @foreach (var fs in app.FinancialStatements.OrderByDescending(f => f.FinancialYear))
                {
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title" style="margin: 0;">FY @fs.FinancialYear</h3>
                                <div style="margin-top: 0.25rem; display: flex; gap: 0.5rem;">
                                    <span class="badge badge-secondary">@fs.FinancialYearType</span>
                                    <span class="badge badge-info">@fs.Currency</span>
                                    @if (!string.IsNullOrEmpty(fs.AuditOpinion)) { <span class="badge badge-success">@fs.AuditOpinion</span> }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- P&L Summary -->
                            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem;">Income Statement</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                                @InfoField("Revenue", FormatMoney(fs.Revenue))
                                @InfoField("Gross Profit", FormatMoney(fs.GrossProfit))
                                @InfoField("EBITDA", FormatMoney(fs.Ebitda))
                                @InfoField("Net Profit", FormatMoney(fs.NetProfit))
                            </div>

                            <!-- Balance Sheet Summary -->
                            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">Balance Sheet</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                                @InfoField("Total Assets", FormatMoney(fs.TotalAssets))
                                @InfoField("Total Liabilities", FormatMoney(fs.TotalLiabilities))
                                @InfoField("Total Equity", FormatMoney(fs.TotalEquity))
                            </div>

                            <!-- Cash Flow Summary -->
                            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">Cash Flow</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                                @InfoField("Net Cash from Operations", FormatMoney(fs.NetCashFromOperating))
                                @InfoField("Year End Date", fs.YearEndDate)
                            </div>

                            @if (!string.IsNullOrEmpty(fs.AuditorName) || !string.IsNullOrEmpty(fs.AuditorFirm))
                            {
                                <div style="border-top: 1px solid var(--border-color); padding-top: 0.75rem; font-size: 0.85rem; color: var(--text-secondary);">
                                    Audited by <strong>@fs.AuditorFirm</strong>@(!string.IsNullOrEmpty(fs.AuditorName) ? $" — {fs.AuditorName}" : "")
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- ══════════════════════════════════════════════
         TECHNICAL APPRAISAL TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "technical-appraisal")
    {
        var techReport = app.TechnicalAppraisalReport;
        var techDocs = app.Documents.Where(d => d.Stage == "TechnicalAppraisal").ToList();
        var hasTechReportDoc = techDocs.Any(d => d.Category == "TechnicalReport");
        var canEditTech = app.Status is "Submitted" or "TechnicalAppraisal" &&
                          (User?.HasAnyRole("AgriculturalEngineer", "SystemAdmin") ?? false);

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- Report Form -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Technical Appraisal Report</h3>
                    @if (techReport != null && !canEditTech)
                    { <span class="badge badge-success">Submitted @app.TechnicalAppraisalAt?.ToLocalTime().ToString("dd MMM yyyy")</span> }
                </div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Farm / Site Location Description *</label>
                            <textarea class="form-control" rows="2" @bind="techFarmLocation" disabled="@(!canEditTech)" placeholder="Describe the farm location..."></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">GPS Coordinates</label>
                            <input type="text" class="form-control" @bind="techGpsCoords" disabled="@(!canEditTech)" placeholder="e.g. 6.5244° N, 3.3792° E" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Land Area Assessed (Hectares)</label>
                            <input type="number" class="form-control" step="0.01" @bind="techLandArea" disabled="@(!canEditTech)" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Soil Condition Rating *</label>
                            <select class="form-control" @bind="techSoilRating" disabled="@(!canEditTech)">
                                <option value="">-- Select --</option>
                                <option value="Excellent">Excellent</option>
                                <option value="Good">Good</option>
                                <option value="Fair">Fair</option>
                                <option value="Poor">Poor</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Overall Viability Rating *</label>
                            <select class="form-control" @bind="techViabilityRating" disabled="@(!canEditTech)">
                                <option value="">-- Select --</option>
                                <option value="Viable">Viable</option>
                                <option value="Marginal">Marginal</option>
                                <option value="NotViable">Not Viable</option>
                            </select>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Water Source Availability *</label>
                            <textarea class="form-control" rows="2" @bind="techWaterSource" disabled="@(!canEditTech)" placeholder="Describe water availability..."></textarea>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Proposed Equipment Suitability *</label>
                            <textarea class="form-control" rows="2" @bind="techEquipSuitability" disabled="@(!canEditTech)" placeholder="Assess suitability of requested equipment for the site..."></textarea>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Infrastructure Notes</label>
                            <textarea class="form-control" rows="2" @bind="techInfraNotes" disabled="@(!canEditTech)" placeholder="Roads, power, storage facilities..."></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Risks Identified</label>
                            <textarea class="form-control" rows="2" @bind="techRisks" disabled="@(!canEditTech)" placeholder="Environmental, operational, market risks..."></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Recommended Mitigations</label>
                            <textarea class="form-control" rows="2" @bind="techMitigations" disabled="@(!canEditTech)" placeholder="Steps to address identified risks..."></textarea>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="form-label">Summary Notes</label>
                            <textarea class="form-control" rows="2" @bind="techSummaryNotes" disabled="@(!canEditTech)" placeholder="Overall observations and key findings..."></textarea>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(techReportError))
                    { <div class="alert alert-danger" style="margin-top: 0.75rem;">@techReportError</div> }
                    @if (canEditTech)
                    {
                        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                            <button class="btn btn-secondary" @onclick="SaveTechReport" disabled="@isSavingTechReport">
                                @if (isSavingTechReport) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                                Save Report Draft
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Documents for this stage -->
            <div class="card">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <h3 class="card-title">Supporting Documents</h3>
                    @if (canEditTech)
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="OpenTechDocUpload">
                            <span class="material-symbols-outlined" style="font-size: 16px;">upload</span> Upload
                        </button>
                    }
                </div>
                <div class="card-body" style="padding: 0;">
                    @if (!techDocs.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <span class="material-symbols-outlined" style="font-size: 36px; opacity: 0.3;">folder_open</span>
                            <div style="margin-top: 0.5rem; font-size: 0.875rem;">No documents uploaded for this stage yet.</div>
                            @if (canEditTech) { <div style="font-size: 0.8rem; color: var(--danger-600); margin-top: 0.25rem;">At least one Technical Report is required before approving.</div> }
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr><th>Category</th><th>File Name</th><th>Description</th><th>Size</th><th>Uploaded</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in techDocs.OrderBy(d => d.Category).ThenByDescending(d => d.UploadedAt))
                                    {
                                        var capturedDoc = doc;
                                        var techStage = "TechnicalAppraisal";
                                        <tr>
                                            <td><span class="badge @(doc.Category == "TechnicalReport" ? "badge-primary" : "badge-secondary")">@FormatDocCategory(doc.Category)</span></td>
                                            <td>
                                                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--text-secondary);">attach_file</span>
                                                @doc.FileName
                                            </td>
                                            <td style="font-size: var(--text-sm); color: var(--text-secondary);">@(doc.Description ?? "—")</td>
                                            <td style="font-size: var(--text-sm); color: var(--text-secondary);">@FormatFileSize(doc.FileSize)</td>
                                            <td style="font-size: var(--text-sm); color: var(--text-secondary); white-space: nowrap;">@doc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            <td style="white-space: nowrap;">
                                                <button class="btn btn-ghost btn-sm" title="View" @onclick="() => OpenDocView(capturedDoc.Id, capturedDoc.FileName, capturedDoc.ContentType)">
                                                    <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                                </button>
                                                @if (canEditTech)
                                                {
                                                    <button class="btn btn-ghost btn-sm" title="Edit" @onclick="() => OpenEditDoc(capturedDoc.Id, capturedDoc.Category, capturedDoc.Description, techStage, capturedDoc.FileName, capturedDoc.FileSize, capturedDoc.ContentType)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
                                                    </button>
                                                    <button class="btn btn-ghost btn-sm" title="Delete" style="color: var(--danger-600);" @onclick="() => OpenDeleteDoc(capturedDoc.Id)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Decision Record (read-only, shown after decision submitted) -->
            @if (app.TechnicalAppraisalAt.HasValue)
            {
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Appraisal Decision</h3></div>
                    <div class="card-body">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            @if (app.Status == "TechnicalDeclined")
                            {
                                <span class="badge badge-danger" style="font-size: 0.95rem;">Declined</span>
                            }
                            else
                            {
                                <span class="badge badge-success" style="font-size: 0.95rem;">Approved</span>
                            }
                            <span style="font-size: 0.875rem; color: var(--text-secondary);">@app.TechnicalAppraisalAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(app.TechnicalAppraisalNote))
                        { <div style="margin-top: 0.5rem; font-size: 0.875rem;">@app.TechnicalAppraisalNote</div> }
                    </div>
                </div>
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════
         FINANCIAL APPRAISAL TAB
    ══════════════════════════════════════════════ -->
    @if (detailTab == "financial-appraisal")
