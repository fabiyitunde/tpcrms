                            <div>
                                <div style="font-size: var(--text-sm); font-weight: 500;">Countersigned Copy</div>
                                @if (SignedOfferLetterDoc != null)
                                {
                                    <div style="font-size: var(--text-xs); color: var(--gray-500);">@SignedOfferLetterDoc.FileName — uploaded @SignedOfferLetterDoc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                }
