@page "/rhshf"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CRMS.Application.Rhshf.DTOs
@using CRMS.Domain.Enums
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>RH-SHF Queue - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">RH-SHF Credit Profiling</h1>
        <p class="page-subtitle">Renewed Hope Dry Season — input-financing appraisal &amp; risk review</p>
    </div>
    <button class="btn btn-ghost btn-sm" @onclick="LoadQueue" disabled="@isLoading" title="Refresh queue">
        <span class="material-symbols-outlined" style="font-size: 18px; @(isLoading ? "animation: spin 1s linear infinite;" : "")">refresh</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger" style="margin-bottom: 1rem;">@pageError</div>
}

<div class="tabs">
    @if (CanAppraise)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.Appraisal ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.Appraisal)'>
            Appraisal
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.Appraisal)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanReviewRisk)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.RiskReview ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.RiskReview)'>
            Risk Review
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.RiskReview)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanVoteOnCommittee)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.CommitteeVoting ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.CommitteeVoting)'>
            Committee
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.CommitteeVoting)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanRatify)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.Ratification ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.Ratification)'>
            Ratification
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.Ratification)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanRatify || CanClearLegally)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.AwaitingOfferAcceptance ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.AwaitingOfferAcceptance)'>
            Awaiting Offer
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.AwaitingOfferAcceptance)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanClearLegally)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.LegalClearance ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.LegalClearance)'>
            Legal Clearance
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.LegalClearance)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanBookDisbursement)
    {
        <div class="tab @(!showAll && activeStage == RhshfInternalStage.Disbursement ? "active" : "")" @onclick='() => SwitchTab(RhshfInternalStage.Disbursement)'>
            Disbursement
            @if (!showAll && queue.Count > 0 && activeStage == RhshfInternalStage.Disbursement)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    @if (CanSeeAll)
    {
        <div class="tab @(showAll ? "active" : "")" @onclick="SwitchToAll">
            All
            @if (showAll && queue.Count > 0)
            {
                <span class="badge badge-gray" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (isLoading)
        {
            <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
        }
        else if (queue.Count == 0)
        {
            <div class="p-6 text-center" style="color: var(--gray-500);">Nothing in this queue right now.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Company</th>
                        <th style="text-align: right;">Total EOP Value</th>
                        <th>Cycle</th>
                        <th>Status</th>
                        <th>Stage</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in queue)
                    {
                        <tr style="cursor: pointer;" @onclick="() => OpenReview(item.Reference)">
                            <td><code>@item.Reference</code></td>
                            <td>@item.CompanyName</td>
                            <td style="text-align: right;">@item.Currency @item.TotalEopValue.ToString("N2")</td>
                            <td>@item.CurrentCycleNumber</td>
                            <td><span class="badge @StatusBadge(item.Status)">@Humanise(item.Status.ToString())</span></td>
                            <td style="font-size: 0.85rem; color: var(--gray-600);">@(item.InternalStage is null ? "—" : Humanise(item.InternalStage.ToString()!))</td>
                            <td>@item.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private RhshfInternalStage activeStage = RhshfInternalStage.Appraisal;
    private bool showAll;
    private List<RhshfQueueItemDto> queue = [];
    private bool isLoading;
    private string? pageError;

    // Admin / head office get an "All" tab across every case regardless of status or stage.
    private bool CanSeeAll => (AuthService.CurrentUser?.HasAnyRole("SystemAdmin") ?? false)
        || (AuthService.CurrentUser?.IsHeadOffice ?? false);

    private bool CanAppraise => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CreditOfficer") ?? false;
    private bool CanReviewRisk => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "RiskManager") ?? false;
    private bool CanVoteOnCommittee => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CommitteeMember") ?? false;
    private bool CanRatify => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "FinalApprover") ?? false;
    private bool CanClearLegally => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "LegalOfficer") ?? false;
    private bool CanBookDisbursement => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "DisbursementOfficer") ?? false;

    protected override async Task OnInitializedAsync()
    {
        if (!CanAppraise && CanReviewRisk)
            activeStage = RhshfInternalStage.RiskReview;
        else if (!CanAppraise && !CanReviewRisk && CanVoteOnCommittee)
            activeStage = RhshfInternalStage.CommitteeVoting;
        else if (!CanAppraise && !CanReviewRisk && !CanVoteOnCommittee && CanRatify)
            activeStage = RhshfInternalStage.Ratification;
        else if (!CanAppraise && !CanReviewRisk && !CanVoteOnCommittee && !CanRatify && CanClearLegally)
            activeStage = RhshfInternalStage.LegalClearance;
        else if (!CanAppraise && !CanReviewRisk && !CanVoteOnCommittee && !CanRatify && !CanClearLegally && CanBookDisbursement)
            activeStage = RhshfInternalStage.Disbursement;

        await LoadQueue();
    }

    private async Task SwitchTab(RhshfInternalStage stage)
    {
        showAll = false;
        activeStage = stage;
        await LoadQueue();
    }

    private async Task SwitchToAll()
    {
        showAll = true;
        await LoadQueue();
    }

    private async Task LoadQueue()
    {
        isLoading = true;
        pageError = null;
        try
        {
            var user = AuthService.CurrentUser;
            // Branch-scoped like every other CRMS queue — HO sees everything, branch staff see
            // only their own branch (computed here, not deep in a child component).
            Guid? branchId = (user?.IsHeadOffice ?? false) ? null : user?.LocationId;
            queue = showAll
                ? await AppService.GetRhshfAllCasesAsync(branchId)
                : await AppService.GetRhshfStaffQueueAsync(activeStage, branchId);
        }
        catch (Exception ex)
        {
            pageError = $"Failed to load queue: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenReview(string reference) => Navigation.NavigateTo($"/rhshf/detail/{reference}");

    private static string StatusBadge(RhshfCaseStatus status) => status switch
    {
        RhshfCaseStatus.Approved => "badge-success",
        RhshfCaseStatus.Declined => "badge-danger",
        RhshfCaseStatus.Cancelled or RhshfCaseStatus.Expired => "badge-gray",
        RhshfCaseStatus.ProfilingPending or RhshfCaseStatus.ProfilingInProgress => "badge-warning",
        _ => "badge-primary",
    };

    // Insert spaces before capitals: "AwaitingOfferAcceptance" -> "Awaiting Offer Acceptance".
    private static string Humanise(string pascal) =>
        System.Text.RegularExpressions.Regex.Replace(pascal, "(?<=[a-z])(?=[A-Z])", " ");
}
