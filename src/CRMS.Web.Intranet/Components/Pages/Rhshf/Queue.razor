@page "/rhshf"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CRMS.Application.Rhshf.DTOs
@using CRMS.Domain.Enums
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>RH-SHF Queue - CRMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">RH-SHF Credit Profiling</h1>
        <p class="page-subtitle">Renewed Hope Dry Season — input-financing appraisal &amp; risk review</p>
    </div>
    <button class="btn btn-ghost btn-sm" @onclick="LoadQueue" disabled="@isLoading" title="Refresh queue">
        <span class="material-symbols-outlined" style="font-size: 18px; @(isLoading ? "animation: spin 1s linear infinite;" : "")">refresh</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger" style="margin-bottom: 1rem;">@pageError</div>
}

@* Every RH-SHF actor sees every stage: a case should be findable whatever stage it is in, by anyone
   who works the pipeline. Acting on it is a different question and stays gated — the detail page
   shows a stage's buttons only to that stage's role, and the domain refuses a second appraisal /
   risk review / vote for the same cycle. Each role still LANDS on its own stage (see
   OnInitializedAsync); the other tabs are there to look, not to act. *@
<div class="tabs">
    @foreach (var (stage, label) in StageTabs)
    {
        var isActive = !showAll && activeStage == stage;
        <div class="tab @(isActive ? "active" : "")" @onclick="() => SwitchTab(stage)">
            @label
            @if (isActive && queue.Count > 0)
            {
                <span class="badge badge-warning" style="margin-left: 6px;">@queue.Count</span>
            }
        </div>
    }
    <div class="tab @(showAll ? "active" : "")" @onclick="SwitchToAll">
        All
        @if (showAll && queue.Count > 0)
        {
            <span class="badge badge-gray" style="margin-left: 6px;">@queue.Count</span>
        }
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (isLoading)
        {
            <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
        }
        else if (queue.Count == 0)
        {
            <div class="p-6 text-center" style="color: var(--gray-500);">Nothing in this queue right now.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Company</th>
                        <th style="text-align: right;">Total EOP Value</th>
                        <th>Cycle</th>
                        <th>Status</th>
                        <th>Stage</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in queue)
                    {
                        <tr style="cursor: pointer;" @onclick="() => OpenReview(item.Reference)">
                            <td><code>@item.Reference</code></td>
                            <td>@item.CompanyName</td>
                            <td style="text-align: right;">@item.Currency @item.TotalEopValue.ToString("N2")</td>
                            <td>@item.CurrentCycleNumber</td>
                            <td><span class="badge @StatusBadge(item.Status)">@Humanise(item.Status.ToString())</span></td>
                            <td style="font-size: 0.85rem; color: var(--gray-600);">@(item.InternalStage is null ? "—" : Humanise(item.InternalStage.ToString()!))</td>
                            <td>@item.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private RhshfInternalStage activeStage = RhshfInternalStage.Appraisal;
    private bool showAll;
    private List<RhshfQueueItemDto> queue = [];
    private bool isLoading;
    private string? pageError;

    /// <summary>
    /// Every stage in flow order. PreDeploymentVerification and Active used to have no tab at all,
    /// which left a case invisible to the very officer who owns it — the only route in was the
    /// admin-only "All" list or a hand-typed URL.
    /// </summary>
    private static readonly (RhshfInternalStage Stage, string Label)[] StageTabs =
    [
        (RhshfInternalStage.Appraisal, "Appraisal"),
        (RhshfInternalStage.LegalClearance, "Legal Clearance"),
        (RhshfInternalStage.RiskReview, "Risk Review"),
        (RhshfInternalStage.CommitteeVoting, "Committee"),
        (RhshfInternalStage.Ratification, "Ratification"),
        (RhshfInternalStage.AwaitingOfferAcceptance, "Awaiting Offer"),
        (RhshfInternalStage.PreDeploymentVerification, "Pre-Deployment"),
        (RhshfInternalStage.Disbursement, "Disbursement"),
        (RhshfInternalStage.Active, "Active"),
    ];

    /// <summary>Where each role lands, so an officer still opens on their own work; every other tab
    /// is one click away. Order matters — the first matching role wins.</summary>
    private RhshfInternalStage DefaultStageForRole()
    {
        var user = AuthService.CurrentUser;
        if (user is null) return RhshfInternalStage.Appraisal;

        if (user.HasAnyRole("CreditOfficer")) return RhshfInternalStage.Appraisal;
        if (user.HasAnyRole("LegalOfficer")) return RhshfInternalStage.LegalClearance;
        if (user.HasAnyRole("RiskManager")) return RhshfInternalStage.RiskReview;
        if (user.HasAnyRole("CommitteeMember")) return RhshfInternalStage.CommitteeVoting;
        if (user.HasAnyRole("FinalApprover")) return RhshfInternalStage.Ratification;
        // The disbursement officer's first task is the gate, not the booking.
        if (user.HasAnyRole("DisbursementOfficer")) return RhshfInternalStage.PreDeploymentVerification;
        return RhshfInternalStage.Appraisal;
    }

    protected override async Task OnInitializedAsync()
    {
        activeStage = DefaultStageForRole();
        await LoadQueue();
    }

    private async Task SwitchTab(RhshfInternalStage stage)
    {
        showAll = false;
        activeStage = stage;
        await LoadQueue();
    }

    private async Task SwitchToAll()
    {
        showAll = true;
        await LoadQueue();
    }

    private async Task LoadQueue()
    {
        isLoading = true;
        pageError = null;
        try
        {
            var user = AuthService.CurrentUser;
            // Branch-scoped like every other CRMS queue — HO sees everything, branch staff see
            // only their own branch (computed here, not deep in a child component).
            Guid? branchId = (user?.IsHeadOffice ?? false) ? null : user?.LocationId;
            queue = showAll
                ? await AppService.GetRhshfAllCasesAsync(branchId)
                : await AppService.GetRhshfStaffQueueAsync(activeStage, branchId);
        }
        catch (Exception ex)
        {
            pageError = $"Failed to load queue: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenReview(string reference) => Navigation.NavigateTo($"/rhshf/detail/{reference}");

    private static string StatusBadge(RhshfCaseStatus status) => status switch
    {
        RhshfCaseStatus.Approved => "badge-success",
        RhshfCaseStatus.Declined => "badge-danger",
        RhshfCaseStatus.Cancelled or RhshfCaseStatus.Expired => "badge-gray",
        RhshfCaseStatus.ProfilingPending or RhshfCaseStatus.ProfilingInProgress => "badge-warning",
        _ => "badge-primary",
    };

    // Insert spaces before capitals: "AwaitingOfferAcceptance" -> "Awaiting Offer Acceptance".
    private static string Humanise(string pascal) =>
        System.Text.RegularExpressions.Regex.Replace(pascal, "(?<=[a-z])(?=[A-Z])", " ");
}
