@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums

<div class="card">
    <div class="card-header"><h3 class="card-title">Disbursement</h3></div>

    @if (History.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="material-symbols-outlined">account_balance</span></div>
            <div class="empty-state-title">Not yet disbursed</div>
            <div class="empty-state-text">This case has not yet been disbursed.</div>
        </div>
    }
    else
    {
        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var (d, i) in History.Select((d, i) => (d, i)))
            {
                <div style="@(i > 0 ? "border-top: 1px solid var(--gray-100); padding-top: 1rem;" : "")">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <span class="badge @StatusBadgeClass(d.Status)">@d.Status</span>
                        <span style="font-size: 0.8rem; color: var(--gray-500);">Cycle @d.CycleNumber &middot; @d.BookedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                        @if (d.Status == RhshfDisbursementStatus.Booked)
                        {
                            <span style="font-size: 0.8rem; color: var(--gray-700);">Fineract loan <code>@d.FineractLoanAccountNumber</code></span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(d.FailureReason))
                    {
                        <div style="font-size: 0.875rem; margin-top: 0.4rem; color: var(--danger-600);">@d.FailureReason</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<RhshfDisbursementDto> History { get; set; } = [];

    private static string StatusBadgeClass(RhshfDisbursementStatus status) => status switch
    {
        RhshfDisbursementStatus.Booked => "badge-success",
        RhshfDisbursementStatus.Failed => "badge-danger",
        _ => "badge-gray",
    };
}
