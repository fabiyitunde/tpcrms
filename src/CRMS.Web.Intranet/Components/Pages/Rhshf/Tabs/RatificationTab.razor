@using CRMS.Application.Rhshf.DTOs
@using CRMS.Domain.Enums

<div class="card">
    <div class="card-header"><h3 class="card-title">Ratification</h3></div>

    @if (Ratifications.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="material-symbols-outlined">task_alt</span></div>
            <div class="empty-state-title">Not yet ratified</div>
            <div class="empty-state-text">This case has not yet been ratified.</div>
        </div>
    }
    else
    {
        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var (r, i) in Ratifications.Select((r, i) => (r, i)))
            {
                <div style="@(i > 0 ? "border-top: 1px solid var(--gray-100); padding-top: 1rem;" : "")">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <span class="badge @OutcomeBadgeClass(r.Outcome)">@r.Outcome</span>
                        <strong style="font-size: 0.875rem;">@r.FinalApproverName</strong>
                        <span style="font-size: 0.8rem; color: var(--gray-500);">Cycle @r.CycleNumber &middot; @r.RatifiedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                        @if (r.ApprovedAmount is not null)
                        {
                            <span style="font-size: 0.8rem; font-weight: 600; color: var(--primary-700);">@Currency @r.ApprovedAmount.Value.ToString("N2")</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(r.Notes))
                    {
                        <div style="font-size: 0.875rem; margin-top: 0.4rem; color: var(--gray-700);">@r.Notes</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<RhshfRatificationDto> Ratifications { get; set; } = [];
    [Parameter] public string Currency { get; set; } = "NGN";

    private static string OutcomeBadgeClass(RhshfRatificationOutcome outcome) => outcome switch
    {
        RhshfRatificationOutcome.Ratified => "badge-success",
        RhshfRatificationOutcome.Declined => "badge-danger",
        RhshfRatificationOutcome.ReturnToFac => "badge-warning",
        _ => "badge-gray",
    };
}
