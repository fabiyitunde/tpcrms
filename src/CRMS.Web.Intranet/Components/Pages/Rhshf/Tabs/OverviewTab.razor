@using CRMS.Application.Rhshf.DTOs
@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums

@* Mirrors Corporate's OverviewTab structure: two side-by-side info cards + a full-width summary
   stat row, using the same info-grid / summary-stat layout. RH-SHF peculiarities (the EOP
   breakdown, the directors capture, the decision record) are kept as additional full-width cards
   below, which Corporate's Overview has no equivalent for. Status lives in the page header badge
   and the Workflow tab, same as Corporate — the old Case Status / Stage Progression side column is
   gone. Directors management stays here for now; it moves to its own tab (mirroring Corporate's
   Directors & Signatories) in the next step. *@

<div class="grid grid-cols-2 gap-6">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">FAC Information</h3>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Company Name</span>
                    <span class="info-value">@Workspace.CompanyName</span>
                </div>
                <div class="info-item">
                    <span class="info-label">BOA Account</span>
                    <span class="info-value">@Workspace.BoaAccountNumber</span>
                </div>
                <div class="info-item">
                    <span class="info-label">RC Number</span>
                    <span class="info-value">@Workspace.RcNumber</span>
                </div>
                <div class="info-item">
                    <span class="info-label">TIN</span>
                    <span class="info-value">@(string.IsNullOrWhiteSpace(Workspace.Tin) ? "Not provided" : Workspace.Tin)</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Location</span>
                    <span class="info-value">@Workspace.Lga, @Workspace.State</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Farmers Served</span>
                    <span class="info-value">@(Workspace.FarmerCount?.ToString("N0") ?? "N/A")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Received</span>
                    <span class="info-value">@Workspace.ReceivedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Submission ID</span>
                    <span class="info-value" style="font-size: var(--text-xs);">@Workspace.SubmissionId</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Facility Details</h3>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Product</span>
                    <span class="info-value">RH-SHF Dry Season Input Financing</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Requested Amount</span>
                    <span class="info-value" style="color: var(--primary-600); font-weight: 600;">@Workspace.Currency @Workspace.TotalEopValue.ToString("N2")</span>
                </div>
                @if (Workspace.ApprovedAmount.HasValue)
                {
                    <div class="info-item">
                        <span class="info-label">Approved Amount</span>
                        <span class="info-value" style="color: var(--success-600); font-weight: 600;">@Workspace.Currency @Workspace.ApprovedAmount.Value.ToString("N2")</span>
                    </div>
                }
                <div class="info-item">
                    <span class="info-label">Committee Tier</span>
                    <span class="info-value">
                        @if (Workspace.CommitteeTier is not null)
                        {
                            <span class="badge badge-primary">@Workspace.CommitteeTier</span>
                            <span style="font-size: var(--text-xs); color: var(--gray-500);"> routed by @Workspace.Currency @Workspace.TotalEopValue.ToString("N0") (@Workspace.CommitteeTierBand)</span>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </span>
                </div>
                <div class="info-item">
                    <span class="info-label">Currency</span>
                    <span class="info-value">@Workspace.Currency</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Cycle</span>
                    <span class="info-value">@Workspace.CurrentCycleNumber</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Bureau Outcome</span>
                    <span class="info-value">@Workspace.BureauCheckOutcome</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Workspace.BranchResolutionNote))
                {
                    <div class="info-item full-width">
                        <span class="info-label">Branch Routing</span>
                        <span class="info-value">@Workspace.BranchResolutionNote</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card" style="grid-column: span 2;">
        <div class="card-header">
            <h3 class="card-title">Application Summary</h3>
        </div>
        <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6);">
                <div class="summary-stat">
                    <div class="summary-stat-value">@(Directors?.Directors.Count ?? 0)</div>
                    <div class="summary-stat-label">Directors</div>
                </div>
                <div class="summary-stat">
                    <div class="summary-stat-value">@Workspace.SupportingDocuments.Count</div>
                    <div class="summary-stat-label">Documents</div>
                </div>
                <div class="summary-stat">
                    <div class="summary-stat-value">@Workspace.EopLines.Count</div>
                    <div class="summary-stat-label">EOP Lines</div>
                </div>
                <div class="summary-stat">
                    <div class="summary-stat-value">@(Workspace.FarmerCount?.ToString("N0") ?? "0")</div>
                    <div class="summary-stat-label">Farmers</div>
                </div>
            </div>
        </div>
    </div>

    <!-- EOP Breakdown — RH-SHF peculiarity; no Corporate equivalent -->
    <div class="card" style="grid-column: span 2;">
        <div class="card-header"><h3 class="card-title">EOP Breakdown</h3></div>
        @if (Workspace.EopLines.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="material-symbols-outlined">agriculture</span></div>
                <div class="empty-state-title">No EOP lines</div>
                <div class="empty-state-text">No commodity lines were submitted for this cycle.</div>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Commodity</th>
                            @if (ShowEopQuantities)
                            {
                                <th style="text-align: right;">Qty (kg)</th>
                                <th style="text-align: right;">Unit Price</th>
                            }
                            <th style="text-align: right;">Line Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Workspace.EopLines)
                        {
                            <tr>
                                <td>@line.Commodity</td>
                                @if (ShowEopQuantities)
                                {
                                    <td style="text-align: right;">@(line.QuantityKg > 0 ? line.QuantityKg.ToString("N0") : "—")</td>
                                    <td style="text-align: right;">@(line.UnitPricePerKg > 0 ? line.UnitPricePerKg.ToString("N2") : "—")</td>
                                }
                                <td style="text-align: right; font-weight: 600;">@line.LineValue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!ShowEopQuantities)
            {
                <div style="padding: 0 1rem 0.75rem; font-size: 0.8rem; color: var(--gray-500);">
                    The portal records input quantities per item (bags, litres), not a tonnage of the
                    commodity grown, so no per-commodity quantity is available. Values are exact.
                </div>
            }
            <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 600; color: var(--gray-700);">Total EOP Value</span>
                <span style="font-weight: 700; font-size: 1.05rem; color: var(--primary-700);">@Workspace.Currency @Workspace.TotalEopValue.ToString("N2")</span>
            </div>
        }
    </div>

    @if (Workspace.DecisionOutcome is not null || Workspace.Status is RhshfCaseStatus.Cancelled)
    {
        <div class="card" style="grid-column: span 2;">
            <div class="card-header"><h3 class="card-title">Decision</h3></div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Outcome</span>
                        <span class="info-value">
                            <span class="badge @DecisionBadgeClass()">@(Workspace.DecisionOutcome?.ToString() ?? "Cancelled")</span>
                        </span>
                    </div>
                    @if (Workspace.ApprovedAmount.HasValue)
                    {
                        <div class="info-item">
                            <span class="info-label">Approved Amount</span>
                            <span class="info-value">@Workspace.Currency @Workspace.ApprovedAmount.Value.ToString("N2")</span>
                        </div>
                    }
                    <div class="info-item">
                        <span class="info-label">Decided At</span>
                        <span class="info-value">@(Workspace.DecidedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "—")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Decided By</span>
                        <span class="info-value">@(Workspace.DecidedBy ?? "—")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Workspace.DecisionNotes))
                    {
                        <div class="info-item full-width">
                            <span class="info-label">Notes</span>
                            <span class="info-value">@Workspace.DecisionNotes</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-4);
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .info-item.full-width {
        grid-column: span 2;
    }

    .info-label {
        font-size: var(--text-xs);
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .info-value {
        font-size: var(--text-sm);
        color: var(--gray-800);
    }

    .summary-stat {
        text-align: center;
        padding: var(--space-4);
        background: var(--gray-50);
        border-radius: var(--radius-lg);
    }

    .summary-stat-value {
        font-size: var(--text-3xl);
        font-weight: 700;
        color: var(--primary-600);
    }

    .summary-stat-label {
        font-size: var(--text-sm);
        color: var(--gray-500);
        margin-top: var(--space-1);
    }
</style>

@code {
    [Parameter, EditorRequired] public RhshfCaseWorkspaceDto Workspace { get; set; } = null!;
    // Directors list is passed for the Application Summary count only — management lives on the
    // Directors & Signatories tab now (mirroring Corporate's Parties tab).
    [Parameter] public RhshfDirectorsDto? Directors { get; set; }

    // The portal sends quantityKg/unitPricePerKg as 0 by design — it holds quantities per input
    // (bags, litres), never a tonnage of the commodity grown. Rendering a "0 kg" measurement invites
    // a credit officer to treat the whole EOP as nonsense, so the columns drop when none carry one.
    private bool ShowEopQuantities => Workspace.EopLines.Any(l => l.QuantityKg > 0 || l.UnitPricePerKg > 0);

    private string DecisionBadgeClass() => Workspace.DecisionOutcome switch
    {
        RhshfDecisionOutcome.Approved => "badge-success",
        RhshfDecisionOutcome.Declined => "badge-danger",
        _ => "badge-gray",
    };
}
