@inject CRMS.Web.Intranet.Services.RhshfDocumentLinks Links
@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums

<div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Offer</h3>
                <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 2px;">Read-only — accepting/rejecting the offer is the FAC's own action on their offer-acceptance page.</div>
            </div>
            @if (Offer is not null)
            {
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    @if (!string.IsNullOrEmpty(Offer.OfferDocumentPath))
                    {
                        <a href="@Links.Sign($"/api/rhshf-offer-letters/{Reference}/view")" target="_blank" rel="noopener" class="btn btn-outline btn-sm" title="View the generated offer letter">
                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">visibility</span> View letter
                        </a>
                        <a href="@Links.Sign($"/api/rhshf-offer-letters/{Reference}/download")" class="btn btn-ghost btn-sm" title="Download the offer letter PDF">
                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">download</span>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Offer.KfsDocumentPath))
                    {
                        <a href="@Links.Sign($"/api/rhshf-offer-kfs/{Reference}/view")" target="_blank" rel="noopener" class="btn btn-outline btn-sm" title="View the Key Facts Statement">
                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">description</span> View KFS
                        </a>
                        <a href="@Links.Sign($"/api/rhshf-offer-kfs/{Reference}/download")" class="btn btn-ghost btn-sm" title="Download the Key Facts Statement PDF">
                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">download</span>
                        </a>
                    }
                    @if (CanRegenerate)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="() => OnRegenerate.InvokeAsync()" disabled="@IsRegenerating" title="Re-create the offer letter PDF (recovery, before the FAC responds)">
                            @if (IsRegenerating) { <span class="spinner" style="width: 12px; height: 12px;"></span> }
                            else { <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">sync</span> }
                            Regenerate
                        </button>
                    }
                    @if (CanIssueCorrected)
                    {
                        <button class="btn btn-warning btn-sm" @onclick="() => OnIssueCorrected.InvokeAsync()" title="This offer is wrong: issue a corrected one for the FAC to accept. This offer, and any signed copy, is kept on record.">
                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">edit_document</span>
                            Issue corrected offer
                        </button>
                    }
                    @if (CanResendCallback)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="() => OnResendCallback.InvokeAsync()" disabled="@IsResendingCallback" title="Re-send the OfferReady notification to the portal (if the automatic callback failed)">
                            @if (IsResendingCallback) { <span class="spinner" style="width: 12px; height: 12px;"></span> }
                            else { <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">send</span> }
                            Re-send to portal
                        </button>
                    }
                    @if (CanCopyLink)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="() => OnCopyLink.InvokeAsync()" title="Copy the FAC offer-acceptance link with a token (testing only — hidden in production)">
                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">link</span> Copy accept link
                        </button>
                    }
                    <span class="badge @StatusBadgeClass(Offer.Status)">@Offer.Status</span>
                </div>
            }
        </div>

        @if (Offer is null)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="material-symbols-outlined">request_quote</span></div>
                <div class="empty-state-title">No offer yet</div>
                <div class="empty-state-text">No offer has been generated for this cycle yet.</div>
            </div>
        }
        else
        {
            <div class="card-body">
                @* Core banking is configured to deduct something this EOP already financed. The letter
                   is correct — the charge was left off it — but the deduction still happens at booking
                   until somebody changes the product, so this has to reach a person, not just a log. *@
                @if (!string.IsNullOrEmpty(Offer.SuppressedProductFees))
                {
                    <div class="alert alert-warning" style="margin-bottom: 1rem; font-size: 0.875rem;">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle;">error</span>
                        <strong>Core banking would charge this borrower twice.</strong>
                        The loan product in core banking charges <strong>@Offer.SuppressedProductFees</strong>,
                        which this EOP already finances. It was left off the offer letter, but core banking
                        will still deduct it at disbursement until the product is corrected.
                        <div style="margin-top: 0.4rem;">
                            Ask whoever maintains the core banking product to remove that charge, then use
                            Regenerate to re-check. The programme's rule is that the approved EOP, this letter
                            and the booking must reconcile to the same figures.
                        </div>
                    </div>
                }
                @if (string.IsNullOrEmpty(Offer.OfferDocumentPath))
                {
                    <div class="alert alert-warning" style="margin-bottom: 1rem; font-size: 0.875rem;">
                        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle;">warning</span>
                        The offer letter file is not available for this case.
                        @(CanRegenerate ? "Use Regenerate above to re-create it." : "A Final Approver can regenerate it.")
                    </div>
                }
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                    @FieldChip("Approved Amount", Offer.ApprovedAmount is not null ? $"{Offer.Currency} {Offer.ApprovedAmount.Value:N2}" : null)
                    @FieldChip("Generated", Offer.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm"))
                    @FieldChip("FAC Responded", Offer.FacRespondedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm"))
                </div>
                @if (!string.IsNullOrEmpty(Offer.FacResponseNotes))
                {
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
                        <div class="field-chip-label" style="margin-bottom: 0.35rem;">FAC Notes</div>
                        <div style="font-size: 0.875rem; color: var(--gray-700);">@Offer.FacResponseNotes</div>
                    </div>
                }
            </div>
        }
    </div>

    @if (Offer is not null && !string.IsNullOrEmpty(Offer.OfferDocumentPath))
    {
        <div class="card">
            <div class="card-header" style="cursor: pointer;" @onclick="() => showPreview = !showPreview">
                <h3 class="card-title">Offer Letter Preview</h3>
                <span class="material-symbols-outlined" style="color: var(--gray-500);">@(showPreview ? "expand_less" : "expand_more")</span>
            </div>
            @if (showPreview)
            {
                <div class="card-body" style="padding: 0;">
                    <iframe src="@Links.Sign($"/api/rhshf-offer-letters/{Reference}/view")" title="Offer letter"
                            style="width: 100%; height: 640px; border: 0; display: block;"></iframe>
                </div>
            }
        </div>
    }

    @if (Offer is not null)
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Signed Copies</h3>
                <span class="badge badge-gray">@Offer.SignedDocuments.Count</span>
            </div>
            @if (Offer.SignedDocuments.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><span class="material-symbols-outlined">draw</span></div>
                    <div class="empty-state-title">Not uploaded yet</div>
                    <div class="empty-state-text">The FAC has not uploaded a signed copy yet.</div>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="table">
                        <thead><tr><th>File</th><th style="text-align: right;">Size</th><th>Uploaded</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var doc in Offer.SignedDocuments)
                            {
                                <tr>
                                    <td>
                                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--gray-500);">attach_file</span>
                                        @doc.FileName
                                        <span class="badge badge-gray" style="margin-left: 6px; font-size: 0.65rem;">@KindLabel(doc.Kind)</span>
                                    </td>
                                    <td style="text-align: right; font-size: 0.8rem; color: var(--gray-500);">@((doc.SizeBytes / 1024.0).ToString("N0")) KB</td>
                                    <td style="font-size: 0.8rem; color: var(--gray-500);">@doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <button class="btn btn-ghost btn-sm" title="Download" @onclick='() => OnDownload.InvokeAsync(doc.Id)'>
                                            <span class="material-symbols-outlined" style="font-size: 16px;">download</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @* Every version, so an officer can see what the FAC accepted before a correction replaced it and
       open its signed copy. The card above only ever shows the current offer. *@
    @if (History.Count > 1)
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Version history</h3>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr><th>Version</th><th>Issued</th><th>Status</th><th>FAC response</th><th>Signed copies</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in History)
                        {
                            <tr>
                                <td>
                                    Version @v.Version
                                    @if (v.IsCurrent) { <span class="badge badge-primary" style="margin-left: 4px;">Current</span> }
                                </td>
                                <td>@v.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td><span class="badge @HistoryBadge(v.Status)">@HistoryLabel(v)</span></td>
                                <td>@(v.FacRespondedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "—")</td>
                                <td>
                                    @if (v.SignedDocuments.Count == 0) { <span class="text-muted">None</span> }
                                    @foreach (var doc in v.SignedDocuments)
                                    {
                                        <button class="btn btn-ghost btn-sm" title="Download @doc.FileName" @onclick='() => OnDownload.InvokeAsync(doc.Id)'>
                                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">download</span>
                                            @KindLabel(doc.Kind)
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<RhshfOfferHistoryItemDto> History { get; set; } = [];

    /// <summary>"Accepted, then superseded" rather than just "Superseded": that a version was
    /// accepted before it was replaced is the part an officer needs to see.</summary>
    private static string HistoryLabel(RhshfOfferHistoryItemDto v) => v.Status switch
    {
        RhshfOfferStatus.Superseded when v.FacRespondedAt is not null => "Accepted, then superseded",
        RhshfOfferStatus.Superseded => "Superseded unanswered",
        RhshfOfferStatus.Generated or RhshfOfferStatus.AwaitingFacResponse => "Awaiting FAC acceptance",
        _ => v.Status.ToString(),
    };

    private static string HistoryBadge(RhshfOfferStatus status) => status switch
    {
        RhshfOfferStatus.Accepted => "badge-success",
        RhshfOfferStatus.Rejected => "badge-danger",
        RhshfOfferStatus.Superseded => "badge-gray",
        _ => "badge-warning",
    };

    [Parameter] public RhshfOfferDto? Offer { get; set; }
    [Parameter] public string Reference { get; set; } = "";
    [Parameter] public bool CanRegenerate { get; set; }
    [Parameter] public bool IsRegenerating { get; set; }
    [Parameter] public EventCallback OnRegenerate { get; set; }
    [Parameter] public bool CanIssueCorrected { get; set; }
    [Parameter] public EventCallback OnIssueCorrected { get; set; }
    [Parameter] public bool CanResendCallback { get; set; }
    [Parameter] public bool IsResendingCallback { get; set; }
    [Parameter] public EventCallback OnResendCallback { get; set; }

    [Parameter] public bool CanCopyLink { get; set; }
    [Parameter] public EventCallback OnCopyLink { get; set; }

    // Collapsed by default — View/Download already cover reading it; the inline preview is opt-in.
    private bool showPreview;

    private static string KindLabel(RhshfOfferDocumentKind kind) => kind switch
    {
        RhshfOfferDocumentKind.SignedOfferLetter => "Offer letter",
        RhshfOfferDocumentKind.SignedKfs => "KFS",
        _ => "Other",
    };
    // Currency/TotalEopValue used to be passed in so this tab could synthesise the approved amount
    // from the case total. The offer now carries its own amount and currency, so they're gone.
    [Parameter] public EventCallback<Guid> OnDownload { get; set; }

    private static RenderFragment FieldChip(string label, string? value) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "field-chip");
        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "class", "field-chip-label");
        __builder.AddContent(4, label);
        __builder.CloseElement();
        __builder.OpenElement(5, "div");
        __builder.AddAttribute(6, "class", "field-chip-value");
        __builder.AddContent(7, value);
        __builder.CloseElement();
        __builder.CloseElement();
    };

    private static string StatusBadgeClass(RhshfOfferStatus status) => status switch
    {
        RhshfOfferStatus.Accepted => "badge-success",
        RhshfOfferStatus.Rejected or RhshfOfferStatus.Expired => "badge-danger",
        _ => "badge-warning",
    };
}
