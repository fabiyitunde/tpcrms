@using CRMS.Application.Rhshf.DTOs
@using CRMS.Domain.Enums

<div class="card">
    <div class="card-header"><h3 class="card-title">Appraisal</h3></div>

    @if (Appraisals.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="material-symbols-outlined">psychology</span></div>
            <div class="empty-state-title">No appraisal yet</div>
            <div class="empty-state-text">No appraisal has been recorded for this case yet.</div>
        </div>
    }
    else
    {
        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var (a, i) in Appraisals.Select((a, i) => (a, i)))
            {
                <div style="@(i > 0 ? "border-top: 1px solid var(--gray-100); padding-top: 1rem;" : "")">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <span class="badge @OutcomeBadgeClass(a.Outcome)">@a.Outcome</span>
                        <strong style="font-size: 0.875rem;">@a.CreditOfficerName</strong>
                        <span style="font-size: 0.8rem; color: var(--gray-500);">Cycle @a.CycleNumber &middot; @a.AppraisedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(a.Notes))
                    {
                        <div style="font-size: 0.875rem; margin-top: 0.4rem; color: var(--gray-700);">@a.Notes</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<RhshfAppraisalDto> Appraisals { get; set; } = [];

    private static string OutcomeBadgeClass(RhshfAppraisalOutcome outcome) => outcome switch
    {
        RhshfAppraisalOutcome.Proceed => "badge-success",
        RhshfAppraisalOutcome.Decline => "badge-danger",
        RhshfAppraisalOutcome.ReturnToFac => "badge-warning",
        _ => "badge-gray",
    };
}
