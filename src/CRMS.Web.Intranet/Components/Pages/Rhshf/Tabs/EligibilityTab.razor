@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums

<div class="card">
    <div class="card-header">
        <div>
            <h3 class="card-title">Eligibility Checklist</h3>
            <div style="font-size: 0.75rem; color: var(--gray-500); margin-top: 2px;">Institutional eligibility criteria per the RH-SHF programme (S/N 15)</div>
        </div>
    </div>

    @if (Checks.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="material-symbols-outlined">checklist</span></div>
            <div class="empty-state-title">Not yet recorded</div>
            <div class="empty-state-text">The eligibility checklist has not been recorded for this cycle yet.</div>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table">
                <thead><tr><th>Criterion</th><th>Status</th><th>Notes</th><th>Verified By</th></tr></thead>
                <tbody>
                @foreach (var check in Checks)
                {
                    <tr>
                        <td>@FormatCriterion(check.Criterion)</td>
                        <td>
                            @if (check.IsSatisfied)
                            {
                                <span class="badge badge-success">Satisfied</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Not Satisfied</span>
                            }
                        </td>
                        <td style="font-size: 0.85rem; color: var(--gray-600);">@(check.Notes ?? "—")</td>
                        <td style="font-size: 0.8rem; color: var(--gray-500); white-space: nowrap;">
                            <div style="font-weight: 500; color: var(--gray-700);">@check.VerifiedByName</div>
                            <div>@check.VerifiedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<RhshfEligibilityCheckDto> Checks { get; set; } = [];

    private static string FormatCriterion(RhshfEligibilityCriterion criterion) => criterion switch
    {
        RhshfEligibilityCriterion.CacIncorporation => "Full incorporation with the Corporate Affairs Commission (CAC)",
        RhshfEligibilityCriterion.AggregationTrackRecord => "Verifiable track record in agricultural aggregation and logistics",
        RhshfEligibilityCriterion.OutGrowerNetwork => "Active, mapped out-grower network and farmer clusters",
        RhshfEligibilityCriterion.WarehousingAndTransport => "Adequate, secure warehousing and transport infrastructure",
        RhshfEligibilityCriterion.OffTakeAgreements => "Formalized, legally binding market linkage or off-take agreements",
        RhshfEligibilityCriterion.BoaOperationalAccount => "Operational commercial account with the Bank of Agriculture (BOA)",
        RhshfEligibilityCriterion.AuditedFinancials => "Valid audited financial statements and statutory compliance filings",
        RhshfEligibilityCriterion.CleanBureauAndCrmsReports => "Clean Credit Bureau and Central Bank CRMS reports",
        RhshfEligibilityCriterion.ZeroNplHistory => "Zero history of non-performing loans (NPLs) within the financial system",
        RhshfEligibilityCriterion.BoaFrameworkCompliance => "Strict compliance with BOA's operational and risk management framework",
        RhshfEligibilityCriterion.SmallholderBiometricRegistration => "Smallholders formally registered, biometrically captured, and verified under an accredited aggregator",
        _ => criterion.ToString(),
    };
}
