@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums

@* Mirrors Corporate's CollateralTab idiom: a single "Collateral" card with a table (Type, details,
   value, status, recorded, actions) and a totals footer, plus a View-details modal like Corporate's
   ViewCollateralModal. RH-SHF collateral is heterogeneous (bank guarantee / NIRSAL CRG / legal
   mortgage) with no valuation / approval / FSV / LTV lifecycle, so those columns and the
   edit/delete/valuation/approve actions Corporate carries are deliberately absent — the detail
   modal shows the type-specific fields instead. *@

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Collateral</h3>
        <span class="badge badge-primary">@Records.Count</span>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (LegalClearance is not null)
        {
            <div style="padding: 10px 16px; border-bottom: 1px solid var(--gray-100); background: var(--gray-50); font-size: 0.85rem;">
                <span class="badge @LegalBadgeClass(LegalClearance.Outcome)">Legal: @LegalClearance.Outcome</span>
                <span style="margin-left: 8px; color: var(--gray-600);">
                    by <strong style="color: var(--gray-800);">@LegalClearance.LegalOfficerName</strong>
                    &middot; @LegalClearance.ClearedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                </span>
                @if (!string.IsNullOrWhiteSpace(LegalClearance.Comments))
                {
                    <div style="margin-top: 4px; color: var(--gray-700);">&ldquo;@LegalClearance.Comments&rdquo;</div>
                }
            </div>
        }
        @if (CanAssertPerfection)
        {
            @* Legal's job here is to confirm what the FAC declared, instrument by instrument — not to
               enter anything fresh. The progress line is the whole point of the stage at a glance. *@
            <div style="padding: 12px 16px; border-bottom: 1px solid var(--gray-100); background: var(--primary-50);">
                <div style="font-weight: 600; color: var(--gray-800);">
                    @PerfectedCount of @Records.Count instrument(s) confirmed
                </div>
                <div style="font-size: var(--text-sm); color: var(--gray-600); margin-top: 2px;">
                    The FAC declared this security during profiling. Open each one, check it against its
                    document, and record your perfection decision. Only once all are confirmed can this
                    case be granted outright — otherwise use <strong>Grant with Caveat</strong>.
                </div>
            </div>
        }
        @if (Records.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="material-symbols-outlined">security</span></div>
                <div class="empty-state-title">No collateral declared</div>
                <div class="empty-state-text">The FAC declares its security on the profiling form before submitting; anything declared appears here.</div>
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Details</th>
                        <th style="text-align: right;">Value</th>
                        <th>Status</th>
                        <th>Recorded</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Records)
                    {
                        var current = record;
                        <tr>
                            <td><span class="badge badge-gray">@FormatType(record.Type)</span></td>
                            <td>
                                <div style="font-weight: 500;">@PrimaryDetail(record)</div>
                                @if (!string.IsNullOrEmpty(record.ReferenceNumber))
                                {
                                    <div style="font-size: var(--text-xs); color: var(--gray-500);"><code>@record.ReferenceNumber</code></div>
                                }
                            </td>
                            <td style="text-align: right; font-weight: 600;">
                                @(SecuredValue(record) is decimal v ? v.ToString("N2") : "—")
                            </td>
                            <td>
                                @StatusBadge(record)
                                @if (record.PerfectedAt.HasValue)
                                {
                                    <div style="font-size: var(--text-xs); color: var(--gray-500); margin-top: 2px;">
                                        by @(record.PerfectedByName ?? "—") · @record.PerfectedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>
                                }
                            </td>
                            <td>
                                <div style="font-size: var(--text-sm);">@record.RecordedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                <div style="font-size: var(--text-xs); color: var(--gray-500);">by @record.RecordedByName</div>
                            </td>
                            <td>
                                <div style="display: flex; gap: var(--space-2); align-items: center;">
                                    @if (CanAssertPerfection)
                                    {
                                        @* At the legal stage the row's action is the decision, not a peek. *@
                                        <button type="button"
                                                class="btn btn-sm @(record.PerfectionStatus == RhshfCollateralPerfectionStatus.Perfected ? "btn-outline" : "btn-primary")"
                                                @onclick="() => View(current)">
                                            @(record.PerfectionStatus == RhshfCollateralPerfectionStatus.Perfected ? "Review" : "Confirm")
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" title="View details" @onclick="() => View(current)">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">visibility</span>
                                        </button>
                                    }
                                    @if (record.Documents.Count > 0)
                                    {
                                        <span class="badge badge-gray" title="@record.Documents.Count document(s)" style="align-self: center;">
                                            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: middle;">attach_file</span> @record.Documents.Count
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger" title="No document attached" style="align-self: center;">no document</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Records.Any(r => SecuredValue(r) is not null))
            {
                <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 600; color: var(--gray-700);">Total Secured Value</span>
                    <span style="font-weight: 700; font-size: 1.05rem; color: var(--primary-700);">
                        @Records.Sum(r => SecuredValue(r) ?? 0).ToString("N2")
                    </span>
                </div>
            }
        }
    </div>
</div>

@if (_selected is not null)
{
    <div class="modal-backdrop show" @onclick="Close">
        <div class="modal" style="max-width: 640px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@FormatType(_selected.Type)</h3>
                <button class="modal-close" @onclick="Close"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="modal-body">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                    @FieldChip("Reference", _selected.ReferenceNumber)
                    @if (_selected.Type == RhshfCollateralType.BankGuarantee)
                    {
                        @FieldChip("Guarantor Bank", _selected.GuarantorBankName)
                        @FieldChip("Guarantee Amount", _selected.GuaranteeAmount?.ToString("N2"))
                        @FieldChip("Unconditional", _selected.IsUnconditional == true ? "Yes" : "No")
                    }
                    else if (_selected.Type == RhshfCollateralType.NirsalCrg)
                    {
                        @FieldChip("CRG Coverage", _selected.CrgCoveragePercentage.HasValue ? $"{_selected.CrgCoveragePercentage:N1}%" : null)
                    }
                    else if (_selected.Type == RhshfCollateralType.LegalMortgage)
                    {
                        @FieldChip("Property", _selected.PropertyDescription)
                        @FieldChip("Value", _selected.PropertyValue?.ToString("N2"))
                        @FieldChip("Title Reference", _selected.TitleReferenceNumber)
                        @FieldChip("Registration Authority", _selected.RegistrationAuthority)
                    }
                    @FieldChip("Perfection", _selected.PerfectionStatus?.ToString() ?? "Not yet asserted")
                    @if (_selected.PerfectedAt.HasValue)
                    {
                        @FieldChip("Perfected By", $"{_selected.PerfectedByName ?? "—"} · {_selected.PerfectedAt.Value.ToLocalTime():MMM dd, yyyy HH:mm}")
                    }
                    @FieldChip("Legal Note", _selected.PerfectionNote)
                    @FieldChip("Issued", _selected.IssuedDate?.ToLocalTime().ToString("MMM dd, yyyy"))
                    @FieldChip("Expiry", _selected.ExpiryDate?.ToLocalTime().ToString("MMM dd, yyyy"))
                    @FieldChip("Recorded By", $"{_selected.RecordedByName} · {_selected.RecordedAt.ToLocalTime():MMM dd, yyyy HH:mm}")
                </div>
                @if (!string.IsNullOrEmpty(_selected.Notes))
                {
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
                        <div class="field-chip-label" style="margin-bottom: 0.35rem;">Notes</div>
                        <div style="font-size: 0.875rem; color: var(--gray-700);">@_selected.Notes</div>
                    </div>
                }

                <div style="margin-top: 1.25rem;">
                    <div class="field-chip-label" style="margin-bottom: 0.5rem;">Documents</div>
                    @if (_selected.Documents.Count == 0)
                    {
                        <div style="font-size: var(--text-sm); color: var(--gray-500);">No documents attached.</div>
                    }
                    else
                    {
                        <table class="table">
                            <thead><tr><th>File</th><th style="text-align: right;">Size</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var doc in _selected.Documents)
                                {
                                    <tr>
                                        <td>
                                            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--gray-500);">attach_file</span>
                                            @doc.FileName
                                        </td>
                                        <td style="text-align: right; font-size: 0.8rem; color: var(--gray-500);">@((doc.SizeBytes / 1024.0).ToString("N0")) KB</td>
                                        <td style="white-space: nowrap;">
                                            <a href="/api/rhshf-collateral-documents/@doc.Id/view" target="_blank" rel="noopener"
                                               class="btn btn-ghost btn-sm" title="View in browser">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                            </a>
                                            <button class="btn btn-ghost btn-sm" title="Download" @onclick="() => OnDownloadDocument.InvokeAsync(doc.Id)">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">download</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                @if (CanAssertPerfection)
                {
                    @* Legal's own assertion, made before the case is circulated for voting. Any title
                       reference / registration authority established during perfection is captured with it. *@
                    <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
                        <div class="field-chip-label" style="margin-bottom: 0.5rem;">Your decision on this instrument</div>
                        @if (_selected.Type == RhshfCollateralType.LegalMortgage)
                        {
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem;">
                                <input class="form-control" placeholder="Title reference" @bind="_perfectionTitleReference" />
                                <input class="form-control" placeholder="Registration authority" @bind="_perfectionRegistrationAuthority" />
                            </div>
                        }
                        <textarea class="form-control" rows="2" style="margin-bottom: 0.5rem;"
                                  placeholder="Your note on this instrument — what you sighted, anything outstanding (optional)"
                                  @bind="_perfectionNote"></textarea>
                        <div style="font-size: var(--text-xs); color: var(--gray-500); margin-bottom: 0.5rem;">
                            Need more evidence on file? Attach it below — this is the FAC's declaration, so their own
                            details and note are left as submitted.
                        </div>
                        @if (_selected.Documents.Count == 0)
                        {
                            <div style="font-size: var(--text-sm); color: var(--danger-color);">
                                Attach the instrument's document first — it can't be marked perfected with no evidence on file.
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(PerfectionError))
                        {
                            <div class="alert alert-danger" style="margin-top: 0.5rem;">@PerfectionError</div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (CanUpload)
                {
                    <InputFile OnChange="e => UploadFile(_selected.Id, e)" class="form-control" style="flex: 1;" />
                }
                @if (CanAssertPerfection)
                {
                    @if (_selected.PerfectionStatus == RhshfCollateralPerfectionStatus.Perfected)
                    {
                        <button class="btn btn-warning" disabled="@IsAssertingPerfection"
                                @onclick="() => AssertPerfection(RhshfCollateralPerfectionStatus.Pending)">
                            Mark as pending
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" disabled="@(IsAssertingPerfection || _selected.Documents.Count == 0)"
                                @onclick="() => AssertPerfection(RhshfCollateralPerfectionStatus.Perfected)">
                            @if (IsAssertingPerfection) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                            Mark as perfected
                        </button>
                    }
                }
                <button class="btn btn-secondary" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<RhshfCollateralDto> Records { get; set; } = [];
    [Parameter] public bool CanUpload { get; set; }
    [Parameter] public EventCallback<(Guid CollateralId, string FileName, string ContentType, byte[] Content)> OnUploadDocument { get; set; }
    [Parameter] public EventCallback<Guid> OnDownloadDocument { get; set; }
    /// <summary>The current cycle's legal clearance (outcome + officer + comment), shown as context since
    /// collateral/security gets its legal sign-off at that stage. Null until a clearance is recorded.</summary>
    [Parameter] public RhshfLegalClearanceDto? LegalClearance { get; set; }

    /// <summary>True only for the Legal Officer while the case sits at legal clearance — perfection is
    /// theirs to assert, and only before the case is circulated for voting.</summary>
    [Parameter] public bool CanAssertPerfection { get; set; }
    [Parameter] public EventCallback<(Guid CollateralId, RhshfCollateralPerfectionStatus Status, string? TitleReference, string? RegistrationAuthority, string? Note)> OnAssertPerfection { get; set; }
    [Parameter] public bool IsAssertingPerfection { get; set; }
    [Parameter] public string? PerfectionError { get; set; }

    private string? _perfectionTitleReference;
    private string? _perfectionRegistrationAuthority;
    private string? _perfectionNote;

    private int PerfectedCount => Records.Count(r => r.PerfectionStatus == RhshfCollateralPerfectionStatus.Perfected);

    private async Task AssertPerfection(RhshfCollateralPerfectionStatus status)
    {
        if (_selected is null) return;
        await OnAssertPerfection.InvokeAsync((
            _selected.Id, status,
            string.IsNullOrWhiteSpace(_perfectionTitleReference) ? null : _perfectionTitleReference,
            string.IsNullOrWhiteSpace(_perfectionRegistrationAuthority) ? null : _perfectionRegistrationAuthority,
            string.IsNullOrWhiteSpace(_perfectionNote) ? null : _perfectionNote));
    }

    private static string LegalBadgeClass(RhshfLegalClearanceOutcome outcome) => outcome switch
    {
        RhshfLegalClearanceOutcome.Granted => "badge-success",
        RhshfLegalClearanceOutcome.Returned => "badge-warning",
        RhshfLegalClearanceOutcome.Declined => "badge-danger",
        _ => "badge-gray",
    };

    private RhshfCollateralDto? _selected;

    private void View(RhshfCollateralDto c) => _selected = c;
    private void Close() => _selected = null;

    private static string FormatType(RhshfCollateralType type) => type switch
    {
        RhshfCollateralType.BankGuarantee => "Bank Guarantee",
        RhshfCollateralType.NirsalCrg => "NIRSAL Credit Risk Guarantee",
        RhshfCollateralType.LegalMortgage => "Legal Mortgage",
        _ => type.ToString(),
    };

    // The one line that best identifies the instrument in the table row.
    private static string PrimaryDetail(RhshfCollateralDto r) => r.Type switch
    {
        RhshfCollateralType.BankGuarantee => r.GuarantorBankName ?? "Bank guarantee",
        RhshfCollateralType.NirsalCrg => r.CrgCoveragePercentage.HasValue ? $"CRG — {r.CrgCoveragePercentage:N1}% cover" : "NIRSAL CRG",
        RhshfCollateralType.LegalMortgage => r.PropertyDescription ?? "Legal mortgage",
        _ => FormatType(r.Type),
    };

    private static decimal? SecuredValue(RhshfCollateralDto r) => r.Type switch
    {
        RhshfCollateralType.BankGuarantee => r.GuaranteeAmount,
        RhshfCollateralType.LegalMortgage => r.PropertyValue,
        _ => null, // NIRSAL CRG is expressed as a coverage %, not a standalone secured amount
    };

    private static RenderFragment StatusBadge(RhshfCollateralDto r) => __builder =>
    {
        // Every instrument now carries a perfection state, because the committee votes on whether the
        // security is actually in place — not just on a mortgage's registration. Null means the Legal
        // Officer has not asserted anything yet.
        if (r.PerfectionStatus is not null)
        {
            var cls = r.PerfectionStatus == RhshfCollateralPerfectionStatus.Perfected ? "badge-success" : "badge-warning";
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", $"badge {cls}");
            __builder.AddContent(2, r.PerfectionStatus.ToString());
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", "badge badge-gray");
            __builder.AddContent(2, "Declared");
            __builder.CloseElement();
        }
    };

    private static RenderFragment FieldChip(string label, string? value) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "field-chip");
        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "class", "field-chip-label");
        __builder.AddContent(4, label);
        __builder.CloseElement();
        __builder.OpenElement(5, "div");
        __builder.AddAttribute(6, "class", "field-chip-value");
        __builder.AddContent(7, value);
        __builder.CloseElement();
        __builder.CloseElement();
    };

    private async Task UploadFile(Guid collateralId, InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        await OnUploadDocument.InvokeAsync((collateralId, e.File.Name, e.File.ContentType, ms.ToArray()));
    }
}
