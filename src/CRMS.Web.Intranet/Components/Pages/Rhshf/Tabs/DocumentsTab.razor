@using CRMS.Application.Rhshf.DTOs

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Supporting Documents</h3>
        <span class="badge badge-gray">@Documents.Count</span>
    </div>
    @if (Documents.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="material-symbols-outlined">folder_open</span></div>
            <div class="empty-state-title">No documents</div>
            <div class="empty-state-text">No documents were attached during profiling.</div>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr><th>File</th><th style="text-align: right;">Size</th><th>Uploaded</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var doc in Documents)
                    {
                        <tr>
                            <td>
                                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px; color: var(--gray-500);">attach_file</span>
                                @doc.FileName
                            </td>
                            <td style="text-align: right; font-size: 0.8rem; color: var(--gray-500);">@((doc.SizeBytes / 1024.0).ToString("N0")) KB</td>
                            <td style="font-size: 0.8rem; color: var(--gray-500);">@doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <button class="btn btn-ghost btn-sm" title="Download" @onclick='() => OnDownload.InvokeAsync(doc.Id)'>
                                    <span class="material-symbols-outlined" style="font-size: 16px;">download</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<RhshfSupportingDocumentDto> Documents { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDownload { get; set; }
}
