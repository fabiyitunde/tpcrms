@using CRMS.Application.Rhshf.Commands
@using CRMS.Application.Rhshf.DTOs
@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums
@inject IJSRuntime JS

@* Mirrors Corporate's DocumentsTab: a single card with the document table (icon + name, category,
   uploaded, size, actions) and an in-page viewer modal. RH-SHF documents are attached by the FAC
   during profiling, so there is no delete here. A Credit Officer verifies or rejects each one at
   appraisal (Proceed is refused until the mandatory ones are verified); a rejected file goes back
   to the FAC with the case. The viewer uses a blob URL (RH-SHF streams bytes, not a view URL). *@

@if (Readiness is not null && Readiness.Items.Count > 0)
{
    // Counts what actually holds up Proceed. A mandatory item that is simply missing on a case
    // submitted before it was asked for is listed below but does not block, so it is not counted.
    var blocking = Readiness.AppraisalBlockers.Count;
    <div class="card" style="margin-bottom: var(--space-4);">
        <div class="card-header">
            <h3 class="card-title">Credit Risk Readiness</h3>
            <span class="badge @(blocking == 0 ? "badge-success" : "badge-warning")">
                @(blocking == 0 ? "Nothing blocking Proceed" : $"{blocking} blocking Proceed")
            </span>
        </div>
        <div class="card-body" style="padding: 0;">
            @if (Readiness.AppraisalBlockers.Count > 0)
            {
                <div style="padding: var(--space-3) var(--space-4); font-size: var(--text-sm); color: var(--warning-700, #92400e); background: var(--warning-50, #fffbeb);">
                    Proceed is not available yet: @string.Join("; ", Readiness.AppraisalBlockers).
                </div>
            }
            <table class="table">
                <thead><tr><th>Requirement</th><th>For</th><th></th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var item in Readiness.Items)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td style="font-size: var(--text-sm);">@(item.PersonName ?? "Company")</td>
                            <td><span class="badge badge-gray">@(item.IsMandatory ? "Required" : "Optional")</span></td>
                            <td>
                                <span class="badge @StatusBadge(item.Status)">@StatusLabel(item)</span>
                                @if (!string.IsNullOrEmpty(item.Note) && item.Status != "Provided")
                                {
                                    <div style="font-size: var(--text-xs, 0.72rem); color: var(--gray-500);">@item.Note</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="padding: var(--space-2) var(--space-4); font-size: var(--text-xs, 0.72rem); color: var(--gray-500);">
                Which items are required is set in Admin &gt; RH-SHF Document Requirements. Cases submitted before an item
                existed are not held up for it at appraisal.
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Documents</h3>
        <span class="badge badge-primary">@Documents.Count</span>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (_reviewError is not null)
        {
            <div class="alert alert-danger" style="margin: var(--space-3);">@_reviewError</div>
        }
        @if (!Documents.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="material-symbols-outlined">folder_open</span></div>
                <div class="empty-state-title">No documents uploaded</div>
                <div class="empty-state-text">Documents attached by the FAC during profiling appear here.</div>
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Category</th>
                        <th>Uploaded</th>
                        <th>Size</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Documents)
                    {
                        var currentDoc = doc;
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--space-3);">
                                    <div style="width: 40px; height: 40px; background: var(--gray-100); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                                        <span class="material-symbols-outlined" style="color: var(--gray-500);">@GetDocIcon(doc.FileName)</span>
                                    </div>
                                    <div>
                                        <span style="font-weight: 500;">@doc.FileName</span>
                                        <div style="margin-top: 2px;">
                                            <span class="badge @VerificationBadge(doc.VerificationStatus)">@doc.VerificationStatus</span>
                                            @if (doc.VerificationStatus == RhshfDocumentVerificationStatus.Rejected && !string.IsNullOrEmpty(doc.RejectionReason))
                                            {
                                                <span style="font-size: var(--text-xs, 0.72rem); color: var(--gray-500);">@doc.RejectionReason</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @FormatCategory(doc.Category)
                                @if (doc.PersonName is not null)
                                {
                                    <div style="font-size: var(--text-xs, 0.72rem); color: var(--gray-500);">@doc.PersonName</div>
                                }
                            </td>
                            <td>
                                <div style="font-size: var(--text-sm);">@doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                @* A carried-over document was prepared for an earlier season. The reviewer has to
                                   know that before relying on it — the programme sets no expiry, so this is the
                                   only thing that tells them to judge whether it is still current. *@
                                @if (doc.IsReused)
                                {
                                    <div style="font-size: var(--text-xs, 0.72rem); color: var(--gray-500);">
                                        re-used from @doc.ReusedFromReference@(doc.OriginalUploadedAt.HasValue
                                            ? $", originally {doc.OriginalUploadedAt.Value.ToLocalTime():MMM dd, yyyy}"
                                            : "")
                                    </div>
                                }
                            </td>
                            <td style="font-size: var(--text-sm); color: var(--gray-500);">@FormatSize(doc.SizeBytes)</td>
                            <td>
                                <div style="display: flex; gap: var(--space-2); align-items: center;">
                                    @if (IsPersonal(doc) && !CanViewPersonal)
                                    {
                                        @* A CV or ID needs Admin > Feature Access; the download handler refuses it too. *@
                                        <span style="font-size: var(--text-xs, 0.72rem); color: var(--gray-500);" title="Needs the 'Open RH-SHF directors' and managers' CVs and IDs' feature">Restricted</span>
                                    }
                                    else
                                    {
                                    <button class="btn btn-ghost btn-sm" title="Download" @onclick="() => OnDownload.InvokeAsync(currentDoc.Id)">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
                                    </button>
                                    <button class="btn btn-ghost btn-sm" title="View" @onclick="() => ViewDocument(currentDoc)" disabled="@(_loadingView == currentDoc.Id)">
                                        @if (_loadingView == currentDoc.Id)
                                        {
                                            <span class="spinner" style="width: 14px; height: 14px;"></span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined" style="font-size: 18px;">visibility</span>
                                        }
                                    </button>
                                    }
                                    @if (CanVerify)
                                    {
                                        @if (doc.VerificationStatus != RhshfDocumentVerificationStatus.Verified)
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => Verify(currentDoc)">Verify</button>
                                        }
                                        @if (doc.VerificationStatus != RhshfDocumentVerificationStatus.Rejected)
                                        {
                                            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => StartReject(currentDoc)">Reject</button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (_rejecting == currentDoc.Id)
                        {
                            <tr>
                                <td colspan="5">
                                    <div style="display: flex; gap: var(--space-2); align-items: flex-start;">
                                        <textarea class="form-input" rows="2" style="flex: 1;" maxlength="1000"
                                                  placeholder="Why is this document not acceptable? The FAC will see this."
                                                  @bind="_rejectReason" @bind:event="oninput"></textarea>
                                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_rejectReason))" @onclick="() => ConfirmReject(currentDoc)">Reject</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="CancelReject">Cancel</button>
                                    </div>
                                    <div style="font-size: var(--text-xs, 0.72rem); color: var(--gray-500); margin-top: var(--space-1);">
                                        To get a replacement, return the case to the FAC at the supporting documents step after rejecting.
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (_viewerOpen && _selected is not null)
{
    <div class="modal-backdrop show" @onclick="CloseViewer">
        <div class="modal" style="max-width: 1000px; height: 92vh; max-height: 92vh;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">@_selected.FileName</h3>
                <button class="modal-close" @onclick="CloseViewer">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 0; flex: 1; overflow: hidden; min-height: 0;">
                @if (_blobUrl is not null && IsViewableInBrowser(_selected.FileName))
                {
                    <iframe src="@_blobUrl" style="width: 100%; height: 100%; border: none;"></iframe>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: var(--space-4);">
                        <span class="material-symbols-outlined" style="font-size: 64px; color: var(--gray-400);">@GetDocIcon(_selected.FileName)</span>
                        <div style="text-align: center;">
                            <div style="font-weight: 600; font-size: var(--text-lg);">@_selected.FileName</div>
                            <div style="color: var(--gray-500); font-size: var(--text-sm); margin-top: var(--space-2);">
                                This file type cannot be previewed in the browser.
                            </div>
                        </div>
                        <button class="btn btn-primary" @onclick="() => OnDownload.InvokeAsync(_selected.Id)">
                            <span class="material-symbols-outlined" style="font-size: 18px;">download</span>
                            Download File
                        </button>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <div style="display: flex; gap: var(--space-2); align-items: center;">
                    <span class="badge badge-gray">@FormatCategory(_selected.Category)</span>
                    <span style="font-size: var(--text-sm); color: var(--gray-500);">
                        Uploaded @_selected.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm") &middot; @FormatSize(_selected.SizeBytes)
                    </span>
                </div>
                <button class="btn btn-secondary" @onclick="CloseViewer">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<RhshfSupportingDocumentDto> Documents { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDownload { get; set; }
    /// <summary>Fetches the document bytes for the in-page viewer. Returns null if the file can't be
    /// read; the viewer then shows the download fallback.</summary>
    [Parameter] public Func<Guid, Task<RhshfDownloadedFileDto?>>? OnFetchBytes { get; set; }

    /// <summary>The Credit Risk Readiness list; the panel is hidden when null.</summary>
    [Parameter] public RhshfReadinessDto? Readiness { get; set; }
    /// <summary>Computed in Detail.razor: a Credit Officer (or admin) while the case is at appraisal.</summary>
    [Parameter] public bool CanVerify { get; set; }
    /// <summary>Whether this user may open directors' and managers' CVs and IDs.</summary>
    [Parameter] public bool CanViewPersonal { get; set; }
    /// <summary>(documentId, verified, reason). Returns an error to show, or null on success.</summary>
    [Parameter] public Func<Guid, bool, string?, Task<string?>>? OnReview { get; set; }

    private Guid? _rejecting;
    private string? _rejectReason;
    private bool _busy;
    private string? _reviewError;

    private static bool IsPersonal(RhshfSupportingDocumentDto doc) => doc.DirectorId.HasValue || doc.ManagementStaffId.HasValue;

    private async Task Verify(RhshfSupportingDocumentDto doc) => await Review(doc, true, null);

    private void StartReject(RhshfSupportingDocumentDto doc)
    {
        _rejecting = doc.Id;
        _rejectReason = null;
    }

    private void CancelReject()
    {
        _rejecting = null;
        _rejectReason = null;
    }

    private async Task ConfirmReject(RhshfSupportingDocumentDto doc)
    {
        await Review(doc, false, _rejectReason);
        if (_reviewError is null) CancelReject();
    }

    private async Task Review(RhshfSupportingDocumentDto doc, bool verified, string? reason)
    {
        if (OnReview is null) return;
        _busy = true;
        try { _reviewError = await OnReview(doc.Id, verified, reason); }
        finally { _busy = false; }
    }

    private static string VerificationBadge(RhshfDocumentVerificationStatus status) => status switch
    {
        RhshfDocumentVerificationStatus.Verified => "badge-success",
        RhshfDocumentVerificationStatus.Rejected => "badge-danger",
        _ => "badge-warning",
    };

    private static string StatusBadge(string status) => status switch
    {
        "Verified" or "Provided" => "badge-success",
        "Rejected" or "Invalid" => "badge-danger",
        "Pending" => "badge-warning",
        _ => "badge-gray",
    };

    private static string StatusLabel(RhshfReadinessItemDto item) => item.Status switch
    {
        "Pending" => "Awaiting verification",
        "Invalid" => "Not valid",
        _ => item.Status,
    };

    private bool _viewerOpen;
    private RhshfSupportingDocumentDto? _selected;
    private string? _blobUrl;
    private Guid? _loadingView;

    private async Task ViewDocument(RhshfSupportingDocumentDto doc)
    {
        if (OnFetchBytes is null) { await OnDownload.InvokeAsync(doc.Id); return; }

        _loadingView = doc.Id;
        try
        {
            var file = await OnFetchBytes(doc.Id);
            await ReleaseBlobAsync();
            _selected = doc;
            _blobUrl = file is not null && IsViewableInBrowser(doc.FileName)
                ? await JS.InvokeAsync<string>("createBlobUrl", file.Content, file.ContentType)
                : null;
            _viewerOpen = true;
        }
        finally
        {
            _loadingView = null;
        }
    }

    private async Task CloseViewer()
    {
        _viewerOpen = false;
        _selected = null;
        await ReleaseBlobAsync();
    }

    private async Task ReleaseBlobAsync()
    {
        if (_blobUrl is not null)
        {
            await JS.InvokeVoidAsync("revokeBlobUrl", _blobUrl);
            _blobUrl = null;
        }
    }

    private static bool IsViewableInBrowser(string name)
    {
        var ext = Path.GetExtension(name).ToLowerInvariant();
        return ext is ".pdf" or ".png" or ".jpg" or ".jpeg" or ".gif" or ".txt";
    }

    private static string GetDocIcon(string name)
    {
        if (name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)) return "picture_as_pdf";
        if (name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase)) return "table_chart";
        if (name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".doc", StringComparison.OrdinalIgnoreCase)) return "description";
        if (name.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)) return "image";
        return "insert_drive_file";
    }

    // Shared with the admin requirements screen so staff and the FAC never see two names for the
    // same document — see RhshfDisplayNames for the one deliberate override.
    private static string FormatCategory(RhshfDocumentCategory category) =>
        RhshfDisplayNames.CategoryLabel(category);

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1_000_000) return $"{bytes / 1_000_000.0:0.#} MB";
        if (bytes >= 1_000) return $"{bytes / 1_000.0:0.#} KB";
        return $"{bytes} B";
    }
}
