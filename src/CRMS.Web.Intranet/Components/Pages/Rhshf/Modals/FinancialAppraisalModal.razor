@using CRMS.Application.Rhshf.Queries
@using CRMS.Domain.Enums

<div class="modal-backdrop show" @onclick="() => OnClose.InvokeAsync()">
    <div class="modal" style="max-width: 620px; max-height: 88vh; display: flex; flex-direction: column;" @onclick:stopPropagation>
        <div class="modal-header">
            <h3 class="modal-title">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 6px;">calculate</span>
                Financial Appraisal
            </h3>
            <button class="modal-close" @onclick="() => OnClose.InvokeAsync()"><span class="material-symbols-outlined">close</span></button>
        </div>

        <div class="modal-body" style="overflow-y: auto; flex: 1;">
            <p class="text-muted" style="font-size: 0.85rem;">
                Expected revenue comes from the farm plan
                (<strong>@Data.Currency @Data.FarmPlans.Sum(p => p.ExpectedRevenue).ToString("N2")</strong>) and the
                financed input cost is the case's own EOP value
                (<strong>@Data.Currency @Data.TotalEopValue.ToString("N2")</strong>). Enter the remaining assumptions
                below — every ratio is computed server-side.
            </p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Own Production Cost (@Data.Currency) *</label>
                    <input type="number" class="form-control" min="0" step="0.01" @bind="ownProductionCost" />
                    <small class="form-hint">Land prep, planting, weeding — funded by the FAC.</small>
                </div>
                <div class="form-group">
                    <label class="form-label">Harvest &amp; Logistics (@Data.Currency) *</label>
                    <input type="number" class="form-control" min="0" step="0.01" @bind="harvestAndLogisticsCost" />
                </div>
            </div>

            @* Tenor and rate are the loan's terms, set on the core banking product. They are shown, not
               entered, so the appraisal, the offer letter and the booked loan cannot disagree. *@
            @if (ProductTerms is { } terms)
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Tenor</label>
                        <div class="form-control" style="background: var(--gray-50);">@terms.TenorMonths month@(terms.TenorMonths == 1 ? "" : "s")</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Interest Rate</label>
                        <div class="form-control" style="background: var(--gray-50);">@terms.AnnualRatePercent.ToString("0.##")% a year</div>
                    </div>
                </div>
                <small class="form-hint" style="display: block; margin: -0.5rem 0 1rem;">
                    From the core banking product "@terms.ProductName". Change them there, not here.
                </small>
            }
            else
            {
                <div class="alert alert-danger">
                    The tenor and interest rate could not be read from core banking, so the appraisal cannot be
                    saved yet. @ProductTermsError
                </div>
            }

            <div class="form-group">
                <label class="form-label">Basis for Yield / Price Assumptions</label>
                <textarea class="form-control" rows="2" @bind="assumptionBasisNote"
                          placeholder="Off-take agreement, prior season actuals, extension service advice…"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Risk Commentary for Committee</label>
                <textarea class="form-control" rows="3" @bind="summaryNotes"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Recommendation *</label>
                <div style="display: flex; gap: 0.5rem;">
                    <button type="button" class="btn @(recommendation == "Pass" ? "btn-success" : "btn-outline-success")"
                            style="flex: 1;" @onclick='() => recommendation = "Pass"'>
                        Pass — recommend for risk review
                    </button>
                    <button type="button" class="btn @(recommendation == "Fail" ? "btn-danger" : "btn-outline-danger")"
                            style="flex: 1;" @onclick='() => recommendation = "Fail"'>
                        Fail — decline at appraisal
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Override Justification</label>
                <textarea class="form-control" rows="2" @bind="overrideJustification"
                          placeholder="Required only if recommending Pass while one or more viability gates fail."></textarea>
                <small class="form-hint">
                    A Pass with failing gates is permitted but must be justified in writing — the system will
                    reject it otherwise.
                </small>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage) || !string.IsNullOrEmpty(clientError))
            {
                <div class="alert alert-danger">@(ErrorMessage ?? clientError)</div>
            }
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
            <button class="btn btn-primary" disabled="@(IsSubmitting || ProductTerms is null)" @onclick="Submit">
                @if (IsSubmitting) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                Save Appraisal
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RhshfFinancialAppraisalDto Data { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(decimal OwnProductionCost, decimal HarvestAndLogisticsCost,
        string? AssumptionBasisNote, string Recommendation,
        string? SummaryNotes, string? OverrideJustification)> OnConfirm { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    /// <summary>The core banking product's tenor and rate. Null when they could not be read.</summary>
    [Parameter] public CRMS.Application.Rhshf.Services.RhshfProductTerms? ProductTerms { get; set; }
    [Parameter] public string? ProductTermsError { get; set; }

    private decimal ownProductionCost;
    private decimal harvestAndLogisticsCost;
    private string? assumptionBasisNote;
    private string? summaryNotes;
    private string? overrideJustification;
    private string recommendation = "Pass";
    private string? clientError;
    private bool initialised;

    protected override void OnParametersSet()
    {
        // Pre-fill from the existing appraisal when revising, so the officer edits rather than retypes.
        if (initialised) return;
        if (Data.Report is { } r)
        {
            ownProductionCost = r.OwnProductionCost;
            harvestAndLogisticsCost = r.HarvestAndLogisticsCost;
            assumptionBasisNote = r.AssumptionBasisNote;
            summaryNotes = r.SummaryNotes;
            overrideJustification = r.OverrideJustification;
            recommendation = r.CreditOfficerRecommendation.ToString();
        }
        initialised = true;
    }

    private async Task Submit()
    {
        clientError = null;

        if (ownProductionCost < 0 || harvestAndLogisticsCost < 0) { clientError = "Costs cannot be negative."; return; }

        await OnConfirm.InvokeAsync((
            ownProductionCost, harvestAndLogisticsCost,
            string.IsNullOrWhiteSpace(assumptionBasisNote) ? null : assumptionBasisNote,
            recommendation,
            string.IsNullOrWhiteSpace(summaryNotes) ? null : summaryNotes,
            string.IsNullOrWhiteSpace(overrideJustification) ? null : overrideJustification));
    }
}
