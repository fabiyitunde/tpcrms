@using CRMS.Domain.Enums

<div class="modal-backdrop show" @onclick="() => OnClose.InvokeAsync()">
    <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
        <div class="modal-header">
            <h3 class="modal-title"><span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 6px;">shield_person</span>@Title</h3>
            <button class="modal-close" @onclick="() => OnClose.InvokeAsync()"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Notes @(RequiresNotes ? "(required)" : "(optional)")</label>
                <textarea class="form-control" rows="3" @bind="notes" placeholder="Enter notes..."></textarea>
            </div>
            @if (Intent == "ReturnToFac")
            {
                <div class="form-group">
                    <label class="form-label">Reopen the FAC's form at:</label>
                    <select class="form-control" @bind="returnToStage">
                        @foreach (var stage in Enum.GetValues<RhshfProfilingStage>())
                        {
                            <option value="@stage">@stage</option>
                        }
                    </select>
                </div>
            }
            @if (!string.IsNullOrEmpty(ErrorMessage) || !string.IsNullOrEmpty(clientError))
            {
                <div class="alert alert-danger">@(ErrorMessage ?? clientError)</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
            <button class="btn @ConfirmButtonClass" disabled="@IsSubmitting" @onclick="Confirm">
                @if (IsSubmitting) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                @ConfirmLabel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Intent { get; set; } = "Cleared";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(RhshfRiskReviewOutcome Outcome, string? Notes, RhshfProfilingStage? ReturnToStage)> OnConfirm { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private string notes = string.Empty;
    private string? clientError;
    private RhshfProfilingStage returnToStage = RhshfProfilingStage.ReviewAndSubmit;

    private bool RequiresNotes => Intent != "Cleared";
    private string Title => Intent switch { "ReturnToFac" => "Return to FAC", "Decline" => "Decline at Risk Review", _ => "Clear Risk Review" };
    private string ConfirmLabel => Intent switch { "ReturnToFac" => "Return to FAC", "Decline" => "Confirm Decline", _ => "Cleared" };
    private string ConfirmButtonClass => Intent switch { "Decline" => "btn-danger", "ReturnToFac" => "btn-warning", _ => "btn-success" };

    private async Task Confirm()
    {
        if (RequiresNotes && string.IsNullOrWhiteSpace(notes))
        {
            clientError = "Notes are required for this decision.";
            return;
        }
        clientError = null;
        var outcome = Enum.Parse<RhshfRiskReviewOutcome>(Intent);
        await OnConfirm.InvokeAsync((outcome, string.IsNullOrWhiteSpace(notes) ? null : notes, Intent == "ReturnToFac" ? returnToStage : null));
    }
}
