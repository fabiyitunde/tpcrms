@* Replaces an issued offer that turned out to be wrong, accepted or not. Spelled out in the dialog because the
   consequence is not obvious from the button: the case goes back to waiting for the FAC, and the
   reason is written to the case history. *@
<div class="modal-backdrop show" @onclick="() => OnClose.InvokeAsync()">
    <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
        <div class="modal-header">
            <h3 class="modal-title"><span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 6px;">edit_document</span>Issue a Corrected Offer</h3>
            <button class="modal-close" @onclick="() => OnClose.InvokeAsync()"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            <div class="alert alert-warning" style="margin-bottom: var(--space-3); font-size: var(--text-sm);">
                A new offer letter is generated from the case as it stands now, for the same approved amount and terms.
                The FAC must accept it before the case can move on, and the current offer can no longer be accepted. The current offer, and any signed copy, is kept on record.
            </div>
            <div class="form-group">
                <label class="form-label">What was wrong with the current offer? (required)</label>
                <textarea class="form-control" rows="3" @bind="reason" placeholder="e.g. The implementation plan did not list the EOP inputs and suppliers."></textarea>
            </div>
            @if (!string.IsNullOrEmpty(ErrorMessage) || !string.IsNullOrEmpty(clientError))
            {
                <div class="alert alert-danger">@(ErrorMessage ?? clientError)</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
            <button class="btn btn-warning" disabled="@IsSubmitting" @onclick="Confirm">
                @if (IsSubmitting) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                Issue corrected offer
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnConfirm { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private string reason = string.Empty;
    private string? clientError;

    private async Task Confirm()
    {
        clientError = null;
        if (string.IsNullOrWhiteSpace(reason))
        {
            clientError = "Say what was wrong with the current offer.";
            return;
        }
        await OnConfirm.InvokeAsync(reason.Trim());
    }
}
