@using CRMS.Application.Rhshf.Queries

<div class="modal-backdrop show" @onclick="() => OnClose.InvokeAsync()">
    <div class="modal" style="max-width: 520px;" @onclick:stopPropagation>
        <div class="modal-header">
            <h3 class="modal-title">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 6px;">agriculture</span>
                @(IsEditing ? $"Edit {Existing!.Crop}" : "Add Crop to Farm Plan")
            </h3>
            <button class="modal-close" @onclick="() => OnClose.InvokeAsync()"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            @if (!IsEditing)
            {
                <div class="form-group">
                    <label class="form-label">Crop *</label>
                    <input class="form-control" @bind="crop" placeholder="e.g. Maize" />
                </div>
            }

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Hectares *</label>
                    <input type="number" class="form-control" min="0" step="0.01" @bind="hectares" />
                </div>
                <div class="form-group">
                    <label class="form-label">Expected Yield (kg/ha) *</label>
                    <input type="number" class="form-control" min="0" step="1" @bind="yieldPerHa" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Expected Farm-Gate Price (@Currency/kg) *</label>
                <input type="number" class="form-control" min="0" step="0.01" @bind="pricePerKg" />
                <small class="form-hint">Record the basis for this figure in the appraisal's assumptions note.</small>
            </div>

            @if (Preview > 0)
            {
                <div class="field-chip">
                    <div class="field-chip-label">Expected Revenue From This Crop</div>
                    <div class="field-chip-value">@Currency @Preview.ToString("N2")</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage) || !string.IsNullOrEmpty(clientError))
            {
                <div class="alert alert-danger">@(ErrorMessage ?? clientError)</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
            <button class="btn btn-primary" disabled="@IsSubmitting" @onclick="Submit">
                @if (IsSubmitting) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                @(IsEditing ? "Save" : "Add Crop")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public RhshfFarmPlanDto? Existing { get; set; }
    [Parameter] public string Currency { get; set; } = "NGN";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(string Crop, decimal Hectares, decimal YieldPerHa, decimal PricePerKg)> OnAdd { get; set; }
    [Parameter] public EventCallback<(Guid PlanId, decimal Hectares, decimal YieldPerHa, decimal PricePerKg)> OnUpdate { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private bool IsEditing => Existing is not null;

    private string crop = string.Empty;
    private decimal hectares;
    private decimal yieldPerHa;
    private decimal pricePerKg;
    private string? clientError;
    private bool initialised;

    private decimal Preview => hectares * yieldPerHa * pricePerKg;

    protected override void OnParametersSet()
    {
        if (initialised || Existing is null) return;
        crop = Existing.Crop;
        hectares = Existing.Hectares;
        yieldPerHa = Existing.ExpectedYieldKgPerHectare;
        pricePerKg = Existing.ExpectedPricePerKg;
        initialised = true;
    }

    private async Task Submit()
    {
        clientError = null;

        if (!IsEditing && string.IsNullOrWhiteSpace(crop)) { clientError = "Crop is required."; return; }
        if (hectares <= 0) { clientError = "Hectares must be greater than zero."; return; }
        if (yieldPerHa <= 0) { clientError = "Expected yield must be greater than zero."; return; }
        if (pricePerKg <= 0) { clientError = "Expected price must be greater than zero."; return; }

        if (IsEditing)
            await OnUpdate.InvokeAsync((Existing!.Id, hectares, yieldPerHa, pricePerKg));
        else
            await OnAdd.InvokeAsync((crop.Trim(), hectares, yieldPerHa, pricePerKg));
    }
}
