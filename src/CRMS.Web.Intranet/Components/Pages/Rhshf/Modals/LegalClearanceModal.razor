@using CRMS.Domain.Enums

<div class="modal-backdrop show" @onclick="() => OnClose.InvokeAsync()">
    <div class="modal" style="max-width: 480px;" @onclick:stopPropagation>
        <div class="modal-header">
            <h3 class="modal-title"><span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 6px;">gavel</span>@Title</h3>
            <button class="modal-close" @onclick="() => OnClose.InvokeAsync()"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Comments @(RequiresNotes ? "(required)" : "(optional)")</label>
                <textarea class="form-control" rows="3" @bind="comments" placeholder="Enter comments..."></textarea>
            </div>
            @if (ReasonType is { } reasonType)
            {
                <ReasonCodePicker Type="reasonType" @bind-Value="reasonCode" />
            }
            @if (Intent == "Returned")
            {
                <FacVisibleNoteHint />
                <div class="form-group">
                    <label class="form-label">Reopen the FAC's form at:</label>
                    <select class="form-control" @bind="returnToStage">
                        @foreach (var stage in Enum.GetValues<RhshfProfilingStage>())
                        {
                            <option value="@stage">@stage</option>
                        }
                    </select>
                </div>
            }
            @if (!string.IsNullOrEmpty(ErrorMessage) || !string.IsNullOrEmpty(clientError))
            {
                <div class="alert alert-danger">@(ErrorMessage ?? clientError)</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
            <button class="btn @ConfirmButtonClass" disabled="@IsSubmitting" @onclick="Confirm">
                @if (IsSubmitting) { <span class="spinner" style="width: 14px; height: 14px;"></span> }
                @ConfirmLabel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Intent { get; set; } = "Granted";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(RhshfLegalClearanceOutcome Outcome, string? Comments, RhshfProfilingStage? ReturnToStage, string? ReasonCode)> OnConfirm { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private string comments = string.Empty;
    private string? clientError;
    private RhshfProfilingStage returnToStage = RhshfProfilingStage.CreditBureauCheck;

    private string? reasonCode;
    /// <summary>Which reasons apply: a return's or a decline's, or none for a forward decision.</summary>
    private RhshfReasonCodeType? ReasonType => Intent switch { "Returned" => RhshfReasonCodeType.Correction, "Declined" => RhshfReasonCodeType.Decline, _ => null };
    private bool RequiresNotes => Intent != "Granted";
    // Clearance runs before the committee votes, so a defect goes back to the FAC that declared the
    // security — there is no ratification to return to at this point.
    private string Title => Intent switch { "Returned" => "Return to the FAC", "Declined" => "Decline at Legal Clearance", "GrantedWithCaveat" => "Grant with a Caveat", _ => "Grant Legal Clearance" };
    private string ConfirmLabel => Intent switch { "Returned" => "Return to the FAC", "Declined" => "Confirm Decline", "GrantedWithCaveat" => "Grant with Caveat", _ => "Grant" };
    private string ConfirmButtonClass => Intent switch { "Declined" => "btn-danger", "Returned" => "btn-warning", "GrantedWithCaveat" => "btn-warning", _ => "btn-success" };

    private async Task Confirm()
    {
        if (RequiresNotes && string.IsNullOrWhiteSpace(comments))
        {
            clientError = "Comments are required for this decision.";
            return;
        }
        if (ReasonType is not null && reasonCode is null)
        {
            clientError = "Pick a reason.";
            return;
        }
        clientError = null;
        var outcome = Enum.Parse<RhshfLegalClearanceOutcome>(Intent);
        await OnConfirm.InvokeAsync((
            outcome,
            string.IsNullOrWhiteSpace(comments) ? null : comments,
            outcome == RhshfLegalClearanceOutcome.Returned ? returnToStage : null,
            ReasonType is null ? null : reasonCode));
    }
}
