    private async Task RefreshBankStatement()
    {
        bankStatementLoaded = true;
        if (string.IsNullOrWhiteSpace(workspace?.BoaAccountNumber))
        {
            bankStatement = null;
            bankStatementError = null;
            return;
        }
        isFetchingStatement = true;
        bankStatementError = null;
        var (statement, error) = await AppService.GetRhshfBankStatementAsync(
            workspace.BoaAccountNumber, DateTime.UtcNow.AddMonths(-6), DateTime.UtcNow);
        bankStatement = statement;
        bankStatementError = error;
        isFetchingStatement = false;
    }

