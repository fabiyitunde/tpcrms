@page "/rhshf/detail/{Reference}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CRMS.Application.Rhshf.Commands
@using CRMS.Application.Rhshf.DTOs
@using CRMS.Application.Rhshf.Queries
@using CRMS.Application.CoreBanking.DTOs
@using CRMS.Domain.Enums
@using CRMS.Web.Intranet.Components.Pages.Rhshf.Tabs
@using CRMS.Web.Intranet.Components.Pages.Rhshf.Modals
@using CRMS.Web.Intranet.Services
@inject ApplicationService AppService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

<PageTitle>RH-SHF @Reference - CRMS</PageTitle>

@if (isLoading)
{
    <div class="p-6 text-center"><div class="spinner" style="margin: 0 auto;"></div></div>
}
else if (workspace is null)
{
    <div class="alert alert-danger">Could not load this case.</div>
}
else
{
    <div class="page-header">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <button class="btn btn-ghost btn-sm" @onclick='() => Navigation.NavigateTo("/rhshf")'>
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
            </button>
            <div>
                <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <h1 class="page-title" style="margin: 0; font-family: var(--font-mono, ui-monospace, monospace);">@workspace.Reference</h1>
                    <span class="badge @StatusBadgeClass(workspace.Status)" style="font-size: 0.8rem;">@workspace.Status</span>
                    @if (workspace.CommitteeTier is not null)
                    {
                        <span class="badge badge-primary" style="font-size: 0.8rem;" title="Routed by EOP value (@workspace.CommitteeTierBand)">@workspace.CommitteeTier Tier</span>
                    }
                    @if (workspace.InternalStage is not null)
                    {
                        <span class="badge badge-secondary" style="font-size: 0.8rem;">@workspace.InternalStage</span>
                    }
                </div>
                <p class="page-subtitle" style="margin: 0;">@workspace.CompanyName &middot; Cycle @workspace.CurrentCycleNumber</p>
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            @* Re-run Credit Checks lives in the header action bar (mirroring Corporate), not inside
               the Bureau tab — it's an action, and actions belong with the other stage buttons. *@
            @if (CanRunBureauChecks)
            {
                <button class="btn btn-secondary" @onclick="RunBureauChecks" disabled="@isRunningBureauChecks">
                    @if (isRunningBureauChecks)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px;">refresh</span>
                    }
                    Re-run Credit Checks
                </button>
            }
            @if (CanAppraise && workspace.InternalStage == RhshfInternalStage.Appraisal)
            {
                <button class="btn btn-warning" @onclick='() => OpenAppraisalModal("ReturnToFac")'>Return to FAC</button>
                <button class="btn btn-danger" @onclick='() => OpenAppraisalModal("Decline")'>Decline</button>
                <button class="btn btn-success" @onclick='() => OpenAppraisalModal("Proceed")'>Proceed</button>
            }
            @if (CanReviewRisk && workspace.InternalStage == RhshfInternalStage.RiskReview)
            {
                <button class="btn btn-warning" @onclick='() => OpenRiskReviewModal("ReturnToFac")'>Return to FAC</button>
                <button class="btn btn-danger" @onclick='() => OpenRiskReviewModal("Decline")'>Decline</button>
                <button class="btn btn-success" @onclick='() => OpenRiskReviewModal("Cleared")'>Clear</button>
            }
            @if (CanVoteOnCommittee && workspace.InternalStage == RhshfInternalStage.CommitteeVoting && CanActuallyVote)
            {
                <button class="btn btn-warning" @onclick='() => OpenCommitteeModal("ReturnToFac")'>Return to FAC</button>
                <button class="btn btn-outline-secondary" @onclick='() => OpenCommitteeModal("Abstain")'>Abstain</button>
                <button class="btn btn-danger" @onclick='() => OpenCommitteeModal("Reject")'>Reject</button>
                <button class="btn btn-success" @onclick='() => OpenCommitteeModal("Approve")'>Approve</button>
            }
            @if (CanRatify && workspace.InternalStage == RhshfInternalStage.Ratification)
            {
                <button class="btn btn-warning" @onclick='() => OpenRatificationModal("ReturnToFac")'>Return to FAC</button>
                <button class="btn btn-danger" @onclick='() => OpenRatificationModal("Declined")'>Decline</button>
                <button class="btn btn-success" @onclick='() => OpenRatificationModal("Ratified")'>Ratify</button>
            }
            @if (CanClearLegally && workspace.InternalStage == RhshfInternalStage.LegalClearance)
            {
                <button class="btn btn-outline" @onclick='() => openModal = "collateral"'>
                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">security</span> Record Collateral
                </button>
                <button class="btn btn-warning" @onclick='() => OpenLegalClearanceModal("Returned")'>Return to Ratification</button>
                <button class="btn btn-danger" @onclick='() => OpenLegalClearanceModal("Declined")'>Decline</button>
                <button class="btn btn-success" @onclick='() => OpenLegalClearanceModal("Granted")'>Grant</button>
            }
            @if (CanBookDisbursement && workspace.InternalStage == RhshfInternalStage.PreDeploymentVerification)
            {
                <button class="btn btn-outline" @onclick='() => openModal = "predeployment"'>
                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">checklist</span> Pre-Deployment Gate
                </button>
            }
            @if (CanBookDisbursement && workspace.InternalStage == RhshfInternalStage.Disbursement && !disbursementHistory.Any(d => d.Status == RhshfDisbursementStatus.Booked))
            {
                <button class="btn btn-success" @onclick='() => openModal = "disbursement"'>
                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">account_balance</span> Book Disbursement
                </button>
            }
            @if (CanBookDisbursement && workspace.InternalStage == RhshfInternalStage.Active)
            {
                <button class="btn btn-success" @onclick="SubmitMarkClosed" disabled="@isSubmitting">
                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle;">task_alt</span> Mark as Closed
                </button>
            }
        </div>
    </div>

    <!-- Summary strip (mirrors Corporate's under-header card) -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-body" style="padding: var(--space-4) var(--space-6);">
            <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-6);">
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Product</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">RH-SHF Dry Season</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Requested Amount</div>
                    <div style="font-weight: 600; margin-top: var(--space-1); color: var(--primary-600);">@workspace.Currency @workspace.TotalEopValue.ToString("N0")</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Committee Tier</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">
                        @if (workspace.CommitteeTier is not null)
                        {
                            <span class="badge badge-primary">@workspace.CommitteeTier</span>
                            <span style="font-size: var(--text-xs); color: var(--gray-500);">@workspace.CommitteeTierBand</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Farmers</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">@(workspace.FarmerCount?.ToString("N0") ?? "—")</div>
                </div>
                <div>
                    <div style="font-size: var(--text-xs); color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Received</div>
                    <div style="font-weight: 500; margin-top: var(--space-1);">@workspace.ReceivedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(pageError))
    {
        <div class="alert alert-danger" style="margin-bottom: 1rem;">@pageError</div>
    }

    @* Tab order mirrors Corporate (Applications/Detail.razor) exactly for the tabs they share:
       Overview, Directors & Signatories, Documents, Financial, Credit Bureau, Collateral, AI Advisory,
       then the stage block, then Workflow. RH-SHF-only tabs are slotted in workflow-logical places:
       Eligibility sits in the informational block (where Corporate's Guarantors is); Risk Review,
       Ratification, Offer, Legal Clearance, Pre-Deployment and Disbursement are the extra stages RH-SHF
       has beyond Corporate, kept next to their Corporate-equivalent siblings.
       Informational tabs are always present (case info is visible to every actor so anyone can make or
       support a decision); conditional (@if Show*) tabs appear once their stage is reached and then stay
       for history. Action BUTTONS inside each tab remain role- and stage-gated, so maker-checker holds. *@
    <div class="tabs" style="flex-wrap: wrap;">
        <div class="tab @(activeTab == "overview" ? "active" : "")" @onclick='() => activeTab = "overview"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">summarize</span>Overview
        </div>
        @* EOP Breakdown — RH-SHF peculiarity, no Corporate equivalent; sits right after Overview as the
           defining artifact of the case (what is being financed) and the input to Financial Appraisal. *@
        <div class="tab @(activeTab == "eop" ? "active" : "")" @onclick='() => activeTab = "eop"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">receipt_long</span>EOP Breakdown
        </div>
        <div class="tab @(activeTab == "directors" ? "active" : "")" @onclick='async () => { activeTab = "directors"; await EnsureDirectorCrossCheckLoaded(); }'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">groups</span>Directors &amp; Signatories
        </div>
        <div class="tab @(activeTab == "documents" ? "active" : "")" @onclick='() => activeTab = "documents"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">folder_open</span>Documents
        </div>
        <div class="tab @(activeTab == "financialappraisal" ? "active" : "")" @onclick='() => activeTab = "financialappraisal"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">calculate</span>Financial Appraisal
        </div>
        @* Financial Analysis — the FAC's multi-year financial statements + ratio analysis (institutional
           strength), distinct from the crop-economics Financial Appraisal above. Lazy-loaded on open. *@
        <div class="tab @(activeTab == "financialanalysis" ? "active" : "")" @onclick='async () => { activeTab = "financialanalysis"; await EnsureFinancialAnalysisLoaded(); }'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">analytics</span>Financial Analysis
        </div>
        @* Bank Statements — pulls BOA account transactions from core banking (lazy-loaded on open) plus
           shows uploaded other-bank statements; mirrors Corporate's position after Financial. *@
        <div class="tab @(activeTab == "statements" ? "active" : "")" @onclick='async () => { activeTab = "statements"; await EnsureBankStatementLoaded(); }'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">receipt_long</span>Bank Statements
        </div>
        <div class="tab @(activeTab == "bureau" ? "active" : "")" @onclick='() => activeTab = "bureau"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">fact_check</span>Credit Bureau
        </div>
        <div class="tab @(activeTab == "collateral" ? "active" : "")" @onclick='() => activeTab = "collateral"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">security</span>Collateral
        </div>
        <div class="tab @(activeTab == "guarantors" ? "active" : "")" @onclick='() => activeTab = "guarantors"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">handshake</span>Guarantors
        </div>
        <div class="tab @(activeTab == "advisory" ? "active" : "")" @onclick='() => activeTab = "advisory"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">psychology_alt</span>AI Advisory
        </div>
        @* ── Stage block (mirrors Corporate: decisions are actioned from the top action bar and the
             full decision history, incl. appraisal & risk review with their notes, lives in the
             Workflow tab — so no standalone per-stage history tabs). ── *@
        @* Committee stays always-present (informational), mirroring Corporate. *@
        <div class="tab @(activeTab == "committee" ? "active" : "")" @onclick='() => activeTab = "committee"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">groups</span>Committee
        </div>
        @if (ShowOfferTab)
        {
            <div class="tab @(activeTab == "offer" ? "active" : "")" @onclick='() => activeTab = "offer"'>
                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">mail</span>Offer
            </div>
        }
        @if (ShowPreDeploymentTab)
        {
            <div class="tab @(activeTab == "predeployment" ? "active" : "")" @onclick='() => activeTab = "predeployment"'>
                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">checklist</span>Pre-Deployment
            </div>
        }
        @if (ShowDisbursementTab)
        {
            <div class="tab @(activeTab == "disbursement" ? "active" : "")" @onclick='() => activeTab = "disbursement"'>
                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">account_balance</span>Disbursement
            </div>
        }
        @if (ShowLoanAccountTab)
        {
            <div class="tab @(activeTab == "loanaccount" ? "active" : "")" @onclick='() => activeTab = "loanaccount"'>
                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">account_balance_wallet</span>Loan Account
            </div>
        }
        <div class="tab @(activeTab == "comments" ? "active" : "")" @onclick='() => activeTab = "comments"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">forum</span>Comments
        </div>
        <div class="tab @(activeTab == "workflow" ? "active" : "")" @onclick='() => activeTab = "workflow"'>
            <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">history</span>Workflow
        </div>
    </div>

    @switch (activeTab)
    {
        case "overview":
            <OverviewTab Workspace="workspace" Directors="directors" />
            break;
        case "eop":
            <EopTab Workspace="workspace" />
            break;
        case "directors":
            <DirectorsTab Directors="directors" CanManageDirectors="CanManageDirectors"
                CrossCheck="directorCrossCheck" IsCrossChecking="isCrossChecking" CrossCheckError="@crossCheckError"
                OnRunCrossCheck="RunDirectorCrossCheck" OnAddDirector="OpenAddDirectorModal"
                OnEditDirector="OpenEditDirectorModal" OnRemoveDirector="RemoveDirector" />
            break;
        case "financialanalysis":
            <RhshfFinancialAnalysisTab Analysis="financialAnalysis" LoadError="@financialAnalysisLoadError"
                CanManage="CanManageFinancials" Currency="@workspace.Currency"
                HasUploadedFinancials="HasUploadedFinancials" ImportMessage="@financialImportMessage" IsImporting="isImportingFinancials"
                OnAddYear="OpenAddFinancialStatement" OnUploadExcel="OpenUploadFinancials" OnImportFromUpload="ImportFinancialsFromUpload"
                OnEditYear="OpenEditFinancialStatement" OnSubmit="SubmitFinancialStatementForReview"
                OnVerify="VerifyFinancialStatement" OnReject="RejectFinancialStatement"
                OnRevert="RevertFinancialStatement" OnDelete="DeleteFinancialStatement" />
            break;
        case "statements":
            <RhshfBankStatementsTab BoaAccountNumber="@workspace.BoaAccountNumber" Statement="bankStatement"
                StatementError="@bankStatementError" IsFetching="isFetchingStatement" OnRefresh="RefreshBankStatement"
                UploadedStatements="BankStatementDocs" OnDownload="DownloadSupportingDocument"
                OnFetchBytes="AppService.DownloadRhshfSupportingDocumentAsync" Currency="@workspace.Currency" />
            break;
        case "guarantors":
            <GuarantorsTab Guarantors="guarantors" CanManage="CanManageGuarantors" Currency="@workspace.Currency"
                OnAdd="OpenAddGuarantorModal" OnEdit="OpenEditGuarantorModal" OnRemove="RemoveGuarantor" />
            break;
        case "bureau":
            <BureauTab Reports="bureauReports" CanRecheck="CanRunBureauChecks" RecheckError="@bureauError" />
            break;
        case "collateral":
            <CollateralTab Records="collateralRecords" CanUpload="CanClearLegally"
                OnUploadDocument="UploadCollateralDocument" OnDownloadDocument="DownloadCollateralDocument" />
            break;
        case "documents":
            <DocumentsTab Documents="workspace.SupportingDocuments" OnDownload="DownloadSupportingDocument"
                OnFetchBytes="AppService.DownloadRhshfSupportingDocumentAsync" />
            break;
        case "financialappraisal":
            <FinancialAppraisalTab Data="financialAppraisal" LoadError="@financialAppraisalError"
                CanEdit="CanEditFinancialAppraisal"
                OnAddFarmPlan="OpenAddFarmPlanModal" OnEditFarmPlan="OpenEditFarmPlanModal"
                OnRemoveFarmPlan="RemoveFarmPlan" OnOpenAppraisal="OpenFinancialAppraisalModal" />
            break;
        case "committee":
            <CommitteeTab Committee="committeeReview" Roster="committeeRoster" CurrentUserId="CurrentUserId" />
            break;
        case "offer":
            <OfferTab Offer="offer" Reference="@Reference" OnDownload="DownloadOfferDocument"
                CanRegenerate="CanRegenerateOffer" IsRegenerating="isRegeneratingOffer" OnRegenerate="RegenerateOffer"
                CanResendCallback="CanResendOfferCallback" IsResendingCallback="isResendingCallback" OnResendCallback="ResendOfferCallback"
                CanCopyLink="CanCopyAcceptanceLink" OnCopyLink="CopyAcceptanceLink" />
            break;
        case "predeployment":
            <PreDeploymentTab Checklist="preDeploymentChecklist" />
            break;
        case "disbursement":
            <DisbursementTab History="disbursementHistory" />
            break;
        case "loanaccount":
            <RhshfLoanAccountTab LoanAccount="loanAccount" LoanAccountError="@loanAccountError" OnRefresh="LoadLoanAccount" />
            break;
        case "advisory":
            <AdvisoryTab Advisory="advisory" IsGenerating="isGeneratingAdvisory" CanGenerate="CanGenerateAdvisory" OnGenerate="GenerateAdvisory"
                BureauReports="bureauReports" Appraisal="financialAppraisal" Currency="@workspace.Currency" />
            break;
        case "comments":
            <RhshfCommentsTab Comments="comments" OnAddComment="AddComment" IsSubmitting="isAddingComment" SubmitError="@commentError" />
            break;
        case "workflow":
            <WorkflowTab History="statusHistory" CurrentStatus="workspace.Status"
                CurrentInternalStage="workspace.InternalStage" CurrentProfilingStage="workspace.CurrentProfilingStage" />
            break;
    }

    @if (openModal == "collateral")
    {
        <CollateralModal OnClose="CloseModal" OnConfirm="SubmitCollateral" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "disbursement")
    {
        <DisbursementModal OnClose="CloseModal" OnConfirm="SubmitDisbursement" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "appraisal")
    {
        <AppraisalModal Intent="@modalIntent" OnClose="CloseModal" OnConfirm="SubmitAppraisal" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "riskreview")
    {
        <RiskReviewModal Intent="@modalIntent" Preview="committeeRoutingPreview" OnClose="CloseModal" OnConfirm="SubmitRiskReview" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "committee")
    {
        <CommitteeVoteModal Intent="@modalIntent" OnClose="CloseModal" OnVote="SubmitCommitteeVote" OnReturnToFac="SubmitCommitteeReturnToFac" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "ratification")
    {
        <RatificationModal Intent="@modalIntent" TotalEopValue="workspace.TotalEopValue" Currency="@workspace.Currency" OnClose="CloseModal" OnConfirm="SubmitRatify" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "legal")
    {
        <LegalClearanceModal Intent="@modalIntent" OnClose="CloseModal" OnConfirm="SubmitLegalClearance" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "farmplan")
    {
        <FarmPlanModal Existing="editingFarmPlan" Currency="@workspace.Currency" OnClose="CloseModal"
            OnAdd="SubmitAddFarmPlan" OnUpdate="SubmitUpdateFarmPlan" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "financialappraisal" && financialAppraisal is not null)
    {
        <FinancialAppraisalModal Data="financialAppraisal" OnClose="CloseModal"
            OnConfirm="SubmitFinancialAppraisal" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "director")
    {
        <DirectorModal Existing="editingDirector" OnClose="CloseModal" OnAdd="SubmitAddDirector"
            OnUpdate="SubmitUpdateDirector" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "guarantor")
    {
        <GuarantorModal Existing="editingGuarantor" OnClose="CloseModal" OnSave="SubmitGuarantor"
            IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "financialstatement")
    {
        <RhshfFinancialStatementModal Existing="editingFinancialStatement" DefaultYear="DefaultFinancialYear" DefaultCurrency="@workspace.Currency"
            OnClose="CloseModal" OnSave="SaveFinancialStatement" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
    @if (openModal == "uploadfinancials")
    {
        <RhshfUploadFinancialStatementModal Reference="@Reference" Currency="@workspace.Currency"
            OnClose="CloseModal" OnImported="OnFinancialStatementsImported" />
    }
    @if (openModal == "predeployment")
    {
        <PreDeploymentGateModal Checklist="preDeploymentChecklist" OnClose="CloseModal" OnConfirmItem="SubmitConfirmChecklistItem"
            OnComplete="SubmitCompletePreDeployment" IsSubmitting="isSubmitting" ErrorMessage="@modalError" />
    }
}

@code {
    [Parameter] public string Reference { get; set; } = string.Empty;

    private RhshfCaseWorkspaceDto? workspace;
    private List<RhshfCollateralDto> collateralRecords = [];
    private RhshfCommitteeReviewDto? committeeReview;
    private StandingCommitteeInfo? committeeRoster;
    private CRMS.Application.Rhshf.Queries.RhshfCommitteeRoutingPreviewDto? committeeRoutingPreview;
    private RhshfOfferDto? offer;
    private List<RhshfStatusHistoryDto> statusHistory = [];
    private AccountStatementDto? bankStatement;
    private string? bankStatementError;
    private bool isFetchingStatement;
    private bool bankStatementLoaded;
    private RhshfFinancialAnalysisDto? financialAnalysis;
    private string? financialAnalysisLoadError;
    private bool financialAnalysisLoaded;
    private RhshfFinancialStatementDto? editingFinancialStatement;
    private string? financialImportMessage;
    private bool isImportingFinancials;
    private List<RhshfCommentDto> comments = [];
    private bool isAddingComment;
    private string? commentError;
    private List<RhshfGuarantorDto> guarantors = [];
    private RhshfGuarantorDto? editingGuarantor;
    private List<RhshfDisbursementDto> disbursementHistory = [];
    private List<RhshfPreDeploymentChecklistItemDto> preDeploymentChecklist = [];
    private RhshfLoanAccountDto? loanAccount;
    private string? loanAccountError;
    private RhshfAdvisoryDto? advisory;
    private bool isGeneratingAdvisory;
    private RhshfDirectorsDto? directors;
    private List<RhshfBureauReportDto> bureauReports = [];
    private RhshfDirectorDto? editingDirector;
    private CRMS.Application.Rhshf.Queries.RhshfDirectorCrossCheckDto? directorCrossCheck;
    private bool directorCrossCheckLoaded;
    private bool isCrossChecking;
    private string? crossCheckError;
    private bool isRunningBureauChecks;
    private string? bureauError;
    private RhshfFinancialAppraisalDto? financialAppraisal;
    private string? financialAppraisalError;
    private RhshfFarmPlanDto? editingFarmPlan;

    private string activeTab = "overview";
    private bool isLoading = true;
    private bool isSubmitting;
    private string? pageError;
    private string? modalError;
    private string? openModal;
    private string modalIntent = string.Empty;

    private Guid CurrentUserId => AuthService.CurrentUser?.Id ?? Guid.Empty;
    private bool CanAppraise => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CreditOfficer") ?? false;
    private bool CanReviewRisk => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "RiskManager") ?? false;
    private bool CanVoteOnCommittee => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CommitteeMember") ?? false;
    private bool CanRatify => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "FinalApprover") ?? false;
    private bool CanClearLegally => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "LegalOfficer") ?? false;
    private bool CanBookDisbursement => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "DisbursementOfficer") ?? false;
    // Director capture and bureau checks are both credit-officer work, done before the appraisal
    // decision — same gate as NAMP's CanManageDirectors.
    private bool CanManageDirectors => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CreditOfficer") ?? false;
    // Same maker gate as directors — the Credit Officer who assembles the case records its guarantors.
    private bool CanManageGuarantors => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CreditOfficer") ?? false;
    private bool CanManageFinancials => AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CreditOfficer") ?? false;
    private bool CanRunBureauChecks => CanManageDirectors;
    // Only editable while the case actually sits at Appraisal — the domain enforces the same rule,
    // this just keeps the buttons honest.
    private bool CanEditFinancialAppraisal => CanAppraise && workspace!.InternalStage == RhshfInternalStage.Appraisal;
    // No SystemAdmin bypass here, deliberately — a committee vote is a credit decision, and this
    // codebase's maker-checker floor allows no single-actor exceptions, admins included.
    private bool CanActuallyVote => !(committeeReview?.Votes.Any(v => v.UserId == CurrentUserId) ?? false)
        && (committeeRoster?.Members.Any(m => m.UserId == CurrentUserId) ?? false);

    // Terminal/late-pipeline stages a "has this case ever reached X" check needs to include —
    // PreDeploymentVerification onward. Completed is the legacy terminal marker (pre-Active/Closed).
    private static readonly RhshfInternalStage[] PostLegalStages =
    [
        RhshfInternalStage.LegalClearance, RhshfInternalStage.PreDeploymentVerification, RhshfInternalStage.Disbursement,
        RhshfInternalStage.Completed, RhshfInternalStage.Active, RhshfInternalStage.Closed,
    ];

    // Tabs stay visible once the case has ever reached the relevant stage, even after moving past
    // it — staff need the history, not just "is it my turn right now".
    private bool ShowCollateralTab => (workspace!.InternalStage is not null && PostLegalStages.Contains(workspace.InternalStage.Value))
        || collateralRecords.Count > 0;
    private bool ShowCommitteeTab => workspace!.RiskReviews.Count > 0 || committeeReview is not null;
    private bool ShowOfferTab => workspace!.Ratifications.Any(r => r.Outcome == RhshfRatificationOutcome.Ratified) || offer is not null;
    private bool ShowPreDeploymentTab => workspace!.InternalStage is RhshfInternalStage.PreDeploymentVerification or RhshfInternalStage.Disbursement
            or RhshfInternalStage.Completed or RhshfInternalStage.Active or RhshfInternalStage.Closed
        || preDeploymentChecklist.Count > 0;
    private bool ShowDisbursementTab => workspace!.InternalStage is RhshfInternalStage.Disbursement or RhshfInternalStage.Completed
            or RhshfInternalStage.Active or RhshfInternalStage.Closed
        || disbursementHistory.Count > 0;
    private bool ShowLoanAccountTab => workspace!.InternalStage is RhshfInternalStage.Active or RhshfInternalStage.Closed;
    // Advisory tab shows once the case has at least an appraisal and a bureau check to draw on —
    // it's meaningful earlier than Active/Closed, matching NAMP's own "once financial appraisal
    // exists" gating.
    private bool ShowAdvisoryTab => workspace!.Appraisals.Count > 0;
    private bool CanGenerateAdvisory => (AuthService.CurrentUser?.HasAnyRole("SystemAdmin", "CreditOfficer") ?? false)
        && workspace!.BureauCheckOutcome != RhshfBureauOutcome.NotRun;

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    // Sequential, not parallel — AppService calls share one scoped DbContext per circuit; running
    // them concurrently silently returns empty results (established gotcha in this codebase).
    private async Task LoadAllAsync()
    {
        isLoading = true;
        pageError = null;
        try
        {
            workspace = await AppService.GetRhshfCaseWorkspaceAsync(Reference);
            if (workspace is null)
                return;

            directors = await AppService.GetRhshfDirectorsAsync(Reference);
            bureauReports = await AppService.GetRhshfBureauReportsAsync(Reference);
            var appraisalResult = await AppService.GetRhshfFinancialAppraisalAsync(Reference);
            financialAppraisal = appraisalResult.Data;
            financialAppraisalError = appraisalResult.Error;
            collateralRecords = await AppService.GetRhshfCollateralAsync(Reference);
            committeeReview = await AppService.GetRhshfCommitteeReviewAsync(Reference);
            committeeRoster = committeeReview is not null
                ? await AppService.GetStandingCommitteeByTypeAsync(committeeReview.Tier.ToString(), committeeReview.BranchId)
                : null;
            offer = await AppService.GetRhshfOfferAsync(Reference);
            preDeploymentChecklist = await AppService.GetRhshfPreDeploymentChecklistAsync(Reference);
            disbursementHistory = await AppService.GetRhshfDisbursementHistoryAsync(Reference);
            if (workspace.InternalStage is RhshfInternalStage.Active or RhshfInternalStage.Closed)
                await LoadLoanAccount();
            advisory = await AppService.GetRhshfAdvisoryAsync(Reference);
            statusHistory = await AppService.GetRhshfStatusHistoryAsync(Reference);
            comments = await AppService.GetRhshfCommentsAsync(Reference);
            guarantors = await AppService.GetRhshfGuarantorsAsync(Reference);
        }
        catch (Exception ex)
        {
            pageError = $"Failed to load case: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

