    private int DefaultFinancialYear
    {
        get
        {
            var existing = financialAnalysis?.Years.Select(y => y.FinancialYear).ToHashSet() ?? [];
            for (var y = DateTime.UtcNow.Year - 1; y > DateTime.UtcNow.Year - 7; y--)
                if (!existing.Contains(y)) return y;
            return DateTime.UtcNow.Year - 1;
        }
    }

