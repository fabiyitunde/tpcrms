    // Final Approver / admin can regenerate the letter — but only before the FAC has responded, so an
    // accepted (contractual) offer is never silently replaced.
    private bool CanRegenerateOffer => CanRatify && offer is not null
        && offer.Status is RhshfOfferStatus.Generated or RhshfOfferStatus.AwaitingFacResponse;
    private bool isRegeneratingOffer;

    private async Task RegenerateOffer()
    {
        isRegeneratingOffer = true;
        pageError = null;
        var result = await AppService.RegenerateRhshfOfferLetterAsync(Reference, CurrentUserId);
        isRegeneratingOffer = false;
        if (!result.Success) { pageError = result.Error; return; }
        offer = await AppService.GetRhshfOfferAsync(Reference);
    }

    // Testing-only helper: copy the full FAC offer-acceptance link (with a minted token). Hidden in
    // Production — in a real deployment the portal appends its own token to the callback's actionUrl.
    private bool CanCopyAcceptanceLink => Env.EnvironmentName != "Production" && CanRatify && offer is not null;

    private async Task CopyAcceptanceLink()
    {
        var (url, error) = await AppService.GetRhshfOfferAcceptanceLinkAsync(Reference);
        if (url is null) { pageError = error; return; }
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", url); } catch { /* non-secure context */ }
        await JS.InvokeVoidAsync("alert", $"FAC offer-acceptance link (copied to clipboard):\n\n{url}");
    }

    // Manual re-send of the OfferReady portal callback (for a failed/interrupted auto-delivery).
    private bool CanResendOfferCallback => CanRatify
        && workspace?.InternalStage == RhshfInternalStage.AwaitingOfferAcceptance;
    private bool isResendingCallback;

    private async Task ResendOfferCallback()
    {
        isResendingCallback = true;
        pageError = null;
        var result = await AppService.ResendRhshfOfferReadyCallbackAsync(Reference);
        isResendingCallback = false;
        if (!result.Success) { pageError = result.Error; return; }
        await JS.InvokeVoidAsync("alert", "Offer-ready callback re-queued — the portal will be notified on the next delivery cycle.");
    }
    private async Task DownloadCollateralDocument(Guid documentId) => await TriggerDownload(await AppService.DownloadRhshfCollateralDocumentAsync(documentId));

    private async Task TriggerDownload(RhshfDownloadedFileDto? file)
    {
        if (file is null) { pageError = "Could not download the file."; return; }
        await JS.InvokeVoidAsync("downloadFileFromBytes", file.FileName, file.ContentType, file.Content);
    }

    private static string StatusBadgeClass(RhshfCaseStatus status) => status switch
    {
        RhshfCaseStatus.Approved => "badge-success",
        RhshfCaseStatus.Declined => "badge-danger",
        RhshfCaseStatus.Cancelled or RhshfCaseStatus.Expired => "badge-secondary",
        RhshfCaseStatus.UnderReview => "badge-warning",
        _ => "badge-secondary",
    };
}
